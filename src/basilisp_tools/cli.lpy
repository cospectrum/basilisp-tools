(ns basilisp-tools.cli
  "The blt command line interface."
  (:require [basilisp.string :as str]
            [basilisp-tools.format :as fmt]
            [basilisp-tools.syntax :as syntax])
  (:import [argparse] [importlib] [difflib] [os] [os.path :as pathutil] [pathlib] [re] [stat] [sys] [tempfile]
           [importlib.metadata :as metadata]
           [concurrent.futures :as futures]))

(def ^:private skipped-directories
  #{".git" ".hg" ".svn" ".venv" "venv" ".direnv" ".tox" "node_modules"
    "__pycache__" ".pytest_cache" ".mypy_cache" "build" "dist"})

(defn- add-check-options! [commands]
  (let [p (.add_parser commands "check" ** :help "Check Basilisp source and Python interop."
                       :description "Analyze source without evaluating it. Use - for stdin."
                       :formatter_class argparse/RawDescriptionHelpFormatter
                       :epilog (str "Examples:\n"
                                    "  blt check src tests\n"
                                    "  blt check --format json src\n"
                                    "  blt check --filename example.lpy - < example.lpy\n\n"
                                    "Configuration: .clj-kondo/config.edn; --config accepts an\n"
                                    "EDN map or filename and can be repeated. Later values win.\n"
                                    "Exit codes: 0 clean, 2 warnings, 3 errors."))]
    (.add_argument p "paths" ** :nargs "*" :metavar "PATH"
                   :help "Files/directories, or - for stdin. Defaults to the current directory.")
    (.add_argument p "--lint" ** :action "extend" :nargs "+" :metavar "PATH"
                   :help "clj-kondo-style alias for positional source paths; may be repeated.")
    (.add_argument p "--config" ** :action "append" :metavar "EDN_OR_FILE"
                   :help "Additional checker configuration; repeat to merge multiple sources.")
    (.add_argument p "--config-dir" ** :metavar "DIR"
                   :help "Use this .clj-kondo configuration directory.")
    (.add_argument p "--repro" ** :action "store_true"
                   :help "Ignore home configuration for reproducible checks.")
    (.add_argument p "--format" ** :choices #py ["text" "json" "edn"]
                   :help "Output format; overrides configuration.")
    (.add_argument p "--filename" ** :metavar "NAME"
                   :help "Filename used for stdin diagnostics and namespace context.")
    (.add_argument p "--fail-level" ** :choices #py ["warning" "error"] :default "warning"
                   :help "Minimum severity causing a nonzero exit (default: warning).")
    (.add_argument p "--report-level" ** :choices #py ["info" "warning" "error"] :default "info"
                   :help "Minimum displayed diagnostic severity (default: info).")
    (.add_argument p "--python" ** :dest "python_executable" :metavar "EXECUTABLE"
                   :help "Python environment to inspect; defaults to the project .venv, then this interpreter.")
    (.add_argument p "--no-python-inspection" ** :dest "python_inspection" :action "store_false"
                   :help "Disable runtime inspection of installed Python dependencies.")
    (.add_argument p "--python-timeout" ** :type python/float :default 5.0 :metavar "SECONDS"
                   :help "Timeout for Python inspection (default: 5).")))

(defn- add-lsp-options! [commands]
  (let [p (.add_parser commands "lsp" ** :help "Start the stdio language server."
                       :description "Serve editor features over LSP on stdin/stdout."
                       :epilog "Configure your editor to launch: blt lsp")]
    (.add_argument p "-s" "--settings" ** :metavar "EDN"
                   :help "Force LSP settings over client and .lsp/config.edn settings.")
    (.add_argument p "--python" ** :dest "python_executable" :metavar "EXECUTABLE"
                   :help "Python environment to inspect; defaults to the workspace .venv, then this interpreter.")
    (.add_argument p "--no-python-inspection" ** :dest "python_inspection" :action "store_false"
                   :help "Disable runtime inspection of installed Python dependencies.")
    (.add_argument p "--python-timeout" ** :type python/float :default 5.0 :metavar "SECONDS"
                   :help "Timeout for Python inspection (default: 5).")))

(def ^:private format-switches
  [:align-form-columns? :align-map-columns? :align-single-column-lines?
   :blank-lines-separate-alignment? :indentation? :indent-line-comments?
   :insert-missing-whitespace? :remove-consecutive-blank-lines?
   :remove-multiple-non-indenting-spaces? :remove-surrounding-whitespace?
   :remove-trailing-whitespace? :remove-blank-lines-in-forms?
   :normalize-newlines-at-file-end? :sort-ns-references?
   :split-keypairs-over-multiple-lines? :read-clj-config-files? :parallel? :ansi?])

(defn- format-argument [option]
  (str "format_" (str/replace (str/replace (name option) "?" "") "-" "_")))

(defn- add-format-options! [p]
  (doseq [option format-switches]
    (.add_argument p (str "--" (str/replace (name option) "?" ""))
                   ** :dest (format-argument option) :action argparse/BooleanOptionalAction
                   :default nil :help (str "Override :" (name option) " from formatter configuration.")))
  (.add_argument p "--function-arguments-indentation"
                 ** :dest "format_function_arguments_indentation"
                 :choices #py ["community" "cursive" "zprint"]
                 :help "Override the function argument indentation style.")
  (.add_argument p "--file-pattern" ** :dest "format_file_pattern" :metavar "REGEX"
                 :help "Match paths relative to each searched directory.")
  (doseq [option [:max-column-alignment-gap :max-column-alignment-width]]
    (.add_argument p (str "--" (name option)) ** :dest (format-argument option)
                   :type python/int :metavar "N" :help (str "Override :" (name option) ".")))
  (.add_argument p "--project-root" ** :dest "format_project_root" :metavar "DIR"
                 :help "Base directory for displayed paths; input paths remain relative to the working directory.")
  (.add_argument p "--verbose" "-v" ** :action "store_true" :default nil
                 :help "Report every processed file."))

(defn- parser []
  (let [p (argparse/ArgumentParser ** :prog "blt"
                                   :description "Development tools for Basilisp."
                                   :epilog "Run blt COMMAND --help for command options and examples.")
        commands (.add_subparsers p ** :dest "command" :required true)
        format (.add_parser commands "format" ** :help "Format Basilisp source."
                            :description "Format files in place, or use - for stdin/stdout. Directories are searched recursively for .lpy files."
                            :formatter_class argparse/RawDescriptionHelpFormatter
                            :epilog (str "Examples:\n"
                                         "  blt format src tests\n"
                                         "  blt format --check .\n"
                                         "  blt format --diff .\n"
                                         "  blt format - < file.lpy\n\n"
                                         "Configuration: discovers project.clj with Leiningen precedence,\n"
                                         "otherwise the nearest .cljfmt.edn or cljfmt.edn. Add\n"
                                         "--read-clj-config-files to discover .clj configurations too.\n"
                                         "Project settings load files only with :load-config-file? true;\n"
                                         "project values win.\n"
                                         "--config selects a file directly. Project code is never evaluated.\n\n"
                                         "Exit codes: 0 success, 1 changes needed (--check/--diff), 2 error."))
        modes (.add_mutually_exclusive_group format)]
    (add-format-options! format)
    (add-check-options! commands)
    (add-lsp-options! commands)
    (.add_argument p "--version" ** :action "version"
                   :version (str "blt " (metadata/version "basilisp-tools")))
    (.add_argument format "paths" ** :nargs "*" :metavar "PATH"
                   :help "Files/directories, or - for stdin. Defaults to configured :paths, then the current directory.")
    (.add_argument modes "--check" ** :action "store_true"
                   :help "Report files that need formatting without changing them.")
    (.add_argument modes "--diff" ** :action "store_true"
                   :help "Print unified diffs without changing files.")
    (.add_argument format "--config" ** :metavar "FILE"
                   :help "Use an EDN or literal .clj configuration file instead of discovery.")
    (.add_argument format "--quiet" "-q" ** :action "store_true" :default nil
                   :help "Suppress file status messages.")
    p))

(defn- error [message] (throw (python/ValueError message)))
(defn- report [message] (.write sys/stderr (str message "\n")))

(defn- configuration [args]
  (let [discovery {:read-clj-config-files? (.-format_read_clj_config_files args)}
        base (if-let [path (.-config args)]
               (let [p (pathlib/Path path)]
                 (when-not (.is_file p) (error (str "Configuration file does not exist: " path)))
                 (fmt/load-config p discovery))
               (fmt/load-config (.cwd pathlib/Path) discovery))
        options (reduce (fn [options option]
                          (let [value (python/getattr args (format-argument option))]
                            (if (nil? value) options (assoc options option value))))
                        base (concat format-switches [:max-column-alignment-gap :max-column-alignment-width
                                                      :project-root]))
        options (cond-> options
                  (.-format_function_arguments_indentation args)
                  (assoc :function-arguments-indentation (keyword (.-format_function_arguments_indentation args)))
                  (.-format_file_pattern args) (assoc :file-pattern (re/compile (.-format_file_pattern args)))
                  (some? (.-quiet args)) (assoc :quiet? (.-quiet args))
                  (some? (.-verbose args)) (assoc :verbose? (.-verbose args)))]
    ;; --project-root changes displayed paths. Leiningen's configured paths
    ;; retain their original project root even when that display base changes.
    (vary-meta options assoc :paths-root (:paths-root (meta base)))))

(defn- walk-files [path pattern]
  (let [result (atom [])]
    (doseq [[root dirs files]
            (iterator-seq (os/walk path ** :followlinks false
                                   :onerror (fn [e] (throw e))))]
      ;; Mutating os.walk's directory list prunes generated and hidden trees.
      (.clear dirs)
      (doseq [entry (iterator-seq (.iterdir (pathlib/Path root)))
              :when (and (.is_dir entry) (not (.is_symlink entry))
                         (not (contains? skipped-directories (.-name entry))))]
        (.append dirs (.-name entry)))
      (.sort dirs)
      (doseq [name (sort files)
              :let [p (.joinpath (pathlib/Path root) name)]
              :when (and (re/search pattern (.as_posix (.relative_to p (pathlib/Path path))))
                         (.is_file p) (not (.is_symlink p)))]
        (swap! result conj p)))
    @result))

(defn- collect-files [paths options]
  (let [pattern (:file-pattern options (re/compile "\\.lpy$"))]
    (->> paths
         (mapcat (fn [path]
                   (let [p (.absolute (pathlib/Path path))]
                     (cond
                       (.is_symlink p) (error (str "Refusing symbolic link: " path))
                       (.is_file p) [p]
                       (.is_dir p) (walk-files p pattern)
                       :else (error (str "Path does not exist: " path))))))
         distinct
         (sort-by str)
         vec)))

(defn- format-source [source options label]
  (try
    (fmt/format-string source options)
    (catch python/Exception e
      (if-let [diagnostic (first (:diagnostics (ex-data e)))]
        (let [pos (syntax/offset->position (syntax/parse source) (:start diagnostic))]
          (error (str label ":" (inc (:line pos)) ":" (inc (:character pos))
                      ": " (:message diagnostic))))
        (throw e)))))

(defn- diff [source formatted label]
  (str/join ""
            (map (fn [line]
                   (if (.endswith line "\n") line
                       (str line "\n\\ No newline at end of file\n")))
                 (iterator-seq
                  (difflib/unified_diff (.splitlines source true) (.splitlines formatted true)
                                        ** :fromfile (str "a/" label) :tofile (str "b/" label))))))

(defn- display-diff [source formatted label options]
  (let [text (diff source formatted label)
        color? (and (:ansi? options true) (.isatty sys/stdout)
                    (os/getenv "TERM") (nil? (os/getenv "NO_COLOR")))
        escape (python/chr 27)]
    (if color?
      (reduce (fn [text [pattern code]]
                (re/sub pattern #(str escape "[" code "m" (.group % 0) escape "[0m") text))
              text [[#"(?m)^(@@.*@@)$" "036"]
                    [#"(?m)^(\+(?!\+\+).*)$" "032"]
                    [#"(?m)^(-(?!--).*)$" "031"]])
      text)))

(defn- displayed-path [path options]
  (pathutil/relpath path (:project-root options ".")))

(defn- prepare-files [files options]
  (when (and (:verbose? options) (not (:quiet? options)))
    (doseq [path files] (report (str "Processing file: " (displayed-path path options)))))
  (let [prepare (fn [path]
                  (let [original (.read_bytes path)
                        source (.decode original "utf-8")
                        label (displayed-path path options)]
                    {:path path :original original :source source
                     :formatted (format-source source options label) :label label}))]
    (if (and (:parallel? options) (> (count files) 1))
      (with-open [pool (futures/ThreadPoolExecutor ** :max_workers (min 32 (count files)))]
        (vec (iterator-seq (.map pool prepare files))))
      (mapv prepare files))))

(defn- replace-file! [path original formatted]
  (when-not (= original (.read_bytes path))
    (error (str "File changed while formatting: " path)))
  (let [[fd name] (tempfile/mkstemp ** :prefix (str "." (.-name path) ".")
                                    :dir (str (.-parent path)))]
    (try
      (with-open [stream (os/fdopen fd "wb")]
        (.write stream (.encode formatted "utf-8")))
      (os/chmod name (stat/S_IMODE (.-st_mode (.stat path))))
      (when (or (.is_symlink path) (not= original (.read_bytes path)))
        (error (str "File changed while formatting: " path)))
      (os/replace name path)
      (finally
        (when (pathutil/exists name) (os/unlink name))))))

(defn- format-command [args]
  (let [options (configuration args)
        explicit-paths (seq (.-paths args))
        paths (or explicit-paths (:paths options) ["."])
        paths-root (:paths-root (meta options))
        paths (if (and (not explicit-paths) paths-root)
                (mapv #(if (= "-" %) % (str (.joinpath (pathlib/Path paths-root) %))) paths)
                paths)
        check? (or (.-check args) (.-diff args))]
    (if (some #(= "-" %) paths)
      (do
        (when-not (= 1 (count paths)) (error "Stdin (-) cannot be combined with other paths."))
        (let [source (.read sys/stdin)
              formatted (format-source source options "<stdin>")
              changed? (not= source formatted)]
          (cond
            (.-diff args) (.write sys/stdout (display-diff source formatted "stdin" options))
            (not check?) (.write sys/stdout formatted))
          (if (and check? changed?) 1 0)))
      (let [files (collect-files paths options)
            _ (when (empty? files) (error "No matching source files found."))
            ;; Validate and format the entire selection before writing anything.
            changes (filterv #(not= (:source %) (:formatted %)) (prepare-files files options))]
        (doseq [{:keys [path original source formatted label]} changes]
          (cond
            (.-diff args) (.write sys/stdout (display-diff source formatted label options))
            (not check?) (replace-file! path original formatted))
          (when-not (:quiet? options)
            (report (str (if check? "Would format " "Formatted ") label))))
        (if (and check? (seq changes)) 1 0)))))

(defn- check-command [args]
  (let [checker (importlib/import_module "basilisp_tools.check")
        paths (vec (or (seq (concat (.-paths args) (or (.-lint args) []))) ["."]))
        options {:paths paths
                 :config (vec (or (.-config args) []))
                 :config-dir (.-config_dir args)
                 :repro (.-repro args)
                 :filename (or (.-filename args) (when (some #(= "-" %) paths) "stdin.lpy"))
                 :python-executable (.-python_executable args)
                 :python-inspection? (.-python_inspection args)
                 :python-timeout (.-python_timeout args)}
        options (cond-> options
                  (some #(= "-" %) paths) (assoc :stdin (.read sys/stdin)))
        result (.run checker options)
        output (.output checker result (.-format args) (keyword (.-report_level args)))]
    (.write sys/stdout output)
    (.exit_status checker result (keyword (.-fail_level args)))))

(defn- lsp-command [args]
  (let [server (importlib/import_module "basilisp_tools.lsp")
        options (cond-> {:python-inspection? (.-python_inspection args)
                         :python-timeout (.-python_timeout args)}
                  (.-python_executable args) (assoc :python-executable (.-python_executable args))
                  (.-settings args) (assoc :force-settings (.read_settings server (.-settings args) "--settings")))]
    (.start server options)))

(defn main
  "Run blt. Format: 0 success, 1 changes required, 2 error.
  Check: 0 clean, 2 warnings, 3 analysis errors; invalid CLI input returns 2."
  ([] (main nil))
  ([argv]
   (let [args (.parse_args (parser) argv)]
     (try
       (case (.-command args)
         "format" (format-command args)
         "check" (check-command args)
         "lsp" (lsp-command args))
       (catch python/BrokenPipeError _ 0)
       (catch python/Exception e
         (report (str "blt: " (or (ex-message e) (str e))))
         2)))))
