(ns basilisp-tools.format
  "Pure, lossless formatting with cljfmt-compatible EDN options."
  (:require [basilisp.edn :as edn]
            [basilisp.string :as str]
            [basilisp-tools.syntax :as syntax])
  (:import [pathlib] [re] [sys] [operator :as op]))

(def ^:private containers
  #{:root :list :vector :map :set :anonymous-function
    :reader-conditional :reader-splice :interpolation})
(def ^:private literals #{:string :bytes :regex :f-string})
(def ^:private punctuation #{:delimiter :prefix :string-text})
(def ^:private gap-kinds #{:whitespace :newline :gap})
(defn- gap? [n] (contains? gap-kinds (:kind n)))
(defn- form? [n]
  (not (or (gap? n) (syntax/trivia? n)
           (contains? punctuation (:kind n)) (op/eq :discard (:kind n)))))
(defn- node-forms [node] (filterv form? (:children node)))
(defn- leaf [kind text] {:kind kind :text text})
(defn- column-width [s]
  ;; Match cljfmt's UTF-16 columns; syntax offsets remain Unicode code points.
  (if (.isascii s) (python/len s)
      (op/floordiv (python/len (.encode s "utf-16-le" "surrogatepass")) 2)))
(defn- spaces [n] (op/mul " " (max 0 n)))
(defn- newline? [s] (boolean (re/search "[\r\n]" s)))
(defn- bare [n]
  (if (op/eq :metadata (:kind n)) (recur (last (node-forms n))) n))
(defn- head [n]
  (let [f (bare (first (node-forms n)))
        f (if (#{:reader-conditional :reader-splice} (:kind f))
            (some->> (node-forms f)
                     (drop-while #(not (op/eq :keyword (:kind (bare %)))))
                     second bare)
            f)]
    (when (op/eq :symbol (:kind f)) (:text f))))

(def ^:private rule-groups
  {[:inner 0] "bound-fn def defmacro defmethod defmulti defn defn- defonce deftest fdef fn use-fixtures ANY DELETE GET HEAD OPTIONS PATCH POST PUT context defroutes rfn"
   [:block 0] "alt! alt!! comment cond delay do finally future go thread try with-out-str"
   [:block 1] "binding case cond-> cond->> defstruct doseq dotimes doto extend for go-loop if if-let if-not if-some let let* locking loop match ns struct-map testing when when-first when-let when-not when-some while with-local-vars with-open with-precision with-redefs let-routes"
   [:block 2] "are as-> catch condp"})

(def default-indents
  (merge
   (into {} (for [[rule names] rule-groups
                  n (str/split names #" ")]
              [(symbol n) [rule]]))
   {'defprotocol [[:block 1] [:inner 1]]
    'defrecord [[:block 2] [:inner 1]]
    'deftype [[:block 2] [:inner 1]]
    'proxy [[:block 2] [:inner 1]]
    'extend-protocol [[:block 1] [:inner 1]]
    'extend-type [[:block 1] [:inner 1]]
    'reify [[:inner 0] [:inner 1]]
    'letfn [[:block 1] [:inner 2 0]]
    (re/compile "^def(?!ault)(?!late)(?!er)") [[:inner 0]]
    (re/compile "^with-") [[:inner 0]]}))

(def ^:private binding-forms
  (zipmap '[let doseq go-loop binding with-open loop for with-local-vars with-redefs]
          (repeat #{0})))

(def default-options
  {:alias-map {} :refer-map {}
   :function-arguments-indentation :community
   :indent-line-comments? false :indentation? true
   :indents default-indents :extra-indents {}
   :normalize-newlines-at-file-end? false
   :insert-missing-whitespace? true
   :remove-blank-lines-in-forms? false
   :remove-consecutive-blank-lines? true
   :remove-multiple-non-indenting-spaces? false
   :remove-surrounding-whitespace? true
   :remove-trailing-whitespace? true
   :sort-ns-references? false :split-keypairs-over-multiple-lines? false
   :align-map-columns? false :align-form-columns? false
   :align-binding-columns? false :align-single-column-lines? false
   :aligned-forms binding-forms :extra-aligned-forms {}
   :blank-line-forms (assoc binding-forms 'comment :all 'cond :all)
   :extra-blank-line-forms {}
   :blank-lines-separate-alignment? false
   :max-column-alignment-gap nil :max-column-alignment-width nil})

(def ^:private runtime-options
  #{:paths :file-pattern :project-root :read-clj-config-files? :quiet? :verbose? :ansi? :parallel?})
(defn- invalid [message data] (throw (ex-info message data)))

(defn- regex? [x] (instance? re/Pattern x))
(defn- matcher? [x] (or (symbol? x) (string? x) (regex? x)))
(defn- rule-key? [k]
  (or (matcher? k)
      (and (vector? k) (op/eq 2 (count k)) (every? matcher? k))))

(defn resolve-options
  "Validate options and merge cljfmt defaults. :indents replaces defaults;
  :extra-indents extends them. Unknown options fail instead of being ignored."
  [options]
  (when-not (map? options)
    (invalid "Formatter options must be a map" {:options options}))
  (let [legacy? (:legacy/merge-indents? options)
        options (cond-> (dissoc options :legacy/merge-indents?)
                  legacy? (-> (dissoc :indents)
                              (assoc :extra-indents
                                     (merge (:indents options) (:extra-indents options)))))
        opts (merge default-options options)]
    (doseq [[k v] options]
      (when-not (or (contains? default-options k) (contains? runtime-options k))
        (invalid (str "Unknown formatter option: " k) {:option k}))
      (when (and (.endswith (name k) "?")
                 (not (boolean? v)))
        (invalid (str k " must be a boolean") {:option k})))
    (when-not (#{:community :cursive :zprint} (:function-arguments-indentation opts))
      (invalid "Invalid :function-arguments-indentation" {}))
    (doseq [k [:indents :extra-indents :alias-map :refer-map
               :aligned-forms :extra-aligned-forms :blank-line-forms :extra-blank-line-forms]]
      (when-not (map? (get opts k)) (invalid (str k " must be a map") {:option k})))
    (doseq [k [:max-column-alignment-gap :max-column-alignment-width]
            :let [v (get opts k)]]
      (when-not (or (nil? v) (and (integer? v) (>= v 0)))
        (invalid (str k " must be nil or a nonnegative integer") {:option k})))
    (doseq [[k rules] (merge (:indents opts) (:extra-indents opts))]
      (when-not (and (rule-key? k) (sequential? rules)
                     (every? (fn [r]
                               (and (vector? r)
                                    (case (first r)
                                      :default (op/eq 1 (count r))
                                      :block (and (op/eq 2 (count r))
                                                  (integer? (second r)) (>= (second r) 0))
                                      :inner (and (<= 2 (count r) 3)
                                                  (every? #(and (integer? %) (>= % 0)) (rest r)))
                                      false))) rules))
        (invalid (str "Invalid indentation rule for " k) {:key k})))
    (doseq [k [:aligned-forms :extra-aligned-forms :blank-line-forms :extra-blank-line-forms]
            [key v] (get opts k)]
      (when-not (and (rule-key? key)
                     (or (op/eq :all v)
                         (and (set? v) (every? #(and (integer? %) (>= % 0)) v))))
        (invalid (str "Invalid " k " rule for " key) {:key key})))
    (when (and (contains? options :project-root) (not (string? (:project-root options))))
      (invalid ":project-root must be a path string" {}))
    (when (and (:file-pattern opts) (not (regex? (:file-pattern opts))))
      (invalid ":file-pattern must be a #re regular expression" {}))
    (when (and (:paths opts) (not (and (sequential? (:paths opts)) (every? string? (:paths opts)))))
      (invalid ":paths must be a vector of paths" {}))
    (assoc opts :indents (merge (:indents opts) (:extra-indents opts))
           :aligned-forms (merge (:aligned-forms opts) (:extra-aligned-forms opts))
           :blank-line-forms (merge (:blank-line-forms opts) (:extra-blank-line-forms opts)))))

(defn- config-error [file message]
  (invalid (str file ": " message) {:path (str file) :code :unsupported-config}))

(defn- config-map [pairs file]
  (reduce (fn [result [k v]]
            (when (contains? result k) (config-error file (str "Duplicate configuration key: " k)))
            (assoc result k v))
          {} pairs))

(defn- config-value [node file clj?]
  ;; Decode data from our syntax tree. Never invoke the compiler, project code,
  ;; reader evaluation, or user-defined tagged-literal readers.
  (let [kind (:kind node)
        forms (node-forms node)]
    (cond
      (and (op/eq :keyword kind) (.startswith (:text node) "::"))
      (if (and (true? clj?) (< (.find (subs (:text node) 2) "/") 0))
        (keyword (str "user/" (subs (:text node) 2)))
        (config-error file "Auto-resolved keyword aliases require a Clojure namespace"))

      (#{:nil :boolean :number :symbolic-number :character :keyword :symbol :string} kind)
      (edn/read-string (syntax/text node))

      (and (true? clj?) (op/eq :metadata kind))
      (let [metadata (config-value (first forms) file clj?)
            target (second forms)]
        (when-not (and (or (map? metadata) (keyword? metadata)
                           (symbol? metadata) (string? metadata))
                       (#{:symbol :map :vector :set :list :namespaced-map :metadata} (:kind target)))
          (config-error file "Invalid configuration metadata"))
        (config-value target file clj?))

      (#{:map :vector :set :list} kind)
      (let [values (mapv #(config-value % file clj?) forms)]
        (case kind
          :map (config-map (partition 2 values) file)
          :vector values
          :set (do (when (not= (count values) (count (set values)))
                     (config-error file "Duplicate set element"))
                   (set values))
          :list (apply list values)))

      (op/eq :namespaced-map kind)
      (let [prefix (:text (first (:children node)))
            auto? (.startswith prefix "#::")
            ns-name (if auto? "user" (subs prefix 2))
            values (config-value (first forms) file clj?)]
        (when (and auto? (not (and (true? clj?) (op/eq prefix "#::"))))
          (config-error file "Auto-resolved namespace aliases require a Clojure namespace"))
        (config-map
         (for [[k v] values]
           [(if (or (keyword? k) (symbol? k))
              (let [constructor (if (keyword? k) keyword symbol)]
                (case (namespace k)
                  nil (constructor (str ns-name "/" (name k)))
                  "_" (constructor (name k))
                  k))
              k)
            v])
         file))

      (and clj? (op/eq :regex kind) (.startswith (syntax/text node) "#\""))
      (let [source (syntax/text node)]
        (re/compile (subs source 2 (dec (count source)))))

      (and (not clj?) (op/eq :tagged kind)
           (op/eq "#re" (:text (first (:children node))))
           (op/eq :string (:kind (first forms))))
      (re/compile (config-value (first forms) file false))

      :else (config-error file
                          (str "Unsupported configuration form " (name kind)
                               "; use literal data (computed values and reader macros are not evaluated)")))))

(defn- config-tree [file]
  (let [parsed (syntax/parse (.read_text file ** :encoding "utf-8"))]
    (when (seq (:diagnostics parsed))
      (invalid (str file ": Invalid configuration syntax")
               {:path (str file) :diagnostics (:diagnostics parsed)}))
    (:root parsed)))

(defn- read-file-config [file]
  (when-not (#{".edn" ".clj"} (.-suffix file))
    (config-error file "Configuration filename must end in .edn or .clj"))
  (let [clj? (op/eq ".clj" (.-suffix file))
        parsed (syntax/parse (.read_text file ** :encoding "utf-8"))
        node (first (node-forms (:root parsed)))
        ;; Both upstream readers consume just the first form. A malformed
        ;; later form must not invalidate the selected configuration map.
        prefix (if node (syntax/parse (subs (:source parsed) 0 (:end node))) parsed)
        diagnostics (:diagnostics prefix)]
    (when (seq diagnostics)
      (invalid (str file ": Invalid configuration syntax")
               {:path (str file) :diagnostics (vec diagnostics)}))
    (when (nil? node) (config-error file "EOF while reading configuration"))
    (let [value (if node (config-value node file clj?) nil)
          value (if (nil? value) {} value)]
      (when-not (map? value) (config-error file "Expected a configuration map"))
      ;; Validate before merging project overrides and convert legacy keys at
      ;; this point, exactly like cljfmt.config/load-config.
      (resolve-options (dissoc value :legacy/merge-indents?))
      (if (:legacy/merge-indents? value)
        (-> value
            (assoc :extra-indents (:indents value default-indents))
            (dissoc :indents :legacy/merge-indents?))
        value))))

(defn- find-formatter-config [directory options]
  (let [names [".cljfmt.edn" ".cljfmt.clj" "cljfmt.edn" "cljfmt.clj"]]
    (loop [dir directory]
      (let [files (filter #(.is_file %) (map #(.joinpath dir %) names))
            preferred (first files)
            ignored? (and preferred (not (:read-clj-config-files? options))
                          (op/eq ".clj" (.-suffix preferred)))
            chosen (if ignored?
                     (first (filter #(op/eq ".edn" (.-suffix %)) files))
                     preferred)]
        (when ignored?
          (.write sys/stderr
                  (str "Warning: .clj config file '" (.-name preferred)
                       "' detected but --read-clj-config-files is not set. Ignoring config file.\n")))
        (or chosen
            (when (not (op/eq dir (.-parent dir))) (recur (.-parent dir))))))))

(defn- find-config [directory names]
  (loop [dir directory]
    (or (first (filter #(.is_file %) (map #(.joinpath dir %) names)))
        (when (not (op/eq dir (.-parent dir))) (recur (.-parent dir))))))

(defn- project-fields [file]
  (let [projects (filter #(and (op/eq :list (:kind %))
                               (#{"defproject" "leiningen.core.project/defproject"} (head %)))
                         (node-forms (config-tree file)))]
    (when-not (op/eq 1 (count projects))
      (config-error file "Expected one top-level defproject form"))
    (let [forms (node-forms (first projects))
          fields (drop 3 forms)]
      (when-not (and (>= (count forms) 3) (even? (count fields))
                     (every? #(op/eq :keyword (:kind %)) (take-nth 2 fields)))
        (config-error file "Expected literal defproject keyword/value pairs"))
      (config-map (map (fn [[k v]] [(:text k) v]) (partition 2 fields)) file))))

(defn- project-paths [fields options root file]
  (if (some? (:paths options))
    (:paths options)
    (let [paths (mapcat (fn [[key fallback]]
                          (let [value (if-let [node (get fields key)]
                                        (config-value node file :project) fallback)
                                value (if (nil? value) fallback value)]
                            (when-not (or (nil? value)
                                          (and (sequential? value) (every? string? value)))
                              (config-error file (str key " must contain literal paths")))
                            value))
                        [[":source-paths" ["src"]] [":test-paths" ["test"]]])]
      (when (empty? paths)
        (config-error file "No source or test paths defined in project map"))
      (filterv #(.is_dir (.joinpath root %)) paths))))

(defn- read-project-config [file]
  (let [fields (project-fields file)
        root (.-parent file)
        profiles (get fields ":profiles")
        _ (when (and profiles
                     (some #(and (op/eq :keyword (:kind %))
                                 (#{":cljfmt" ":source-paths" ":test-paths"} (:text %)))
                           (syntax/nodes profiles)))
            (config-error file "Leiningen profiles affecting formatter settings are unsupported; use top-level configuration or --config"))
        project (if-let [node (get fields ":cljfmt")] (config-value node file :project) {})
        project (if (nil? project) {} project)
        _ (when-not (map? project) (config-error file ":cljfmt must be a literal map"))
        ;; Lein selects paths before loading the optional config file.
        project (assoc project :paths (project-paths fields project root file)
                       :project-root (str root))
        config-file (when (:load-config-file? project)
                      (find-formatter-config root {}))
        from-file (if config-file (read-file-config config-file) {})]
    ;; This is deliberately shallow: a project map replaces the corresponding
    ;; file map, exactly as lein-cljfmt's merge-file-options does.
    (with-meta (dissoc (merge from-file project) :load-config-file? :legacy/merge-indents?)
      {:paths-root (str root)})))

(defn load-config
  "Load literal project.clj settings with Leiningen precedence, or discover
  cljfmt configuration upward when there is no project. Clojure files require
  :read-clj-config-files? for discovery; explicit files always load. No project
  code, reader evaluation or custom tagged-literal reader is executed."
  ([] (load-config (.cwd pathlib/Path) {}))
  ([path] (load-config path {}))
  ([path options]
   (let [p (.absolute (pathlib/Path path))
         file (cond
                (.is_file p) p
                (.is_dir p) (or (find-config p ["project.clj"])
                                (find-formatter-config p options))
                :else (config-error p "Configuration path does not exist"))
         value (cond
                 (nil? file) {}
                 (op/eq "project.clj" (.-name file)) (read-project-config file)
                 :else (read-file-config file))]
     (resolve-options value)
     value)))

(defn- semantic-forms [node]
  (mapv bare (node-forms (bare node))))

(defn- infer-libspec [ctx node prefix]
  (let [node (bare node)
        kind (:kind node)
        xs (semantic-forms node)]
    (cond
      (op/eq :reader-conditional kind)
      (reduce #(infer-libspec %1 %2 prefix) ctx (take-nth 2 (rest xs)))

      (op/eq :reader-splice kind)
      (reduce (fn [c branch]
                (reduce #(infer-libspec %1 %2 prefix) c (semantic-forms branch)))
              ctx (take-nth 2 (rest xs)))

      (and (#{:vector :list} kind) (op/eq :symbol (:kind (first xs))))
      (let [name (:text (first xs))
            target (if prefix (str prefix "." name) name)
            items (rest xs)]
        (if (op/eq :keyword (:kind (first items)))
          (reduce (fn [c [key value]]
                    (case (:text key)
                      ":as" (if (op/eq :symbol (:kind value))
                              (assoc-in c [:aliases (:text value)] target) c)
                      ":as-alias" (if (op/eq :symbol (:kind value))
                                    (assoc-in c [:aliases (:text value)] target) c)
                      ":refer" (reduce (fn [m ref]
                                         (if (op/eq :symbol (:kind ref))
                                           (assoc-in m [:refers (:text ref)] target) m))
                                       c (semantic-forms value))
                      c))
                  ctx (partition 2 items))
          (reduce #(infer-libspec %1 %2 target) ctx items)))

      :else ctx)))

(defn- namespace-context [root opts]
  (let [ns-form (first (filter #(and (op/eq :list (:kind %)) (op/eq "ns" (head %)))
                               (node-forms root)))
        ns-name (some-> ns-form semantic-forms second :text)
        clauses (filter #(and (op/eq :list (:kind %))
                              (#{":require" ":require-macros"}
                               (:text (first (semantic-forms %)))))
                        (semantic-forms ns-form))
        inferred
        (reduce (fn [ctx clause]
                  (reduce #(infer-libspec %1 %2 nil)
                          ctx (rest (semantic-forms clause))))
                {:ns ns-name :aliases {} :refers {} :rule-cache (atom {})} clauses)]
    (-> inferred
        (update :aliases merge (into {} (map (fn [[k v]] [(str k) (str v)]) (:alias-map opts))))
        (update :refers merge (into {} (map (fn [[k v]] [(str k) (str v)]) (:refer-map opts)))))))

(defn- symbol-parts [s ctx]
  (let [parts (.rsplit s "/" 1)]
    (if (op/eq 2 (count parts))
      [(get (:aliases ctx) (first parts) (first parts)) (second parts)]
      [(get (:refers ctx) s (:ns ctx)) s])))

(defn- matches? [pattern value]
  (and value (if (regex? pattern) (boolean (re/search pattern value))
                 (op/eq (str pattern) value))))

(defn- key-matches? [key s ctx]
  (when s
    (let [[namespace name] (symbol-parts s ctx)]
      (cond
        (vector? key) (and (matches? (first key) namespace) (matches? (second key) name))
        (regex? key) (matches? key name)
        :else ;; qualified/unqualified symbols handled below
        (let [parts (.rsplit (str key) "/" 1)]
          (if (op/eq 2 (count parts))
            (and (op/eq (first parts) namespace) (op/eq (second parts) name))
            (op/eq (str key) name)))))))

(defn- rule-priority [[k rules]]
  [(- (apply max 0 (map #(if (op/eq :inner (first %)) (second %) 0) rules)))
   (cond (regex? k) 2
         (or (vector? k) (str/includes? (str k) "/")) 0
         :else 1)
   (str k)])

(defn- matching-rules [node opts ctx]
  (when (#{:list :anonymous-function} (:kind node))
    (let [s (head node) cache (:rule-cache ctx)]
      (if (contains? @cache s)
        (get @cache s)
        (let [rules
              (vec
               (mapcat
                (fn [entry]
                  (map-indexed (fn [i rule] [(conj (rule-priority entry) i) rule])
                               (second entry)))
                (filter #(key-matches? (first %) s ctx) (:indents opts))))]
          (swap! cache assoc s rules)
          rules)))))

(defn- configured-form? [frame parent rules ctx]
  (or (some (fn [[k v]] (and (op/eq :all v) (key-matches? k (head (:node frame)) ctx))) rules)
      (and parent
           (some (fn [[k v]]
                   (and (key-matches? k (head (:node parent)) ctx)
                        (and (not (op/eq :all v)) (contains? v (dec (:parent-index frame))))))
                 rules))))

(defn- combine-gaps [children]
  (reduce (fn [xs n]
            (if (gap? n)
              (if (gap? (peek xs))
                (conj (pop xs) (update (peek xs) :text str (if (op/eq :newline (:kind n)) "\n" (:text n))))
                (conj xs (assoc n :kind :gap :text (if (op/eq :newline (:kind n)) "\n" (:text n)))))
              (conj xs n))) [] children))

(declare prepare)
(defn- normalize-children [node opts]
  (let [xs (combine-gaps (mapv #(prepare % opts) (:children node)))
        bounded? (or (#{:discard :quote :syntax-quote :unquote-splicing :deref :var-quote} (:kind node))
                     (and (op/eq :unquote (:kind node))
                          (not (op/eq :deref (:kind (first (node-forms node))))))
                     (and (contains? containers (:kind node)) (not (op/eq :root (:kind node)))))
        trim? (and bounded? (:remove-surrounding-whitespace? opts))
        xs (if (and trim? (gap? (get xs 1)) (not (op/eq :comment (:kind (get xs 2)))))
             (into [(first xs)] (drop 2 xs)) xs)
        n (count xs)
        xs (if (and trim? (gap? (get xs (- n 2))))
             (let [before (get xs (- n 3)) gap (get xs (- n 2))]
               (if (op/eq :comment (:kind before))
                 (assoc xs (- n 2) (leaf :gap (or (some-> (re/search "\r\n|\r|\n" (:text gap)) .group) "\n")))
                 (conj (vec (take (- n 2) xs)) (last xs)))) xs)]
    (loop [result [] remaining xs form-index 0]
      (if-let [n (first remaining)]
        (let [previous (peek result)
              split? (and (op/eq :map (:kind node)) (:split-keypairs-over-multiple-lines? opts)
                          (form? n) (pos? form-index) (even? form-index))
              result (cond
                       (and split? (not (and (gap? previous) (newline? (:text previous)))))
                       (if (gap? previous)
                         (conj (pop result) (leaf :gap (str (:text previous) "\n")))
                         (conj result (leaf :gap "\n")))
                       (and (:insert-missing-whitespace? opts)
                            previous (not (gap? previous))
                            (or (and (form? previous) (form? n))
                                (and (op/eq :discard (:kind previous)) (form? n))))
                       (conj result (leaf :gap " "))
                       :else result)]
          (recur (conj result n) (rest remaining) (+ form-index (if (form? n) 1 0))))
        result))))

(defn- comment? [node] (op/eq :comment (:kind node)))
(defn- gap-lines [node]
  (if (gap? node) (.count (:text node) "\n") 0))

(defn- reference-spans [children]
  (let [indexes (vec (keep-indexed
                      (fn [i node] (when (or (form? node) (op/eq :discard (:kind node))) i))
                      children))]
    (mapv
     (fn [i]
       (let [start
             (loop [start i]
               (let [space (get children (dec start))
                     comment-index (- start 2)
                     comment (get children comment-index)
                     before (get children (dec comment-index))]
                 (if (and (op/eq 1 (gap-lines space)) (comment? comment)
                          (pos? (gap-lines before)))
                   (recur comment-index)
                   start)))
             next (get children (inc i))
             after (get children (+ i 2))
             end (cond
                   (comment? next) (+ i 2)
                   (and (gap? next) (zero? (gap-lines next)) (comment? after)) (+ i 3)
                   :else (inc i))]
         {:start start :end end :node (get children i)
          :nodes (subvec children start end)}))
     (rest indexes))))

(defn- protect-comment-lines [children]
  (loop [remaining children result []]
    (if-let [node (first remaining)]
      (let [next (second remaining)
            result (conj result node)]
        (cond
          (and (comment? node) next (gap? next) (zero? (gap-lines next)))
          (recur (rest (rest remaining)) (conj result (leaf :gap (str "\n" (:text next)))))

          (and (comment? node) next (not (gap? next)))
          (recur (rest remaining) (conj result (leaf :gap "\n")))

          :else (recur (rest remaining) result)))
      result)))

(defn- sort-reference-clause [clause]
  (let [children (:children clause)
        spans (reference-spans children)
        ordered (sort-by #(str/lower-case
                           (re/sub "[\\[\\](){}]" "" (syntax/text (bare (:node %)))))
                         spans)]
    (loop [slots spans items ordered offset 0 result []]
      (if-let [slot (first slots)]
        (recur (rest slots) (rest items) (:end slot)
               (into (into result (subvec children offset (:start slot)))
                     (:nodes (first items))))
        (assoc clause :children
               (protect-comment-lines (into result (subvec children offset))))))))

(defn- sort-references [node]
  (if-not (and (op/eq :list (:kind node)) (op/eq "ns" (head node))) node
          (update node :children
                  (fn [children]
                    (mapv (fn [clause]
                            (if (and (op/eq :list (:kind clause))
                                     (#{":require" ":require-macros" ":import" ":use"}
                                      (some-> clause node-forms first syntax/text)))
                              (sort-reference-clause clause)
                              clause))
                          children)))))

(defn- prepare [node opts]
  (cond
    (contains? literals (:kind node)) node
    (:children node)
    (cond-> (assoc node :children (normalize-children node opts))
      (and (:sort-ns-references? opts) (op/eq :root (:kind node)))
      (update :children #(mapv sort-references %)))
    :else node))

(defn- ordinary-indent [frame opts]
  (let [node (:node frame) i (:index frame) pos (:positions frame)
        body (:body frame)
        list? (#{:list :anonymous-function} (:kind node))
        style (:function-arguments-indentation opts)
        first-node (when (not (op/eq style :community))
                     (first (remove #(or (gap? %) (syntax/trivia? %)
                                         (contains? punctuation (:kind %))) (:children node))))
        first-kind (:kind (if (op/eq style :cursive) (bare first-node) first-node))
        extra? (and (not (op/eq style :community))
                    (if (op/eq style :cursive)
                      (not (#{:list :vector :map :set} first-kind))
                      (#{:symbol :keyword :list :number :nil :boolean :symbolic-number :character} first-kind)))]
    (cond
      (op/eq :root (:kind node)) 0
      (not list?) body
      (<= i 1) (+ body (if extra? 1 0))
      :else (or (:col (get pos 1)) body))))

(defn- indentation [frames opts _ctx]
  (let [frame (peek frames)
        ancestors (vec (reverse frames))
        candidates
        (sort-by first
                 (mapcat (fn [[depth ancestor]]
                           (map (fn [[priority rule]] [priority depth rule])
                                (:rules ancestor)))
                         (map-indexed vector ancestors)))]
    (or
     (some
      (fn [[_ depth [kind n arg]]]
        (case kind
          :inner (when (and (pos? (:index frame)) (op/eq n depth)
                            (or (nil? arg)
                                (and (pos? depth)
                                     (op/eq arg (dec (:parent-index (get ancestors (dec depth))))))))
                   (inc (:body frame)))
          :block (when (zero? depth)
                   (if (<= (:index frame) n)
                     (ordinary-indent frame opts)
                     (let [p (get (:positions frame) (inc n))
                           before (get (:positions frame) n)]
                       (if (or (nil? p) (not (op/eq (:line p) (:line before))))
                         (inc (:body frame))
                         (ordinary-indent frame opts)))))
          :default (when (zero? depth) (ordinary-indent frame opts))
          nil))
      candidates)
     (ordinary-indent frame opts))))

(defn- write! [state s]
  ;; Private, invocation-local buffers avoid allocating a persistent map and
  ;; vector for every token; the public formatter remains a pure function.
  (let [lines (re/split "\r\n|\r|\n" s)
        n (python/len lines)]
    (.append (op/getitem state "parts") s)
    (op/setitem state "line" (op/add (op/getitem state "line") (dec n)))
    (op/setitem state "col"
                (if (op/gt n 1)
                  (column-width (op/getitem lines -1))
                  (op/add (op/getitem state "col") (column-width s))))))

(defn- format-gap [text previous next frames opts ctx]
  (let [frame (peek frames)
        root? (op/eq :root (:kind (:node frame)))
        comment? (op/eq :comment (:kind next))
        indent-comment? (and (:indent-line-comments? opts)
                             (re/fullmatch ";;(?:[^;].*)?" (or (:text next) "")))
        text (if (and (:remove-consecutive-blank-lines? opts) (or next (not root?)))
               (re/sub "((?:\r\n|\r|\n))[ \t,]*(?:(?:\r\n|\r|\n)[ \t,]*){2,}" "\\1\\1" text) text)
        text (if (and (:remove-blank-lines-in-forms? opts)
                      (not (#{:root :map} (:kind (:node frame))))
                      (not (configured-form? frame (peek (pop frames)) (:blank-line-forms opts) ctx)))
               (re/sub "((?:\r\n|\r|\n))[ \t,]*(?:(?:\r\n|\r|\n)[ \t,]*)+" "\\1" text) text)
        text (if (and (:indentation? opts) (not (:remove-trailing-whitespace? opts))
                      (newline? text))
               (re/sub "(?<=\n)[ \t]*(?=\n)"
                       (spaces (or (::wrapper-indent opts) (indentation frames opts ctx))) text) text)
        text (if (:remove-trailing-whitespace? opts)
               (re/sub "[ \t]+(?=\r\n|\r|\n)" "" text) text)
        text (if (and (:remove-trailing-whitespace? opts) root? (nil? next))
               (re/sub "[ \t]+$" "" text) text)]
    (cond
      (and (:indentation? opts) (newline? text) next
           (or (not comment?) indent-comment?))
      (re/sub "[ \t]*\\Z" (spaces (or (::wrapper-indent opts) (indentation frames opts ctx))) text ** :count 1)

      (and (:remove-multiple-non-indenting-spaces? opts)
           previous next (not comment?) (not (newline? text))
           (re/fullmatch "[ \t,]+" text)) (re/sub "[ \t]+" " " text)

      :else text)))

(declare render!)
(defn- render-children! [state node frames opts ctx]
  (let [collection? (contains? containers (:kind node))
        wrapper-indent (when (#{:quote :syntax-quote :unquote :unquote-splicing
                                :deref :var-quote :tagged :namespaced-map :discard} (:kind node))
                         (inc (op/getitem state "col")))
        body (+ (op/getitem state "col")
                (if (op/eq :root (:kind node)) 0 (count (:text (first (:children node))))))
        frame {:node node :body body :positions [] :index 0
               :rules (when collection? (matching-rules node opts ctx))
               :parent-index (:index (peek frames))}
        frames (if collection? (conj frames frame) frames)]
    (loop [xs (:children node) frames frames previous nil]
      (when-let [n (first xs)]
        (let [next (second xs)
              frame (peek frames)
              current-form? (and collection? (form? n))
              frames (if current-form?
                       (conj (pop frames)
                             (update frame :positions conj {:col (op/getitem state "col") :line (op/getitem state "line")}))
                       frames)]
          (if (gap? n)
            (write! state (format-gap (:text n) previous next frames
                                      (cond-> opts wrapper-indent (assoc ::wrapper-indent wrapper-indent)) ctx))
            (render! state n frames opts ctx))
          (recur (rest xs)
                 (if current-form?
                   (conj (pop frames) (update (peek frames) :index inc)) frames)
                 n))))))

(defn- render! [state node frames opts ctx]
  (cond
    (contains? literals (:kind node)) (write! state (syntax/text node))
    (:children node) (render-children! state node frames opts ctx)
    :else (write! state (:text node))))

(defn- render [root opts ctx]
  (let [state #py {"parts" #py [] "line" 0 "col" 0}]
    (render! state root [] opts ctx)
    (.join "" (op/getitem state "parts"))))

(declare align-columns)

(defn- source-shape [node]
  (when-not (gap? node)
    (python/tuple
     #py [(:kind node)
          (cond
            (contains? literals (:kind node)) (syntax/text node)
            (:children node) (python/tuple (python/filter nil
                                                          (python/map source-shape (:children node))))
            (comment? node) (.rstrip (:text node) " \t")
            :else (:text node))])))

(defn- preparation-shape
  ;; Only direct children of an ns reference clause may change order. Every
  ;; reference retains its complete structure, including reader attachments.
  ([node] (preparation-shape node nil))
  ([node parent]
   (when-not (gap? node)
     (if (and (:children node) (not (contains? literals (:kind node))))
       (let [sortable? (and (op/eq :ns parent) (op/eq :list (:kind node))
                            (#{":require" ":require-macros" ":import" ":use"}
                             (some-> node node-forms first syntax/text)))
             top-ns? (and (op/eq :root parent) (op/eq :list (:kind node))
                          (op/eq "ns" (head node)))
             context (if top-ns? :ns (:kind node))
             children (keep #(preparation-shape % context) (:children node))]
         [(:kind node) (if sortable? (frequencies children) (vec children))])
       (source-shape node)))))

(defn- validate-output [original prepared output options]
  (let [parsed (syntax/parse output)
        actual (source-shape (:root parsed))]
    (when (or (seq (:diagnostics parsed))
              (if (:sort-ns-references? options)
                (or (not (op/eq (source-shape prepared) actual))
                    (not (op/eq (preparation-shape original) (preparation-shape prepared))))
                (not (op/eq (source-shape original) actual))))
      (invalid "Refusing formatter output that changes source structure or text"
               {:code :unsafe-formatting}))
    output))

(defn- format-aligned [source opts ctx]
  ;; Some upstream alignment cases need multiple passes when moving a
  ;; multiline value shifts another value on its closing line. Return only
  ;; a stable layout, and fail closed on a cycle or excessive convergence.
  (loop [candidate (align-columns source opts ctx) seen #{source} passes 0]
    (let [parsed (syntax/parse candidate)
          _ (when (seq (:diagnostics parsed))
              (invalid "Invalid syntax produced during alignment" {:code :unsafe-formatting}))
          rendered (render (prepare (:root parsed) opts) opts ctx)
          result (align-columns rendered opts ctx)]
      (cond
        (op/eq result candidate) result
        (or (contains? seen result) (op/ge passes 15))
        (invalid "Column alignment did not converge" {:code :unstable-formatting})
        :else (recur result (conj seen candidate) (inc passes))))))

(defn format-string
  "Format Basilisp source without evaluation. Validate source preservation
  before returning output. Invalid syntax/options or unsafe output raises
  ExceptionInfo."
  ([source] (format-string source {}))
  ([source options]
   (let [opts (resolve-options options)
         parsed (syntax/parse source)
         _ (when (seq (:diagnostics parsed))
             (invalid "Cannot format invalid syntax" {:diagnostics (:diagnostics parsed)}))
         original (:root parsed)
         ctx (namespace-context original opts)
         prepared (prepare original opts)
         result (render prepared opts ctx)
         result (if (or (:align-map-columns? opts) (:align-form-columns? opts)
                        (:align-binding-columns? opts))
                  (format-aligned result opts ctx) result)
         result (if (:normalize-newlines-at-file-end? opts)
                  (let [trimmed (re/sub "[ \t\r\n]+$" "" result)]
                    (if (empty? trimmed) "" (str trimmed "\n")))
                  result)]
     (validate-output original prepared result opts))))

(def reformat-string format-string)

(defn- apply-edits [source edits]
  (reduce (fn [s [start end replacement]]
            (str (subs s 0 start) replacement (subs s end)))
          source (reverse (sort-by first edits))))

(defn- position [parsed offset]
  (let [p (syntax/offset->position parsed offset)
        start (nth (:line-starts parsed) (:line p))]
    (assoc p :character (column-width (subs (:source parsed) start offset)))))

(defn- alignment-targets [root opts ctx]
  (letfn [(walk [node parent index]
            (let [frame {:node node :parent-index index}
                  selected? (or (and (:align-map-columns? opts) (op/eq :map (:kind node)))
                                (and (or (:align-form-columns? opts) (:align-binding-columns? opts))
                                     (configured-form? frame {:node parent} (:aligned-forms opts) ctx)))]
              (concat (when selected? [node])
                      (mapcat (fn [[i n]] (walk n node i))
                              (map-indexed vector (filter form? (:children node)))))))]
    (walk root nil 0)))

(defn- column-rows [node parsed opts]
  (let [forms (filter form? (:children node))]
    (loop [xs forms rows [] row [] previous-line nil previous-end nil group 0]
      (if-let [n (first xs)]
        (let [line (:line (position parsed (:start n)))
              split? (and previous-line (not (op/eq line previous-line)))
              group (if (and split? (:blank-lines-separate-alignment? opts)
                             (re/search "\n[ \t,]*\n"
                                        (subs (:source parsed) previous-end (:start n))))
                      (inc group) group)]
          (recur (rest xs)
                 (if (and split? (seq row)) (conj rows row) rows)
                 (conj (if split? [] row) {:node n :group group})
                 (:line (position parsed (:end n))) (:end n) group))
        (cond-> rows (seq row) (conj row))))))

(defn- column-edits [source parsed node column opts]
  (let [rows (column-rows node parsed opts)
        starts
        (reduce (fn [m row]
                  (if-let [prior (get row (dec column))]
                    (if (or (get row column) (:align-single-column-lines? opts))
                      (update m (:group prior) (fnil conj [])
                              (:character (position parsed (:end (:node prior))))) m) m))
                {} rows)]
    (mapcat
     (fn [row]
       (when-let [entry (get row column)]
         (let [n (:node entry)
               previous (:node (get row (dec column)))
               from (:end previous) to (:start n)
               gap (subs source from to)
               widths (get starts (:group entry))
               widths (if-let [limit (:max-column-alignment-width opts)]
                        (filter #(<= % limit) widths) widths)
               target (inc (apply max 0 widths))
               new-gap (- target (:character (position parsed from)))
               new-gap (if (or (< new-gap 1)
                               (and (:max-column-alignment-gap opts)
                                    (> new-gap (:max-column-alignment-gap opts))))
                         1 new-gap)
               delta (- new-gap (count gap))]
           (when (and (not (zero? delta)) (re/fullmatch "[ \t]+" gap))
             (cons [from to (spaces new-gap)]
                    ;; Keep multiline children in the same position relative to
                    ;; their first line, without touching literal contents.
                   (keep (fn [[a b]]
                           (when (and (op/eq :newline (:kind a)) (op/eq :whitespace (:kind b))
                                      (re/fullmatch "[ \t]+" (:text b)))
                             [(:start b) (:end b) (spaces (+ (count (:text b)) delta))]))
                         (partition 2 1 (syntax/tokens n))))))))
     rows)))

(defn- align-columns [source opts ctx]
  ;; Resolve one column at a time so padding in earlier columns is included
  ;; in later column widths. Each collection is processed outside-in.
  (loop [source source target-index 0]
    (let [parsed (syntax/parse source)
          targets (vec (alignment-targets (:root parsed) opts ctx))]
      (if-let [target (get targets target-index)]
        (let [columns (apply max 0 (map count (column-rows target parsed opts)))
              source
              (reduce (fn [s column]
                        (let [p (syntax/parse s)
                              n (nth (alignment-targets (:root p) opts ctx) target-index)]
                          (apply-edits s (column-edits s p n column opts))))
                      source (range 1 columns))]
          (recur source (inc target-index)))
        source))))
