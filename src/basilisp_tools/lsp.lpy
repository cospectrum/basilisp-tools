(ns basilisp-tools.lsp
  "The blt stdio language server. Analysis snapshots are immutable; pygls owns
  JSON-RPC transport, lifecycle, cancellation and negotiated position encoding."
  (:require [basilisp.string :as str]
            [basilisp.edn :as edn]
            [basilisp-tools.analyzer :as analyzer]
            [basilisp-tools.check :as check]
            [basilisp-tools.cache :as cache]
            [basilisp-tools.hooks :as hooks]
            [basilisp-tools.format :as fmt]
            [basilisp-tools.python :as py]
            [basilisp-tools.regex :as regex]
            [basilisp-tools.syntax :as syntax])
  (:import [concurrent.futures :as futures] [contextvars] [queue] [threading]
           [hashlib] [json] [tempfile]
           [urllib.parse :as url] [zipfile] [asyncio] [functools] [logging] [os] [os.path :as pathutil] [pathlib] [re] [sys]
           [importlib] [importlib.metadata :as metadata]
           [lsprotocol.types :as lsp]
           [lsprotocol.converters :as converters]
           [pygls.exceptions :as errors]
           [pygls.lsp.server :as server]
           [pygls.protocol :as protocol]
           [pygls.uris :as uris]
           [pygls.workspace :as workspace]))

(defn- worker-loop [jobs]
  (loop []
    (when-let [[future context function arguments] (.get jobs)]
      (when (.set_running_or_notify_cancel future)
        (try
          (.set_result future (.run context #(apply function arguments)))
          (catch python/BaseException error (.set_exception future error))))
      (recur))))

(defn- create-workers []
  ;; A fixed number of daemon workers bounds live computations, including jobs
  ;; whose awaiting coroutine was cancelled. Disposable analysis must not keep
  ;; the stdio server alive after the client has requested shutdown and exit.
  (let [jobs (queue/Queue)
        threads (mapv (fn [number]
                        (doto (threading/Thread ** :target #(worker-loop jobs)
                                                :name (str "blt-analysis-" number) :daemon true)
                          (.start))) (range 4))]
    {:jobs jobs :threads threads :closed (threading/Event)}))

(defn- stop-workers! [workers]
  (when (and workers (not (.is_set (:closed workers))))
    (.set (:closed workers))
    (loop []
      (when-let [job (try (.get_nowait (:jobs workers)) (catch queue/Empty _ nil))]
        (.cancel (first job))
        (recur)))
    (doseq [_ (:threads workers)] (.put (:jobs workers) nil))))

(defasync ^:private worker! [state function & arguments]
  (let [workers (or (:workers @state)
                    (let [workers (create-workers)] (swap! state assoc :workers workers) workers))
        future (futures/Future)]
    (when (.is_set (:closed workers)) (throw (asyncio/CancelledError)))
    (.put (:jobs workers) [future (contextvars/copy_context) function arguments])
    ;; wrap_future handles delivery to a cancelled future or closed event loop.
    (await (asyncio/wrap_future future))))

(def ^:private excluded-directories
  #{".git" ".hg" ".svn" ".lsp" ".clj-kondo" ".venv" "venv" ".direnv" ".tox" "node_modules"
    "__pycache__" ".pytest_cache" ".mypy_cache" "build" "dist"})

(def ^:private source-suffixes #{".lpy" ".cljc"})

(defn- failure [message]
  (throw (errors/JsonRpcInvalidParams message)))

(defn- file-path [uri]
  (when (.startswith uri "file://")
    (some-> (uris/to_fs_path uri) pathlib/Path)))

(defn deep-merge-settings
  "Merge LSP settings recursively, concatenating collections as clojure-lsp does."
  [a b]
  (reduce (fn [result [key value]]
            (assoc result key
                   (if (contains? result key)
                     (let [previous (get result key)]
                       (cond
                         (and (map? previous) (map? value)) (deep-merge-settings previous value)
                         (and (set? previous) (set? value)) (into previous value)
                         (and (coll? previous) (coll? value)) (vec (concat previous value))
                         :else value))
                     value)))
          (or a {}) b))

(defn merge-settings
  "Apply clojure-lsp's special merge rules to cumulative settings."
  [a b]
  (let [merged (deep-merge-settings a b)]
    (cond
      (get-in merged [:cljfmt :indents])
      (assoc-in merged [:cljfmt :indents] (merge (get-in a [:cljfmt :indents])
                                                 (get-in b [:cljfmt :indents])))
      (seq (:paths-ignore-regex merged))
      (update merged :paths-ignore-regex #(vec (distinct %)))
      (coll? (:project-specs merged))
      (update merged :project-specs
              (fn [specs]
                (:items (reduce (fn [{:keys [seen items] :as result} spec]
                                  (if (contains? seen (:project-path spec)) result
                                      {:seen (conj seen (:project-path spec)) :items (conj items spec)}))
                                {:seen #{} :items []} specs))))
      :else merged)))

(defn- overlay-settings [a b]
  (if (and (map? a) (map? b)) (merge-with overlay-settings a b) b))

(defn- setting-keyword [value]
  (cond (keyword? value) value
        (string? value) (keyword (if (.startswith value ":") (subs value 1) value))))

(defn- setting-text [value]
  (if (keyword? value) (subs (str value) 1) (str value)))

(defn clean-client-settings
  "Convert JSON initialization options using clojure-lsp's client conventions."
  [settings]
  (let [settings (or settings {})
        paths (when (seq (:source-paths settings))
                (not-empty (set (keep #(when (string? %)
                                         (if (.startswith % ":") (subs % 1) %))
                                      (:source-paths settings)))))
        clean-value (fn clean-value [value]
                      (cond (string? value) (keyword value)
                            (regex/pattern? value) value
                            (map? value) (into {} (map (fn [[k v]] [(clean-value k) (clean-value v)]) value))
                            (vector? value) (mapv clean-value value)
                            (set? value) (set (map clean-value value))
                            (seq? value) (apply list (map clean-value value))
                            :else value))
        settings (-> settings
                     (update :dependency-scheme #(or % "zipfile"))
                     (update :text-document-sync-kind setting-keyword)
                     (assoc :source-paths paths)
                     (update :source-aliases #(when (seq %) (not-empty (set (keep setting-keyword %)))))
                     (update :cljfmt-config-path #(or % ".cljfmt.edn"))
                     (update :document-formatting? #(if (nil? %) true %))
                     (update :document-range-formatting? #(if (nil? %) true %)))]
    (cond-> settings
      (contains? (:cljfmt settings) :indents)
      (update-in [:cljfmt :indents]
                 #(into {} (map (fn [[k v]]
                                  [(let [text (if (keyword? k) (subs (str k) 1) (str k))]
                                     (if (.startswith text "#") (regex/compile (subs text 1))
                                         (symbol text))) (clean-value v)]) %)))
      (contains? settings :linters)
      (update :linters #(into {} (map (fn [[key value]] [key (clean-value value)]) %))))))

(defn read-settings
  "Read literal LSP EDN, with #re tags and top-level JSON-style string keys."
  ([source] (read-settings source "LSP settings"))
  ([source label]
   (let [parsed (syntax/parse source)
         node (first (syntax/forms (:root parsed)))
         prefix (syntax/parse (if node (subs source 0 (:end node)) source))]
     (when (seq (:diagnostics prefix))
       (throw (python/ValueError (str label ": " (:message (first (:diagnostics prefix)))))))
     (if (or (nil? node) (= :nil (:kind node))) {}
         (into {} (map (fn [[k v]] [(if (string? k) (keyword k) k) v])
                       (check/read-config (syntax/text node) label {:readers #{'re}})))))))

(defn- read-settings-file [path]
  (when (.is_file path)
    (try
      (read-settings (.read_text path ** :encoding "utf-8") (str path))
      (catch python/Exception e
        (logging/warning "Could not read LSP configuration %s: %s" (str path) (str e))
        {}))))

(declare workspace-options)

(defn- exported-settings [paths selected]
  (loop [pending (vec selected) seen #{} settings {}]
    (if-let [selector (first pending)]
      (let [selector (str selector)]
        (if (or (contains? seen selector)
                (not (re/fullmatch "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+" selector))
                (some #{"." ".."} (str/split selector #"/")))
          (recur (subvec pending 1) seen settings)
          (let [relative (str "clojure-lsp.exports/" selector "/config.edn")
                configs (keep (fn [entry]
                                (try
                                  (let [path (pathlib/Path entry)]
                                    (cond
                                      (.is_dir path) (read-settings-file (.joinpath path relative))
                                      (and (.is_file path) (zipfile/is_zipfile path))
                                      (with-open [archive (zipfile/ZipFile path)]
                                        (when (some #{relative} (.namelist archive))
                                          (read-settings (.decode (.read archive relative) "utf-8") (str path ":" relative))))))
                                  (catch python/Exception error
                                    (logging/warning "Could not read exported LSP configuration: %s" (str error))
                                    nil))) paths)
                settings (reduce merge-settings settings configs)
                next-paths (mapcat :classpath-config-paths configs)]
            (recur (into (subvec pending 1) next-paths) (conj seen selector) settings))))
      settings)))

(defn load-settings
  "Resolve initialization options < global/ancestor/project .lsp files < forced settings.
  Optional :home and :xdg-config-home make global discovery reproducible for callers."
  [{:keys [root client-settings force-settings home xdg-config-home python-options classpath-paths]}]
  (let [home (pathlib/Path (or home (.home pathlib/Path)))
        xdg (pathlib/Path (or xdg-config-home (.get os/environ "XDG_CONFIG_HOME")
                              (.joinpath home ".config")))
        xdg-directory (.joinpath xdg "clojure-lsp")
        global-file (.joinpath (if (.exists xdg-directory) xdg-directory
                                   (.joinpath home ".lsp")) "config.edn")
        root (when root (.absolute (pathlib/Path root)))
        directories (when root (reverse (cons root (vec (.-parents root)))))
        files (keep (fn [directory]
                      (let [file (.joinpath directory ".lsp" "config.edn")]
                        (when (not= (.absolute file) (.absolute global-file)) file)))
                    directories)
        file-settings (reduce deep-merge-settings (or (read-settings-file global-file) {})
                              (keep read-settings-file files))
        initial (overlay-settings (clean-client-settings client-settings) file-settings)
        discovery-settings (overlay-settings initial (or force-settings {}))
        selected (:classpath-config-paths discovery-settings)
        exported (when (seq selected)
                   (exported-settings
                    (or classpath-paths (py/environment-paths
                                         (workspace-options (or root (.cwd pathlib/Path)) discovery-settings (or python-options {})))) selected))]
    (overlay-settings (overlay-settings (deep-merge-settings (clean-client-settings client-settings) exported) file-settings)
                      (or force-settings {}))))

(defn- root-for [state uri]
  (when-let [path (file-path uri)]
    (first (sort-by #(- (count %))
                    (filter #(.is_relative_to (.resolve path) (.resolve (pathlib/Path %))) (:roots @state))))))

(defn- settings-for [state uri]
  (get-in @state [:settings-by-root (root-for state uri)] (:settings @state)))

(declare source-paths)

(defn- options-for [state uri]
  (let [root (root-for state uri)
        options (:options @state)
        settings (settings-for state uri)
        configured (:python settings)
        executable (or (:python-executable options)
                       (when-let [executable (:executable configured)]
                         (if (or (str/includes? executable "/") (str/includes? executable "\\"))
                           (str (.joinpath (pathlib/Path (or root (.cwd pathlib/Path))) executable))
                           executable))
                       (when root
                         (some (fn [name]
                                 (let [path (.joinpath (pathlib/Path root) name)]
                                   (when (.is_file path) (str path))))
                               [".venv/bin/python" ".venv/Scripts/python.exe"]))
                       sys/executable)]
    (cond-> (assoc options :workspace-root root :analysis-epoch (:analysis-epoch @state 0)
                   :persistent-cache-context (or (:persistent-cache-context @state) (:persistent-cache-context options))
                   :python-executable executable
                   :python-paths (vec (distinct (concat
                                                 (when root (cons root (source-paths root settings)))
                                                 (map #(str (.joinpath (pathlib/Path (or root (.cwd pathlib/Path))) %))
                                                      (:paths configured))
                                                 (:python-paths options)))))
      (and (not= false (:python-inspection? options)) (contains? configured :inspection?))
      (assoc :python-inspection? (:inspection? configured)))))

(defn workspace-options
  "Resolve a workspace's interpreter and search paths using the server's rules."
  [root settings options]
  (let [root (str (.absolute (pathlib/Path root)))
        uri (.as_uri (.joinpath (pathlib/Path root) "__blt__.lpy"))]
    (options-for (atom {:roots [root] :options options :settings settings
                        :settings-by-root {root settings}}) uri)))

(defn- ignored-path? [settings path]
  (some #(regex/fullmatch % (str path)) (:paths-ignore-regex settings)))

(defn- source-paths [root settings]
  (let [root (pathlib/Path root)
        paths (or (:source-paths settings) #{"src" "test"})
        ignored (:source-paths-ignore-regex settings ["target.*"])]
    (vec (keep (fn [path]
                 (let [path (pathlib/Path (pathutil/abspath (str (.joinpath root path))))
                       relative (pathutil/relpath (str path) (str root))]
                   (when-not (some #(regex/fullmatch % relative) ignored) (str path))))
               paths))))

(defn- logging-property [config key default]
  (cond (contains? config key) (get config key)
        (contains? config (keyword key)) (get config (keyword key))
        :else (os/getenv (-> key str/upper-case (str/replace "." "_") (str/replace "-" "_")) default)))

(defn- logging-boolean [value]
  (or (true? value) (= "true" (str/lower-case (str value)))))

(defn- logging-duration [value]
  (let [matched (re/fullmatch #"([0-9]+(?:\.[0-9]+)?)\s*(ns|us|ms|s|m|h|d)?" (str value))]
    (when-not matched (failure "Telemetry durations must be nonnegative numbers in milliseconds or use ns/us/ms/s/m/h/d."))
    (* (python/float (.group matched 1))
       (get {"ns" 0.000001 "us" 0.001 "ms" 1 "s" 1000 "m" 60000 "h" 3600000 "d" 86400000}
            (.group matched 2) 1))))

(defn- logging-pairs [value]
  (cond
    (nil? value) {}
    (map? value) (into {} (map (fn [[key value]] [(str key) (str value)]) value))
    :else
    (into {} (for [part (str/split (str value) #",") :when (not (str/blank? part))
                   :let [pair (.partition part "=")]]
               (do
                 (when (or (str/blank? (first pair)) (empty? (second pair)))
                   (failure "Telemetry headers and resource attributes must use key=value pairs."))
                 [(url/unquote (str/trim (first pair))) (url/unquote (str/trim (last pair)))])))))

(defn- logging-signal-property [config suffix default]
  (logging-property config (str "otel.exporter.otlp.logs." suffix)
                    (logging-property config (str "otel.exporter.otlp." suffix) default)))

(defn- logging-exporter [config]
  (let [protocol (str/lower-case (str (logging-signal-property config "protocol" "grpc")))
        grpc? (= "grpc" protocol)
        specific (logging-property config "otel.exporter.otlp.logs.endpoint" nil)
        base (logging-property config "otel.exporter.otlp.endpoint" (if grpc? "http://localhost:4317" "http://localhost:4318"))
        endpoint (or specific (if grpc? base (str (.rstrip base "/") "/v1/logs")))
        _ (when-not (contains? #{"grpc" "http/protobuf" "http/json"} protocol)
            (failure "Unsupported OTLP logs protocol; use grpc, http/protobuf, or http/json."))
        exporter (importlib/import_module
                  (case protocol
                    "grpc" "opentelemetry.exporter.otlp.proto.grpc._log_exporter"
                    "http/json" "opentelemetry.exporter.otlp.json.http._log_exporter"
                    "opentelemetry.exporter.otlp.proto.http._log_exporter"))
        certificate (logging-signal-property config "certificate" nil)
        client-key (logging-signal-property config "client.key" nil)
        client-certificate (logging-signal-property config "client.certificate" nil)
        compression (str/lower-case (str (logging-signal-property config "compression" "none")))
        timeout (/ (logging-duration (logging-signal-property config "timeout" 10000)) 1000.0)
        headers (python/dict (logging-pairs (logging-signal-property config "headers" nil)))]
    (if grpc?
      (let [grpc (importlib/import_module "grpc")
            read-pem (fn [file] (when file (.read_bytes (pathlib/Path file))))
            credentials (when (or certificate client-key client-certificate)
                          (.ssl_channel_credentials grpc (read-pem certificate) (read-pem client-key) (read-pem client-certificate)))
            compression (case compression "none" (.-NoCompression (.-Compression grpc))
                              "gzip" (.-Gzip (.-Compression grpc))
                              "deflate" (.-Deflate (.-Compression grpc))
                              (failure "Unsupported OTLP compression."))]
        (.OTLPLogExporter exporter ** :endpoint endpoint :headers headers :timeout timeout
                          :credentials credentials :compression compression
                          :insecure (case (.-scheme (url/urlparse endpoint))
                                      "http" true "https" false
                                      (logging-boolean (logging-signal-property config "insecure" false)))))
      (let [http (importlib/import_module "opentelemetry.exporter.otlp.proto.http")
            compression (case compression "none" (.-NoCompression (.-Compression http))
                              "gzip" (.-Gzip (.-Compression http))
                              "deflate" (.-Deflate (.-Compression http))
                              (failure "Unsupported OTLP compression."))]
        (.OTLPLogExporter exporter ** :endpoint endpoint :headers headers :timeout timeout
                          :certificate_file certificate :client_key_file client-key
                          :client_certificate_file client-certificate :compression compression)))))

(defn- logging-provider [config]
  (let [sdk (importlib/import_module "opentelemetry.sdk._logs")
        resources (importlib/import_module "opentelemetry.sdk.resources")
        processors (importlib/import_module "opentelemetry.sdk._logs.export")
        attributes (logging-pairs (logging-property config "otel.resource.attributes" nil))
        attributes (assoc attributes "service.name" (logging-property config "otel.service.name" (get attributes "service.name" "basilisp-tools")))
        provider (.LoggerProvider sdk ** :resource (.create (.-Resource resources) (python/dict attributes))
                                  :shutdown_on_exit false
                                  :log_record_limits (.LogRecordLimits sdk **
                                                                       :max_log_record_attributes
                                                                       (python/int (logging-property config "otel.logrecord.attribute.count.limit"
                                                                                                     (logging-property config "otel.attribute.count.limit" 128)))
                                                                       :max_log_record_attribute_length
                                                                       (some-> (logging-property config "otel.logrecord.attribute.value.length.limit"
                                                                                                 (logging-property config "otel.attribute.value.length.limit" nil))
                                                                               python/int)))
        exporters (str/split (str (logging-property config "otel.logs.exporter" "otlp")) #",")]
    (try
      (doseq [name exporters :let [name (str/trim name)] :when (not= "none" name)]
        (let [exporter (case name
                         "otlp" (logging-exporter config)
                         ("console" "logging") (.ConsoleLogRecordExporter processors ** :out sys/stderr)
                         (failure "Unsupported telemetry log exporter; use otlp, console, or none."))]
          (.add_log_record_processor provider
                                     (.BatchLogRecordProcessor processors exporter **
                                                               :schedule_delay_millis (logging-duration (logging-property config "otel.blrp.schedule.delay" 1000))
                                                               :export_timeout_millis (logging-duration (logging-property config "otel.blrp.export.timeout" 30000))
                                                               :max_queue_size (python/int (logging-property config "otel.blrp.max.queue.size" 2048))
                                                               :max_export_batch_size (python/int (logging-property config "otel.blrp.max.export.batch.size" 512))))))
      provider
      (catch python/Exception error
        (.shutdown provider)
        (throw error)))))

(defn- stop-workspace-logging! [current]
  (let [logger (logging/getLogger)]
    (doseq [handler (:handlers current)]
      (.removeHandler logger handler)
      (.close handler))
    (when-let [provider (:provider current)] (.shutdown provider))
    (when (some? (:previous-level current)) (.setLevel logger (:previous-level current)))))

(defn- start-workspace-logging! [root settings options]
  (let [path (when-not (:log-configured? options) (or (:log-path options) (:log-path settings)))
        otlp (:otlp settings)
        enabled? (and (map? otlp) (logging-boolean (:enable otlp)))
        logger (logging/getLogger)
        handlers (atom [])
        provider (atom nil)
        previous (.-level logger)]
    (try
      (when path
        (let [file (.absolute (.joinpath (pathlib/Path (or root (.cwd pathlib/Path))) path))]
          (.mkdir (.-parent file) ** :parents true :exist_ok true)
          (let [handler (logging/FileHandler (str file) ** :encoding "utf-8")]
            (.setFormatter handler (logging/Formatter "%(asctime)s %(levelname)s %(name)s: %(message)s"))
            (.addHandler logger handler)
            (swap! handlers conj handler))))
      (when (and enabled? (not (logging-boolean (logging-property (:config otlp {}) "otel.sdk.disabled" false))))
        (reset! provider (logging-provider (:config otlp {})))
        (let [bridge (importlib/import_module "opentelemetry.instrumentation.logging.handler")
              context (importlib/import_module "opentelemetry.context")
              handler (.LoggingHandler bridge ** :logger_provider @provider :level logging/NOTSET)]
          ;; Exporter failures must not recursively export their own log records.
          (.addFilter handler
                      (fn [record]
                        (and (not (.get_value context (.-_SUPPRESS_INSTRUMENTATION_KEY context)))
                             (not (.startswith (.-name record) "opentelemetry.")))))
          (.addHandler logger handler)
          (swap! handlers conj handler)))
      (when (seq @handlers)
        (.setLevel logger (or (:log-level options)
                              (python/getattr logging (str/upper-case (str (logging-property (:config otlp {}) "otel.log.level" "info")))
                                              logging/INFO))))
      {:handlers @handlers :provider @provider :previous-level previous}
      (catch python/Exception error
        (stop-workspace-logging! {:handlers @handlers :provider @provider :previous-level previous})
        (throw error)))))

(defasync ^:private replace-workspace-logging! [state desired previous]
  (when previous (await (asyncio/shield previous)))
  (when (and (= desired (:logging-desired @state)) (not (:logging-stopping? @state)))
    (when-let [resource (:logging-resource @state)]
      (swap! state dissoc :logging-resource)
      (await (asyncio/to_thread stop-workspace-logging! resource)))
    (try
      (let [resource (await (asyncio/to_thread start-workspace-logging!
                                               (:root desired) (:settings desired) (:options desired)))]
        (swap! state assoc :logging-resource resource))
      (catch python/Exception error
        (logging/warning "Cannot configure workspace logging: %s" (str error))))))

(defn- refresh-workspace-logging! [state]
  (when (and (:initialized? @state) (not (:logging-stopping? @state)))
    (let [desired {:root (first (:roots @state))
                   :settings (select-keys (:settings @state) [:log-path :otlp])
                   :options (select-keys (:options @state) [:log-path :log-configured? :log-level])}]
      (when (not= desired (:logging-desired @state))
        (let [previous (:logging-task @state)]
          (swap! state assoc :logging-desired desired
                 :logging-task (asyncio/create_task (replace-workspace-logging! state desired previous))))))))

(defasync ^:private shutdown-workspace-logging! [state]
  (swap! state assoc :logging-stopping? true)
  (when-let [task (:logging-task @state)] (await (asyncio/shield task)))
  (when-let [resource (:logging-resource @state)]
    (swap! state dissoc :logging-resource)
    (await (asyncio/to_thread stop-workspace-logging! resource))))

(defn- load-workspace-settings! [state]
  (let [base {:python-options (:options @state)
              :client-settings (:client-settings @state)
              :force-settings (:force-settings @state)}
        settings (load-settings (assoc base :root (first (:roots @state))))
        by-root (into {} (map (fn [root] [root (load-settings (assoc base :root root))])
                              (:roots @state)))
        changed? (or (not= settings (:settings @state))
                     (not= by-root (:settings-by-root @state)))]
    (when changed?
      (swap! state assoc :settings settings :settings-by-root by-root :analyses {})
      (swap! state update :analysis-epoch (fnil inc 0))
      (swap! state update :generation inc)
      (swap! state assoc :tokens {})
      (py/clear-cache! (:python-cache (:options @state)))
      (reset! (:dependency-cache (:options @state)) {})
      (refresh-workspace-logging! state))
    changed?))

(declare index! prepare-workspace-kondo-configs!)

(defn- refresh-settings! [state]
  (when (load-workspace-settings! state)
    (swap! state assoc :index-task (asyncio/create_task (index! state (:roots @state))))))

(defn- selected-path? [state path]
  (some (fn [[root settings]]
          (and (not (ignored-path? settings path))
               (some #(.is_relative_to path (pathlib/Path %)) (source-paths root settings))))
        (:settings-by-root @state)))

(defn- cljfmt-settings [state uri]
  (let [settings (settings-for state uri)
        root (pathlib/Path (or (root-for state uri) (.cwd pathlib/Path)))
        path (.joinpath root (:cljfmt-config-path settings ".cljfmt.edn"))
        file-options (when (.is_file path)
                       (fmt/load-config path))]
    (overlay-settings (:cljfmt settings {}) (or file-options {}))))

(defn- initialization-roots [params]
  (vec (or (seq (keep #(some-> (.-uri %) file-path str)
                      (or (.-workspace_folders params) [])))
           (when-let [root (some-> (.-root_uri params) file-path str)] [root])
           (when-let [root (.-root_path params)] [root]) [])))

;; pygls captures sync kind before the initialize hook; configure it before
;; delegating request dispatch so its workspace and advertised capability agree.
(def ^:private configured-protocol
  (python/type
   "ConfiguredProtocol" (python/tuple [protocol/LanguageServerProtocol])
   #py {"__setattr__"
        (fn [self name value]
          (when (and (= name "server_capabilities") value)
            (set! (.-experimental value) #py {"testTree" true "projectTree" true "cursorInfo" true "serverInfo" true "clojuredocs" true}))
          (.__setattr__ python/object self name value))
        "structure_message"
        (fn [self data]
          (let [method (.get data "method" "") original (.get data "params")
                custom? (or (.startswith method "clojure/") (.startswith method "basilisp/"))
                message (.structure_message protocol/LanguageServerProtocol self data)]
            (when (and custom? (python/hasattr message "params"))
              (python/setattr message "params" original))
            message))
        "_handle_request"
        (fn [self id method params]
          (when (= method lsp/INITIALIZE)
            (let [ls (.-_server self)
                  settings (load-settings {:root (first (initialization-roots params))
                                           :client-settings (py->lisp (.-initialization_options params))
                                           :force-settings (.-blt_force_settings ls)})]
              (python/setattr ls "_text_document_sync_kind"
                              (if (= :incremental (:text-document-sync-kind settings))
                                (.-Incremental lsp/TextDocumentSyncKind)
                                (.-Full lsp/TextDocumentSyncKind)))))
          (._handle_request protocol/LanguageServerProtocol self id method params))}))

(defn- snapshot [ls uri]
  (let [document (.get_text_document (.-workspace ls) uri)]
    (workspace/TextDocument uri ** :source (.-source document)
                            :version (.-version document)
                            :position_codec (.-position_codec (.-workspace ls)))))

(defn- source-file [document]
  (if-let [path (file-path (.-uri document))] (str path) (.-uri document)))

(defn- client-position [document offset]
  (let [source (.-source document) offset (max 0 (min offset (count source)))]
    (cond
      (empty? source) (lsp/Position 0 0)
      (and (pos? offset) (= offset (count source)) (not (.endswith source "\n")))
      (let [position (.server_position_at_offset document (dec offset))]
        (.position_to_client_units document (lsp/Position (.-line position) (inc (.-character position)))))
      :else (.client_position_at_offset document offset))))

(defn- span [document start end]
  (lsp/Range (client-position document (max 0 start))
             (client-position document (max start end))))

(defn- location [state item]
  (when-let [filename (:filename item)]
    (try
      (let [uri (.as_uri (.absolute (pathlib/Path filename)))
            document (or (get-in @state [:documents uri])
                         (workspace/TextDocument uri ** :position_codec (:codec @state)))]
        (lsp/Location
         uri (if (contains? item :start)
               (span document (:start item) (:end item (:start item)))
               (let [row (max 0 (dec (:row item 1))) col (max 0 (dec (:col item 1)))]
                 (lsp/Range (.position_to_client_units document (lsp/Position row col))
                            (.position_to_client_units document
                                                       (lsp/Position row (+ col (count (:name item ""))))))))))
      (catch python/OSError _ nil))))

(defn- declaration-index [documents]
  (reduce (fn [index document]
            (let [info (analyzer/declarations (.-source document)
                                              {:filename (source-file document)})]
              (if-let [ns (:namespace info)]
                (assoc index ns (:definitions info)) index)))
          {} (vals documents)))

(declare kondo-options)

(defn- cached-declaration-index [documents cache options settings epoch]
  (let [raw (reduce (fn [index [uri document]]
                      (let [source (.-source document) prior (get @cache uri)
                            info (if (and (= source (:source prior)) (= epoch (:declaration-epoch prior))) (:info prior)
                                     (let [filename (source-file document)
                                           config (check/load-config (kondo-options filename options settings))
                                           info (analyzer/declarations source {:filename filename :config config :python-options options})]
                                       (swap! cache assoc uri {:source source :info info :config config :declaration-epoch epoch}) info))]
                        (if-let [ns (:namespace info)] (assoc index ns (:definitions info)) index)))
                    {} documents)]
    (reduce (fn [index [uri document]]
              (let [prior (get @cache uri)
                    expanded (if (= epoch (:epoch prior)) (:expanded prior)
                                 (let [config (:config prior)
                                       info (:info prior)
                                       definitions (if (or (seq (:hooks config)) (seq (:lint-as config)))
                                                     (:definitions (analyzer/analyze (.-source document)
                                                                                     {:filename (source-file document) :declarations info :project raw
                                                                                      :config (assoc-in config [:analysis :var-definitions :shallow] true)
                                                                                      :python-options options :dependency-cache (:dependency-cache options)}))
                                                     (:definitions info))]
                                   (swap! cache assoc-in [uri :expanded] definitions)
                                   (swap! cache assoc-in [uri :epoch] epoch)
                                   definitions))]
                (if-let [ns (:namespace (:info prior))] (assoc index ns expanded) index)))
            raw documents)))

(defn- dependency-fingerprint [analysis project]
  (let [names (set (concat (vals (:aliases analysis))
                           (map :ns (vals (:refers analysis)))
                           (keep #(when-not (:python %) (:name %)) (:namespace-usages analysis))
                           (map :ns (:var-usages analysis))))]
    (into {} (for [ns names :when (not= ns (:namespace analysis))]
               [ns (into {} (map (fn [[name definition]]
                                   [name (dissoc definition :scope-end :scope-end-row :scope-end-col)])
                                 (get project ns)))]))))

(defn- refresh-project-definitions [analysis project]
  (let [freshen (fn [item]
                  (if-let [definition (:definition item)]
                    (if-let [fresh (get-in project [(:ns definition) (:name definition)])]
                      (assoc item :definition (merge definition fresh)) item) item))]
    (cond-> analysis
      (contains? analysis :var-usages) (update :var-usages #(mapv freshen %))
      (contains? analysis :calls) (update :calls #(mapv freshen %)))))

(defn- discover [roots codec settings-by-root]
  (let [documents (atom {})]
    (doseq [root roots
            :let [settings (get settings-by-root root)]
            source (source-paths root settings)
            [directory dirs files] (iterator-seq (os/walk source ** :followlinks false))]
      (let [keep (filterv #(not (contains? excluded-directories %)) dirs)]
        (.clear dirs)
        (.extend dirs keep))
      (doseq [name files :when (contains? source-suffixes (.-suffix (pathlib/Path name)))
              :let [path (.joinpath (pathlib/Path directory) name)]
              :when (and (not (.is_symlink path)) (not (ignored-path? settings path)))]
        (try
          (let [uri (.as_uri (.absolute path))]
            (swap! documents assoc uri
                   (workspace/TextDocument uri ** :source (.read_text path ** :encoding "utf-8")
                                           :position_codec codec)))
          (catch python/OSError _ nil)
          (catch python/UnicodeError _ nil))))
    {:documents @documents}))

(defn- navigation-analysis [document analysis declarations]
  (let [records (check/keyword-output analysis {:filename (source-file document) :declarations declarations})
        ;; Checker coordinates are UTF-16 even when the editor negotiates UTF-8.
        utf16-document (workspace/TextDocument (.-uri document) ** :source (.-source document))
        offset (fn [row col] (.offset_at_position utf16-document (lsp/Position (dec row) (dec col))))
        keywords (mapv (fn [item]
                         (assoc item :keyword? true :ns (some-> (:ns item) str)
                                :start (offset (:row item) (:col item))
                                :end (offset (:end-row item) (:end-col item)))) records)]
    (assoc analysis :keyword-usages keywords)))

(declare kondo-options)

(def ^:private analysis-cache-schema 2)

(defn- cache-encode [value] (cache/encode value))

(defn- cache-decode [value] (cache/decode value))

(defn- analysis-cache-stat [file]
  (try
    (let [path (.resolve (pathlib/Path file)) stat (.stat path)]
      [(str path) (.-st_mtime_ns stat) (.-st_size stat)])
    (catch python/OSError _ [(str file) nil nil])))

(defn- analysis-cache-source-files [roots suffixes]
  (sort-by first
           (distinct
            (mapcat
             (fn [root]
               (when (.is_dir (pathlib/Path root))
                 (mapcat (fn [[directory dirs files]]
                           (let [keep (filterv #(not (contains? (conj excluded-directories ".lsp" ".clj-kondo") %)) dirs)]
                             (.clear dirs)
                             (.extend dirs keep))
                           (for [file files
                                 :let [path (.joinpath (pathlib/Path directory) file)]
                                 :when (and (contains? suffixes (.-suffix path)) (not (.is_symlink path)))]
                             (analysis-cache-stat path)))
                         (iterator-seq (os/walk root ** :followlinks false)))))
             roots))))

(defn- analysis-cache-context [project options settings config]
  (let [executable (or (:python-executable options) sys/executable)
        engine (.-parent (pathlib/Path (.-__file__ (get sys/modules "basilisp_tools.lsp"))))
        context {:schema analysis-cache-schema :version (metadata/version "basilisp-tools")
                 :runtime (vec sys/version_info) :engine (analysis-cache-source-files [(str engine)] #{".lpy" ".py"})
                 :project project :config config :settings settings
                 :python (select-keys options [:python-executable :python-paths :python-inspection? :python-timeout])
                 :executable (analysis-cache-stat executable)
                 :environment (mapv analysis-cache-stat (py/environment-paths options))
                 :python-sources (analysis-cache-source-files (:python-paths options) #{".py" ".pyi"})
                 :hook-sources (analysis-cache-source-files (:config-directories config) #{".lpy" ".cljc" ".clj" ".edn"})}]
    (.hexdigest (hashlib/sha256 (.encode (json/dumps (cache-encode context) ** :ensure_ascii false) "utf-8")))))

(defn- analysis-cache-key [document project options settings config]
  (let [storage (:persistent-cache-context options)
        python-options (select-keys options [:workspace-root :python-executable :python-paths :python-inspection? :python-timeout])
        key [(:workspace-root options) (:analysis-epoch options) (python/id project)]
        prior (when storage (get @storage key))
        reusable? (and prior (identical? project (:project prior)) (= config (:config prior))
                       (= settings (:settings prior)) (= python-options (:options prior)))
        fingerprint (if reusable? (:fingerprint prior)
                        (let [fingerprint (analysis-cache-context project options settings config)]
                          (when storage
                            (swap! storage (fn [entries]
                                             (assoc (if (>= (count entries) 16) {} entries) key
                                                    {:project project :config config :settings settings
                                                     :options python-options :fingerprint fingerprint}))))
                          fingerprint))]
    (.hexdigest (hashlib/sha256 (.encode (str fingerprint "\u0000" (source-file document) "\u0000" (.-source document)) "utf-8")))))

(defn- analysis-cache-file [document options settings]
  (when (and (:workspace-root options) (not= false (:cache options)) (not= false (:cache-path settings)))
    (let [root (pathlib/Path (:workspace-root options))
          directory (.expanduser (pathlib/Path (or (:cache-path settings) ".lsp/.cache")))
          directory (if (.is_absolute directory) directory (.joinpath root directory))
          filename (.hexdigest (hashlib/sha256 (.encode (source-file document) "utf-8")))]
      (.joinpath directory "blt-analysis-v2" (str filename ".json")))))

(defn- analysis-cache-dependencies [analysis]
  (let [dependencies (atom #{}) files (atom #{}) seen (python/set)]
    (letfn [(walk [value]
              (when (and (or (map? value) (sequential? value) (set? value))
                         (not (contains? seen (python/id value))))
                (.add seen (python/id value))
                (if (map? value)
                  (do
                    (doseq [key [:filename :file] :let [file (get value key)]
                            :when (and (string? file) (not (contains? @files file)))]
                      (swap! files conj file)
                      (when (and (.is_absolute (pathlib/Path file)) (.is_file (pathlib/Path file)))
                        (swap! dependencies conj (analysis-cache-stat file))))
                    (doseq [dependency (:dependencies value)
                            :when (and (sequential? dependency) (= 3 (count dependency)) (string? (first dependency)))]
                      (swap! dependencies conj (vec dependency)))
                    (run! walk (vals value)))
                  (run! walk value))))]
      (walk analysis))
    (vec (sort-by first @dependencies))))

(defn- analysis-cache-read [file fingerprint]
  (try
    (when (and (.is_file file) (<= (.-st_size (.stat file)) (* 64 1024 1024)))
      (let [payload (json/loads (.read_text file ** :encoding "utf-8"))]
        (when (and (= analysis-cache-schema (get payload "schema"))
                   (= fingerprint (get payload "fingerprint"))
                   (every? #(= (vec %) (analysis-cache-stat (first %))) (get payload "dependencies" [])))
          (let [analysis (cache/decode-graph (get payload "analysis"))]
            (when (and (map? analysis) (vector? (:findings analysis))) analysis)))))
    (catch python/Exception _ nil)))

(defn- analysis-cache-write! [file fingerprint analysis & [current?]]
  (let [temporary (atom nil) current? (or current? (constantly true))]
    (try
      (when (current?)
        (let [payload #py {"schema" analysis-cache-schema "fingerprint" fingerprint
                           "dependencies" (lisp->py (analysis-cache-dependencies analysis))
                           "analysis" (cache/encode-graph analysis)}]
          (.mkdir (.-parent file) ** :parents true :exist_ok true)
          (let [stream (tempfile/NamedTemporaryFile ** :mode "w" :encoding "utf-8"
                                                    :dir (str (.-parent file)) :prefix ".blt-" :suffix ".tmp" :delete false)]
            (reset! temporary (pathlib/Path (.-name stream)))
            (try
              (.write stream (json/dumps payload ** :ensure_ascii false :allow_nan false))
              (.flush stream)
              (os/fsync (.fileno stream))
              (finally (.close stream))))
          ;; An edit or shutdown during serialization must not replace a newer
          ;; session's reusable snapshot with obsolete work.
          (when (current?) (os/replace (str @temporary) (str file)))))
      (catch python/Exception _ nil)
      (finally
        (when (and @temporary (.exists @temporary))
          (try (.unlink @temporary) (catch python/OSError _ nil)))))))

(defn- saved-document? [document]
  ;; Unsaved editor versions cannot be reused after restart. Keep their analysis
  ;; in memory without serializing Python metadata or replacing the disk cache.
  (or (nil? (.-version document))
      (try
        (when-let [path (file-path (.-uri document))]
          (= (.-source document) (.read_text path ** :encoding "utf-8")))
        (catch python/OSError _ false)
        (catch python/UnicodeError _ false))))

(defn- cached-analysis [document project options settings config compute]
  (let [entry (try
                (when (saved-document? document)
                  (when-let [file (analysis-cache-file document options settings)]
                    [file (analysis-cache-key document project options settings config)]))
                (catch python/Exception _ nil))]
    (or (when entry (analysis-cache-read (first entry) (second entry)))
        (let [analysis (compute)]
          (when (and entry
                     (not (some-> (:shutdown-event options) .is_set))
                     (not-any? #(contains? #{"inspection-timeout" "inspection-failed" "interpreter-unavailable"
                                             "invalid-inspection-output" "missing-result"} (:reason %))
                               (vals (:python-modules analysis))))
            (if-let [deferred (:deferred-cache-writes options)]
              (swap! deferred conj {:file (first entry) :fingerprint (second entry) :analysis analysis})
              (analysis-cache-write! (first entry) (second entry) analysis)))
          analysis))))

(defn- analyze-document [document project options settings]
  (let [filename (source-file document)
        config (check/load-config (kondo-options filename options settings))
        config (if (get-in settings [:linters :clj-kondo :report-duplicates] true)
                 (reduce #(assoc-in %1 [:linters %2 :report-duplicates] true) config
                         [:unresolved-symbol :unresolved-namespace :unresolved-var]) config)]
    (cached-analysis
     document project options settings config
     (fn []
       (let [declarations (analyzer/declarations (.-source document)
                                                 {:filename filename :config config :python-options options})]
         (navigation-analysis document
                              (analyzer/analyze (.-source document)
                                                {:filename filename :project project :config config :declarations declarations
                                                 :python-options options :dependency-cache (:dependency-cache options)})
                              declarations))))))

(def ^:private unnecessary-diagnostics
  #{:redefined-var :redundant-do :redundant-expression :redundant-let :unused-binding
    :unreachable-code :unused-import :unused-namespace :unused-private-var :unused-referred-var :clojure-lsp/unused-public-var})

(defn- diagnostic [document finding settings]
  (lsp/Diagnostic
   (let [start (:start finding 0) end (:end finding start)
         source (.-source document)
         simple? (and (not= :full (setting-keyword (get-in settings [:diagnostics :range-type] :full)))
                      (< start (count source)) (contains? #{"(" "[" "{"} (subs source start (inc start))))
         multiline? (not= (:row finding) (:end-row finding (:row finding)))]
     (span document start (if (or simple? multiline?) start end)))
   (:message finding)
   ** :severity (case (:level finding)
                  :warning (.-Warning lsp/DiagnosticSeverity)
                  :info (.-Information lsp/DiagnosticSeverity)
                  (.-Error lsp/DiagnosticSeverity))
   :source "blt" :code (str (symbol (:type finding :syntax)))
   :tags (python/list (cond-> []
                        (contains? unnecessary-diagnostics (:type finding)) (conj (.-Unnecessary lsp/DiagnosticTag))
                        (= :deprecated-var (:type finding)) (conj (.-Deprecated lsp/DiagnosticTag))))))

(defn diagnostics-data
  "Return wire-format diagnostics for a source snapshot."
  [filename source analysis settings]
  (let [document (workspace/TextDocument (.as_uri (.absolute (pathlib/Path filename))) ** :source source)
        converter (converters/get_converter)
        excluded (get-in settings [:linters :clj-kondo :ns-exclude-regex])
        findings (if (or (= :off (get-in settings [:linters :clj-kondo :level]))
                         (and excluded (regex/fullmatch (if (keyword? excluded) (setting-text excluded) excluded) (:namespace analysis ""))))
                   (filter :lsp? (:findings analysis)) (:findings analysis))]
    (mapv #(py->lisp (.unstructure converter (diagnostic document % settings))) findings)))

(defn- publish! [ls state document analysis]
  (let [settings (settings-for state (.-uri document))
        excluded (get-in settings [:linters :clj-kondo :ns-exclude-regex])
        findings (if (or (= :off (get-in settings [:linters :clj-kondo :level]))
                         (and excluded (regex/fullmatch (if (keyword? excluded) (setting-text excluded) excluded) (:namespace analysis ""))))
                   (filter :lsp? (:findings analysis)) (:findings analysis))]
    (.text_document_publish_diagnostics
     ls (lsp/PublishDiagnosticsParams
         (.-uri document) (python/list (map #(diagnostic document % settings) findings))
         ** :version (.-version document)))))

(defasync ^:private wait-index! [state]
  (when-let [task (:index-task @state)]
    (await (asyncio/shield task))
    (when-not (identical? task (:index-task @state)) (await (wait-index! state)))))

(defasync ^:private wait-reloads! [state]
  (when (seq (:reloads @state))
    (await (asyncio/shield
            (apply (functools/partial asyncio/gather ** :return_exceptions true)
                   (vals (:reloads @state)))))))

(defn- workspace-documents [state uri]
  (let [root (when uri (root-for state uri))]
    (if uri
      (into {} (filter (fn [[candidate _]] (= root (root-for state candidate))) (:documents @state)))
      (:documents @state))))

(defasync ^:private project! [state uri]
  (await (wait-reloads! state))
  (let [generation (:generation @state) root (root-for state uri)
        cached (get-in @state [:project-caches root])]
    (if (= generation (:generation cached))
      (:project cached)
      (let [pending (get-in @state [:project-pending root])
            task (if (= generation (:generation pending))
                   (:task pending)
                   (let [task (asyncio/create_task
                               (worker! state cached-declaration-index (workspace-documents state uri) (:declaration-cache @state)
                                        (options-for state uri) (settings-for state uri) (:analysis-epoch @state 0)))]
                     (swap! state assoc-in [:project-pending root] {:generation generation :task task})
                     task))
            project (await (asyncio/shield task))]
        (when (= generation (:generation @state))
          (swap! state assoc-in [:project-caches root] {:generation generation :project project}))
        project))))

(defasync ^:private persist-analysis! [state uri document generation epoch entry]
  ;; Yield once so document diagnostics can be published before disk persistence.
  (await (asyncio/sleep 0))
  (let [current? #(and (= generation (:generation @state)) (= epoch (:analysis-epoch @state 0))
                       (identical? document (get-in @state [:documents uri]))
                       (not (some-> (:workers @state) :closed .is_set)))
        lock (or (:cache-write-lock @state)
                 (let [lock (asyncio/Lock)] (swap! state assoc :cache-write-lock lock) lock))]
    (try
      ;; Persist at most one snapshot at a time, leaving workers for editor
      ;; requests. Stale tasks check again after waiting for this lock.
      (await (.acquire lock))
      (swap! state assoc :cache-writing-task (asyncio/current_task))
      (try
        (when (current?)
          (await (worker! state analysis-cache-write! (:file entry) (:fingerprint entry) (:analysis entry) current?)))
        (finally
          (swap! state dissoc :cache-writing-task)
          (.release lock)))
      (finally
        (when (identical? (asyncio/current_task) (get-in @state [:cache-writes uri]))
          (swap! state update :cache-writes dissoc uri))))))

(defasync ^:private analyze-latest! [state uri]
  (await (wait-index! state))
  (let [document (get-in @state [:documents uri]) generation (:generation @state)
        epoch (:analysis-epoch @state 0) cached (get-in @state [:analyses uri])
        writes (atom [])]
    (when document
      (let [project (await (project! state uri))
            same-source? (and (= (.-source document) (:source cached)) (= epoch (:epoch cached)))
            current? (and same-source? (= generation (:generation cached)))
            reusable? (and same-source?
                           (or current? (= (:dependencies cached) (dependency-fingerprint (:analysis cached) project))))
            result (cond
                     current? (:analysis cached)
                     reusable? (refresh-project-definitions (:analysis cached) project)
                     :else (await (worker! state analyze-document document project
                                           (assoc (options-for state uri) :deferred-cache-writes writes)
                                           (settings-for state uri))))]
        (if (and (= generation (:generation @state)) (= epoch (:analysis-epoch @state 0))
                 (= (.-source document) (some-> (get-in @state [:documents uri]) .-source)))
          (do
            (when-not current?
              (swap! state assoc-in [:analyses uri]
                     {:source (.-source document) :generation generation :epoch epoch
                      :dependencies (if reusable? (:dependencies cached) (dependency-fingerprint result project)) :analysis result}))
            (when-let [entry (first @writes)]
              ;; Coalesce queued saves without cancelling the writer that holds
              ;; the slot; its snapshot guard rejects obsolete work at replace.
              (when-let [prior (get-in @state [:cache-writes uri])]
                (when-not (identical? prior (:cache-writing-task @state)) (.cancel prior)))
              (swap! state assoc-in [:cache-writes uri]
                     (asyncio/create_task (persist-analysis! state uri document generation epoch entry))))
            result)
          (await (analyze-latest! state uri)))))))

(defasync ^:private analyzed! [state uri]
  ;; A cancelled request must not abandon a running analysis thread. All readers
  ;; share one worker per document; the worker retries only the newest snapshot.
  (let [pending (get-in @state [:analysis-pending uri])
        task (if (and pending (not (.done pending))) pending
                 (let [task (asyncio/create_task (analyze-latest! state uri))]
                   (swap! state assoc-in [:analysis-pending uri] task)
                   task))]
    (await (asyncio/shield task))))

(declare all-analyses! test-tree project-findings)

(defn- custom-findings [state uri analyses]
  (let [root (root-for state uri)
        settings (settings-for state uri)
        settings (update-in settings [:linters :custom]
                            #(into {} (map (fn [[function parameters]]
                                             [(if (or (keyword? function) (string? function))
                                                (symbol (setting-text function)) function)
                                              parameters]) %)))
        documents (workspace-documents state uri)
        projected (into {} (for [[candidate analysis] analyses
                                 :let [document (get documents candidate)
                                       filename (source-file document)
                                       declarations (analyzer/declarations (.-source document) {:filename filename})]]
                             [candidate (check/analysis-output
                                         {:config {:analysis {:locals true :keywords true :arglists true}}
                                          :analysis [analysis]
                                          :sources [{:filename filename :declarations declarations}]})]))
        db {:analysis projected :documents (into {} (map (fn [[uri document]] [uri {:text (.-source document)}]) documents))
            :internal-uris (set (keys documents)) :external-uris #{}}
        paths (vec (distinct (concat [(str root) (str (.joinpath (pathlib/Path (or root ".")) ".lsp"))]
                                     (:python-paths (options-for state uri)))))
        diagnostics (hooks/run-custom-linters {:db db :uris [uri] :settings settings :hook-paths paths
                                               :hook-cache (:hook-cache @state)})
        document (get documents uri)
        offset (fn [row col]
                 (.offset_at_position document
                                      (.position_to_client_units document (lsp/Position (max 0 (dec (or row 1)))
                                                                                        (max 0 (dec (or col 1)))))))]
    (vec (for [entry diagnostics :when (= uri (:uri entry))
               :let [range (:range entry)]]
           {:start (offset (:row range) (:col range))
            :end (offset (:end-row range (:row range)) (:end-col range (:col range)))
            :message (:message entry) :level (:level entry :warning)
            :type (keyword (str (:code entry "custom")))}))))

(defasync ^:private latest-project-findings! [state uri]
  (let [analyses (await (all-analyses! state uri))
        generation (:generation @state)
        root (root-for state uri)
        documents (into {} (map (fn [[candidate document]] [candidate (.-source document)]) (workspace-documents state uri)))
        findings (await (worker! state project-findings documents analyses (settings-for state uri) root))]
    (if (= generation (:generation @state))
      (do (swap! state assoc-in [:project-diagnostics root] {:generation generation :findings findings}) findings)
      (await (latest-project-findings! state uri)))))

(defasync ^:private workspace-findings! [state uri]
  (let [root (root-for state uri) generation (:generation @state)
        cached (get-in @state [:project-diagnostics root])
        pending (get-in @state [:project-diagnostics-pending root])]
    (if (= generation (:generation cached))
      (:findings cached)
      (let [task (if (and pending (not (.done pending))) pending
                     (let [task (asyncio/create_task (latest-project-findings! state uri))]
                       (swap! state assoc-in [:project-diagnostics-pending root] task) task))]
        (await (asyncio/shield task))))))

(defasync ^:private refresh! [ls state uri]
  ;; Publish document findings as soon as they are ready. Whole-project linters
  ;; enrich them later, so a large unrelated file cannot hide local diagnostics.
  (await (asyncio/sleep 0.08))
  (let [document (get-in @state [:documents uri])
        version (some-> document .-version)
        publish-current! (fn [result]
                           (when (and (contains? (:open @state) uri)
                                      (= version (some-> (get-in @state [:documents uri]) .-version))
                                      (identical? document (get-in @state [:documents uri])))
                             (publish! ls state document result)
                             true))]
    (when document
      (try
        (let [result (await (analyzed! state uri))]
          (when (and (publish-current! result) (:test-tree? @state))
            (when-let [tree (test-tree uri document result)]
              (.notify (.-protocol ls) "clojure/textDocument/testTree" (lisp->py tree))))
          (try
            (let [project-findings (await (workspace-findings! state uri))
                  enriched (update result :findings into (map #(assoc % :lsp? true) (get project-findings uri)))
                  enriched (if (seq (get-in (settings-for state uri) [:linters :custom]))
                             (let [analyses (await (all-analyses! state uri))
                                   custom (await (worker! state custom-findings state uri analyses))]
                               (update enriched :findings into (map #(assoc % :lsp? true) custom))) enriched)]
              (when (not= (:findings result) (:findings enriched))
                (publish-current! enriched)))
            (catch python/Exception error
              (logging/warning "Could not enrich diagnostics for %s: %s" uri (str error)))))
        (catch python/Exception error
          (publish-current! {:findings [{:type :configuration :level :error
                                         :start 0 :end 0 :message (str error)}]}))))))

(defn- changed! [ls state params]
  (refresh-settings! state)
  (let [uri (.-uri (.-text_document params))]
    (when-let [task (get-in @state [:tasks uri])] (.cancel task))
    (swap! state (fn [value]
                   (-> value (assoc-in [:documents uri] (snapshot ls uri))
                       (update :generation inc) (update :open conj uri))))
    (doseq [uri (if (get (settings-for state uri) :notify-references-on-file-change true)
                  (:open @state) [uri])]
      (when-let [task (get-in @state [:tasks uri])] (.cancel task))
      (swap! state assoc-in [:tasks uri] (asyncio/create_task (refresh! ls state uri))))))

(defasync ^:private index! [state roots]
  (await (prepare-workspace-kondo-configs! state))
  (let [settings (:settings-by-root @state)
        result (await (worker! state discover roots (:codec @state) settings))]
    (when (and (= (set roots) (set (:roots @state)))
               (= settings (:settings-by-root @state)))
      (swap! state update :documents
             #(merge (:documents result) (select-keys % (:open @state))))
      (swap! state update :generation inc))))

(defasync ^:private closed! [state uri]
  (when-let [path (file-path uri)]
    (when (and (contains? source-suffixes (.-suffix path)) (selected-path? state path))
      (try
        (let [source (await (worker! state #(.read_text path ** :encoding "utf-8")))]
          (when-not (contains? (:open @state) uri)
            (swap! state assoc-in [:documents uri]
                   (workspace/TextDocument uri ** :source source :position_codec (:codec @state)))
            (swap! state update :generation inc)))
        (catch python/OSError _ nil)
        (catch python/UnicodeError _ nil)))))

(defn- occurrence [analysis offset]
  (first
   (filter #(and (<= (:start % 0) offset) (< offset (:end % 0)))
           (concat (:local-usages analysis) (:locals analysis)
                   (:var-usages analysis) (:var-definitions analysis)
                   (:python-usages analysis) (:keyword-usages analysis)
                   (map #(assoc % :namespace? true) (remove :python (concat (:namespace-definitions analysis) (:namespace-usages analysis))))))))

(defasync ^:private formatting-options! [state uri]
  (let [options (await (worker! state cljfmt-settings state uri))
        project (await (project! state uri))
        analysis (await (analyzed! state uri))
        definitions (concat (mapcat vals (vals project)) (:var-definitions analysis)
                            (keep :definition (:var-usages analysis)))
        refers (into {} (concat (map (fn [[name definition]] [name (:ns definition)]) (:refers analysis))
                                (map (juxt :name :ns) (:var-definitions analysis))))
        options (-> options
                    (update :alias-map #(merge (:aliases analysis) %))
                    (update :refer-map #(merge refers %)))]
    (fmt/with-analysis-indents options definitions)))

(defn- identity-of [item]
  (cond
    (= "clj-kondo/unknown-namespace" (:ns item)) nil
    (:python item) (let [definition (:definition item)]
                     (cond
                       (and (:filename definition) (:row definition))
                       [:python-source (:filename definition) (:row definition) (:name definition)]
                       (and (= :class (:kind definition)) (:type-module definition))
                       [:python (:type-module definition) (:type-path definition)]
                       (:python-path item) [:python (:python-module item (:ns item)) (:python-path item)]
                       :else [:python (:ns item) [(:name item)]]))
    (:keyword? item) [:keyword (:ns item) (:name item)]
    (:namespace? item) [:namespace (:name item)]
    (:id item) [:local (:id item)]
    :else (when-let [definition (or (:definition item) (when (:ns item) item))]
            (when (and (:ns definition) (:name definition))
              [:var (:ns definition) (:name definition)]))))

(defn- definition-of [analysis item]
  (or (:definition item)
      (when (:keyword? item) item)
      (when (:id item) (first (filter #(= (:id %) (:id item)) (:locals analysis))))
      (when (some #(= % item) (:var-definitions analysis)) item)))

(defasync ^:private query! [state params]
  (refresh-settings! state)
  (let [uri (.-uri (.-text_document params))
        analysis (await (analyzed! state uri))
        document (get-in @state [:documents uri])
        offset (.offset_at_position document (.-position params))]
    {:uri uri :document document :analysis analysis :offset offset
     :item (or (occurrence analysis offset)
               (when (pos? offset) (occurrence analysis (dec offset))))}))

(defasync ^:private all-analyses!
  ([state] (await (all-analyses! state nil)))
  ([state uri]
   (refresh-settings! state)
   (await (wait-index! state))
   (await (wait-reloads! state))
   (loop [uris (keys (workspace-documents state uri)) result {}]
     (if-let [uri (first uris)]
       (recur (rest uris) (assoc result uri (await (analyzed! state uri))))
       result))))

(defn- occurrences [analyses identity declarations?]
  ;; Realize each document before advancing: nested lazy comprehensions retain
  ;; a stack frame per document when a long run has no matching occurrences.
  (reduce
   (fn [result [uri analysis]]
     (into result
           (for [item (concat (:local-usages analysis) (:var-usages analysis) (:keyword-usages analysis) (:python-usages analysis)
                              (map #(assoc % :namespace? true) (remove :python (:namespace-usages analysis)))
                              (when declarations? (map #(assoc % :namespace? true) (:namespace-definitions analysis)))
                              (for [[_alias referred] (:refers analysis)
                                    :when (not (:all referred))
                                    node (distinct (remove nil? [(:node referred) (:refer-node referred)
                                                                 (:rename-node referred)]))]
                                (merge node {:filename (or (some-> uri file-path str) uri)
                                             :name (:name referred) :ns (:ns referred)}))
                              (when declarations? (concat (:locals analysis) (:var-definitions analysis))))
                 :when (= identity (identity-of item))]
             [uri item])))
   [] analyses))

(defn- markdown
  ([definition] (markdown definition {}))
  ([definition settings]
   (let [signature (or (when (seq (:overloads definition))
                         (str/join "\n" (map :signature (:overloads definition))))
                       (:signature definition)
                       (when (seq (:arglists definition))
                         (str/join " " (:arglists definition))))
         doc (:doc definition)]
     (lsp/MarkupContent (.-PlainText lsp/MarkupKind)
                        (str (:name definition "")
                             (when signature (str (if (or (get-in settings [:hover :arity-on-same-line?]) (:show-docs-arity-on-same-line? settings)) " " "\n") signature))
                             (when (seq doc) (str "\n\n" doc))
                             (when (and (:filename definition) (not (get-in settings [:hover :hide-file-location?])))
                               (str "\n\n" (:filename definition))))))))

(defn- definition-kind [definition]
  (if (or (:macro definition) (seq (:arglists definition)))
    (.-Function lsp/SymbolKind) (.-Variable lsp/SymbolKind)))

(defn- map-binding? [document definition]
  (let [offset (:start definition)
        ancestors (filter #(and (<= (:start %) offset) (< offset (:end %)))
                          (syntax/nodes (:root (syntax/parse (.-source document)))))
        list-start (:start (last (filter #(= :list (:kind %)) ancestors)) -1)]
    ;; Map destructuring may encode keyword names and :or defaults. Renaming its
    ;; token alone would silently change the lookup key, so decline the edit.
    (some #(and (= :map (:kind %)) (> (:start %) list-start)) ancestors)))

(defn- type-or-protocol-binding? [document definition]
  (let [offset (:start definition)]
    (some (fn [node]
            (when (and (= :list (:kind node)) (<= (:start node) offset) (< offset (:end node)))
              (contains? #{"defrecord" "deftype" "defprotocol"}
                         (last (str/split (or (:text (first (syntax/forms node))) "") #"/")))))
          (syntax/nodes (:root (syntax/parse (.-source document)))))))

(defn- editable-definition? [state analysis item]
  (when-let [definition (definition-of analysis item)]
    (when-let [document (some #(when (= (:filename definition) (source-file %)) %)
                              (vals (:documents @state)))]
      (and (contains? definition :start)
           (not (:generated definition)) (not (:derived-location definition))
           (not (.startswith (:name definition "") "%"))
           ;; Generated constructors share the type's declaration token. Their
           ;; names must be renamed as a group, which this operation declines.
           (= (:name definition) (subs (.-source document) (:start definition) (:end definition)))
           (not (some #(and (= (:start definition) (:start %))
                            (= (:filename definition) (:filename %))
                            (not= (:name definition) (:name %)))
                      (vals (get-in @state [:project-caches (root-for state (.-uri document)) :project (:ns definition)]))))
           (not (type-or-protocol-binding? document definition))
           (not (and (:id definition) (map-binding? document definition)))))))

(defn- name-span [document item]
  ;; A qualified use edits only the name, leaving its namespace alias intact.
  (let [end (:end item) source (.-source document)
        token (subs source (:start item) end)
        suffix (last (str/split token #"/"))]
    (span document (- end (count suffix)) end)))

(defn- workspace-edit [state changes]
  (if (:document-changes? @state)
    (lsp/WorkspaceEdit ** :document_changes (python/list changes))
    (lsp/WorkspaceEdit
     ** :changes (python/dict
                  (python/list (map #(vector (.-uri (.-text_document %)) (.-edits %)) changes))))))

(defn- valid-name? [name]
  (let [tree (syntax/parse name) forms (syntax/forms (:root tree))]
    (and (empty? (:diagnostics tree)) (= 1 (count forms))
         (= :symbol (:kind (first forms))) (= name (:text (first forms)))
         (not (str/includes? name "/")) (not (str/includes? name "."))
         (not (.startswith name "%"))
         (not (contains? #{"&" "**" "if" "do" "let*" "letfn*" "fn*" "quote" "var"
                           "def" "set!" "try" "catch" "finally" "throw" "new" "await" "recur"}
                         name)))))

(defn- completion-item [label definition range]
  (lsp/CompletionItem
   label ** :kind (case (:kind definition)
                    :class (.-Class lsp/CompletionItemKind)
                    :module (.-Module lsp/CompletionItemKind)
                    :function (.-Function lsp/CompletionItemKind)
                    (if (seq (:arglists definition)) (.-Function lsp/CompletionItemKind)
                        (.-Variable lsp/CompletionItemKind)))
   :detail (or (:signature definition) (:ns definition))
   :documentation (when (:doc definition) (markdown definition))
   :text_edit (lsp/TextEdit range label)))

(defn- completion-prefix [document offset]
  (let [source (subs (.-source document) 0 offset)
        match (re/search "[^\\s,()\\[\\]{}\";@^~\\\\]*$" source)]
    (if match (.group match 0) "")))

(defn- method-candidates [analysis offset prefix options]
  (let [tree (syntax/parse (:source analysis))
        form (last (filter #(and (= :list (:kind %)) (<= (:start %) offset) (<= offset (:end %)))
                           (syntax/nodes (:root tree))))
        receiver (:text (second (syntax/forms form)))
        local (last (sort-by :start
                             (filter #(and (= receiver (:name %))
                                           (<= (:scope-start % 0) offset) (<= offset (:scope-end % offset)))
                                     (:locals analysis))))
        receiver-node (second (syntax/forms form))
        expression (last (filter #(and (= (:start %) (:start receiver-node))
                                       (= (:end %) (:end receiver-node))) (:python-expressions analysis)))
        type (or (:python-type expression) (:python-type local))]
    (when type
      (let [info (py/inspect-type type options)
            attribute? (.startswith prefix ".-")
            suffix (subs prefix (if attribute? 2 1))]
        (for [[name definition] (:members info) :when (.startswith name suffix)]
          [(str (if attribute? ".-" ".") name) (py/bind-member definition)])))))

(defn- completion-candidates [analysis offset prefix options]
  (cond
    (.startswith prefix ".") (method-candidates analysis offset prefix options)
    (str/includes? prefix "/")
    (let [[alias member-prefix] (str/split prefix #"/" 2)
          module (if (= alias "python") "builtins" (:name (get (:imports analysis) alias)))]
      (if module
        (let [parts (vec (.split member-prefix "."))
              path (vec (butlast parts)) suffix (last parts)
              info (if (seq path) (py/inspect-path module path options) (py/inspect-module module options))
              qualifier (if (seq path) (str (str/join "." path) ".") "")]
          (for [[name definition] (:members info) :when (.startswith name suffix)]
            [(str alias "/" qualifier name) definition]))
        (let [ns (get (:aliases analysis) alias alias)]
          (for [[name definition] (analyzer/namespace-symbols ns {:project (:project analysis) :python-options options :dependency-cache (:dependency-cache options)})
                :when (and (not (:private definition)) (.startswith name member-prefix))]
            [(str alias "/" name) definition]))))
    :else
    (concat
     (for [local (:locals analysis)
           :when (and (<= (:scope-start local 0) offset) (<= (:end local 0) offset)
                      (<= offset (:scope-end local offset)) (.startswith (:name local) prefix))]
       [(:name local) local])
     (for [[name definition] (:definitions analysis) :when (.startswith name prefix)]
       [name definition])
     (for [[alias referred] (:refers analysis) :when (.startswith alias prefix)
           :let [definition (get (analyzer/namespace-symbols (:ns referred) {:project (:project analysis) :python-options options :dependency-cache (:dependency-cache options)})
                                 (:name referred))]
           :when definition]
       [alias definition])
     (for [[alias referred] (:python-refers analysis) :when (.startswith alias prefix)
           :let [definition (py/inspect-path (:name referred) [(:member referred)] options)]
           :when (= :known (:status definition))]
       [alias definition])
     (for [[alias original] (:core-renamed analysis) :when (.startswith alias prefix)]
       [alias (get (analyzer/core-symbols) original)])
     (for [[name definition] (analyzer/core-symbols)
           :when (and (.startswith name prefix)
                      (not (contains? (:core-excluded analysis) name))
                      (not (some #{name} (vals (:core-renamed analysis))))
                      (or (nil? (:core-only analysis)) (contains? (:core-only analysis) name)))]
       [name definition]))))

;; These queries share the analyzer's resolved identities and source offsets.
;; All protocol positions pass through TextDocument's negotiated position codec.
(defn- call-at [analysis offset]
  (last (sort-by :start (filter #(and (<= (:start %) offset) (<= offset (:end %)))
                                (:calls analysis)))))

(defn- arglist-parameters [arglist]
  (let [nodes (syntax/forms (first (syntax/forms (:root (syntax/parse arglist)))))]
    (loop [nodes nodes result []]
      (if-let [node (first nodes)]
        (if (= "&" (:text node))
          (conj result {:name (str "& " (syntax/text (second nodes))) :kind :var-positional})
          (recur (rest nodes) (conj result {:name (syntax/text node) :kind :positional-or-keyword})))
        result))))

(defn- signature-variants [definition]
  (if (seq (:arglists definition))
    (mapv (fn [arglist] {:signature (str "(" (:name definition) " " arglist ")")
                         :parameters (arglist-parameters arglist) :doc (:doc definition)})
          (:arglists definition))
    (when (:signature definition)
      (mapv #(assoc % :signature (str (:name definition) (:signature %)) :doc (:doc definition))
            (or (seq (:overloads definition)) [definition])))))

(defn- signature-help [analysis document offset]
  (when-let [call (call-at analysis offset)]
    (let [definition (:definition call)
          variants (signature-variants definition)
          preferred (some-> (:signatures call) first :signature)
          preferred-index (when preferred
                            (first (keep-indexed #(when (= (:signature %2) (str (:name definition) preferred)) %1) variants)))
          arguments (:arguments call)
          before (vec (filter #(<= (:start %) offset) arguments))
          marker (first (keep-indexed #(when (= "**" (subs (.-source document) (:start %2) (:end %2))) %1) arguments))
          keyword-node (when (and marker (> (count before) (inc marker)))
                         (nth arguments (+ marker 1 (* 2 (quot (- (count before) marker 2) 2))) nil))
          keyword-name (when keyword-node
                         (let [value (subs (.-source document) (:start keyword-node) (:end keyword-node))
                               node (first (syntax/forms (:root (syntax/parse value))))]
                           (analyzer/python-keyword-name node)))
          positional (if marker marker (count arguments))
          index (or preferred-index (first (keep-indexed
                                            (fn [index variant]
                                              (let [params (:parameters variant)
                                                    fixed (count (filter #(contains? #{:positional-only :positional-or-keyword}
                                                                                     (:kind %)) params))]
                                                (when (or (= fixed positional)
                                                          (and (<= (count (filter #(and (contains? #{:positional-only :positional-or-keyword} (:kind %))
                                                                                        (:required? % true)) params)) positional)
                                                               (or (<= positional fixed)
                                                                   (some #(= :var-positional (:kind %)) params)))) index)))
                                            variants))
                    (when (seq variants) (dec (count variants))))
          active (when index
                   (let [params (:parameters (nth variants index))]
                     (when (seq params)
                       (or (when keyword-name
                             (first (keep-indexed #(when (= keyword-name (:name %2)) %1) params)))
                           (max 0 (min (dec (count params))
                                       (if (and (seq before) (> offset (:end (last before))))
                                         (count before) (dec (count before)))))))))]
      (when (seq variants)
        (lsp/SignatureHelp
         (python/list
          (map (fn [variant]
                 (lsp/SignatureInformation
                  (:signature variant) ** :documentation (:doc variant)
                  :parameters (python/list (map #(lsp/ParameterInformation (:name %)) (:parameters variant)))))
               variants))
         ** :active_signature index :active_parameter active)))))

(def ^:private token-types
  ["namespace" "type" "function" "macro" "keyword" "class" "variable" "method" "event" "interface" "comment"])
(def ^:private token-modifiers ["definition" "defaultLibrary" "implementation"])

(defn- split-token [start text kind modifier prefix]
  (let [slash (.find text "/")]
    (if (and (pos? slash) (< slash (dec (count text))))
      [[(+ start prefix) (+ start slash) 1 0]
       [(+ start slash) (+ start slash 1) 8 0]
       [(+ start slash 1) (+ start (count text)) kind modifier]]
      [[(+ start prefix) (+ start (count text)) kind modifier]])))

(defn- semantic-spans [analysis document]
  (let [source (.-source document) tree (syntax/parse source) nodes (syntax/nodes (:root tree))
        discarded (filter #(= :discard (:kind %)) nodes)
        discarded (remove (fn [node]
                            (some #(and (< (:start %) (:start node)) (<= (:end node) (:end %)))
                                  discarded)) discarded)
        ignored? (fn [start] (some #(and (<= (:start %) start) (< start (:end %))) discarded))
        items (concat
               (for [item (:namespace-definitions analysis)] [item 0 0])
               (for [item (:locals analysis)] [item 6 0])
               (for [item (:local-usages analysis)] [item 6 0])
               (for [item (:var-definitions analysis)] [item (if (:protocol item) 9 2) 1])
               (for [item (:var-usages analysis)] [item (if (get-in item [:definition :macro]) 3 2) 0])
               (for [item (:python-usages analysis)]
                 [item (case (get-in item [:definition :kind]) :module 0 :class 5 :property 6
                             (if (.startswith (:name item "") ".") 7 2)) 0]))
        ranges (concat
                (mapcat (fn [[item kind modifier]]
                          (let [start (:start item) end (:end item)]
                            (when (and start end (<= 0 start end (count source)) (not (ignored? start)))
                              (split-token start (subs source start end) kind modifier 0)))) items)
                (mapcat (fn [node]
                          (when (and (= :keyword (:kind node)) (not (ignored? (:start node))))
                            (split-token (:start node) (:text node) 4 0
                                         (if (.startswith (:text node) "::") 2 1)))) nodes)
                (for [node discarded] [(:start node) (:end node) 10 0]))]
    (sort-by first (distinct ranges))))

(defn- semantic-data [analysis document requested-range]
  (let [lower (if requested-range (.offset_at_position document (.-start requested-range)) 0)
        upper (if requested-range (.offset_at_position document (.-end requested-range)) (count (.-source document)))
        tokens (mapcat
                (fn [[start end kind modifiers]]
                  (when (and (< start end) (< start upper) (< lower end))
                     ;; Split reader-discard comments into individual lines. This
                     ;; works even when the client does not support multiline tokens.
                    (loop [start start result []]
                      (if (>= start end) result
                          (let [newline (.find (.-source document) "\n" start end)
                                stop (if (neg? newline) end newline)
                                token-end (if (and (> stop start) (= "\r" (subs (.-source document) (dec stop) stop)))
                                            (dec stop) stop)
                                from (client-position document start)
                                to (client-position document token-end)
                                length (- (.-character to) (.-character from))
                                result (if (pos? length)
                                         (conj result [(.-line from) (.-character from) length kind modifiers]) result)]
                            (recur (inc stop) result))))))
                (semantic-spans analysis document))]
    (:data (reduce (fn [{:keys [line column end-line end-column data] :as previous}
                        [row col length kind modifiers]]
                     (if (and (= row end-line) (< col end-column)) previous
                         {:line row :column col :end-line row :end-column (+ col length)
                          :data (into data [(- row line) (if (= row line) (- col column) col)
                                            length kind modifiers])}))
                   {:line 0 :column 0 :end-line -1 :end-column 0 :data []} tokens))))

(defn- token-response! [state uri data previous-id]
  (let [previous (get-in @state [:tokens uri])
        id (str (swap! (:token-sequence @state) inc))]
    (swap! state assoc-in [:tokens uri] {:id id :data data})
    (if (and previous-id (= previous-id (:id previous)))
      (let [before (:data previous)
            prefix (count (take-while true? (map = before data)))
            suffix (count (take-while true? (map = (reverse (drop prefix before))
                                                 (reverse (drop prefix data)))))
            removed (- (count before) prefix suffix)
            replacement (subvec data prefix (- (count data) suffix))]
        (lsp/SemanticTokensDelta
         (if (and (zero? removed) (empty? replacement)) #py []
             #py [(lsp/SemanticTokensEdit prefix removed ** :data (python/list replacement))])
         ** :result_id id))
      (lsp/SemanticTokens (python/list data) ** :result_id id))))

(defn- reference-title [references noun]
  (str (count references) " " noun (when (not= 1 (count references)) "s")))

(defn- hierarchy-item [state definition]
  (when-let [loc (location state definition)]
    (let [document (get-in @state [:documents (.-uri loc)])]
      (lsp/CallHierarchyItem
       (:name definition) (definition-kind definition) (.-uri loc)
       (if (and document (:scope-start definition))
         (span document (:scope-start definition) (:scope-end definition)) (.-range loc))
       (.-range loc) ** :detail (:ns definition)
       :data (lisp->py {:ns (:ns definition) :name (:name definition)
                        :filename (:filename definition)})))))

(defn- item-identity [item]
  (let [data (py->lisp (.-data item))]
    [:var (:ns data) (:name data)]))

(defn- unused-binding-actions [state uri document analysis requested-range context]
  (let [start (.offset_at_position document (.-start requested-range))
        end (.offset_at_position document (.-end requested-range))
        only (.-only context)]
    (python/list
     (if (or (not (seq only)) (some #(or (= % "quickfix") (.startswith "quickfix" (str % "."))) only))
       (for [finding (:findings analysis)
             :when (and (= :unused-binding (:type finding))
                        (<= (:start finding) end) (<= start (:end finding)))
             :let [definition (first (filter #(= (:start finding) (:start %)) (:locals analysis)))
                   name (:name definition)
                   replacement (str "_" name)]
             :when (and definition (valid-name? name) (not (map-binding? document definition))
                        (not (type-or-protocol-binding? document definition))
                        (not (some #(= replacement (:text %))
                                   (syntax/nodes (:root (syntax/parse (.-source document)))))))]
         (lsp/CodeAction
          (str "Mark '" name "' as intentionally unused") ** :kind (.-QuickFix lsp/CodeActionKind)
          :is_preferred true
          :diagnostics #py [(diagnostic document finding (settings-for state uri))]
          :edit (workspace-edit
                 state #py [(lsp/TextDocumentEdit
                             (lsp/OptionalVersionedTextDocumentIdentifier uri (.-version document))
                             #py [(lsp/TextEdit (span document (:start definition) (:end definition)) replacement)])]))) []))))

(defn- enclosing-nodes [tree offset]
  (sort-by #(- (:end %) (:start %))
           (filter #(and (<= (:start %) offset) (<= offset (:end %))
                         (not (contains? #{:root :delimiter :whitespace :newline :comma} (:kind %))))
                   (syntax/nodes (:root tree)))))

(defn- selection-range [document tree position]
  (let [offset (.offset_at_position document position)
        ranges (distinct
                (mapcat (fn [node]
                          (let [children (:children node)
                                opening (first children) closing (last children)]
                            (cond-> [[(:start node) (:end node)]]
                              (and (= :delimiter (:kind opening)) (= :delimiter (:kind closing))
                                   (<= (:end opening) offset) (<= offset (:start closing))
                                   (< (:end opening) (:start closing)))
                              (conj [(:end opening) (:start closing)]))))
                        (enclosing-nodes tree offset)))
        ranges (sort-by (fn [[start end]] (- end start)) ranges)]
    (or (reduce (fn [parent [start end]] (lsp/SelectionRange (span document start end) ** :parent parent))
                nil (reverse ranges))
        (lsp/SelectionRange (span document offset offset)))))

(defn- folding-ranges [document tree]
  (python/list
   (for [node (syntax/nodes (:root tree))
         :when (contains? #{:list :vector :map :set :string :fn-literal} (:kind node))
         :let [range (span document (:start node) (:end node))
               start (.-start range) end (.-end range)]
         :when (< (.-line start) (.-line end))]
     (lsp/FoldingRange (.-line start) (.-line end)
                       ** :start_character (.-character start) :end_character (.-character end)
                       :kind (.-Region lsp/FoldingRangeKind)))))

(defn- document-links [document tree]
  (python/list
   (for [node (syntax/nodes (:root tree))
         :when (contains? #{:string :comment} (:kind node))
         match (iterator-seq (re/finditer "https?://[^\\s\\\"<>]+" (:text node "")))
         :let [target (.rstrip (.group match) ".,;:!?)]}")
               start (+ (:start node) (.start match))]
         :when (seq target)]
     (lsp/DocumentLink (span document start (+ start (count target))) ** :target target))))

(defn- type-label [type]
  (cond
    (seq (:union type)) (str/join " | " (map type-label (:union type)))
    (:typevar type) (:typevar type)
    (seq (:path type)) (str (str/join "." (:path type))
                            (when (seq (:arguments type))
                              (str "[" (str/join ", " (map type-label (:arguments type))) "]"))
                            (when (:nullable? type) " | None"))
    :else nil))

(defn- inlay-hints [state uri document analysis requested-range]
  (let [settings (:inlay-hints (settings-for state uri) {})
        start (.offset_at_position document (.-start requested-range))
        end (.offset_at_position document (.-end requested-range))
        parameters? (get settings :parameter-names? true)
        types? (get settings :type-hints? true)
        inside? #(and (<= start (:start %)) (<= (:end %) end))]
    (python/list
     (concat
      (when parameters?
        (for [call (:calls analysis)
              :when (inside? call)
              :let [definition (cond-> (:definition call) (seq (:signatures call)) (assoc :overloads (:signatures call)))
                    variants (signature-variants definition)
                    args (:arguments call)
                    variants (filter #(= (count args) (count (:parameters %))) variants)
                    names (mapv #(mapv :name (:parameters %)) variants)
                    names (when (and (seq names) (apply = names)) (first names))]
              [argument name] (map vector args names)
              :let [text (subs (.-source document) (:start argument) (:end argument))]
              :when (and name (not= name text) (not (.startswith name "&"))
                         (not (.startswith name "_")) (not (str/includes? name " "))
                         (not (contains? #{"**" "self" "cls"} name)))]
          (lsp/InlayHint (client-position document (:start argument)) (str name ":")
                         ** :kind (.-Parameter lsp/InlayHintKind) :padding_right true)))
      (when types?
        (for [definition (concat (:locals analysis) (:var-definitions analysis))
              :when (inside? definition)
              :let [label (type-label (:python-type definition))]
              :when label]
          (lsp/InlayHint (client-position document (:end definition)) (str ": " label)
                         ** :kind (.-Type lsp/InlayHintKind) :padding_left false)))))))

(defn- edits-for [state uri edits]
  (when (seq edits)
    (let [document (get-in @state [:documents uri])]
      (workspace-edit state #py [(lsp/TextDocumentEdit
                                  (lsp/OptionalVersionedTextDocumentIdentifier uri (.-version document))
                                  (python/list (map (fn [[start end text]]
                                                      (lsp/TextEdit (span document start end) text)) edits)))]))))

(defn- plain-tree? [node]
  (not-any? #(contains? #{:comment :discard :reader-conditional :reader-conditional-splicing :reader-splice
                          :syntax-quote :unquote :unquote-splicing} (:kind %))
            (syntax/nodes node)))

(defn- source-of [source node] (subs source (:start node) (:end node)))
(defn- list-text [parts] (str "(" (str/join " " parts) ")"))
(defn- head-name [node] (:text (first (syntax/forms node))))
(defn- literal? [node]
  (or (contains? #{:number :string :character :keyword :nil :boolean} (:kind node))
      (and (contains? #{:vector :map :set} (:kind node)) (every? literal? (syntax/forms node)))))

(defn- unique-name [analysis base]
  (let [names (set (concat (map :name (:locals analysis)) (map :name (:var-definitions analysis)) (map :name (:var-usages analysis))
                           (keys (:refers analysis)) (keys (:imports analysis)) (keys (analyzer/core-symbols))))]
    (first (remove names (cons base (map #(str base %) (range 1 10000)))))))

(defn- thread-form [source node direction all? keep-parens?]
  (when (and (= :list (:kind node)) (> (count (syntax/forms node)) 1) (plain-tree? node)
             (not (contains? #{"ns" "def" "defn" "defn-" "defprotocol" "deftype" "defrecord" "fn" "let" "loop" "binding" "quote"} (head-name node))))
    (loop [node node steps []]
      (let [parts (vec (syntax/forms node))
            index (if (= direction :first) 1 (dec (count parts)))
            argument (nth parts index)
            remaining (concat (subvec parts 0 index) (subvec parts (inc index)))
            step (if (and (= 1 (count remaining)) (not keep-parens?)) (source-of source (first remaining))
                     (list-text (map #(source-of source %) remaining)))
            steps (cons step steps)]
        (if (and all? (= :list (:kind argument)) (> (count (syntax/forms argument)) 1))
          (recur argument steps)
          (list-text (concat [(if (= direction :first) "basilisp.core/->" "basilisp.core/->>")
                              (source-of source argument)] steps)))))))

(defn- unwind-form [source node all?]
  (let [parts (syntax/forms node) head (:text (first parts))]
    (when (and (contains? #{"->" "->>" "basilisp.core/->" "basilisp.core/->>"} head)
               (> (count parts) 2) (plain-tree? node))
      (let [first? (contains? #{"->" "basilisp.core/->"} head)
            steps (drop 2 parts)]
        (loop [expression (source-of source (second parts)) steps steps]
          (let [step (first steps)
                members (if (= :list (:kind step)) (map #(source-of source %) (syntax/forms step))
                            [(source-of source step)])
                expression (list-text (if first? (concat [(first members) expression] (rest members))
                                          (concat members [expression])))]
            (cond
              (empty? (rest steps)) expression
              all? (recur expression (rest steps))
              :else (list-text (concat [head expression] (map #(source-of source %) (rest steps)))))))))))

(defn- extract-edits [source tree analysis node name]
  (let [inside? #(and (<= (:start node) (:start %)) (<= (:end %) (:end node)))
        locals (into {} (map (juxt :id identity) (:locals analysis)))
        free (distinct (keep (fn [usage]
                               (let [definition (get locals (:id usage))]
                                 (when (and (inside? usage) definition (not (inside? definition)))
                                   (:name definition)))) (:local-usages analysis)))
        top (first (filter #(and (<= (:start %) (:start node)) (<= (:end node) (:end %)))
                           (syntax/forms (:root tree))))]
    (when (and top (plain-tree? node) (valid-name? name) (= name (unique-name analysis name))
               (not-any? #(contains? #{"recur" "set!" "yield" "await"} (:text %)) (syntax/nodes node)))
      [[(:start top) (:start top)
        (str "(" (if (get-in analysis [:settings :private-by-default-on-extract?] true)
                   (if (get-in analysis [:settings :use-metadata-for-privacy?]) "basilisp.core/defn ^:private" "basilisp.core/defn-")
                   "basilisp.core/defn") " " name " [" (str/join " " free) "]\n  " (source-of source node) ")\n\n")]
       [(:start node) (:end node) (list-text (cons name free))]])))

(defn- inline-local-edits [source tree analysis offset]
  (when-let [item (occurrence analysis offset)]
    (when-let [definition (when (:id item) (definition-of analysis item))]
      (let [binding (first (filter #(and (= :vector (:kind %))
                                         (< (:start %) (:start definition)) (< (:end definition) (:end %)))
                                   (enclosing-nodes tree (:start definition))))
            pairs (partition 2 (syntax/forms binding))
            pair (first (filter #(= (:start definition) (:start (first %))) pairs))
            initializer (second pair)
            uses (filter #(= (:id definition) (:id %)) (:local-usages analysis))]
        (when (and pair (= :symbol (:kind (first pair))) (literal? initializer)
                   (plain-tree? binding) (seq uses)
                   (or (= 1 (count uses)) (not (contains? #{:vector :map :set} (:kind initializer)))))
          (concat [[(:start (first pair)) (:end initializer) ""]]
                  (map #(vector (:start %) (:end %) (source-of source initializer)) uses)))))))

(defn- clean-apply [source edits]
  (reduce (fn [text [start end replacement]]
            (str (subs text 0 start) replacement (subs text end)))
          source (sort-by first > edits)))

(defn- clean-space? [source start end]
  (boolean (re/fullmatch "[\\s,]*" (subs source start end))))

(defn- clean-ns-node [tree]
  (first (filter #(= "ns" (head-name %)) (syntax/forms (:root tree)))))

(defn- clean-libspecs [node]
  (for [clause (syntax/forms node)
        :when (contains? #{":require" ":import" ":refer-clojure" ":refer-basilisp"} (head-name clause))
        spec (syntax/nodes clause)
        :when (and (= :vector (:kind spec)) (= :symbol (:kind (first (syntax/forms spec)))))]
    spec))

(defn- clean-unused-edits [source tree unused]
  (mapcat
   (fn [spec]
     (let [parts (vec (syntax/forms spec))]
       (mapcat
        (fn [index]
          (let [key (nth parts index) value (nth parts (inc index) nil)
                previous (nth parts (dec index))
                plain-gap? (and value (clean-space? source (:end key) (:start value)))
                start (if (clean-space? source (:end previous) (:start key)) (:end previous) (:start key))]
            (cond
              (and (= ":as" (:text key)) plain-gap?
                   (or (contains? unused (:start value))
                       (contains? unused (:start (first parts)))
                       (contains? unused (:start spec))))
              [[start (:end value) ""]]

              (and (= ":refer" (:text key)) (= :vector (:kind value)))
              (let [members (syntax/forms value)
                    removed (filter #(contains? unused (:start %)) members)
                    kept (remove #(contains? unused (:start %)) members)]
                (when (seq removed)
                  (cond
                    (and (empty? kept) plain-gap? (plain-tree? value))
                    [[start (:end value) ""]]
                    (plain-tree? value)
                    [[(:start value) (:end value) (str "[" (str/join " " (map #(source-of source %) kept)) "]")]]
                    :else (map #(vector (:start %) (:end %) "") removed))))

              :else [])))
        (range 1 (count parts) 2))))
   (clean-libspecs (clean-ns-node tree))))

(defn- clean-layout-edits [source tree settings]
  (let [style (or (get-in settings [:clean :ns-inner-blocks-indentation])
                  (when (:keep-require-at-start? settings) :same-line) :keep)]
    (when (contains? #{:same-line :next-line} style)
      (mapcat
       (fn [clause]
         (let [forms (vec (syntax/forms clause)) head (first forms)
               entries (subvec forms 1)
               column (:character (syntax/offset->position tree (:start clause)))
               same-column (inc (:character (syntax/offset->position tree (:end head))))
               indentation (apply str (repeat (if (= style :same-line) same-column (inc column)) " "))]
           (concat
            (for [index (range (count entries))
                  :let [entry (nth entries index)
                        previous (if (zero? index) head (nth entries (dec index)))
                        start (:end previous) end (:start entry)
                        text (if (and (zero? index) (= style :same-line)) " " (str "\n" indentation))]
                  :when (and (clean-space? source start end) (not= text (subs source start end)))]
              [start end text])
            (let [last-entry (last entries) close (last (:children clause))]
              (when (and last-entry (clean-space? source (:end last-entry) (:start close))
                         (< (:end last-entry) (:start close)))
                [[(:end last-entry) (:start close) ""]])))))
       (filter #(contains? #{":require" ":import"} (head-name %)) (syntax/forms (clean-ns-node tree)))))))

(defn- clean-refer-text [source tree vector settings]
  (let [options (get-in settings [:clean :sort :refer] true)
        sorted? (boolean options)
        limit (if (map? options) (:max-line-length options 80) 80)
        members (syntax/forms vector)
        members (if sorted? (sort-by #(.lower (:text %)) members) members)
        start (inc (:character (syntax/offset->position tree (:start vector))))
        indentation (apply str (repeat start " "))]
    (loop [members members column start result "[" first? true]
      (if-let [member (first members)]
        (let [text (source-of source member)
              next-column (+ column (if first? 0 1) (count text))
              wrap? (and (not first?) (number? limit) (pos? limit) (> next-column limit))]
          (recur (rest members) (if wrap? (+ start (count text)) next-column)
                 (str result (cond wrap? (str "\n" indentation) first? "" :else " ") text) false))
        (str result "]")))))

(defn- clean-refer-edits [source tree settings]
  (for [spec (clean-libspecs (clean-ns-node tree))
        [key value] (partition 2 (rest (syntax/forms spec)))
        :when (and (= ":refer" (:text key)) (= :vector (:kind value))
                   (plain-tree? value) (every? #(= :symbol (:kind %)) (syntax/forms value)))
        :let [replacement (clean-refer-text source tree value settings)]
        :when (not= replacement (source-of source value))]
    [(:start value) (:end value) replacement]))

(defn clean-namespace-edits
  "Clean aliases, refers and namespace layout using analysis :settings.
  Dependencies and their load order are retained. Comments and reader forms are
  preserved; member sorting is skipped when a refer vector contains trivia."
  [source tree analysis]
  (when-let [node (clean-ns-node tree)]
    (let [start (:start node) original (source-of source node)
          unused (set (map #(- (:start %) start)
                           (filter #(contains? #{:unused-namespace :unused-import :unused-alias :unused-referred-var} (:type %))
                                   (:findings analysis))))
          settings (:settings analysis {})
          cleaned (clean-apply original (clean-unused-edits original (syntax/parse original) unused))
          cleaned (clean-apply cleaned (clean-layout-edits cleaned (syntax/parse cleaned) settings))
          cleaned (clean-apply cleaned (clean-refer-edits cleaned (syntax/parse cleaned) settings))]
      (when (not= original cleaned) [[start (:end node) cleaned]]))))

(defn- executable-node? [tree analysis node]
  (let [ancestors (enclosing-nodes tree (:start node))
        definition? (some #(and (= (:start node) (:start %)) (= (:end node) (:end %)))
                          (concat (:locals analysis) (:var-definitions analysis)))
        binding-vectors
        (keep (fn [parent]
                (let [forms (syntax/forms parent) head (:text (first forms))]
                  (cond
                    (contains? #{"let" "loop" "binding" "with-open" "doseq" "for" "letfn" "when-let" "if-let" "when-some" "if-some"} head)
                    (second forms)
                    (contains? #{"defn" "defn-" "fn" "defmacro"} head)
                    (first (filter #(= :vector (:kind %)) (rest forms)))
                    (= :vector (:kind (first forms))) (first forms)))) ancestors)]
    (and node (not definition?)
         (not-any? #(and (<= (:start %) (:start node)) (<= (:end node) (:end %))) binding-vectors)
         (not-any? #(or (contains? #{:quote :syntax-quote :discard :metadata :var-quote} (:kind %))
                        (contains? #{"ns" "defprotocol" "deftype" "defrecord" "quote"} (head-name %))) ancestors)
         (not (and (= :list (:kind node))
                   (contains? #{"def" "defn" "defn-" "defmacro" "declare" "ns"} (head-name node)))))))

(declare core-call?)

(defn- lookup-data [analysis node]
  (let [[head target key default & more] (syntax/forms node)
        keyword? (= :keyword (:kind head))
        builtin? (and (contains? #{"get" "get-in" "basilisp.core/get" "basilisp.core/get-in"} (:text head))
                      (core-call? analysis node))
        path? (contains? #{"get-in" "basilisp.core/get-in"} (:text head))
        keys (cond keyword? [head] path? (when (= :vector (:kind key)) (syntax/forms key)) builtin? [key])
        default (if keyword? key default)]
    (when (and (= :list (:kind node)) target (seq keys) (every? literal? keys)
               (or (nil? default) (literal? default))
               (if keyword? (nil? (nth (syntax/forms node) 3 nil)) (empty? more))
               (plain-tree? node))
      {:target target :keys (vec keys) :default default :keyword? keyword?})))

(defn- lookup-proof [analysis node]
  (let [expression (first (filter #(and (= (:start node) (:start %)) (= (:end node) (:end %))) (:python-expressions analysis)))
        item (when (= :symbol (:kind node)) (occurrence analysis (:start node)))
        definition (definition-of analysis item)
        type (or (:python-type definition) (:python-type expression))]
    (cond
      (= :map (:kind node))
      {:map? true :entries (into {} (map (fn [[key value]] [(:text key) value]) (partition 2 (syntax/forms node))))}
      (= "basilisp.lang.map" (:module type))
      {:map? true :entries (into {} (map (fn [[key value]] [(str key) (:node value)]) (:map-values definition)))}
      :else
      (when-let [data (lookup-data analysis node)]
        (loop [value (:target data) keys (:keys data)]
          (if-let [key (first keys)]
            (when-let [child (get (:entries (lookup-proof analysis value)) (:text key))]
              (recur child (rest keys)))
            (lookup-proof analysis value)))))))

(defn- get-in-form [source analysis node all?]
  (when-let [data (lookup-data analysis node)]
    (when (or (not (:keyword? data)) (:map? (lookup-proof analysis (:target data))))
      (let [render (fn [target keys default]
                     (str "(basilisp.core/" (if (= 1 (count keys)) "get" "get-in") " "
                          (source-of source target) " "
                          (if (= 1 (count keys)) (source-of source (first keys))
                              (str "[" (str/join " " (map #(source-of source %) keys)) "]"))
                          (when default (str " " (source-of source default))) ")"))]
        (if (and (:keyword? data) (not all?))
          (render (:target data) (:keys data) (:default data))
          (loop [target (:target data) keys (:keys data) changed? (:keyword? data)]
            (let [inner (lookup-data analysis target)]
              (if (and inner (nil? (:default inner))
                       (or (not (:keyword? inner)) (:map? (lookup-proof analysis (:target inner)))))
                (let [keys (into (:keys inner) keys)]
                  (if all? (recur (:target inner) keys true)
                      (render (:target inner) keys (:default data))))
                (when changed? (render target keys (:default data)))))))))))

(defn- get-out-form [source analysis node all?]
  (when-let [data (lookup-data analysis node)]
    (when-not (:keyword? data)
      (let [keys (:keys data) default (:default data)
            lookup (fn [target key default proof]
                     (let [keyword? (and (= :keyword (:kind key)) (:map? proof))]
                       (str "(" (if keyword? (source-of source key) "basilisp.core/get")
                            " " target (when-not keyword? (str " " (source-of source key)))
                            (when default (str " " (source-of source default))) ")")))
            proof (lookup-proof analysis (:target data))]
        (if all?
          (first (reduce (fn [[expression proof] [index key]]
                           [(lookup expression key (when (= index (dec (count keys))) default) proof)
                            (some->> (get (:entries proof) (:text key)) (lookup-proof analysis))])
                         [(source-of source (:target data)) proof] (map-indexed vector keys)))
          (if (= 1 (count keys)) (lookup (source-of source (:target data)) (first keys) default proof)
              (str "(basilisp.core/" (if (= 2 (count keys)) "get" "get-in") " "
                   (lookup (source-of source (:target data)) (first keys) nil proof) " "
                   (if (= 2 (count keys)) (source-of source (second keys))
                       (str "[" (str/join " " (map #(source-of source %) (rest keys))) "]"))
                   (when default (str " " (source-of source default))) ")")))))))

(defn- sibling-edits [source tree node direction]
  (let [parent (first (filter #(and (< (:start %) (:start node)) (<= (:end node) (:end %)))
                              (enclosing-nodes tree (:start node))))
        forms (vec (syntax/forms parent))
        index (first (keep-indexed #(when (= (:start node) (:start %2)) %1) forms))
        pair? (= :map (:kind parent))
        index (when index (if pair? (* 2 (quot index 2)) index))
        step (if pair? 2 1) other (when index (+ index (* direction step)))]
    (when (and index other (<= 0 other) (<= (+ other step) (count forms))
               (not= :root (:kind parent)) (plain-tree? parent))
      (let [left (subvec forms index (+ index step)) right (subvec forms other (+ other step))
            text #(subs source (:start (first %)) (:end (last %)))]
        [[(:start (first left)) (:end (last left)) (text right)]
         [(:start (first right)) (:end (last right)) (text left)]]))))

(defn- paredit-edits [_source tree node command]
  (let [ancestors (enclosing-nodes tree (:start node))
        collection (first (filter #(contains? #{:list :vector :map :set} (:kind %)) ancestors))
        parent (or (first (filter #(< (:start %) (:start collection)) ancestors)) (:root tree))
        siblings (vec (syntax/forms parent))
        children (:children collection) opening (first children) closing (last children)
        forms (vec (syntax/forms collection))
        index (first (keep-indexed #(when (= (:start collection) (:start %2)) %1) siblings))
        forward? (.startswith command "forward")
        slurp? (.endswith command "slurp")
        step (if (= :map (:kind collection)) 2 1)]
    (when (and collection (= :delimiter (:kind opening)) (= :delimiter (:kind closing)))
      (if slurp?
        (when (and index (if forward? (<= (+ index step 1) (count siblings)) (>= (- index step) 0)))
          (let [target (nth siblings (if forward? (+ index step) (- index step)))]
            (if forward?
              [[(:start closing) (:end closing) ""] [(:end target) (:end target) (:text closing)]]
              [[(:start opening) (:end opening) ""] [(:start target) (:start target) (:text opening)]])))
        (when (> (count forms) step)
          (if forward?
            (let [last-kept (nth forms (- (count forms) step 1))]
              [[(:start closing) (:end closing) ""] [(:end last-kept) (:end last-kept) (:text closing)]])
            (let [first-kept (nth forms step)]
              [[(:start opening) (:end opening) ""] [(:start first-kept) (:start first-kept) (:text opening)]])))))))

(defn- keyword-cycle [analysis text]
  (cond
    (.startswith text "::")
    (let [parts (str/split (subs text 2) #"/")]
      (if (= 1 (count parts)) (str ":" (:namespace analysis) "/" (first parts))
          (when-let [ns (get-in analysis [:aliases (first parts)])]
            (str ":" ns "/" (second parts)))))
    (.startswith text ":")
    (let [parts (str/split (subs text 1) #"/") ns (first parts)]
      (when (= 2 (count parts))
        (if (= ns (:namespace analysis)) (str "::" (second parts))
            (when-let [alias (first (keep (fn [[name entry]] (when (= ns entry) name)) (:aliases analysis)))]
              (str "::" alias "/" (second parts))))))
    :else nil))

(defn- promote-literal [source node analysis name]
  (when (and (= :anonymous-function (:kind node)) (plain-tree? node))
    (let [tokens (filter #(and (= :symbol (:kind %)) (.startswith (:text %) "%")) (syntax/nodes node))
          highest (reduce max 0 (keep #(when (re/fullmatch "%[0-9]+" (:text %))
                                         (python/int (subs (:text %) 1))) tokens))
          highest (max highest (if (some #(= "%" (:text %)) tokens) 1 0))
          args (mapv #(unique-name analysis (str "arg" %)) (range 1 (inc highest)))
          rest-name (when (some #(= "%&" (:text %)) tokens) (unique-name analysis "args"))
          replacements (map (fn [token] [(:start token) (:end token)
                                         (cond (= "%&" (:text token)) rest-name
                                               (= "%" (:text token)) (first args)
                                               :else (nth args (dec (python/int (subs (:text token) 1)))))]) tokens)
          body (reduce (fn [text [start end replacement]]
                         (str (subs text 0 (- start (:start node) 1)) replacement
                              (subs text (- end (:start node) 1))))
                       (subs (source-of source node) 1) (sort-by first > replacements))]
      (str "(fn " (when name (str name " ")) "[" (str/join " " args)
           (when rest-name (str (when (seq args) " ") "& " rest-name)) "] " body ")"))))

(defn- suppress-edits [_source node code]
  (when (and node code (re/fullmatch "[A-Za-z0-9-]+" (str code)))
    [[(:start node) (:start node) (str "#_{:clj-kondo/ignore [:" code "]} ")]]))

(defn- core-call? [analysis node]
  (let [head (first (syntax/forms node)) usage (first (filter #(= (:start head) (:start %)) (:var-usages analysis)))]
    (or (= "basilisp.core" (:ns usage))
        (.startswith (:text head "") "basilisp.core/")
        (and (contains? (analyzer/core-symbols) (:text head))
             (not (contains? (:definitions analysis) (:text head)))
             (not (contains? (:refers analysis) (:text head)))
             (not (contains? (:core-excluded analysis) (:text head)))
             (not-any? #(and (= (:text head) (:name %)) (<= (:scope-start % 0) (:start node))
                             (< (:start node) (:scope-end % 0))) (:locals analysis))))))

(defn- demote-function [source analysis node]
  (let [[head bindings body & more] (syntax/forms node)
        params (syntax/forms bindings)
        definitions (filter #(some (fn [param] (= (:start param) (:start %))) params) (:locals analysis))]
    (when (and (= "fn" (:text head)) (= :vector (:kind bindings)) (= :list (:kind body))
               (empty? more) (every? #(= :symbol (:kind %)) params)
               (not-any? #(= "&" (:text %)) params)
               (= (count params) (count definitions))
               (or (empty? params) (some #(and (= (:id (last definitions)) (:id %))
                                               (<= (:start body) (:start %)) (< (:end %) (:end body))) (:local-usages analysis)))
               (plain-tree? node)
               (not-any? #(or (= :anonymous-function (:kind %))
                              (and (= :symbol (:kind %)) (.startswith (:text %) "%")))
                         (syntax/nodes body)))
      (let [names (into {} (map-indexed (fn [index param] [(:start param) (str "%" (inc index))]) params))
            by-id (into {} (map (fn [definition] [(:id definition) (get names (:start definition))]) definitions))
            uses (filter #(contains? by-id (:id %)) (:local-usages analysis))
            body-text (reduce (fn [text use]
                                (str (subs text 0 (- (:start use) (:start body))) (get by-id (:id use))
                                     (subs text (- (:end use) (:start body)))))
                              (source-of source body) (sort-by :start > uses))]
        (str "#" body-text)))))

(defn- add-libspec [_source tree clause lib alias refer]
  (let [ns-node (first (filter #(= "ns" (head-name %)) (syntax/forms (:root tree))))
        existing (first (filter #(= clause (head-name %)) (syntax/forms ns-node)))
        valid-lib? (and (string? lib) (re/fullmatch "[A-Za-z_][A-Za-z0-9_.-]*" lib))
        spec (str "[" lib (when alias (str " :as " alias)) (when refer (str " :refer [" refer "]")) "]")]
    (when (and ns-node valid-lib? (or (nil? alias) (valid-name? alias))
               (or (nil? refer) (valid-name? refer))
               (not-any? #(= lib (:text %)) (syntax/nodes existing)))
      (let [offset (dec (:end (or existing ns-node)))]
        [[offset offset (if existing (str " " spec) (str "\n  (" clause " " spec ")"))]]))))

(defn- move-inside? [outer inner]
  (and (some? (:start outer)) (some? (:end outer))
       (some? (:start inner)) (some? (:end inner))
       (<= (:start outer) (:start inner)) (<= (:end inner) (:end outer))))

(defn- move-apply [source edits]
  (let [ordered (vec (sort-by first (distinct edits)))]
    (when (and (every? (fn [[start end _]] (<= 0 start end (count source))) ordered)
               (every? (fn [[left right]] (<= (second left) (first right)))
                       (partition 2 1 ordered)))
      (reduce (fn [text [start end value]] (str (subs text 0 start) value (subs text end)))
              source (reverse ordered)))))

(defn- move-envelope [source form]
  (let [line-start (inc (.rfind source "\n" 0 (:start form)))
        start (loop [start line-start]
                (if (pos? start)
                  (let [previous (inc (.rfind source "\n" 0 (dec start)))
                        text (str/trim (subs source previous (dec start)))]
                    (if (and (.startswith text ";") (not (.startswith text "#!")))
                      (recur previous) start))
                  start))
        line-end (.find source "\n" (:end form))
        line-end (if (neg? line-end) (count source) line-end)
        suffix (str/trim (subs source (:end form) line-end))
        end (if (or (empty? suffix) (.startswith suffix ";"))
              (min (count source) (inc line-end)) (:end form))]
    {:start (if (str/blank? (subs source line-start (:start form))) start (:start form))
     :end end}))

(defn- move-qualified [analysis namespace name]
  (when (and (or (not (contains? (:aliases analysis) namespace))
                 (= namespace (get (:aliases analysis) namespace)))
             (not (contains? (:imports analysis) namespace)))
    (str namespace "/" name)))

(defn- move-refer-removals [analysis tree namespace name]
  (vec
   (mapcat
    (fn [[_ referred]]
      (when (and (= namespace (:ns referred)) (= name (:name referred)) (not (:all referred)))
        (let [node (or (:refer-node referred) (:node referred))
              renamed (:rename-node referred)
              rename-pair (when renamed
                            (some (fn [candidate]
                                    (when (= :map (:kind candidate))
                                      (some (fn [[key value]]
                                              (when (= (:start renamed) (:start value))
                                                [(:start key) (:end value) ""]))
                                            (partition 2 (syntax/forms candidate)))))
                                  (syntax/nodes (:root tree))))]
          (cond-> [] node (conj [(:start node) (:end node) ""])
                  rename-pair (conj rename-pair)))))
    (:refers analysis))))

(defn- move-reachable? [graph start target]
  (loop [pending [start] seen #{}]
    (if-let [node (peek pending)]
      (cond (= node target) true
            (contains? seen node) (recur (pop pending) seen)
            :else (recur (into (pop pending) (get graph node)) (conj seen node)))
      false)))

(defn- move-attribute-maps [form]
  (when (contains? #{"defn" "defn-" "basilisp.core/defn" "basilisp.core/defn-"} (head-name form))
    (filter #(= :map (:kind %))
            (take-while #(contains? #{:string :map} (:kind %)) (drop 2 (syntax/forms form))))))

(defn- move-type-hints [form]
  (let [nodes (vec (syntax/nodes form))
        quoted (filter #(or (contains? #{:quote :discard} (:kind %))
                            (and (= :list (:kind %))
                                 (contains? #{"quote" "basilisp.core/quote"} (head-name %)))) nodes)
        hints (reduce (fn [out node]
                        (if (= :metadata (:kind node))
                          (let [metadata (first (syntax/forms node))]
                            (cond
                              (contains? #{:symbol :string} (:kind metadata)) (conj out metadata)
                              (= :map (:kind metadata))
                              (into out (keep (fn [[key value]] (when (= ":tag" (syntax/text key)) value))
                                              (partition 2 (syntax/forms metadata))))
                              :else out))
                          out))
                      (vec (keep (fn [[key value]] (when (= ":tag" (syntax/text key)) value))
                                 (mapcat #(partition 2 (syntax/forms %)) (move-attribute-maps form))))
                      nodes)]
    (filterv (fn [hint] (not-any? #(move-inside? % hint) quoted)) hints)))

(defn- move-python-reference [analysis text]
  (let [parts (.partition text "/") prefix (first parts) member (last parts)]
    (if (= "/" (second parts))
      (cond (= "python" prefix) {:module "builtins" :path (str/split member #"\.")}
            (get-in analysis [:imports prefix :name])
            {:module (get-in analysis [:imports prefix :name]) :path (str/split member #"\.")}
            :else nil)
      (cond (get-in analysis [:imports text :name])
            {:module (get-in analysis [:imports text :name]) :path []}
            (get-in analysis [:python-refers text])
            {:module (get-in analysis [:python-refers text :name])
             :path [(get-in analysis [:python-refers text :member])]}
            :else nil))))

(defn- move-import-prefix [analysis module]
  (or (first (sort (keep (fn [[alias entry]] (when (= module (:name entry)) alias))
                         (:imports analysis))))
      (when-not (or (contains? (:imports analysis) module)
                    (contains? (:aliases analysis) module)
                    (contains? (:definitions analysis) module)
                    (contains? (:refers analysis) module)
                    (contains? (:python-refers analysis) module))
        module)))

(defn- move-decorated? [form]
  (let [metadata (keep #(when (= :metadata (:kind %)) (first (syntax/forms %)))
                       (syntax/nodes form))
        attr-maps (move-attribute-maps form)]
    (some (fn [node]
            (and (= :map (:kind node))
                 (some #(= ":decorators" (syntax/text (first %)))
                       (partition 2 (syntax/forms node)))))
          (concat metadata attr-maps))))

(defn- move-literal? [node]
  (cond
    (contains? #{:nil :boolean :string :bytes :number :character :keyword :symbolic-number :regex} (:kind node)) true
    (= :quote (:kind node)) true
    (contains? #{:vector :map :set :namespaced-map} (:kind node)) (every? move-literal? (syntax/forms node))
    (= :metadata (:kind node)) (move-literal? (last (syntax/forms node)))
    :else false))

(defn- move-constant? [form definition]
  (and (contains? #{"def" "basilisp.core/def"} (head-name form))
       (not (:dynamic definition))
       (<= 3 (count (syntax/forms form)))
       (move-literal? (last (syntax/forms form)))))

(defn- move-scope-sensitive-python? [use]
  (let [module (:python-module use) path (:python-path use)]
    (or (and (= "builtins" module)
             (contains? #{"eval" "exec" "globals" "locals" "vars"} (first path)))
        (and (= "inspect" module)
             (contains? #{"currentframe" "stack" "trace"} (first path)))
        (and (= "sys" module)
             (contains? #{"_getframe" "_getframemodulename"} (first path))))))

(defn move-form-edits
  "Move a resolved public function to an existing workspace namespace.
  Returns offset edits by document, or nil when a move cannot preserve bindings."
  [documents analyses uri offset target-uri]
  (let [source (get documents uri) target-source (get documents target-uri)
        analysis (get analyses uri) target-analysis (get analyses target-uri)
        source-ns (:namespace analysis) target-ns (:namespace target-analysis)
        tree (when source (syntax/parse source))
        target-tree (when target-source (syntax/parse target-source))
        form (first (filter #(and (<= (:start %) offset) (< offset (:end %)))
                            (syntax/forms (:root tree))))
        head (first (syntax/forms form))
        definitions (filter #(move-inside? form %) (:var-definitions analysis))
        definition (first definitions)
        name (:name definition)
        target-ns-form (first (filter #(= "ns" (head-name %)) (syntax/forms (:root target-tree))))
        source-ns-form (first (filter #(= "ns" (head-name %)) (syntax/forms (:root tree))))
        uses (filterv #(move-inside? form %) (:var-usages analysis))
        python-uses (filter #(move-inside? form %) (:python-usages analysis))
        target-forms (syntax/forms (:root target-tree))
        target-consumers (filter #(and (= source-ns (:ns %)) (= name (:name %))
                                       (not (move-inside? target-ns-form %))) (:var-usages target-analysis))
        target-dependencies (keep #(when (= target-ns (:ns %))
                                     (get-in target-analysis [:definitions (:name %)])) uses)
        target-before (or (first (sort (keep (fn [use]
                                               (some #(when (move-inside? % use) (:start %)) target-forms))
                                             target-consumers))) (count (or target-source "")))
        target-after (reduce max (or (:end (when (and target-source target-ns-form)
                                             (move-envelope target-source target-ns-form))) 0)
                             (keep (fn [definition]
                                     (some #(when (move-inside? % definition)
                                              (:end (move-envelope target-source %))) target-forms))
                                   target-dependencies))
        unsupported? (or (some move-scope-sensitive-python? python-uses)
                         (some #(contains? #{:syntax-quote :reader-conditional :reader-splice :tagged} (:kind %))
                               (syntax/nodes form))
                         (some #(and (move-inside? form %)
                                     (contains? #{:syntax :unresolved-symbol :unresolved-namespace} (:type %)))
                               (:findings analysis))
                         (some #(or (and (get-in % [:definition :macro])
                                         (not= "basilisp.core" (:ns %)))
                                    (and (get-in % [:definition :private]) (not= name (:name %)))
                                    (and (= "basilisp.core" (:ns %))
                                         (contains? #{"eval" "resolve" "ns-resolve" "load-string" "load-file" "in-ns"} (:name %))))
                               uses)
                         (move-decorated? form))]
    (when (and source target-source (not= uri target-uri) source-ns target-ns (not= source-ns target-ns)
               source-ns-form target-ns-form (empty? (:diagnostics tree)) (empty? (:diagnostics target-tree))
               (or (contains? #{"defn" "defn-" "basilisp.core/defn" "basilisp.core/defn-"} (head-name form))
                   (move-constant? form definition))
               (or (core-call? analysis form) (= "def" (head-name form))) (= 1 (count definitions)) (not (:private definition))
               (not (contains? (:definitions target-analysis) name))
               (not (contains? (:refers target-analysis) name))
               (not (contains? (:imports target-analysis) name))
               (not (contains? (:python-refers target-analysis) name))
               (or (not (contains? (analyzer/core-symbols) name))
                   (contains? (:core-excluded target-analysis) name))
               (<= target-after target-before) (not unsupported?))
      (let [envelope (move-envelope source form)
            start (:start envelope) end (:end envelope)
            requirements (atom {})
            import-requirements (atom {})
            local-names (set (map :name (filter #(move-inside? form %) (:locals analysis))))
            edits (atom {})
            safe? (atom true)
            require! (fn [file namespace]
                       (when (and (not= "basilisp.core" namespace)
                                  (not= namespace (:namespace (get analyses file))))
                         (swap! requirements update file (fnil conj #{}) namespace)))
            qualify (fn [file namespace var-name]
                      (if-let [text (move-qualified (get analyses file) namespace var-name)]
                        (do (require! file namespace) text)
                        (do (reset! safe? false) "")))
            import! (fn [file module]
                      (when-not (or (= "builtins" module)
                                    (some #(= module (:name %)) (vals (:imports (get analyses file)))))
                        (swap! import-requirements update file (fnil conj #{}) module)))
            python-qualify (fn [module member-path]
                             (if (= "builtins" module)
                               (when (seq member-path) (str "python/" (str/join "." member-path)))
                               (if-let [prefix (move-import-prefix target-analysis module)]
                                 (if (and (empty? member-path) (contains? local-names prefix))
                                   (do (reset! safe? false) "")
                                   (do (import! target-uri module)
                                       (str prefix (when (seq member-path) (str "/" (str/join "." member-path))))))
                                 (do (reset! safe? false) ""))))
            hint-edits
            (vec
             (keep (fn [node]
                     (let [text (syntax/text node)
                           imported (when (= :symbol (:kind node)) (move-python-reference analysis text))
                           parts (.partition text "/") prefix (first parts) member (last parts)
                           referred (get-in analysis [:refers text])
                           definition (get-in analysis [:definitions text])
                           replacement
                           (cond
                             imported (python-qualify (:module imported) (:path imported))
                             (= :keyword (:kind node)) text
                             (and (= :symbol (:kind node)) (= "/" (second parts))
                                  (or (get-in analysis [:aliases prefix]) (= prefix source-ns)
                                      (some #(= prefix (:name %)) (:namespace-usages analysis))))
                             (qualify target-uri (get (:aliases analysis) prefix prefix) member)
                             (and (= :symbol (:kind node)) (or referred definition))
                             (if (or (:private definition) (get-in referred [:definition :private]))
                               (do (reset! safe? false) "")
                               (qualify target-uri (if referred (:ns referred) source-ns)
                                        (if referred (:name referred) text)))
                             ;; Unknown forward references can change meaning after a move.
                             :else (do (reset! safe? false) ""))]
                       (when (not= text replacement)
                         [(- (:start node) start) (- (:end node) start) replacement])))
                   (move-type-hints form)))
            body-edits (vec
                        (concat
                         [[(- (:start head) start) (- (:end head) start)
                           (if (move-constant? form definition) "def" "basilisp.core/defn")]]
                         (for [use uses :when (and (not= (:start head) (:start use)) (:ns use))]
                           [(- (:start use) start) (- (:end use) start)
                            (qualify target-uri (if (and (= source-ns (:ns use)) (= name (:name use))) target-ns (:ns use))
                                     (:name use))])
                         hint-edits
                         (for [use python-uses
                               :let [text (subs source (:start use) (:end use))
                                     imported (move-python-reference analysis text)]
                               :when imported]
                           [(- (:start use) start) (- (:end use) start)
                            (python-qualify (:module imported) (:path imported))])
                         (for [node (syntax/nodes form)
                               :when (= :namespaced-map (:kind node))
                               :let [prefix (first (:children node)) text (syntax/text prefix)]
                               :when (.startswith text "#::")
                               :let [alias (subs text 3)
                                     namespace (if (empty? alias) source-ns (get (:aliases analysis) alias))]]
                           (do (when-not namespace (reset! safe? false))
                               [(- (:start prefix) start) (- (:end prefix) start) (str "#:" namespace)]))
                         (for [node (syntax/nodes form)
                               :when (and (= :keyword (:kind node)) (.startswith (:text node "") "::"))
                               :let [raw (subs (:text node) 2)
                                     parts (.partition raw "/")
                                     alias (first parts)
                                     namespace (if (= "/" (second parts)) (get (:aliases analysis) alias) source-ns)
                                     local-name (if (= "/" (second parts)) (last parts) raw)]]
                           (do (when-not namespace (reset! safe? false))
                               [(- (:start node) start) (- (:end node) start) (str ":" namespace "/" local-name)]))))
            moved (move-apply (subs source start end) body-edits)]
        (when-not moved (reset! safe? false))
        (swap! edits assoc uri [[start end ""]])
        (swap! edits update target-uri (fnil conj [])
               [target-after target-after
                (str (when (and (pos? target-after) (not= "\n" (subs target-source (dec target-after) target-after))) "\n")
                     "\n" (.rstrip (or moved "") "\r\n") "\n")])
        (doseq [[file candidate] analyses
                :let [text (get documents file)]
                :when text]
          (let [candidate-tree (if (= file uri) tree (if (= file target-uri) target-tree (syntax/parse text)))
                ns-node (first (filter #(= "ns" (head-name %)) (syntax/forms (:root candidate-tree))))
                consumers (filter #(and (= source-ns (:ns %)) (= name (:name %))
                                        (not (and (= file uri) (move-inside? envelope %)))
                                        (not (move-inside? ns-node %)))
                                  (:var-usages candidate))]
            (doseq [use consumers]
              (swap! edits update file (fnil conj [])
                     [(:start use) (:end use) (qualify file target-ns name)]))
            (let [removals (move-refer-removals candidate candidate-tree source-ns name)]
              (when (seq removals)
                (swap! edits update file (fnil into []) removals)))))
        (let [graph (into {} (for [[_ candidate] analyses]
                               [(:namespace candidate)
                                (set (map :name (remove :python (:namespace-usages candidate))))]))
              graph (atom graph)]
          (doseq [[file namespaces] @requirements namespace (sort namespaces)
                  :let [from (:namespace (get analyses file))]
                  :when (not (contains? (get @graph from) namespace))]
            (if (move-reachable? @graph namespace from)
              (reset! safe? false)
              (swap! graph update from (fnil conj #{}) namespace))))
        (when @safe?
          (let [staged (into {} (for [[file changes] @edits]
                                  [file (move-apply (get documents file) changes)]))]
            (when (every? some? (vals staged))
              (let [updated (reduce
                             (fn [sources [file clause namespace]]
                               (let [text (get sources file (get documents file))
                                     additions (add-libspec text (syntax/parse text) clause namespace nil nil)]
                                 (assoc sources file (if (seq additions) (move-apply text additions) text))))
                             staged
                             (concat
                              (for [[file namespaces] @requirements namespace (sort namespaces)]
                                [file ":require" namespace])
                              (for [[file namespaces] @import-requirements namespace (sort namespaces)]
                                [file ":import" namespace])))]
                (when (every? #(and % (empty? (:diagnostics (syntax/parse %)))) (vals updated))
                  (into {} (for [[file text] updated :when (not= text (get documents file))]
                             [file [[0 (count (get documents file)) text]]])))))))))))

(defn- comment-form [tree offset]
  (first (filter #(contains? #{"comment" "basilisp.core/comment"} (head-name %)) (enclosing-nodes tree offset))))

(defn- contextual-libspec [source tree _analysis offset clause lib alias refer settings]
  (let [comment (comment-form tree offset)
        mode (setting-keyword (get-in settings [:add-missing :add-to-rcf] :ask))]
    (if (and comment (= :always mode))
      (let [head (first (syntax/forms comment))
            spec (str "[" lib (when alias (str " :as " alias)) (when refer (str " :refer [" refer "]")) "]")
            text (if (= ":import" clause) (str "(basilisp.core/import " spec ")")
                     (str "(basilisp.core/require '" spec ")"))]
        (when (and (re/fullmatch "[A-Za-z_][A-Za-z0-9_.-]*" lib)
                   (or (nil? alias) (valid-name? alias)) (or (nil? refer) (valid-name? refer)))
          [[(:end head) (:end head) (str "\n  " text "\n")]]))
      (add-libspec source tree clause lib alias refer))))

(defasync ^:private choose-libspec-settings [ls state uri offset]
  (let [settings (settings-for state uri)
        source (.-source (get-in @state [:documents uri]))
        comment (comment-form (syntax/parse source) offset)
        mode (setting-keyword (get-in settings [:add-missing :add-to-rcf] :ask))]
    (if (and comment (= :ask mode))
      (when-let [choice (await (.window_show_message_request_async ls
                                                                   (lsp/ShowMessageRequestParams (.-Info lsp/MessageType) "Where should this dependency be added?"
                                                                                                 ** :actions #py [(lsp/MessageActionItem "Comment form") (lsp/MessageActionItem "Namespace")])))]
        (assoc-in settings [:add-missing :add-to-rcf] (if (= "Comment form" (.-title choice)) :always :never)))
      settings)))

(defn- namespace-refactor-layout [source analysis command edits]
  (if (and (seq edits) (get-in analysis [:settings :clean :automatically-after-ns-refactor] true)
           (contains? #{"add-missing-import" "add-import-to-namespace" "add-require-suggestion" "add-missing-libspec"
                        "refer-to-as" "as-to-refer" "replace-refer-all-with-refer" "replace-refer-all-with-alias"
                        "swap-namespace-with-alias"} command))
    (let [edited (clean-apply source edits)
          cleaned (clean-apply edited (clean-namespace-edits edited (syntax/parse edited) (assoc analysis :findings [])))]
      (if (= edited cleaned) edits [[0 (count source) cleaned]]))
    edits))

(defn- parameter-edits [documents analyses uri offset direction]
  (let [source (get documents uri) analysis (get analyses uri)
        tree (syntax/parse source)
        node (first (enclosing-nodes tree offset))
        definition (first (filter #(and (<= (:scope-start % (:start %)) offset)
                                        (< offset (:scope-end % (:end %)))) (:var-definitions analysis)))
        form (first (filter #(= (:scope-start definition) (:start %)) (syntax/forms (:root tree))))
        params (first (filter #(= :vector (:kind %)) (syntax/forms form)))
        members (vec (syntax/forms params))
        index (first (keep-indexed #(when (= (:start node) (:start %2)) %1) members))
        target (when index (+ index direction))
        identity (identity-of definition)
        calls (vec (for [[uri analysis] analyses call (:calls analysis)
                         :when (= identity (identity-of (:definition call)))] [uri call]))
        usages (for [[uri analysis] analyses use (:var-usages analysis)
                     :when (= identity (identity-of use))] [uri use])
        direct-usages? (every? (fn [[uri use]]
                                 (some (fn [[call-uri call]]
                                         (and (= uri call-uri) (= (:start use) (:start (:name-range call))))) calls)) usages)
        independent? (not-any? (fn [[uri outer]]
                                 (some (fn [[other-uri inner]]
                                         (and (= uri other-uri) (< (:start outer) (:start inner))
                                              (<= (:end inner) (:end outer)))) calls)) calls)
        preserved-calls? (every? (fn [[uri call]]
                                   (let [tree (syntax/parse (get documents uri))
                                         node (first (filter #(and (= (:start call) (:start %)) (= (:end call) (:end %)))
                                                             (syntax/nodes (:root tree))))
                                         head (first (syntax/forms node))]
                                     (and node (plain-tree? node)
                                          (= (:start head) (:start (:name-range call)))
                                          (= (:end head) (:end (:name-range call)))))) calls)]
    ;; Calls through unknown higher-order uses cannot be rewritten reliably.
    ;; Replacements must also be disjoint and retain all original reader trivia.
    (when (and definition (not (:macro definition)) (not (:dynamic definition)) index target
               (<= 0 target) (< target (count members))
               (every? #(and (= :symbol (:kind %)) (not= "&" (:text %))) members)
               (= 1 (count (:arglists definition))) (plain-tree? params)
               direct-usages? independent? preserved-calls?
               (every? #(= (count members) (count (:arguments (second %)))) calls))
      (let [permutation (assoc (vec (range (count members))) index target target index)
            declaration-edits [[(:start (nth members index)) (:end (nth members index)) (:text (nth members target))]
                               [(:start (nth members target)) (:end (nth members target)) (:text (nth members index))]]
            call-edits
            (for [[uri call] calls
                  :let [source (get documents uri) analysis (get analyses uri)
                        args (:arguments call) head (:name-range call)
                        callee (unique-name analysis "blt-callee")
                        reserved (update analysis :locals conj {:name callee})
                        [_ names] (reduce (fn [[analysis names] index]
                                            (let [name (unique-name analysis (str "blt-arg" index))]
                                              [(update analysis :locals conj {:name name}) (conj names name)]))
                                          [reserved []] (range (count args)))
                        bindings (concat [callee (source-of source head)]
                                         (mapcat (fn [name argument] [name (source-of source argument)]) names args))
                        replacement (str "(basilisp.core/let [" (str/join " " bindings) "] "
                                         (list-text (cons callee (map #(nth names %) permutation))) ")")]]
              [uri [(:start call) (:end call) replacement]])]
        (merge-with into {uri declaration-edits}
                    (into {} (map (fn [[uri entries]] [uri (mapv second entries)]) (group-by first call-edits))))))))

(defn- inline-function-edits [source analysis offset]
  (when-let [call (call-at analysis offset)]
    (let [definition (:definition call)
          ;; A same-position definition in another source file is not this body.
          declaration (first (filter #(= (identity-of definition) (identity-of %)) (:var-definitions analysis)))
          tree (syntax/parse source)
          form (first (filter #(= (:scope-start declaration) (:start %)) (syntax/forms (:root tree))))
          call-node (first (filter #(and (= (:start call) (:start %)) (= (:end call) (:end %))) (syntax/nodes (:root tree))))
          forms (syntax/forms form)
          params (first (filter #(= :vector (:kind %)) forms))
          body (rest (drop-while #(not= params %) forms))
          parameters (syntax/forms params)
          arguments (:arguments call)
          body-start (:start (first body)) body-end (:end (last body))]
      (when (and declaration form (contains? #{"defn" "defn-"} (head-name form))
                 (not (:macro definition)) (not (:dynamic definition))
                 (= 1 (count (:arglists definition)))
                 (= (count parameters) (count arguments)) (seq body)
                 (plain-tree? call-node)
                 (= (:start (first (syntax/forms call-node))) (:start (:name-range call)))
                 (not= :map (:kind (first body)))
                 (every? #(and (= :symbol (:kind %)) (not= "&" (:text %))) parameters)
                 (not-any? #(contains? #{"recur" "await" "yield" "set!"} (:text %)) (mapcat syntax/nodes body)))
        (let [[_ names] (reduce (fn [[analysis names] index]
                                  (let [name (unique-name analysis (str "blt-inline" index))]
                                    [(update analysis :locals conj {:name name}) (conj names name)]))
                                [analysis []] (range (count arguments)))
              globals (filter #(and (<= body-start (:start %)) (<= (:end %) body-end) (:ns %))
                              (:var-usages analysis))
              body-text (reduce (fn [text use]
                                  (str (subs text 0 (- (:start use) body-start))
                                       (:ns use) "/" (:name use)
                                       (subs text (- (:end use) body-start))))
                                (subs source body-start body-end) (sort-by :start > globals))
              initial (mapcat (fn [name arg] [name (source-of source arg)]) names arguments)
              bound (mapcat (fn [param name] [(:text param) name]) parameters names)]
          [[(:start call) (:end call)
            (str "(basilisp.core/let [" (str/join " " initial) "] "
                 "(basilisp.core/let [" (str/join " " bound) "] " body-text "))")]])))))

(defn- require-spec [tree analysis offset]
  (let [item (occurrence analysis offset)
        target (:ns (or (:definition item) item))
        ns-form (first (filter #(= "ns" (head-name %)) (syntax/forms (:root tree))))
        specs (mapcat #(rest (syntax/forms %)) (filter #(= ":require" (head-name %)) (syntax/forms ns-form)))]
    (or (first (filter #(and (<= (:start %) offset) (< offset (:end %))) specs))
        (first (filter #(= target (:text (first (syntax/forms %)))) specs)))))

(defn- refer-alias-edits [source tree analysis offset command args]
  (when-let [spec (require-spec tree analysis offset)]
    (let [forms (vec (syntax/forms spec)) lib (:text (first forms))
          pairs (partition 2 (rest forms))
          options (into {} (map (fn [[key value]] [(:text key) value]) pairs))
          old-alias (:text (get options ":as"))
          alias (or old-alias (second args) (last (str/split lib #"\.")))
          refer (get options ":refer")
          usages (filter #(= lib (:ns (or (:definition %) %))) (:var-usages analysis))
          to-refer? (contains? #{"as-to-refer" "replace-refer-all-with-refer"} command)
          targets (if to-refer?
                    (if (= "replace-refer-all-with-refer" command) usages
                        (filter #(.startswith (source-of source %) (str old-alias "/")) usages))
                    (filter #(not (str/includes? (source-of source %) "/")) usages))
          names (sort (distinct (concat (map :name targets)
                                        (when (= :vector (:kind refer)) (map :text (syntax/forms refer))))))
          keep-alias? (some #(and (= :keyword (:kind %)) (.startswith (:text %) (str "::" old-alias "/")))
                            (syntax/nodes (:root tree)))
          collision? (some (fn [use]
                             (or (contains? (:definitions analysis) (:name use))
                                 (some #(and (= (:name use) (:name %))
                                             (<= (:scope-start % 0) (:start use))
                                             (< (:start use) (:scope-end % 0))) (:locals analysis))
                                 (let [entry (get (:refers analysis) (:name use))]
                                   (and entry (not= lib (:ns entry))))))
                           targets)
          alias-valid? (and (valid-name? alias)
                            (or (nil? (get (:aliases analysis) alias)) (= lib (get (:aliases analysis) alias))))
          preserve (for [[key value] pairs :when (not (contains? #{":refer" ":as"} (:text key)))]
                     (str (source-of source key) " " (source-of source value)))
          spec-text (str "[" lib
                         (when (or (not to-refer?) keep-alias?) (str " :as " alias))
                         (when (and to-refer? (seq names)) (str " :refer [" (str/join " " names) "]"))
                         (when (seq preserve) (str " " (str/join " " preserve))) "]")]
      (when (and (= :vector (:kind spec)) lib (plain-tree? spec) (not (get options ":rename"))
                 (if to-refer? (not collision?) alias-valid?)
                 (or to-refer? refer)
                 (or (not= ":all" (:text refer))
                     (not-any? #(= "clj-kondo/unknown-namespace" (:ns %)) (:var-usages analysis)))
                 (or (not= "as-to-refer" command) old-alias))
        (into [[(:start spec) (:end spec) spec-text]]
              (map (fn [use] [(:start use) (:end use) (if to-refer? (:name use) (str alias "/" (:name use)))])
                   targets))))))

(defn- swap-alias-edits [source tree analysis offset args]
  (let [[target alias] args
        node (first (enclosing-nodes tree offset))
        spec (require-spec tree analysis offset)
        forms (syntax/forms spec)
        old (get (:aliases analysis) alias)]
    (when (and target (valid-name? alias) (= :symbol (:kind node))
               (or (nil? old) (= old target)) (.startswith (:text node) (str target "/")))
      (let [replacement (str alias (subs (:text node) (count target)))
            alias-node (some (fn [[key value]] (when (= ":as" (:text key)) value)) (partition 2 (rest forms)))]
        (when (or (nil? alias-node) (= alias (:text alias-node)))
          (concat [[(:start node) (:end node) replacement]]
                  (if spec
                    (when-not alias-node
                      [[(dec (:end spec)) (dec (:end spec)) (str " :as " alias)]])
                    (add-libspec source tree ":require" target alias nil))))))))

(defn- literal-binding [tree binding]
  (some (fn [node]
          (let [forms (syntax/forms node) vector (second forms)]
            (when (and (contains? #{"let" "basilisp.core/let"} (head-name node)) (= :vector (:kind vector)))
              (some (fn [[name value]] (when (= (:start binding) (:start name)) [node name value]))
                    (partition 2 (syntax/forms vector))))))
        (syntax/nodes (:root tree))))

(defn- destructure-edits [_source tree analysis offset]
  (let [item (occurrence analysis offset) definition (definition-of analysis item)
        binding (first (filter #(= (:start definition) (:start %)) (syntax/nodes (:root tree))))
        [_ _ initial] (literal-binding tree binding)
        uses (filter #(= (:id definition) (:id %)) (:local-usages analysis))
        lookups (keep (fn [use]
                        (let [call (first (filter #(= :list (:kind %)) (enclosing-nodes tree (:start use))))
                              [head target key default & more] (syntax/forms call)
                              entry (cond
                                      (and (= :keyword (:kind head)) (= (:start target) (:start use))
                                           (nil? key)) [call head]
                                      (and (contains? #{"get" "basilisp.core/get"} (:text head))
                                           (core-call? analysis call) (= (:start target) (:start use))
                                           (= :keyword (:kind key)) (nil? default) (empty? more)) [call key])]
                          (when (plain-tree? call) entry))) uses)
        entries (into {} (map (fn [[_ key]] [(:text key) (unique-name analysis (last (str/split (subs (:text key) 1) #"/")))]) lookups))
        names (vals entries)]
    (when (and definition (:id definition) (= :symbol (:kind binding)) (= :map (:kind initial))
               (literal? initial) (seq lookups) (= (count names) (count (set names)))
               (every? valid-name? names))
      (into [[(:start binding) (:end binding)
              (str "{" (str/join " " (mapcat (fn [[key name]] [name key]) (sort-by key entries)))
                   " :as " (:name definition) "}")]]
            (map (fn [[call key]] [(:start call) (:end call) (get entries (:text key))]) lookups)))))

(defn- restructure-edits [source tree analysis offset]
  (let [binding (first (filter #(= :map (:kind %)) (enclosing-nodes tree offset)))
        [_ _ initial] (literal-binding tree binding)
        pairs (partition 2 (syntax/forms binding))
        options (into {} (map (fn [[key value]] [(:text key) value]) pairs))
        as-node (get options ":as")
        name (or (:text as-node) (unique-name analysis "element"))
        defaults (into {} (map (fn [[key value]] [(:text key) value]) (partition 2 (syntax/forms (get options ":or")))))
        entries (mapcat (fn [[key value]]
                          (case (:text key)
                            ":keys" (map (fn [node] [node (str ":" (:text node))]) (syntax/forms value))
                            ":strs" (map (fn [node] [node (pr-str (:text node))]) (syntax/forms value))
                            ":syms" (map (fn [node] [node (str "'" (:text node))]) (syntax/forms value))
                            ":as" [] ":or" []
                            (when (and (= :symbol (:kind key)) (literal? value)) [[key (source-of source value)]]))) pairs)
        by-id (into {} (for [[node key] entries definition (:locals analysis)
                             :when (= (:start node) (:start definition))]
                         [(:id definition) [(:name definition) key]]))]
    (when (and binding (plain-tree? binding) (= :map (:kind initial)) (literal? initial) (seq entries)
               (every? #(and (= :symbol (:kind (first %))) (valid-name? (:text (first %)))) entries)
               (every? literal? (vals defaults))
               (= (count entries) (count by-id)))
      (into [[(:start binding) (:end binding) name]]
            (for [use (:local-usages analysis) :let [[local key] (get by-id (:id use))] :when key]
              [(:start use) (:end use)
               (str "(basilisp.core/get " name " " key
                    (when-let [default (get defaults local)] (str " " (source-of source default))) ")")])))))

(defn- move-binding-edits [source tree analysis node command name]
  (let [parents (rest (enclosing-nodes tree (:start node)))
        wanted (if (= command "move-to-for-let") #{"for" "doseq"} #{"let" "basilisp.core/let"})
        parent (first (filter #(contains? wanted (head-name %)) parents))
        [_ bindings body] (syntax/forms parent)
        direct? (= (:start node) (:start body))]
    (when (and parent (= :vector (:kind bindings)) (valid-name? name)
               (= name (unique-name analysis name)) (plain-tree? parent)
               (or (literal? node) direct?))
      [[(dec (:end bindings)) (dec (:end bindings))
        (str (when (seq (syntax/forms bindings)) " ")
             (if (= command "move-to-for-let")
               (str ":let [" name " " (source-of source node) "]")
               (str name " " (source-of source node))))]
       [(:start node) (:end node) name]])))

(defn- expand-let-edits [source tree _analysis offset]
  (let [ancestors (enclosing-nodes tree offset)
        inner (first (filter #(contains? #{"let" "basilisp.core/let"} (head-name %)) ancestors))
        parent (first (filter #(< (:start %) (:start inner 0)) ancestors))
        [_ bindings & body] (syntax/forms inner)
        [_ outer-bindings & outer-body] (syntax/forms parent)]
    ;; Joining an immediately nested body preserves binding and body evaluation.
    (when (and inner parent (contains? #{"let" "basilisp.core/let"} (head-name parent))
               (= 1 (count outer-body)) (= inner (first outer-body))
               (= :vector (:kind bindings)) (= :vector (:kind outer-bindings))
               (plain-tree? inner) (plain-tree? parent))
      [[(:start parent) (:end parent)
        (str "(basilisp.core/let ["
             (str/join " " (map #(source-of source %) (concat (syntax/forms outer-bindings) (syntax/forms bindings))))
             "] " (str/join " " (map #(source-of source %) body)) ")")]])))

(defn- sort-clause-edits [source collection]
  (when (and collection (plain-tree? collection)
             (contains? #{:map :set :vector} (:kind collection))
             (every? literal? (syntax/forms collection)))
    (let [groups (if (= :map (:kind collection)) (partition 2 (syntax/forms collection))
                     (map vector (syntax/forms collection)))
          sorted (sort-by #(source-of source (first %)) groups)
          children (:children collection)
          opening (first children) closing (last children)]
      [[(:end opening) (:start closing) (str/join " " (mapcat #(map (partial source-of source) %) sorted))]])))

(defn- cycle-map-edits [_source tree analysis offset]
  (let [ancestors (enclosing-nodes tree offset)
        wrapper (first (filter #(= :namespaced-map (:kind %)) ancestors))
        map-node (or (first (filter #(= :map (:kind %)) (syntax/nodes wrapper)))
                     (first (filter #(= :map (:kind %)) ancestors)))
        pairs (partition 2 (syntax/forms map-node))
        keys (map first pairs)
        prefix (:text (first (:children wrapper)))
        qualifier (when wrapper
                    (if (.startswith prefix "#::")
                      (let [alias (subs prefix 3)] (if (empty? alias) (:namespace analysis) (get (:aliases analysis) alias)))
                      (subs prefix 2)))
        qualifiers (keep #(let [parts (str/split (subs (:text %) 1) #"/")]
                            (when (= 2 (count parts)) (first parts))) keys)
        chosen (when-not wrapper (first (sort-by (fn [name] [(- (count (filter #{name} qualifiers))) name]) (distinct qualifiers))))
        qualifier (or qualifier chosen)
        replacements (for [key keys
                           :let [text (:text key)
                                 parts (str/split (subs text 1) #"/")
                                 old (when (= 2 (count parts)) (first parts))
                                 name (last parts)
                                 replacement (if wrapper
                                               (cond (= "_" old) (str ":" name) old text :else (str ":" qualifier "/" name))
                                               (cond (= qualifier old) (str ":" name) old text :else (str ":_/" name)))]]
                       [(:start key) (:end key) replacement])]
    (when (and map-node qualifier (seq keys) (plain-tree? map-node)
               (every? #(and (= :keyword (:kind %)) (not (.startswith (:text %) "::"))) keys))
      (concat replacements
              (if wrapper [[(:start wrapper) (:start map-node) ""]]
                  [[(:start map-node) (:start map-node) (str "#:" qualifier)]])))))

(defn- create-function-edits [_source tree analysis node]
  (let [call (first (filter #(= :list (:kind %)) (enclosing-nodes tree (:start node))))
        [head & arguments] (syntax/forms call)
        name (:text head)
        item (occurrence analysis (:start head))
        top (first (filter #(and (<= (:start %) (:start call)) (<= (:end call) (:end %))) (syntax/forms (:root tree))))
        names (map-indexed (fn [index _] (str "arg" (inc index))) arguments)]
    (when (and top (= :symbol (:kind head)) (valid-name? name)
               (nil? (definition-of analysis item)) (not (contains? (analyzer/core-symbols) name))
               (not (contains? (:definitions analysis) name)) (plain-tree? call))
      [[(:start top) (:start top)
        (str "(basilisp.core/defn- " name " [" (str/join " " names) "]\n"
             "  (throw (python/NotImplementedError \"Implement " name "\")))\n\n")]])))

(defn- extraction-selection [source tree offset end]
  (let [nodes (filter #(and (<= offset (:start %)) (<= (:end %) end)
                            (not (contains? #{:delimiter :prefix :whitespace :newline :comment :root} (:kind %))))
                      (syntax/nodes (:root tree)))
        exact (first (filter #(and (str/blank? (subs source offset (:start %)))
                                   (str/blank? (subs source (:end %) end))) nodes))]
    (or exact
        (some (fn [parent]
                (let [forms (vec (syntax/forms parent))
                      head (head-name parent)
                      params (first (filter #(= :vector (:kind %)) forms))
                      body (cond
                             (= "do" head) (rest forms)
                             (contains? #{"fn" "defn" "defn-" "let" "loop" "basilisp.core/let"} head)
                             (rest (drop-while #(not= params %) forms)))
                      selected (vec (filter #(and (<= offset (:start %)) (<= (:end %) end)) body))]
                  (when (and (> (count selected) 1)
                             (str/blank? (subs source offset (:start (first selected))))
                             (str/blank? (subs source (:end (last selected)) end)))
                    {:kind :selection :start (:start (first selected)) :end (:end (last selected)) :children selected})))
              (enclosing-nodes tree offset)))))

(defn refactor-edits
  "Compute source edits [start end replacement] without changing a document.
  Commands that move evaluation only accept expressions whose safety is known."
  [source analysis command offset args]
  (let [tree (syntax/parse source)
        ancestors (enclosing-nodes tree offset)
        node (if (and (= "extract-function" command) (:selection-end analysis))
               (extraction-selection source tree offset (:selection-end analysis)) (first ancestors))
        collection (first (filter #(contains? #{:list :vector :map :set} (:kind %)) ancestors))
        call (first (filter #(= :list (:kind %)) ancestors))
        parts (vec (syntax/forms call))
        text #(source-of source %)
        replace-node (fn [node replacement] (when replacement [[(:start node) (:end node) replacement]]))
        simple? (and call (plain-tree? call))
        executable? (executable-node? tree analysis node)
        name (or (first args) (unique-name analysis "new-binding"))]
    (when (empty? (:diagnostics tree))
      (case command
        "thread-first" (replace-node call (thread-form source call :first false (get-in analysis [:settings :keep-parens-when-threading?] false)))
        "thread-first-all" (replace-node call (thread-form source call :first true (get-in analysis [:settings :keep-parens-when-threading?] false)))
        "thread-last" (replace-node call (thread-form source call :last false (get-in analysis [:settings :keep-parens-when-threading?] false)))
        "thread-last-all" (replace-node call (thread-form source call :last true (get-in analysis [:settings :keep-parens-when-threading?] false)))
        "unwind-thread" (when (core-call? analysis call) (replace-node call (unwind-form source call false)))
        "unwind-all" (when (core-call? analysis call) (replace-node call (unwind-form source call true)))
        "introduce-let" (when (and executable? (valid-name? name) (= name (unique-name analysis name)))
                          (replace-node node (str "(basilisp.core/let [" name " " (text node) "] " name ")")))
        "extract-function" (when executable? (extract-edits source tree analysis node
                                                            (or (first args) (unique-name analysis "new-function"))))
        "extract-to-def" (when (and executable? (literal? node)
                                    (not (contains? #{:vector :map :set} (:kind node))) (valid-name? name)
                                    (= name (unique-name analysis name)))
                           (let [top (first (filter #(and (<= (:start %) (:start node))
                                                          (<= (:end node) (:end %))) (syntax/forms (:root tree))))]
                             [[(:start top) (:start top) (str "(def ^:private " name " " (text node) ")\n\n")]
                              [(:start node) (:end node) name]]))
        "inline-symbol" (inline-local-edits source tree analysis offset)
        "inline-function" (inline-function-edits source analysis offset)
        "clean-ns" (clean-namespace-edits source tree analysis)
        "refer-to-as" (refer-alias-edits source tree analysis offset command args)
        "as-to-refer" (refer-alias-edits source tree analysis offset command args)
        "replace-refer-all-with-refer" (refer-alias-edits source tree analysis offset command args)
        "replace-refer-all-with-alias" (refer-alias-edits source tree analysis offset command args)
        "swap-namespace-with-alias" (swap-alias-edits source tree analysis offset args)
        "destructure-keys" (destructure-edits source tree analysis offset)
        "restructure-keys" (restructure-edits source tree analysis offset)
        "move-to-let" (when executable? (move-binding-edits source tree analysis node command name))
        "move-to-for-let" (when executable? (move-binding-edits source tree analysis node command name))
        "expand-let" (expand-let-edits source tree analysis offset)
        "sort-clauses" (sort-clause-edits source collection)
        "cycle-namespaced-map" (cycle-map-edits source tree analysis offset)
        "create-function" (create-function-edits source tree analysis node)
        "cycle-coll" (when collection
                       (refactor-edits source analysis "change-coll" offset
                                       [(case (:kind collection) :map "vector" :vector "set" :set "list" :list "map")]))
        "change-coll" (when (and collection (plain-tree? collection))
                        (let [target (str (first args))
                              delimiters (get {"list" ["(" ")"] "vector" ["[" "]"] "map" ["{" "}"] "set" ["#{" "}"]} target)
                              children (syntax/forms collection)]
                          (when (and delimiters (or (not= "map" target) (even? (count children))))
                            (replace-node collection (str (first delimiters) (str/join " " (map text children)) (second delimiters))))))
        "if->cond-refactor" (when (and simple? (contains? #{"if" "basilisp.core/if"} (head-name call))
                                       (<= 3 (count parts) 4))
                              (replace-node call (str "(basilisp.core/cond " (text (nth parts 1)) " " (text (nth parts 2))
                                                      (when (= 4 (count parts)) (str " :else " (text (nth parts 3)))) ")")))
        "cond->if-refactor" (when (and simple? (core-call? analysis call) (= "cond" (head-name call))
                                       (or (= 3 (count parts)) (and (= 5 (count parts)) (= ":else" (:text (nth parts 3))))))
                              (replace-node call (str "(if " (text (nth parts 1)) " " (text (nth parts 2))
                                                      (when (= 5 (count parts)) (str " " (text (nth parts 4)))) ")")))
        "cycle-privacy" (let [definition (first (filter #(contains? #{"defn" "defn-"} (head-name %)) ancestors))
                              head (first (syntax/forms definition))]
                          (when head (replace-node head (if (= "defn" (:text head)) "defn-" "defn"))))
        "raise-sexp" (when (and node (second ancestors))
                       (replace-node (second ancestors) (text node)))
        "kill-sexp" (when node (replace-node node ""))
        "get-in-more" (replace-node call (get-in-form source analysis call false))
        "get-in-all" (replace-node call (get-in-form source analysis call true))
        "get-in-less" (replace-node call (get-out-form source analysis call false))
        "get-in-none" (replace-node call (get-out-form source analysis call true))
        "drag-forward" (when node (sibling-edits source tree node 1))
        "drag-backward" (when node (sibling-edits source tree node -1))
        "move-coll-entry-up" (when node (sibling-edits source tree node -1))
        "move-coll-entry-down" (when node (sibling-edits source tree node 1))
        "forward-slurp" (when node (paredit-edits source tree node command))
        "forward-barf" (when node (paredit-edits source tree node command))
        "backward-slurp" (when node (paredit-edits source tree node command))
        "backward-barf" (when node (paredit-edits source tree node command))
        "cycle-keyword-auto-resolve" (when (= :keyword (:kind node)) (replace-node node (keyword-cycle analysis (text node))))
        "demote-fn" (let [node (first (filter #(= "fn" (head-name %)) ancestors))]
                      (replace-node node (demote-function source analysis node)))
        "add-missing-import" (contextual-libspec source tree analysis offset ":import" (first args) (second args) nil (:settings analysis))
        "add-import-to-namespace" (contextual-libspec source tree analysis offset ":import" (first args) (second args) nil (:settings analysis))
        "add-require-suggestion" (contextual-libspec source tree analysis offset ":require" (first args) (second args) (nth args 2 nil) (:settings analysis))
        "promote-fn" (let [literal (first (filter #(= :anonymous-function (:kind %)) ancestors))]
                       (replace-node literal (promote-literal source literal analysis (first args))))
        "suppress-diagnostic" (suppress-edits source node (first args))
        "sort-map" (when (and collection (= :map (:kind collection)) (plain-tree? collection)
                              (every? literal? (syntax/forms collection)))
                     (let [pairs (partition 2 (syntax/forms collection))]
                       (replace-node collection
                                     (str "{" (str/join " " (mapcat #(map text %) (sort-by #(text (first %)) pairs))) "}"))))
        nil))))

(def ^:private refactor-commands
  ["thread-first" "thread-first-all" "thread-last" "thread-last-all" "unwind-thread" "unwind-all"
   "introduce-let" "extract-function" "extract-to-def" "inline-symbol" "inline-function" "clean-ns"
   "cycle-coll" "change-coll" "if->cond-refactor" "cond->if-refactor" "cycle-privacy"
   "raise-sexp" "kill-sexp" "sort-map" "get-in-more" "get-in-all" "get-in-less" "get-in-none"
   "drag-forward" "drag-backward" "move-coll-entry-up" "move-coll-entry-down"
   "forward-slurp" "forward-barf" "backward-slurp" "backward-barf"
   "cycle-keyword-auto-resolve" "promote-fn" "demote-fn" "suppress-diagnostic"
   "add-missing-import" "add-import-to-namespace" "add-require-suggestion"
   "refer-to-as" "as-to-refer" "replace-refer-all-with-refer" "replace-refer-all-with-alias"
   "swap-namespace-with-alias" "destructure-keys" "restructure-keys" "move-to-let" "move-to-for-let" "expand-let" "sort-clauses" "cycle-namespaced-map" "create-function"])

(defn- refactor-actions [state uri document analysis requested-range context]
  (let [offset (.offset_at_position document (.-start requested-range))
        only (.-only context)
        allowed? (fn [kind] (or (empty? only) (some #(or (= % kind) (.startswith kind (str % "."))) only)))]
    (python/list
     (keep (fn [[command title kind]]
             (when (allowed? kind)
               (when-let [edits (seq (refactor-edits (.-source document) (assoc analysis :settings (settings-for state uri)) command offset []))]
                 (lsp/CodeAction title ** :kind kind :edit (edits-for state uri edits)))))
           [["thread-first-all" "Thread first" "refactor.rewrite"]
            ["thread-last-all" "Thread last" "refactor.rewrite"]
            ["unwind-all" "Unwind threading" "refactor.rewrite"]
            ["introduce-let" "Introduce let binding" "refactor.extract"]
            ["extract-function" "Extract function" "refactor.extract"]
            ["inline-symbol" "Inline binding" "refactor.inline"]
            ["if->cond-refactor" "Convert if to cond" "refactor.rewrite"]
            ["cond->if-refactor" "Convert cond to if" "refactor.rewrite"]
            ["clean-ns" "Clean namespace" "source.organizeImports"]]))))

(defn- namespace-edits [documents analyses old-name new-name]
  (into {}
        (keep (fn [[filename source]]
                (let [analysis (get analyses filename)
                      namespace-tokens (filter #(and (not (:python %)) (= old-name (:name %)))
                                               (concat (:namespace-definitions analysis) (:namespace-usages analysis)))
                      qualified (filter #(and (= old-name (:ns %))
                                              (.startswith (subs source (:start %) (:end %)) (str old-name "/")))
                                        (:var-usages analysis))
                      edits (distinct (concat (map #(vector (:start %) (:end %) new-name) namespace-tokens)
                                              (map #(vector (:start %) (+ (:start %) (count old-name)) new-name) qualified)))]
                  (when (seq edits) [filename (vec edits)]))) documents)))

(defn- path-namespace [state filename]
  (let [uri (.as_uri (.absolute (pathlib/Path filename)))
        root (root-for state uri)
        settings (settings-for state uri)
        path (pathlib/Path filename)]
    (when (and root (contains? source-suffixes (.-suffix path)))
      (when-let [source (first (sort-by #(- (count %))
                                        (filter #(.is_relative_to path (pathlib/Path %)) (source-paths root settings))))]
        (-> (str (.with_suffix (.relative_to path source) ""))
            (str/replace "/" ".") (str/replace "\\" ".") (str/replace "_" "-"))))))

(defasync ^:private rename-files-edit [state params]
  (let [analyses (await (all-analyses! state))
        documents (into {} (map (fn [[uri document]] [uri (.-source document)]) (:documents @state)))
        changes (atom {})]
    (doseq [file (.-files params)
            :let [old (file-path (.-old_uri file)) new (file-path (.-new_uri file))]
            :when (and old new)
            [uri analysis] analyses
            :let [path (file-path uri)]
            :when (and path (or (= path old) (.is_relative_to path old)))
            :let [target (if (= path old) new (.joinpath new (.relative_to path old)))
                  old-name (:namespace analysis) new-name (path-namespace state (str target))]
            :when (and old-name new-name (not= old-name new-name))]
      (when (some #(= new-name (:namespace %)) (vals analyses))
        (failure (str "Namespace already exists: " new-name)))
      (let [scoped (into {} (filter (fn [[candidate _]] (= (root-for state uri) (root-for state candidate))) analyses))]
        (swap! changes #(merge-with into % (namespace-edits (select-keys documents (keys scoped)) scoped old-name new-name)))))
    (when (seq @changes)
      (workspace-edit state
                      (python/list
                       (for [[uri edits] @changes :let [document (get-in @state [:documents uri])]]
                         (lsp/TextDocumentEdit
                          (lsp/OptionalVersionedTextDocumentIdentifier uri (.-version document))
                          (python/list (map (fn [[start end text]] (lsp/TextEdit (span document start end) text)) (distinct edits))))))))))

(defn- dependency-documents [documents options]
  (let [paths (distinct (concat (:python-paths options) (py/environment-paths options)))
        locate (fn [ns]
                 (let [relative (str/replace (str/replace ns "." "/") "-" "_")]
                   (first (for [directory paths suffix [(str relative ".lpy") (str relative ".cljc")
                                                        (str relative "/__init__.lpy") (str relative "/__init__.cljc")]
                                :let [path (.joinpath (pathlib/Path directory) suffix)]
                                :when (.is_file path)] path))))]
    (loop [remaining (vec (vals documents)) seen (set (keys documents)) documents documents]
      (if-let [source (first remaining)]
        (let [tree (syntax/parse source)
              ns-form (first (filter #(= "ns" (head-name %)) (syntax/forms (:root tree))))
              requires (filter #(contains? #{":require" ":require-macros"} (head-name %)) (syntax/forms ns-form))
              names (keep (fn [spec]
                            (cond (= :symbol (:kind spec)) (:text spec)
                                  (= :vector (:kind spec)) (:text (first (syntax/forms spec)))))
                          (mapcat #(rest (syntax/forms %)) requires))
              added (into {} (keep (fn [ns]
                                     (when-let [path (locate ns)]
                                       (let [filename (str (.absolute path))]
                                         (when-not (contains? seen filename)
                                           (try [filename (.read_text path ** :encoding "utf-8")]
                                                (catch python/OSError _ nil)
                                                (catch python/UnicodeError _ nil)))))) names))]
          (recur (into (subvec remaining 1) (vals added)) (into seen (keys added)) (merge documents added)))
        documents))))

(defn- project-match? [pattern value full?]
  (when (and pattern value)
    (try (boolean ((if full? regex/fullmatch regex/search) (if (keyword? pattern) (setting-text pattern) pattern) (str value)))
         (catch python/Exception _ false))))

(defn- project-config [settings ns-name filename]
  (check/merge-configs
   (cons settings
         (keep #(get (:config-in-ns settings) %)
               (cons (symbol ns-name)
                     (keep (fn [{:keys [name pattern filename-pattern]}]
                             (when (or (project-match? pattern ns-name false)
                                       (project-match? filename-pattern filename false))
                               name))
                           (:ns-groups settings)))))))

(defn- project-literal [node]
  (when node
    (try (:value (check/read-config (str "{:value " (syntax/text node) "}")
                                    "source metadata" {:allow-regex? true}))
         (catch python/Exception _ nil))))

(defn- project-metadata [node]
  (when (= :metadata (:kind node))
    (let [[value target] (syntax/forms node) decoded (project-literal value)]
      (merge (project-metadata target)
             (cond (keyword? decoded) {decoded true}
                   (map? decoded) decoded
                   :else {})))))

(defn- project-head [node]
  (some-> node syntax/forms first syntax/text))

(defn- project-within? [outer inner]
  (and (number? (:start outer)) (number? (:start inner))
       (<= (:start outer) (:start inner)) (<= (:end inner) (:end outer))))

(defn- project-ignored-ranges [root]
  (vec
   (reduce
    (fn [out parent]
      (let [children (remove #(or (syntax/trivia? %) (#{:delimiter :prefix} (:kind %)))
                             (:children parent))]
        (into out (keep (fn [[node target]]
                          (when (= :discard (:kind node))
                            (let [value (project-literal (first (syntax/forms node)))
                                  ignored (if (#{:clojure-lsp/ignore :clj-kondo/ignore} value)
                                            true
                                            (when (map? value)
                                              (or (:clojure-lsp/ignore value) (:clj-kondo/ignore value))))]
                              (when ignored (assoc (select-keys target [:start :end]) :ignore ignored)))))
                        (partition 2 1 children)))))
    [] (syntax/nodes root))))

(defn- project-suppressed? [ranges finding]
  (some (fn [{:keys [ignore] :as range}]
          (and (project-within? range finding)
               (or (true? ignore) (some #{(:type finding)} ignore))))
        ranges))

(defn- project-context [source analysis]
  (let [parsed (or (:parsed analysis) (syntax/parse source))
        nodes (vec (syntax/nodes (:root parsed)))
        lists (filterv #(= :list (:kind %)) nodes)]
    {:nodes nodes :lists lists
     :comments (filterv #(contains? #{"comment" "basilisp.core/comment" "clojure.core/comment"}
                                    (project-head %)) lists)
     :ignored (project-ignored-ranges (:root parsed))
     :forms-by-start (into {} (map (juxt :start identity) lists))}))

(defn- project-definition [ctx analysis definition]
  (let [node (get (:forms-by-start ctx) (:scope-start definition))
        xs (syntax/forms node)
        head (syntax/text (first xs))
        usage (first (filter #(= (:start (first xs)) (:start %)) (:var-usages analysis)))
        defined-by (or (:defined-by definition)
                       (when (:ns usage) (symbol (:ns usage) (:name usage)))
                       (when (seq head)
                         (if (not= -1 (.find head "/"))
                           (let [parts (str/split head #"/")]
                             (if (= 2 (count parts))
                               (symbol (get (:aliases analysis) (first parts) (first parts)) (second parts))
                               (symbol "basilisp.core" head)))
                           (symbol "basilisp.core" head))))
        metadata (merge (project-metadata (second xs))
                        (some #(when (= :map (:kind %)) (project-literal %)) (take 2 (drop 2 xs)))
                        (:meta definition))]
    (assoc definition :defined-by defined-by :meta metadata
           :export (or (:export definition) (:export metadata))
           :inside-comment? (boolean (some #(project-within? % definition) (:comments ctx)))
           :protocol-name (or (:protocol-name definition)
                              (some #(when (and (contains? #{"defprotocol" "definterface" "basilisp.core/defprotocol"}
                                                           (project-head %))
                                                (project-within? % node)
                                                (not= (:start %) (:start node))) true)
                                    (:lists ctx))))))

(defn- project-finding [location type level message]
  (merge (select-keys location [:start :end :row :col :end-row :end-col])
         {:type type :level level :message message}))

(defn- project-test-file? [settings filename]
  (some #(project-match? % filename false)
        (get settings :test-locations-regex #{"_test\\.clj[a-z]?$" "_test\\.lpy$"})))

(defn- project-unused-excluded? [settings definition]
  (let [options (get-in settings [:linters :clojure-lsp/unused-public-var])
        ns-name (str (:ns definition)) var-name (str (:name definition))
        fq-name (str ns-name "/" var-name)
        defined-by (str (:defined-by definition))
        defaults #{"clojure.test/deftest" "cljs.test/deftest" "basilisp.test/deftest"
                   "state-flow.cljtest/defflow" "potemkin/import-vars"}
        excluded (set (map setting-text (:exclude options)))
        excluded-definers (into defaults (map setting-text (:exclude-when-defined-by options)))]
    (or (:private definition) (:export definition) (:inside-comment? definition)
        (:protocol-name definition) (= "-main" var-name)
        (some excluded [ns-name var-name fq-name])
        (contains? excluded-definers defined-by)
        (some #(project-match? % fq-name true) (:exclude-regex options))
        (some #(project-match? % defined-by true) (:exclude-when-defined-by-regex options))
        (some #(get (:meta definition) %) (:exclude-when-contains-meta options)))))

(defn- project-unused [_documents analyses contexts settings]
  (let [usages (reduce (fn [out [filename analysis]]
                         (reduce (fn [out usage]
                                   (update out [(str (or (:ns usage) (:to usage)))
                                                (str (:name usage))]
                                           (fnil conj []) (assoc usage :file filename)))
                                 out (concat (:var-usages analysis) (:symbols analysis))))
                       {} analyses)]
    (reduce
     (fn [out [filename analysis]]
       (let [local-settings (project-config settings (:namespace analysis "user") filename)
             options (get-in local-settings [:linters :clojure-lsp/unused-public-var])
             level (:level options :info)
             ctx (get contexts filename)]
         (if (= :off level) out
             (reduce
              (fn [out definition]
                (let [definition (project-definition ctx analysis definition)
                      eligible (get usages [(str (:ns definition)) (str (:name definition))])
                      used? (some (fn [usage]
                                    (and
                                     (not (and (= filename (:file usage))
                                               (<= (:scope-start definition -1) (:start usage -2))
                                               (<= (:end usage -2) (:scope-end definition -1))))
                                     (or (not (:ignore-test-references? options))
                                         (project-test-file? local-settings filename)
                                         (not (project-test-file? local-settings (:file usage))))))
                                  eligible)]
                  (if (or used? (project-unused-excluded? local-settings definition)) out
                      (update out filename (fnil conj [])
                              (assoc (project-finding definition :clojure-lsp/unused-public-var level
                                                      (str "Unused public var '" (:ns definition) "/" (:name definition) "'"))
                                     :tags [1])))))
              out (:var-definitions analysis)))))
     {} analyses)))

(defn- project-unused-keywords [analyses settings]
  (let [used (reduce (fn [out [_ analysis]]
                       (reduce (fn [out entry]
                                 (if (:reg entry) out
                                     (conj out [(str (:ns entry)) (str (:name entry))])))
                               out (:keywords analysis)))
                     #{} analyses)]
    (reduce
     (fn [out [filename analysis]]
       (let [local-settings (project-config settings (:namespace analysis "user") filename)
             level (get-in local-settings [:linters :clojure-lsp/unused-public-var :level] :info)]
         (if (= :off level) out
             (reduce (fn [out entry]
                       (let [entry (assoc entry :defined-by (:reg entry))
                             signature [(str (:ns entry)) (str (:name entry))]]
                         (if (or (not (:reg entry)) (contains? used signature)
                                 (project-unused-excluded? local-settings entry))
                           out
                           (update out filename (fnil conj [])
                                   (assoc (project-finding entry :clojure-lsp/unused-public-var level
                                                           (str "Unused public keyword ':"
                                                                (when (:ns entry) (str (:ns entry) "/"))
                                                                (:name entry) "'")) :tags [1])))))
                     out (:keywords analysis)))))
     {} analyses)))

(defn- project-dependencies [analyses contexts]
  (into {}
        (for [[filename analysis] analyses
              :let [ctx (get contexts filename)
                    usages (remove :python (:namespace-usages analysis))]]
          [filename
           (vec
            (for [usage usages
                  :let [spec (first (filter #(and (= :vector (:kind %))
                                                  (project-within? % usage)) (:nodes ctx)))
                        xs (syntax/forms spec)
                        alias-pair (first (filter #(#{":as" ":as-alias"} (syntax/text (first %)))
                                                  (partition 2 (rest xs))))
                        alias-node (second alias-pair)
                        alias-only? (= ":as-alias" (syntax/text (first alias-pair)))]]
              (assoc usage :file filename :from (:namespace analysis)
                     :alias (or (:alias usage) (when alias-node (syntax/text alias-node)))
                     :alias-location alias-node
                     :load? (not (or alias-only?
                                     (some #(project-within? % usage) (:comments ctx)))))))])))

(defn- project-aliases [dependencies settings]
  (let [options (get-in settings [:linters :clojure-lsp/different-aliases])
        level (:level options :off)
        excluded (set (map setting-text (:exclude-aliases options)))]
    (if (= :off level) {}
        (let [entries (filter #(and (:alias %) (not (contains? excluded (str (:alias %)))))
                              (reduce into [] (vals dependencies)))
              aliases (reduce #(update %1 (str (:name %2)) (fnil conj #{}) (str (:alias %2))) {} entries)]
          (reduce (fn [out entry]
                    (let [names (get aliases (str (:name entry)))]
                      (if (< 1 (count names))
                        (update out (:file entry) (fnil conj [])
                                (project-finding (or (:alias-location entry) entry)
                                                 :clojure-lsp/different-aliases level
                                                 (str "Different aliases #{" (str/join " " (sort names))
                                                      "} found for " (:name entry))))
                        out))) {} entries)))))

(defn- project-graph [analyses dependencies]
  (reduce (fn [out [filename analysis]]
            (update out (:namespace analysis) (fnil into #{})
                    (map (comp str :name) (filter :load? (get dependencies filename)))))
          {} analyses))

(defn- project-cycles [graph]
  ;; Iterative DFS avoids Python's recursion limit on large workspaces.
  (let [colors (atom {}) cycles (atom #{})]
    (doseq [start (sort (keys graph))]
      (when-not (get @colors start)
        (loop [stack [[start false]] path []]
          (when-let [[node exiting?] (peek stack)]
            (cond
              exiting? (do (swap! colors assoc node :black)
                           (recur (pop stack) (pop path)))
              (= :gray (get @colors node))
              (let [index (first (keep-indexed #(when (= node %2) %1) path))]
                (when index (swap! cycles conj (conj (subvec path index) node)))
                (recur (pop stack) path))
              (= :black (get @colors node)) (recur (pop stack) path)
              :else
              (do (swap! colors assoc node :gray)
                  (recur (into (conj (pop stack) [node true])
                               (map #(vector % false) (reverse (sort (filter #(contains? graph %) (get graph node))))))
                         (conj path node))))))))
    (vec (sort @cycles))))

(defn- project-cycle-findings [analyses graph settings]
  (let [options (get-in settings [:linters :clojure-lsp/cyclic-dependencies])
        level (:level options :off)
        excludes (:exclude-namespaces options)]
    (if (= :off level) {}
        (reduce (fn [out cycle]
                  (reduce (fn [out [filename analysis]]
                            (let [ns-name (:namespace analysis)]
                              (if (and (some #{ns-name} cycle)
                                       (not (some #(or (= (setting-text %) ns-name)
                                                       (project-match? % ns-name false)) excludes)))
                                (update out filename (fnil conj [])
                                        (project-finding (first (:namespace-definitions analysis))
                                                         :clojure-lsp/cyclic-dependencies level
                                                         (str "Cyclic dependency detected: " (str/join " -> " cycle))))
                                out))) out analyses))
                {} (project-cycles graph)))))

(defn- project-depend-config [settings root]
  (let [file (when root (.joinpath (pathlib/Path root) ".clj-depend" "config.edn"))
        source (when (and file (.is_file file)) (.read_text file ** :encoding "utf-8"))
        options (:clj-depend settings)
        inline (if (contains? options :config) (:config options)
                   (when options (dissoc options :project-root :files :namespaces :snapshot?)))]
    (when (or source inline)
      (merge {:source-paths (or (not-empty (:source-paths settings)) #{"src"}) :layers {} :rules []}
             (when source (check/read-config source (str file)))
             inline))))

(defn- project-depend-layer [config graph ns-name]
  (some (fn [[layer options]]
          (when (and (or (not (:only-ns-in-source-paths options)) (contains? graph ns-name))
                     (or (some #(= ns-name (str %)) (:namespaces options))
                         (project-match? (:defined-by options) ns-name false)))
            layer)) (:layers config)))

(defn- project-source-file? [config root filename]
  (or (nil? root)
      (some (fn [source]
              (try
                (let [file (pathlib/Path (str/replace filename #"^file://" ""))
                      base (.joinpath (pathlib/Path root) (str source))]
                  (.is_relative_to (.resolve file) (.resolve base)))
                (catch python/Exception _ false)))
            (:source-paths config))))

(defn- project-depend-findings [analyses graph settings root]
  (let [level (get-in settings [:linters :clj-depend :level] :info)
        config (when-not (= :off level) (project-depend-config settings root))
        snapshot-file (when root (.joinpath (pathlib/Path root) ".clj-depend" "snapshot.edn"))
        snapshot (when (and config snapshot-file (.is_file snapshot-file))
                   (:violations (check/read-config (.read_text snapshot-file ** :encoding "utf-8") (str snapshot-file))))
        source-namespaces (set (keep (fn [[filename analysis]]
                                       (when (project-source-file? config root filename) (:namespace analysis))) analyses))
        source-graph (select-keys graph source-namespaces)]
    (if-not config {}
            (reduce
             (fn [out [filename analysis]]
               (let [ns-name (:namespace analysis) location (first (:namespace-definitions analysis))]
                 (if-not (contains? source-namespaces ns-name) out
                         (reduce
                          (fn [out dependency]
                            (let [layer (project-depend-layer config source-graph ns-name)
                                  target-layer (project-depend-layer config source-graph dependency)
                                  from-options (get-in config [:layers layer])
                                  target-options (get-in config [:layers target-layer])
                                  forbidden? (and layer target-layer (not= ns-name dependency)
                                                  (if (= layer target-layer)
                                                    (false? (:access-peer-ns from-options true))
                                                    (or (and (contains? from-options :accesses-layers)
                                                             (not (contains? (set (:accesses-layers from-options)) target-layer)))
                                                        (and (contains? target-options :accessed-by-layers)
                                                             (not (contains? (set (:accessed-by-layers target-options)) layer))))))
                                  circular? (contains? (get graph dependency #{}) ns-name)
                                  rules (filter (fn [rule]
                                                  (and (or (and (empty? (:namespaces rule)) (nil? (:defined-by rule)))
                                                           (some #(= ns-name (str %)) (:namespaces rule))
                                                           (project-match? (:defined-by rule) ns-name false))
                                                       (some #(if (symbol? %) (= (str %) dependency)
                                                                  (project-match? % dependency false)) (:should-not-depend-on rule))))
                                                (:rules config))
                                  layer-message (when forbidden?
                                                  (str "\"" ns-name "\" should not depend on \"" dependency "\" (layer \"" layer "\" on \"" target-layer "\")"))
                                  circular-message (when circular? (str "Circular dependency between \"" ns-name "\" and \"" dependency "\""))
                                  violations (concat (when layer-message [{:layer layer :dependency-layer target-layer :message layer-message}])
                                                     (when circular-message [{:message circular-message}])
                                                     (map #(hash-map :message (or (:message %) (str "\"" ns-name "\" should not depend on \"" dependency "\""))) rules))]
                              (reduce (fn [out violation]
                                        (let [identity (merge {:namespace (symbol ns-name) :dependency-namespace (symbol dependency)}
                                                              (select-keys violation [:layer :dependency-layer]))]
                                          (if (some #(= identity (select-keys % [:namespace :dependency-namespace :layer :dependency-layer])) snapshot)
                                            out
                                            (update out filename (fnil conj [])
                                                    (project-finding location :clj-depend level (:message violation))))))
                                      out violations)))
                          out (sort (get graph ns-name))))))
             {} analyses))))

(defn project-findings
  "Compute cross-document LSP findings from source strings and analyzer results.
  root resolves optional .clj-depend/config.edn and snapshot.edn; no project code runs."
  [documents analyses settings root]
  (let [contexts (into {} (map (fn [[filename analysis]]
                                 [filename (project-context (get documents filename "") analysis)]) analyses))
        dependencies (project-dependencies analyses contexts)
        graph (project-graph analyses dependencies)
        findings (merge-with into
                             (project-unused documents analyses contexts settings)
                             (project-unused-keywords analyses settings)
                             (project-aliases dependencies settings)
                             (project-cycle-findings analyses graph settings)
                             (project-depend-findings analyses graph settings root))]
    (into {} (for [[filename _] analyses]
               [filename (vec (remove #(project-suppressed? (get-in contexts [filename :ignored]) %)
                                      (get findings filename [])))]))))

(defn workspace-analysis
  "Analyze a {filename source} snapshot using the same project index as the server."
  [documents options]
  (let [mode (setting-keyword (if (map? (:analysis options)) (get-in options [:analysis :type]) (:analysis options)))
        documents (if (= mode :project-and-full-dependencies) (dependency-documents documents options) documents)
        snapshots (into {} (map (fn [[filename source]]
                                  (let [uri (.as_uri (.absolute (pathlib/Path filename)))]
                                    [uri (workspace/TextDocument uri ** :source source)])) documents))
        options (merge {:python-cache (py/create-cache) :dependency-cache (analyzer/create-cache) :persistent-cache-context (atom {})} options)
        options (assoc options :workspace-root (or (:workspace-root options) (:project-root options)))
        project (if (= mode :project-namespaces-only) (declaration-index snapshots)
                    (cached-declaration-index snapshots (atom {}) options (:settings options {}) 0))
        analyses (into {} (map (fn [[_ document]]
                                 [(source-file document)
                                  (if (= mode :project-namespaces-only)
                                    (let [declarations (analyzer/declarations (.-source document) {:filename (source-file document)})
                                          ns-form (first (filter #(= "ns" (head-name %)) (syntax/forms (:root (:parsed declarations)))))
                                          node (second (syntax/forms ns-form))]
                                      {:namespace (:namespace declarations) :findings [] :var-definitions [] :var-usages []
                                       :locals [] :local-usages [] :namespace-usages []
                                       :namespace-definitions (if node [(merge node {:name (:namespace declarations) :filename (source-file document)})] [])})
                                    (analyze-document document project options (:settings options {})))])
                               snapshots))
        settings (:settings options {})
        cross (if (= mode :project-namespaces-only) {}
                  (project-findings documents analyses settings (:project-root options)))
        batch-state (atom {:documents snapshots :roots [(:project-root options)]
                           :settings-by-root {(:project-root options) settings} :settings settings
                           :options options :hook-cache (atom {})})
        by-uri (into {} (map (fn [[filename analysis]] [(.as_uri (.absolute (pathlib/Path filename))) analysis]) analyses))]
    (into {} (for [[filename analysis] analyses
                   :let [uri (.as_uri (.absolute (pathlib/Path filename)))
                         custom (when (seq (get-in settings [:linters :custom])) (custom-findings batch-state uri by-uri))]]
               [filename (update analysis :findings into (map #(assoc % :lsp? true) (concat (get cross filename) custom)))]))))

(defn- namespace-batch-query [documents analyses command from to include-declaration?]
  (let [definitions (for [[filename analysis] analyses entry (:namespace-definitions analysis)
                          :when (and (not (:python entry)) (= from (:name entry)))] [filename entry])]
    (cond
      (empty? definitions) {:result [] :edits {} :exit-code 1}
      (= command "references")
      {:result (vec (for [[filename analysis] analyses
                          entry (concat (:namespace-usages analysis)
                                        (when include-declaration? (:namespace-definitions analysis)))
                          :when (= from (:name entry))]
                      (assoc entry :filename filename)))
       :edits {} :exit-code 0}
      (= command "rename")
      (do
        (when-not (every? #(contains? documents (first %)) definitions)
          (failure "External dependency namespaces cannot be renamed."))
        (when-not (and (string? to) (re/fullmatch "[A-Za-z_][A-Za-z0-9_.-]*" to))
          (failure "A namespace name must be a valid dotted symbol."))
        (when (some #(= to (:namespace %)) (vals analyses))
          (failure (str "Namespace already exists: " to)))
        (let [old-path (-> from (str/replace "." "/") (str/replace "-" "_"))
              new-path (-> to (str/replace "." "/") (str/replace "-" "_"))
              renames (into {} (keep (fn [[filename _]]
                                       (let [suffix (.-suffix (pathlib/Path filename))
                                             old-suffix (str old-path suffix)]
                                         (when (and (contains? source-suffixes suffix) (.endswith filename old-suffix))
                                           (let [target (str (subs filename 0 (- (count filename) (count old-suffix))) new-path suffix)]
                                             (when (.exists (pathlib/Path target))
                                               (failure (str "Destination already exists: " target)))
                                             [filename target])))) definitions))]
          {:result {:from from :to to} :edits (namespace-edits documents (select-keys analyses (keys documents)) from to)
           :renames renames :exit-code 0}))
      :else {:result [] :edits {} :exit-code 1})))

(defn- rename-conflict? [analyses matches identity definition name]
  (some
   (fn [[file entries]]
     (let [analysis (get analyses file)
           uses (map second entries)
           local? (= :local (first identity))
           inside? (fn [binding entry]
                     (and (<= (:scope-start binding (:start binding 0)) (:start entry))
                          (< (:start entry) (:scope-end binding (:end binding 0)))))
           overlaps? (fn [left right]
                       (< (max (:scope-start left (:start left 0)) (:scope-start right (:start right 0)))
                          (min (:scope-end left (:end left 0)) (:scope-end right (:end right 0)))))]
       (or (contains? (:refers analysis) name) (contains? (:imports analysis) name)
           (some (fn [candidate]
                   (and (= name (:name candidate)) (not= identity (identity-of candidate))
                        (if local?
                          (overlaps? definition candidate)
                          (some #(inside? candidate %) uses)))) (:locals analysis))
           (some (fn [candidate]
                   (and (= name (:name candidate)) (not= identity (identity-of candidate))
                        (or local? (= (:ns definition) (:ns candidate))))) (:var-definitions analysis)))))
   (group-by first matches)))

(defn batch-query
  "Read-only workspace operations. Returns offset edits and analysis locations.
  Documents maps absolute filenames to text; cursor rows and columns are one-based."
  [documents options command {:keys [filename row col from to include-declaration?]}]
  (let [analyses (or (:analyses options) (workspace-analysis documents options))
        analysis (get analyses filename)
        source (get documents filename "")
        lines (.splitlines source ** :keepends true)
        offset (+ (reduce + 0 (map count (take (dec (or row 1)) lines))) (dec (or col 1)))
        item (when analysis (occurrence analysis offset))
        identity (if from
                   (let [parts (str/split (str from) #"/")]
                     (when (= 2 (count parts)) [:var (first parts) (second parts)]))
                   (identity-of item))
        matches (when identity (occurrences (if (= command "rename") (select-keys analyses (keys documents)) analyses)
                                            identity (if (= command "rename") true include-declaration?)))]
    (if (and from (not (str/includes? (str from) "/")))
      (namespace-batch-query documents analyses command (str from) (when to (str to)) include-declaration?)
      (case command
        "dump" {:result analyses :edits {} :exit-code 0}
        "references" {:result (mapv (fn [[file item]] (assoc (select-keys item [:name :ns :row :col :end-row :end-col :start :end]) :filename file)) matches)
                      :edits {} :exit-code (if (seq matches) 0 1)}
        "rename"
        (let [parts (str/split (str to) #"/")
              name (last parts)
              definition (or (definition-of analysis item)
                             (first (for [[_ result] analyses candidate (:var-definitions result)
                                          :when (= identity (identity-of candidate))] candidate)))]
          (when-not (and identity definition (valid-name? name)
                         (contains? documents (:filename definition))
                         (not (:generated definition)) (not (:derived-location definition))
                         (= (:name definition) (subs (get documents (:filename definition))
                                                     (:start definition) (:end definition)))
                         (or (= 1 (count parts)) (= (second identity) (first parts))))
            (failure "Rename requires a resolved binding and an unqualified name in the same namespace."))
          (when (or (contains? (analyzer/core-symbols) name)
                    (rename-conflict? analyses matches identity definition name))
            (failure (str "Rename would conflict with an existing binding: " name)))
          (when (some (fn [[_ result]]
                        (some (fn [[_ referred]] (and (:renamed referred)
                                                      (= identity [:var (:ns referred) (:name referred)]))) (:refers result)))
                      analyses)
            (failure "Renamed refers require coordinated alias edits."))
          {:edits (into {} (for [[file entries] (group-by first matches)]
                             [file (mapv (fn [[_ entry]]
                                           (let [token (subs (get documents file) (:start entry) (:end entry))
                                                 suffix (last (str/split token #"/"))]
                                             [(- (:end entry) (count suffix)) (:end entry) name])) entries)]))
           :result {:name name :occurrences (count matches)} :exit-code 0})
        (failure (str "Unknown workspace operation: " command))))))

(defn- protocol-data [value]
  (cond
    (python/hasattr value "_asdict") (protocol-data (._asdict value))
    (python/isinstance value python/dict)
    (into {} (map (fn [[key value]] [(keyword key) (protocol-data value)]) (.items value)))
    (or (python/isinstance value python/list) (python/isinstance value python/tuple)) (mapv protocol-data value)
    :else value))

(defn- wire-range [document start end]
  (py->lisp (.unstructure (converters/get_converter) (span document start end))))

(defn- test-tree [uri document analysis]
  (let [tree (syntax/parse (.-source document))
        nodes (filter #(= :list (:kind %)) (syntax/nodes (:root tree)))
        short-head #(last (str/split (or (head-name %) "") #"/"))
        tests (filter #(= "deftest" (short-head %)) nodes)
        ns-node (first (:namespace-definitions analysis))
        testing-tree (fn build [parent]
                       (let [candidates (filter #(and (= "testing" (short-head %))
                                                      (< (:start parent) (:start %)) (< (:end %) (:end parent))) nodes)
                             immediate (remove #(some (fn [other]
                                                        (and (not= other %) (< (:start other) (:start %))
                                                             (< (:end %) (:end other)))) candidates) candidates)]
                         (mapv (fn [node]
                                 (let [label (second (syntax/forms node))]
                                   {:name (if (= :string (:kind label)) (try (edn/read-string (syntax/text label)) (catch python/Exception _ "")) "")
                                    :range (wire-range document (:start node) (:end node))
                                    :nameRange (wire-range document (:start label) (:end label))
                                    :kind 3 :children (build node)})) immediate)))]
    (when (seq tests)
      {:uri uri :tree {:name (:namespace analysis "")
                       :range (wire-range document 0 (count (.-source document)))
                       :nameRange (wire-range document (:start ns-node 0) (:end ns-node 0))
                       :kind 1
                       :children (mapv (fn [node]
                                         (let [name (second (syntax/forms node))]
                                           {:name (:text name "") :kind 2
                                            :range (wire-range document (:start node) (:end node))
                                            :nameRange (wire-range document (:start name) (:end name))
                                            :children (testing-tree node)})) tests)}})))

(defn- project-tree [state analyses node]
  (let [root (first (:roots @state))]
    (cond
      (nil? node) {:name (if root (.-name (pathlib/Path root)) "Workspace") :type 1
                   :nodes (vec (concat
                                (for [root (:roots @state) source (source-paths root (get-in @state [:settings-by-root root]))]
                                  {:name (str (.relative_to (pathlib/Path source) root)) :uri (.as_uri (pathlib/Path source)) :type 2 :final false})
                                [{:name "External dependencies" :id "external-dependencies" :type 3 :final false}]))}
      (= 2 (:type node))
      (assoc (dissoc node :final) :nodes
             (vec (for [[uri analysis] analyses
                        :let [path (file-path uri) source (or (some-> (:uri node) file-path)
                                                              (.joinpath (pathlib/Path root) (:name node)))]
                        :when (and path (.is_relative_to path source))]
                    {:name (:namespace analysis) :uri uri :type 5 :final false})))
      (= 5 (:type node))
      (assoc (dissoc node :final) :nodes
             (vec (for [definition (:var-definitions (get analyses (:uri node)))
                        :let [document (get-in @state [:documents (:uri node)])]]
                    {:name (:name definition) :uri (:uri node) :final true
                     :type (if (seq (:arglists definition)) 7 8)
                     :range (wire-range document (:start definition) (:end definition))
                     :detail (when (:private definition) "private")})))
      :else (assoc (dissoc node :final) :nodes []))))

(def ^:private snippets
  [["comment" "(comment\n  $0\n  )"] ["condp" "(condp ${1:pred} ${2:expr}\n  $0)"]
   ["def" "(def ${1:name} $0)"] ["def-" "(def ^:private ${1:name} $0)"]
   ["def-doc" "(def ${1:name}\n  \"${2:docstring}\"\n  $0)"]
   ["defn" "(defn ${1:name} [$2]\n  $0)"] ["defn-" "(defn- ${1:name} [$2]\n  $0)"]
   ["defn-doc" "(defn ${1:name}\n  \"${2:docstring}\"\n  [${3:args}]\n  $0)"]
   ["defmulti" "(defmulti ${1:name} ${2:dispatch-fn})"]
   ["defmethod" "(defmethod ${1:name} ${2:match}\n  [${3:args}]\n  $0)"]
   ["defprotocol" "(defprotocol ${1:Name}\n  $0)"]
   ["defrecord" "(defrecord ${1:Name} [${2:fields}]\n  ${3:Protocol}\n  $0)"]
   ["deftype" "(deftype ${1:Name} [${2:fields}]\n  ${3:Protocol}\n  $0)"]
   ["fn" "(fn [${1:args}] $0)"] ["for" "(for [${1:item} ${2:coll}]\n  $0)"]
   ["if" "(if ${1:test}\n  ${2:then}\n  ${3:else})"] ["let" "(let [${1:binding} ${2:value}]\n  $0)"]
   ["letfn" "(letfn [(${1:name} [${2:args}]\n  $0)])"] ["ns" "(ns ${1:name}\n  ${0:references})"]
   ["require" "(:require [${1:namespace}])$0"] ["require-as" "(:require [${1:namespace} :as ${2:alias}])$0"]
   ["require-refer" "(:require [${1:namespace} :refer [${2:names}]])$0"]
   ["deftest" "(deftest ${1:name}\n  (is ${0:expression}))"]
   ["testing" "(testing \"${1:description}\"\n  $0)"]])

(defn- snippet-items [document offset prefix settings]
  (let [source (.-source document) start (- offset (count prefix))
        function-call? (and (pos? start) (= "(" (subs source (dec start) start)))
        extra (:additional-snippets settings)
        items (concat (map (fn [[name body]] {:name name :snippet body :detail (str "Insert " name)}) snippets) extra)]
    (for [{:keys [name snippet detail]} items :when (and name snippet (.startswith name prefix))
          :let [current? (str/includes? snippet "$current-form")
                node (when current? (first (sort-by (juxt :start #(- (:end %) (:start %)))
                                                    (filter #(and (>= (:start %) offset)
                                                                  (not (contains? #{:root :whitespace :newline :delimiter :comma} (:kind %))))
                                                            (syntax/nodes (:root (syntax/parse source)))))))
                body (str/replace snippet "$current-form" (if node (source-of source node) ""))
                body (if (and function-call? (.startswith body "(") (.endswith body ")"))
                       (subs body 1 (dec (count body))) body)]]
      (lsp/CompletionItem name ** :kind (.-Snippet lsp/CompletionItemKind) :detail detail
                          :insert_text_format (.-Snippet lsp/InsertTextFormat)
                          :text_edit (lsp/TextEdit (span document start (if node (:end node) offset)) body)))))

(defn- dependency-contents [state uri]
  (when-not (string? uri) (failure "dependencyContents requires a URI."))
  (or (some-> (get-in @state [:documents uri]) .-source)
      (try
        (if-let [file (file-path uri)]
          (.read_text file ** :encoding "utf-8-sig")
          (let [[archive entry]
                (cond
                  (.startswith uri "zipfile:")
                  (let [[archive separator entry] (.partition (subs uri 8) "::")]
                    (when (= separator "::") [(file-path (str "file:" archive)) (url/unquote entry)]))
                  (.startswith uri "jar:")
                  (let [[archive separator entry] (.partition (subs uri 4) "!/")]
                    (when (= separator "!/") [(file-path archive) (url/unquote entry)]))
                  :else nil)]
            (when-not (and archive (seq entry) (not (.startswith entry "/"))
                           (not (some #{"" "." ".."} (str/split entry #"/")))
                           (not (str/includes? entry "\\")))
              (failure "Expected a file URI or a zipfile:/jar:file: archive entry URI."))
            (with-open [archive (zipfile/ZipFile archive)]
              (.decode (.read archive entry) "utf-8-sig"))))
        (catch errors/JsonRpcInvalidParams e (throw e))
        (catch python/Exception e (failure (str "Cannot read dependency source: " e))))))

(defn- server-info [state]
  {:server-version (metadata/version "basilisp-tools")
   :project-root-uri (some-> (:roots @state) first pathlib/Path .as_uri)
   :source-paths (vec (mapcat #(source-paths % (get-in @state [:settings-by-root %])) (:roots @state)))
   :project-settings (pr-str (:settings-by-root @state))
   :client-settings (pr-str (:client-settings @state))
   :final-settings (pr-str (:settings @state))
   :analysis-summary {:documents (count (:documents @state))
                      :open-documents (count (:open @state))}})

(defasync ^:private cursor-info [state params]
  (let [data (protocol-data params) uri (get-in data [:textDocument :uri])
        analysis (await (analyzed! state uri)) document (get-in @state [:documents uri])
        position (get data :position) offset (.offset_at_position document
                                                                  (lsp/Position (:line position) (:character position)))
        item (occurrence analysis offset)
        node (first (enclosing-nodes (syntax/parse (.-source document)) offset))]
    {:node (select-keys node [:kind :start :end :text])
     :elements (if item [{:element (select-keys item [:name :ns :row :col :end-row :end-col])
                          :definition (select-keys (definition-of analysis item)
                                                   [:name :ns :filename :row :col :end-row :end-col])}] [])}))

(defasync ^:private symbol-documentation [state params]
  (let [data (protocol-data params) ns-name (:sym-ns data) name (:sym-name data)]
    (when (and (string? ns-name) (string? name))
      (let [analyses (await (all-analyses! state))
            project (some (fn [[_ analysis]]
                            (when (= ns-name (:namespace analysis))
                              (some #(when (= name (:name %)) %) (:var-definitions analysis)))) analyses)
            definition (or project (get (analyzer/namespace-symbols ns-name (:options @state)) name))]
        (when definition
          (cond-> {:ns ns-name :name name :doc (:doc definition "")
                   :arglists (vec (:arglists definition)) :examples [] :see-alsos []}
            (:filename definition) (assoc :file (:filename definition))
            (:row definition) (assoc :line (:row definition))
            (.startswith ns-name "basilisp.")
            (assoc :url "https://basilisp.readthedocs.io/")))))))

(defn- current-var [analysis offset]
  (first (sort-by #(- (:scope-end % (:end %)) (:scope-start % (:start %)))
                  (filter #(and (not (:generated %))
                                (<= (:scope-start % (:start %)) offset (:scope-end % (:end %))))
                          (:var-definitions analysis)))))

(defn- test-name-node [source name]
  (some (fn [node]
          (when (and (= :list (:kind node))
                     (= "deftest" (last (str/split (or (head-name node) "") #"/")))
                     (= name (:text (second (syntax/forms node)))))
            (second (syntax/forms node))))
        (syntax/nodes (:root (syntax/parse source)))))

(defn- source-test-plan [state _uri analysis offset destination]
  (let [definition (current-var analysis offset)
        name (:name definition)
        ns-name (:namespace analysis)
        _ (when-not name (failure "Select a var definition to create a test."))
        _ (when (.endswith ns-name "-test") (failure "Select a source namespace to create its test."))
        test-ns (str ns-name "-test") test-name (str name "-test")
        relative (str (-> test-ns (str/replace "-" "_") (str/replace "." "/")) ".lpy")
        path (.joinpath (pathlib/Path destination) relative)
        target-uri (.as_uri (.absolute path))
        existing (get-in @state [:documents target-uri])
        exists? (or existing (.is_file path))
        source (if existing (.-source existing)
                   (if exists? (.read_text path ** :encoding "utf-8") ""))
        found (test-name-node source test-name)
        ns-node (first (filter #(and (= :list (:kind %)) (= "ns" (head-name %)))
                               (syntax/forms (:root (syntax/parse source)))))
        needs-require? (and (seq source) (not found) ns-node
                            (not (some #(contains? #{"basilisp.test" "clojure.test"} (:text %))
                                       (syntax/nodes ns-node))))
        require-at (when needs-require? (dec (:end ns-node)))
        require-text "\n  (:require [basilisp.test])"
        prepared-source (if needs-require?
                          (str (subs source 0 require-at) require-text (subs source require-at)) source)
        addition (if (seq source)
                   (str (if (.endswith source "\n") "\n" "\n\n")
                        "(basilisp.test/deftest " test-name "\n  (basilisp.test/is (= 1 1)))\n")
                   (str "(ns " test-ns "\n  (:require [basilisp.test :refer [deftest is]]\n"
                        "            [" ns-name " :as subject]))\n\n"
                        "(deftest " test-name "\n  (is (= 1 1)))\n"))
        final-source (if found source (str prepared-source addition))
        document (workspace/TextDocument target-uri ** :source source :position_codec (:codec @state))
        final-document (workspace/TextDocument target-uri ** :source final-source :position_codec (:codec @state))
        name-node (or found (test-name-node final-source test-name))
        insertion (lsp/TextDocumentEdit
                   (lsp/OptionalVersionedTextDocumentIdentifier target-uri (some-> existing .-version))
                   (python/list (concat
                                 (when needs-require? [(lsp/TextEdit (span document require-at require-at) require-text)])
                                 [(lsp/TextEdit (if (seq source) (span document (count source) (count source))
                                                    (lsp/Range (lsp/Position 0 0) (lsp/Position 0 0))) addition)])))
        changes (if found [] (if exists? [insertion]
                                 [(lsp/CreateFile target-uri ** :options
                                                  (lsp/CreateFileOptions ** :overwrite false :ignore_if_exists true))
                                  insertion]))]
    {:uri target-uri :selection (span final-document (:start name-node) (:end name-node))
     :changes changes :created? (not exists?)}))

(defasync ^:private create-test! [ls state uri line character]
  (let [analysis (await (analyzed! state uri)) document (get-in @state [:documents uri])
        offset (.offset_at_position document (lsp/Position line character))
        root (root-for state uri) settings (settings-for state uri)
        paths (source-paths root settings)
        file (file-path uri)
        current (first (sort-by #(- (count %)) (filter #(.is_relative_to file (pathlib/Path %)) paths)))
        destinations (vec (remove #(= current %) paths))
        _ (when-not (and current (not (str/includes? (pathutil/relpath current root) "test")))
            (failure "Select a var in a source directory to create its test."))
        destination (cond
                      (= 1 (count destinations)) (first destinations)
                      (empty? destinations) (failure "No source-paths besides the current one found.")
                      :else
                      (some-> (await (.window_show_message_request_async
                                      ls (lsp/ShowMessageRequestParams
                                          (.-Info lsp/MessageType) "Choose a source path for the test file."
                                          ** :actions (python/list (map lsp/MessageActionItem destinations)))))
                              .-title))]
    (when destination
      (let [{:keys [uri selection changes created?]} (source-test-plan state uri analysis offset destination)]
        (when (and created? (not (:document-changes? @state)))
          (failure "Creating test files requires workspaceEdit.documentChanges support."))
        (let [applied? (if (seq changes)
                         (.-applied (await (.workspace_apply_edit_async
                                            ls (lsp/ApplyWorkspaceEditParams
                                                (if created? (lsp/WorkspaceEdit ** :document_changes (python/list changes))
                                                    (workspace-edit state changes))
                                                ** :label "Create test"))))
                         true)]
          (when applied?
            (.window_show_document ls (lsp/ShowDocumentParams uri ** :take_focus true :selection selection)))))))
  nil)

(defasync ^:private go-to-test! [ls state uri line character]
  (let [analysis (await (analyzed! state uri)) document (get-in @state [:documents uri])
        offset (.offset_at_position document (lsp/Position line character))
        definition (current-var analysis offset) ns-name (:namespace analysis)
        from-test? (.endswith ns-name "-test")
        target-ns (if from-test? (subs ns-name 0 (- (count ns-name) 5)) (str ns-name "-test"))
        name (:name definition)
        target-name (when name (if from-test? (if (.endswith name "-test") (subs name 0 (- (count name) 5)) name)
                                   (str name "-test")))
        analyses (await (all-analyses! state uri))
        target (some (fn [[target-uri target-analysis]]
                       (when (= target-ns (:namespace target-analysis))
                         (let [target-document (get-in @state [:documents target-uri])
                               found (or (some #(when (= target-name (:name %)) %) (:var-definitions target-analysis))
                                         (when (and target-name (not from-test?))
                                           (test-name-node (.-source target-document) target-name))
                                         (first (:namespace-definitions target-analysis)))]
                           {:uri target-uri :range (span target-document (:start found 0) (:end found 0))}))) analyses)]
    (if target
      (.window_show_document ls (lsp/ShowDocumentParams (:uri target) ** :take_focus true :selection (:range target)))
      (.window_show_message ls (lsp/ShowMessageParams (.-Info lsp/MessageType)
                                                      (str "No test/source namespace found: " target-ns)))))
  nil)

(defn- auto-require-items [document analysis project prefix range settings]
  (when (and (seq prefix) (not (.startswith prefix ".")) (not (.startswith prefix ":")))
    (let [source (.-source document) tree (syntax/parse source)
          offset (.offset_at_position document (.-end range))
          comment (comment-form tree offset)
          ask? (and comment (= :ask (setting-keyword (get-in settings [:add-missing :add-to-rcf] :ask))))
          existing (set (map :name (:namespace-usages analysis)))]
      (for [[ns definitions] (sort-by key project)
            [name definition] (sort-by key definitions)
            :let [label (str ns "/" name)]
            :when (and (not= ns (:namespace analysis)) (not (:private definition)) (not (:generated definition))
                       (or (.startswith label prefix) (.startswith name prefix)))
            :let [edits (when-not (or ask? (contains? existing ns))
                          (contextual-libspec source tree analysis offset ":require" ns nil nil settings))]
            :when (or ask? (contains? existing ns) (seq edits))]
        (let [item (completion-item label definition range)]
          (when (and ask? (not (contains? existing ns)))
            (set! (.-command item) (lsp/Command "Add dependency" "blt-complete-require"
                                                ** :arguments #py [(.-uri document) (.-line (.-start range)) (.-character (.-start range)) ns])))
          (when (seq edits)
            (set! (.-additional_text_edits item)
                  (python/list (map (fn [[start end text]] (lsp/TextEdit (span document start end) text)) edits)))
            (when-let [warning (get-in settings [:completion :additional-edits-warning-text])]
              (set! (.-documentation item) (lsp/MarkupContent (.-PlainText lsp/MarkupKind)
                                                              (str warning "\n\n" (when-let [documentation (.-documentation item)] (python/getattr documentation "value" (str documentation))))))))
          item)))))

(defn- missing-libspec-candidates [source analysis project offset]
  (let [tree (syntax/parse source)
        node (first (enclosing-nodes tree offset))
        text (:text node "")
        parts (str/split text #"/")
        prefix (when (= 2 (count parts)) (first parts))
        name (last parts)
        namespaces (when prefix
                     (filter #(or (= prefix %) (= prefix (last (str/split % #"\.")))) (keys project)))
        candidates (if prefix
                     (for [ns namespaces :when (contains? (get project ns) name)]
                       {:label (str "Require " ns " as " prefix) :ns ns :alias prefix})
                     (for [[ns definitions] project :let [definition (get definitions name)]
                           :when (and definition (not (:private definition)) (not= ns (:namespace analysis)))]
                       {:label (str "Refer " ns "/" name) :ns ns :refer name}))]
    (vec (for [candidate candidates
               :let [edits (add-libspec source tree ":require" (:ns candidate) (:alias candidate) (:refer candidate))]
               :when (seq edits)]
           (assoc candidate :edits edits)))))

(defn- structural-selection [document offset command]
  (let [forward? (.startswith command "forward")
        select? (.endswith command "select")
        tree (syntax/parse (.-source document))
        nodes (remove #(contains? #{:root :delimiter :prefix :whitespace :newline :comment} (:kind %))
                      (syntax/nodes (:root tree)))
        within (filter #(and (< (:start %) offset) (< offset (:end %))) nodes)
        current (first (sort-by #(- (:end %) (:start %)) within))
        candidate (or current
                      (if forward?
                        (first (sort-by (fn [node] [(:start node) (- (:end node))])
                                        (filter #(>= (:start %) offset) nodes)))
                        (first (sort-by (fn [node] [(- (:end node)) (:start node)])
                                        (filter #(<= (:end %) offset) nodes)))))
        target (if candidate (if forward? (:end candidate) (:start candidate)) offset)]
    (span document (if select? (min offset target) target) (if select? (max offset target) target))))

(defn- macro-config-edit [state uri analysis offset target]
  (let [document (get-in @state [:documents uri])
        node (first (enclosing-nodes (syntax/parse (.-source document)) offset))
        form (first (filter #(= :list (:kind %)) (enclosing-nodes (syntax/parse (.-source document)) offset)))
        head (if (= :symbol (:kind node)) node (first (syntax/forms form)))
        item (occurrence analysis (:start head))
        definition (or (:definition item) item)
        pieces (str/split (:text head "") #"/")
        ns-name (or (when (not= "clj-kondo/unknown-namespace" (:ns definition)) (:ns definition))
                    (when (= 2 (count pieces)) (get (:aliases analysis) (first pieces) (first pieces)))
                    (:namespace analysis))
        macro-name (str ns-name "/" (last pieces))
        root (root-for state uri)
        file (.joinpath (pathlib/Path root) ".clj-kondo" "config.edn")
        target-uri (.as_uri file)
        exists? (.is_file file)
        source (if exists? (.read_text file ** :encoding "utf-8") "")
        config (if exists? (check/read-config source (str file)) {})
        target (str/replace target "clojure.core/" "basilisp.core/")]
    (when-not (and root (= :symbol (:kind head)) (re/fullmatch "[A-Za-z_][A-Za-z0-9_.-]*/[^\\s/]+" target))
      (failure "Select a macro call and a qualified form to lint it as."))
    (when (and (not exists?) (not (:document-changes? @state)))
      (failure "Creating lint configuration requires workspaceEdit.documentChanges support."))
    (let [text (str (pr-str (assoc-in config [:lint-as (symbol macro-name)] (symbol target))) "\n")
          document (workspace/TextDocument target-uri ** :source source :position_codec (:codec @state))
          range (if (empty? source) (lsp/Range (lsp/Position 0 0) (lsp/Position 0 0)) (span document 0 (count source)))
          edit (lsp/TextDocumentEdit (lsp/OptionalVersionedTextDocumentIdentifier target-uri nil)
                                     #py [(lsp/TextEdit range text)])]
      (if exists? (workspace-edit state [edit])
          (lsp/WorkspaceEdit ** :document_changes
                             #py [(lsp/CreateFile target-uri ** :options (lsp/CreateFileOptions ** :overwrite false)) edit])))))

(defasync ^:private completion-query! [state params]
  (refresh-settings! state)
  (let [uri (.-uri (.-text_document params))
        document (get-in @state [:documents uri])
        mode (setting-keyword (get-in (settings-for state uri) [:completion :analysis-type] :fast-but-stale))
        cached (get-in @state [:analyses uri :analysis])
        analysis (if (and (= mode :fast-but-stale) cached) cached (await (analyzed! state uri)))
        offset (.offset_at_position document (.-position params))]
    {:uri uri :document document :analysis analysis :offset offset :fast? (= mode :fast-but-stale)}))

(defn- kondo-options [filename options settings]
  (let [root (:workspace-root options)
        configured (:kondo-config-dir settings)
        directory (when configured
                    (str (.absolute (.joinpath (pathlib/Path (or root (.cwd pathlib/Path))) configured))))]
    (cond-> {:filename filename}
      root (assoc :cwd root)
      directory (assoc :config-dir directory))))

(defn- copy-workspace-kondo-configs! [root settings options]
  (when (and root (get settings :copy-kondo-configs? true))
    (let [directory (.absolute (.joinpath (pathlib/Path root) (or (:kondo-config-dir settings) ".clj-kondo")))
          paths (keep (fn [path]
                        (let [path (pathlib/Path path)]
                          (cond (.is_dir path) (let [exports (.joinpath path "clj-kondo.exports")]
                                                 (when (.is_dir exports) (str exports)))
                                (and (.is_file path) (contains? #{".whl" ".zip" ".jar"} (.-suffix path))) (str path))))
                      (py/environment-paths options))]
      (when (seq paths)
        (.mkdir directory ** :parents true :exist_ok true)
        (check/run {:paths paths :cwd root :config-dir (str directory)
                    :copy-configs true :skip-lint true :cache false :dependencies true})))))

(defasync ^:private prepare-workspace-kondo-configs! [state]
  (loop [roots (:roots @state)]
    (when-let [root (first roots)]
      (let [settings (get-in @state [:settings-by-root root] (:settings @state))
            uri (.as_uri (.joinpath (pathlib/Path root) "__blt__.lpy"))
            options (options-for state uri)
            key [settings (:python-executable options) (:python-paths options)]]
        (when (and (get settings :copy-kondo-configs? true)
                   (not= key (get-in @state [:copied-kondo-settings root])))
          (try
            (await (asyncio/to_thread copy-workspace-kondo-configs! root settings options))
            (swap! state assoc-in [:copied-kondo-settings root] key)
            (catch python/Exception error
              (logging/warning "Could not copy exported checker configuration: %s" (str error)))))
        (recur (rest roots))))))

(defn- observed-file-change? [state change]
  ;; Upstream always handles created/deleted files. The option only gates
  ;; Changed watcher events; explicit document edits remain unaffected.
  (or (not= (.-type change) (.-Changed lsp/FileChangeType))
      (get (settings-for state (.-uri change)) :compute-external-file-changes true)))

(defasync ^:private publish-startup-diagnostics! [ls state]
  (await (wait-index! state))
  (loop [entries (seq (:documents @state))]
    (when-let [[uri document] (first entries)]
      (when (and (not (contains? (:open @state) uri))
                 (get (settings-for state uri) :lint-project-files-after-startup? true))
        (let [generation (:generation @state)]
          (try
            (let [analysis (await (analyzed! state uri))
                  project-findings (await (workspace-findings! state uri))
                  analysis (update analysis :findings into (map #(assoc % :lsp? true) (get project-findings uri)))
                  analysis (if (seq (get-in (settings-for state uri) [:linters :custom]))
                             (let [analyses (await (all-analyses! state uri))
                                   custom (await (worker! state custom-findings state uri analyses))]
                               (update analysis :findings into (map #(assoc % :lsp? true) custom))) analysis)]
              (when (and (= generation (:generation @state))
                         (identical? document (get-in @state [:documents uri]))
                         (not (contains? (:open @state) uri)))
                (publish! ls state document analysis)))
            (catch python/Exception error
              (logging/warning "Could not publish startup diagnostics for %s: %s" uri (str error))))))
      (recur (rest entries)))))

(defn create-server
  "Create a fresh server. The options map is forwarded to Python inspection."
  ([] (create-server {}))
  ([options]
   (let [ls (server/LanguageServer "blt" (metadata/version "basilisp-tools")
                                   ** :protocol_cls configured-protocol)
         workers (create-workers)
         state (atom {:workers workers :documents {} :analyses {} :tasks {} :reloads {} :open #{} :hook-cache (atom {}) :declaration-cache (atom {}) :persistent-cache-context (atom {}) :analysis-epoch 0
                      :tokens {} :token-sequence (atom 0) :generation 0 :options (assoc (dissoc options :force-settings) :python-cache (py/create-cache) :dependency-cache (analyzer/create-cache) :shutdown-event (:closed workers))
                      :force-settings (:force-settings options {})})
         feature (fn [method handler & [opts]] ((.feature ls method opts) handler))]
     (python/setattr ls "blt_workers" workers)
     (python/setattr ls "blt_python_cache" (get-in @state [:options :python-cache]))
     (python/setattr ls "blt_force_settings" (:force-settings options {}))
     (feature lsp/INITIALIZE
              (fn [params]
                (let [codec (.-position_codec (.-workspace ls))
                      roots (initialization-roots params)
                      workspace-capabilities (.-workspace (.-capabilities params))
                      edit-capabilities (when workspace-capabilities (.-workspace_edit workspace-capabilities))]
                  (swap! state assoc :roots (vec roots) :watch-registration?
                         (some-> workspace-capabilities .-did_change_watched_files .-dynamic_registration))
                  (swap! state assoc :document-changes?
                         (and edit-capabilities (.-document_changes edit-capabilities)))
                  (swap! state assoc :client-settings (py->lisp (.-initialization_options params))
                         :snippets? (some-> (.-text_document (.-capabilities params)) .-completion .-completion_item .-snippet_support)
                         :test-tree? (get (protocol-data (.-experimental (.-capabilities params))) :testTree false))
                  (load-workspace-settings! state)
                  (doseq [[method key] [[lsp/TEXT_DOCUMENT_FORMATTING :document-formatting?]
                                        [lsp/TEXT_DOCUMENT_RANGE_FORMATTING :document-range-formatting?]]]
                    (.__setitem__ (.-feature_options (.-fm (.-protocol ls))) method
                                  (boolean (some #(get % key true)
                                                 (or (seq (vals (:settings-by-root @state))) [(:settings @state)])))))
                  (when-not (some #(get % :semantic-tokens? true)
                                  (or (seq (vals (:settings-by-root @state))) [(:settings @state)]))
                    (.__setitem__ (.-feature_options (.-fm (.-protocol ls)))
                                  lsp/TEXT_DOCUMENT_SEMANTIC_TOKENS_FULL nil))
                  (swap! state assoc :codec codec)
                  (swap! state assoc :index-task (asyncio/create_task (index! state roots))))))
     (feature lsp/SHUTDOWN
              (fn ^:async shutdown-handler [_params]
                (stop-workers! (:workers @state))
                (py/stop-cache! (get-in @state [:options :python-cache]))
                (doseq [task (distinct (remove nil? (concat [(:startup-diagnostics-task @state) (:index-task @state) (:cache-writing-task @state)]
                                                            (vals (:tasks @state)) (vals (:reloads @state))
                                                            (vals (:analysis-pending @state)) (vals (:cache-writes @state))
                                                            (vals (:project-diagnostics-pending @state))
                                                            (map :task (vals (:project-pending @state))))))]
                  (.cancel task))
                (await (shutdown-workspace-logging! state))
                nil))
     (feature lsp/INITIALIZED
              (fn [_params]
                (swap! state assoc :initialized? true)
                (refresh-workspace-logging! state)
                (swap! state assoc :startup-diagnostics-task (asyncio/create_task (publish-startup-diagnostics! ls state)))
                (when (:watch-registration? @state)
                  (.client_register_capability
                   ls (lsp/RegistrationParams
                       #py [(lsp/Registration
                             "blt-source-files" lsp/WORKSPACE_DID_CHANGE_WATCHED_FILES
                             (lsp/DidChangeWatchedFilesRegistrationOptions
                              #py [(lsp/FileSystemWatcher "**/*.lpy")
                                   (lsp/FileSystemWatcher "**/*.cljc")
                                   (lsp/FileSystemWatcher "**/*.py")
                                   (lsp/FileSystemWatcher "**/*.pyi")
                                   (lsp/FileSystemWatcher "**/config.edn")
                                   (lsp/FileSystemWatcher "**/project.clj")
                                   (lsp/FileSystemWatcher "**/*.clj")
                                   (lsp/FileSystemWatcher "**/*cljfmt.edn")
                                   (lsp/FileSystemWatcher "**/*cljfmt.clj")
                                   (lsp/FileSystemWatcher "**/pyproject.toml")
                                   (lsp/FileSystemWatcher "**/uv.lock")
                                   (lsp/FileSystemWatcher "**/pyvenv.cfg")]))])))))
     (feature lsp/WORKSPACE_DID_CHANGE_WORKSPACE_FOLDERS
              (fn [params]
                (let [event (.-event params)
                      removed (set (keep #(some-> (.-uri %) file-path str) (.-removed event)))
                      added (keep #(some-> (.-uri %) file-path str) (.-added event))
                      roots (vec (distinct (concat (remove removed (:roots @state)) added)))]
                  (swap! state
                         (fn [value]
                           (-> value
                               (assoc :roots roots)
                               (update :documents
                                       #(into {} (remove
                                                  (fn [[uri _document]]
                                                    (and (not (contains? (:open value) uri))
                                                         (some (fn [root]
                                                                 (when-let [path (file-path uri)]
                                                                   (.is_relative_to path (pathlib/Path root))))
                                                               removed))) %)))
                               (assoc :analyses {} :tokens {} :project-caches {} :project-pending {})
                               (update :generation inc))))
                  (load-workspace-settings! state)
                  (swap! state assoc :index-task (asyncio/create_task (index! state roots)))
                  (doseq [uri (:open @state)]
                    (when-let [task (get-in @state [:tasks uri])] (.cancel task))
                    (swap! state assoc-in [:tasks uri] (asyncio/create_task (refresh! ls state uri)))))))
     (feature lsp/WORKSPACE_DID_CHANGE_CONFIGURATION
              (fn [params]
                (swap! state update :client-settings deep-merge-settings (py->lisp (.-settings params)))
                (refresh-settings! state)
                (doseq [uri (:open @state)]
                  (when-let [task (get-in @state [:tasks uri])] (.cancel task))
                  (swap! state assoc-in [:tasks uri] (asyncio/create_task (refresh! ls state uri))))))
     (feature lsp/TEXT_DOCUMENT_DID_OPEN
              (fn [params]
                (changed! ls state params)
                (let [uri (.-uri (.-text_document params)) document (get-in @state [:documents uri])
                      settings (settings-for state uri)
                      namespace (when-let [path (file-path uri)] (path-namespace state (str path)))]
                  (when (and namespace (str/blank? (.-source document)) (get settings :auto-add-ns-to-new-files? true))
                    (.workspace_apply_edit ls (lsp/ApplyWorkspaceEditParams
                                               (edits-for state uri [[0 (count (.-source document)) (str "(ns " namespace ")\n")]])
                                               ** :label "Add namespace"))))))
     (feature lsp/TEXT_DOCUMENT_DID_CHANGE #(changed! ls state %))
     (feature lsp/TEXT_DOCUMENT_DID_SAVE #(changed! ls state %))
     (feature lsp/TEXT_DOCUMENT_DID_CLOSE
              (fn [params]
                (let [uri (.-uri (.-text_document params))]
                  (when-let [task (get-in @state [:tasks uri])] (.cancel task))
                  (swap! state (fn [value]
                                 (-> value (update :open disj uri)
                                     (update :documents dissoc uri)
                                     (update :analyses dissoc uri)
                                     (update :tokens dissoc uri)
                                     (update :tasks dissoc uri)
                                     (update :generation inc))))
                  (.text_document_publish_diagnostics ls (lsp/PublishDiagnosticsParams uri #py []))
                  (swap! state assoc-in [:reloads uri] (asyncio/create_task (closed! state uri))))))
     (feature lsp/WORKSPACE_DID_CHANGE_WATCHED_FILES
              (fn [params]
                (let [changes (filter #(observed-file-change? state %) (.-changes params))]
                  (when (seq changes)
                    (refresh-settings! state)
                    (doseq [change changes
                            :let [uri (.-uri change) path (file-path uri)]
                            :when path]
                      (when (and (contains? source-suffixes (.-suffix path)) (not (contains? (:open @state) uri)))
                        (when-let [task (get-in @state [:reloads uri])] (.cancel task))
                        (swap! state (fn [value]
                                       (-> value (update :documents dissoc uri)
                                           (update :analyses dissoc uri) (update :reloads dissoc uri))))
                        (when-not (= (.-type change) (.-Deleted lsp/FileChangeType))
                          (swap! state assoc-in [:reloads uri] (asyncio/create_task (closed! state uri)))))
                      (when (or (not (contains? source-suffixes (.-suffix path))) (not (selected-path? state path)))
                        (swap! state update :analysis-epoch (fnil inc 0))
                        (reset! (:dependency-cache (:options @state)) {}))
                      (when (#{".lpy" ".cljc" ".clj" ".edn"} (.-suffix path))
                        (reset! (:hook-cache @state) {})
                        (when (or (str/includes? (str path) "/.clj-kondo/") (str/includes? (str path) "/.lsp/"))
                          (swap! state update :analysis-epoch (fnil inc 0))))
                      (when (or (#{".py" ".pyi"} (.-suffix path))
                                (#{"pyproject.toml" "uv.lock" "pyvenv.cfg"} (.-name path)))
                        (py/clear-cache! (:python-cache (:options @state)))
                        (reset! (:dependency-cache (:options @state)) {}))
                      (swap! state update :generation inc))
                    (doseq [uri (:open @state)]
                      (when-let [task (get-in @state [:tasks uri])] (.cancel task))
                      (swap! state assoc-in [:tasks uri] (asyncio/create_task (refresh! ls state uri))))))))
     (feature lsp/WORKSPACE_WILL_RENAME_FILES
              (fn ^:async handler [params] (await (rename-files-edit state params)))
              (lsp/FileOperationRegistrationOptions
               #py [(lsp/FileOperationFilter (lsp/FileOperationPattern "**/*") ** :scheme "file")]))
     (feature lsp/WORKSPACE_DID_RENAME_FILES
              (fn [params]
                (doseq [file (.-files params)
                        :let [old (file-path (.-old_uri file)) new (file-path (.-new_uri file))]
                        :when (and old new)]
                  (doseq [[uri document] (:documents @state)
                          :let [path (file-path uri)]
                          :when (and path (or (= path old) (.is_relative_to path old)))]
                    (let [target (if (= path old) new (.joinpath new (.relative_to path old)))
                          target-uri (.as_uri target)
                          open? (contains? (:open @state) uri)]
                      (swap! state update :documents dissoc uri)
                      (swap! state assoc-in [:documents target-uri]
                             (workspace/TextDocument target-uri ** :source (.-source document)
                                                     :version (.-version document) :position_codec (:codec @state)))
                      (when open? (swap! state update :open #(conj (disj % uri) target-uri))))))
                (swap! state assoc :analyses {} :tokens {})
                (swap! state update :generation inc))
              (lsp/FileOperationRegistrationOptions
               #py [(lsp/FileOperationFilter (lsp/FileOperationPattern "**/*") ** :scheme "file")]))
     (feature lsp/WORKSPACE_DID_CREATE_FILES
              (fn [params]
                (doseq [file (.-files params) :let [uri (.-uri file)]]
                  (swap! state assoc-in [:reloads uri] (asyncio/create_task (closed! state uri)))))
              (lsp/FileOperationRegistrationOptions
               #py [(lsp/FileOperationFilter (lsp/FileOperationPattern "**/*.{lpy,cljc}") ** :scheme "file")]))
     (feature lsp/WORKSPACE_DID_DELETE_FILES
              (fn [params]
                (doseq [file (.-files params) :let [deleted (file-path (.-uri file))]
                        [uri _] (:documents @state) :let [path (file-path uri)]
                        :when (and deleted path (or (= path deleted) (.is_relative_to path deleted)))]
                  (when-let [task (get-in @state [:tasks uri])] (.cancel task))
                  (swap! state update :documents dissoc uri)
                  (swap! state update :open disj uri)
                  (.text_document_publish_diagnostics ls (lsp/PublishDiagnosticsParams uri #py [])))
                (swap! state assoc :analyses {} :tokens {})
                (swap! state update :generation inc))
              (lsp/FileOperationRegistrationOptions
               #py [(lsp/FileOperationFilter (lsp/FileOperationPattern "**/*") ** :scheme "file")]))
     (feature lsp/TEXT_DOCUMENT_SELECTION_RANGE
              (fn ^:async handler [params]
                (let [uri (.-uri (.-text_document params))
                      _ (await (analyzed! state uri))
                      document (get-in @state [:documents uri])
                      tree (syntax/parse (.-source document))]
                  (python/list (map #(selection-range document tree %) (.-positions params))))))
     (feature lsp/TEXT_DOCUMENT_FOLDING_RANGE
              (fn ^:async handler [params]
                (let [uri (.-uri (.-text_document params))
                      _ (await (analyzed! state uri))
                      document (get-in @state [:documents uri])]
                  (folding-ranges document (syntax/parse (.-source document))))))
     (feature lsp/TEXT_DOCUMENT_DOCUMENT_LINK
              (fn ^:async handler [params]
                (let [uri (.-uri (.-text_document params))
                      _ (await (analyzed! state uri))
                      document (get-in @state [:documents uri])]
                  (document-links document (syntax/parse (.-source document)))))
              (lsp/DocumentLinkOptions ** :resolve_provider false))
     (feature lsp/TEXT_DOCUMENT_DOCUMENT_HIGHLIGHT
              (fn ^:async handler [params]
                (let [{:keys [uri document analysis item]} (await (query! state params))
                      identity (identity-of item)
                      definitions (set (concat (:locals analysis) (:var-definitions analysis)))]
                  (python/list
                   (when identity
                     (for [[_ entry] (occurrences {uri analysis} identity true)]
                       (lsp/DocumentHighlight
                        (span document (:start entry) (:end entry))
                        ** :kind (if (contains? definitions entry) (.-Write lsp/DocumentHighlightKind)
                                     (.-Read lsp/DocumentHighlightKind)))))))))
     (feature lsp/TEXT_DOCUMENT_LINKED_EDITING_RANGE
              (fn ^:async handler [params]
                (let [{:keys [uri document analysis item]} (await (query! state params))]
                  (when (and (:id item) (editable-definition? state analysis item))
                    (lsp/LinkedEditingRanges
                     (python/list (map (fn [[_ entry]] (name-span document entry))
                                       (occurrences {uri analysis} (identity-of item) true))))))))
     (feature lsp/TEXT_DOCUMENT_INLAY_HINT
              (fn ^:async handler [params]
                (let [uri (.-uri (.-text_document params))
                      analysis (await (analyzed! state uri))
                      document (get-in @state [:documents uri])]
                  (inlay-hints state uri document analysis (.-range params))))
              (lsp/InlayHintOptions ** :resolve_provider false))
     (feature lsp/TEXT_DOCUMENT_TYPE_DEFINITION
              (fn ^:async handler [params]
                (let [{:keys [uri analysis item offset]} (await (query! state params))
                      definition (definition-of analysis item)
                      expression (first (sort-by #(- (:end %) (:start %))
                                                 (filter #(and (<= (:start %) offset) (< offset (:end %)))
                                                         (:python-expressions analysis))))
                      type (or (:python-type definition) (:python-type expression)
                               (py/return-type definition))
                      types (or (seq (:union type)) (when type [type]))]
                  (python/list
                   (keep #(location state %)
                         (await (worker! state
                                         #(mapv (fn [type] (py/inspect-type type (options-for state uri))) types))))))))
     (feature lsp/TEXT_DOCUMENT_IMPLEMENTATION
              (fn ^:async handler [params]
                (let [{:keys [uri item analysis]} (await (query! state params))
                      definition (definition-of analysis item)
                      identity (identity-of definition)]
                  (python/list
                   (keep #(location state %)
                         (for [[_ analysis] (await (all-analyses! state uri))
                               implementation (:implementations analysis)
                               :when (or (= identity (identity-of (:definition implementation)))
                                         (= identity [:var (:protocol-ns implementation) (:protocol-name implementation)]))]
                           implementation))))))
     ((.command ls "move-form")
      (fn ^:async move-command [uri line character target-filename]
        (let [root (root-for state uri)
              target (if (.startswith (str target-filename) "file:")
                       (file-path target-filename)
                       (.absolute (.joinpath (pathlib/Path (or root (.cwd pathlib/Path))) (str target-filename))))
              target-uri (when target (.as_uri target))]
          (when-not (and root (= root (root-for state target-uri)))
            (failure "Move requires source and destination files in the same workspace."))
          (let [analyses (await (all-analyses! state uri))
                documents (into {} (map (fn [[uri document]] [uri (.-source document)]) (workspace-documents state uri)))
                document (get-in @state [:documents uri])
                offset (.offset_at_position document (lsp/Position line character))
                target-uri (or (some #(when (= (.resolve target) (some-> % file-path .resolve)) %) (keys documents))
                               target-uri)
                changes (move-form-edits documents analyses uri offset target-uri)]
            (when-not (seq changes)
              (failure "Move requires a public definition, an existing destination namespace, and statically safe dependencies."))
            (.workspace_apply_edit
             ls (lsp/ApplyWorkspaceEditParams
                 (workspace-edit state
                                 (python/list
                                  (for [[uri edits] changes
                                        :let [document (get-in @state [:documents uri])]]
                                    (lsp/TextDocumentEdit
                                     (lsp/OptionalVersionedTextDocumentIdentifier uri (.-version document))
                                     (python/list (map (fn [[start end text]] (lsp/TextEdit (span document start end) text)) edits))))))
                 ** :label "Move form"))
            nil))))
     (doseq [[command direction] [["drag-param-backward" -1] ["drag-param-forward" 1]]]
       ((.command ls command)
        (let [command command direction direction]
          (fn ^:async parameter-command [uri line character]
            (let [analyses (await (all-analyses! state uri))
                  documents (into {} (map (fn [[uri document]] [uri (.-source document)]) (workspace-documents state uri)))
                  document (get-in @state [:documents uri])
                  offset (.offset_at_position document (lsp/Position line character))
                  changes (parameter-edits documents analyses uri offset direction)
                  edit (when (seq changes)
                         (workspace-edit
                          state
                          (python/list
                           (for [[uri edits] changes :let [document (get-in @state [:documents uri])]]
                             (lsp/TextDocumentEdit
                              (lsp/OptionalVersionedTextDocumentIdentifier uri (.-version document))
                              (python/list (map (fn [[start end text]]
                                                  (lsp/TextEdit (span document start end) text)) edits)))))))]
              (if edit (.workspace_apply_edit ls (lsp/ApplyWorkspaceEditParams edit ** :label command))
                  (failure "Parameter movement requires a fixed arity function and statically resolved calls."))
              nil)))))
     (feature "clojure/workspace/projectTree/nodes"
              (fn ^:async handler [params]
                (lisp->py (project-tree state (await (all-analyses! state)) (protocol-data params)))))
     (feature "clojure/serverInfo/raw" (fn [_params] (lisp->py (server-info state))))
     (feature "clojure/cursorInfo/raw" (fn ^:async extension-request [params] (lisp->py (await (cursor-info state params)))))
     (feature "clojure/serverInfo/log"
              (fn [_params]
                (.window_show_message ls (lsp/ShowMessageParams (.-Info lsp/MessageType)
                                                                (pr-str (server-info state))))))
     (feature "clojure/cursorInfo/log"
              (fn ^:async extension-request [params]
                (.window_show_message ls (lsp/ShowMessageParams (.-Info lsp/MessageType)
                                                                (pr-str (await (cursor-info state params)))))))
     (feature "clojure/dependencyContents"
              (fn [params] (dependency-contents state (:uri (protocol-data params)))))
     (feature "clojure/clojuredocs/raw"
              (fn ^:async extension-request [params] (lisp->py (await (symbol-documentation state params)))))
     (feature "basilisp/documentation/raw"
              (fn ^:async extension-request [params] (lisp->py (await (symbol-documentation state params)))))
     ((.command ls "create-test") (fn ^:async extension-command [uri line character & _args]
                                    (await (create-test! ls state uri line character))))
     ((.command ls "go-to-test") (fn ^:async extension-command [uri line character & _args]
                                   (await (go-to-test! ls state uri line character))))

     ((.command ls "blt-complete-require")
      (fn ^:async complete-require [uri line character lib]
        (let [analysis (await (analyzed! state uri)) document (get-in @state [:documents uri])
              offset (.offset_at_position document (lsp/Position line character))]
          (when-let [settings (await (choose-libspec-settings ls state uri offset))]
            (let [source (.-source document)
                  edits (contextual-libspec source (syntax/parse source) analysis offset ":require" lib nil nil settings)]
              (when-let [edit (edits-for state uri edits)]
                (.workspace_apply_edit ls (lsp/ApplyWorkspaceEditParams edit ** :label "Add dependency"))))))
        nil))
     ((.command ls "add-missing-libspec")
      (fn ^:async add-missing [uri line character]
        (let [analysis (await (analyzed! state uri)) document (get-in @state [:documents uri])
              offset (.offset_at_position document (lsp/Position line character))
              project (await (project! state uri))
              candidates (missing-libspec-candidates (.-source document) analysis project offset)
              selected (if (= 1 (count candidates)) (first candidates)
                           (when (seq candidates)
                             (let [choice (await (.window_show_message_request_async ls
                                                                                     (lsp/ShowMessageRequestParams (.-Info lsp/MessageType) "Choose a namespace."
                                                                                                                   ** :actions (python/list (map #(lsp/MessageActionItem (:label %)) candidates)))))]
                               (first (filter #(= (:label %) (some-> choice .-title)) candidates)))))]
          (when selected
            (when-let [settings (await (choose-libspec-settings ls state uri offset))]
              (let [source (.-source document)
                    edits (contextual-libspec source (syntax/parse source) analysis offset ":require" (:ns selected) (:alias selected) (:refer selected) settings)
                    edits (namespace-refactor-layout source (assoc analysis :settings settings) "add-missing-libspec" edits)]
                (.workspace_apply_edit ls (lsp/ApplyWorkspaceEditParams (edits-for state uri edits) ** :label "Add require")))))
          nil)))
     (doseq [command ["forward" "forward-select" "backward" "backward-select"]]
       ((.command ls command)
        (let [command command]
          (fn ^:async navigate-form [uri line character]
            (await (analyzed! state uri))
            (let [document (get-in @state [:documents uri])
                  offset (.offset_at_position document (lsp/Position line character))]
              (.window_show_document ls (lsp/ShowDocumentParams uri ** :take_focus true
                                                                :selection (structural-selection document offset command))))
            nil))))
     ((.command ls "resolve-macro-as")
      (fn ^:async resolve-macro [uri line character & [target]]
        (let [analysis (await (analyzed! state uri)) document (get-in @state [:documents uri])
              offset (.offset_at_position document (lsp/Position line character))
              target (or target (some-> (await (.window_show_message_request_async ls
                                                                                   (lsp/ShowMessageRequestParams (.-Info lsp/MessageType) "Lint this macro as which form?"
                                                                                                                 ** :actions (python/list (map #(lsp/MessageActionItem (str "basilisp.core/" %))
                                                                                                                                               ["defn" "def" "let" "for" "doseq" "binding" "with-open" "fn" "do"]))))) .-title))]
          (when target (.workspace_apply_edit ls (lsp/ApplyWorkspaceEditParams
                                                  (macro-config-edit state uri analysis offset target)
                                                  ** :label "Configure macro analysis"))))
        nil))
     ((.command ls "server-info") (fn [& _args]
                                    (.window_show_message ls (lsp/ShowMessageParams (.-Info lsp/MessageType) (pr-str (server-info state)))) nil))
     ((.command ls "cursor-info") (fn ^:async cursor-info-command [uri line character & _args]
                                    (.window_show_message ls (lsp/ShowMessageParams (.-Info lsp/MessageType)
                                                                                    (pr-str (await (cursor-info state (lisp->py {:textDocument {:uri uri} :position {:line line :character character}})))))) nil))
     (doseq [command refactor-commands]
       ((.command ls command)
        (let [command command]
          (fn ^:async refactor-command [uri line character & args]
            (let [analysis (await (analyzed! state uri))
                  document (get-in @state [:documents uri])
                  offset (.offset_at_position document (lsp/Position line character))
                  settings (if (contains? #{"add-missing-import" "add-import-to-namespace" "add-require-suggestion"} command)
                             (await (choose-libspec-settings ls state uri offset)) (settings-for state uri))
                  analysis (cond-> (assoc analysis :settings settings)
                             (and (= command "extract-function") (> (count args) 2))
                             (assoc :selection-end (.offset_at_position document (lsp/Position (second args) (nth args 2)))))
                  edits (when settings (refactor-edits (.-source document) analysis command offset args))
                  edits (namespace-refactor-layout (.-source document) analysis command edits)]
              (if-let [edit (edits-for state uri edits)]
                (do (.workspace_apply_edit ls (lsp/ApplyWorkspaceEditParams edit ** :label command))
                    nil)
                (failure (str "Cannot apply " command " at this position."))))))))
     (feature lsp/TEXT_DOCUMENT_HOVER
              (fn ^:async handler [params]
                (let [{:keys [analysis document item offset]} (await (query! state params))
                      settings (settings-for state (.-uri document))
                      call (call-at analysis offset)
                      calling (:definition call)
                      definition (or (definition-of analysis item) calling)]
                  (when definition
                    (let [content (markdown definition settings)]
                      (when (and calling (not (get-in settings [:hover :hide-signature-call?]))
                                 (not= (identity-of definition) (identity-of calling)))
                        (set! (.-value content)
                              (str (.-value content) "\n\ncalling: " (:name calling) " "
                                   (or (:signature calling) (str/join " " (:arglists calling))))))
                      (lsp/Hover content ** :range (span document (:start item (:start call)) (:end item (:end call)))))))))
     (feature lsp/TEXT_DOCUMENT_DEFINITION
              (fn ^:async handler [params]
                (let [{:keys [uri analysis item]} (await (query! state params))]
                  (if (:namespace? item)
                    (location state (first (for [[_ analysis] (await (all-analyses! state uri))
                                                 definition (:namespace-definitions analysis)
                                                 :when (= (:name item) (:name definition))] definition)))
                    (location state (definition-of analysis item))))))
     (feature lsp/TEXT_DOCUMENT_REFERENCES
              (fn ^:async handler [params]
                (let [{:keys [item uri]} (await (query! state params))]
                  (python/list
                   (keep (fn [[_uri entry]] (location state entry))
                         (when-let [identity (identity-of item)]
                           (occurrences (await (all-analyses! state uri)) identity
                                        (.-include_declaration (.-context params)))))))))
     (feature lsp/TEXT_DOCUMENT_PREPARE_RENAME
              (fn ^:async handler [params]
                (let [{:keys [document item analysis]} (await (query! state params))]
                  (when (and (identity-of item) (editable-definition? state analysis item))
                    (name-span document item)))))
     (feature lsp/TEXT_DOCUMENT_RENAME
              (fn ^:async handler [params]
                (let [{:keys [item analysis uri]} (await (query! state params))
                      identity (identity-of item)
                      name (.-new_name params)]
                  (when-not (and identity (editable-definition? state analysis item) (valid-name? name))
                    (failure "Only resolved Basilisp bindings can be renamed to an unqualified symbol."))
                  (let [generation (:generation @state)
                        analyses (await (all-analyses! state uri))
                        matches (occurrences analyses identity true)
                        uris (set (map first matches))]
                    (doseq [[_uri analysis] analyses]
                      (doseq [[_alias referred] (:refers analysis)
                              :when (and (:renamed referred)
                                         (= identity [:var (:ns referred) (:name referred)]))]
                        (failure "Renaming a var used through :rename requires updating its alias declarations manually.")))
                    (when (or (contains? (analyzer/core-symbols) name)
                              (some (fn [uri]
                                      (or (contains? (:imports (get analyses uri)) name)
                                          (contains? (:refers (get analyses uri)) name)))
                                    uris))
                      (failure (str "Rename would conflict with a core or imported binding: " name)))
                    (when (rename-conflict? analyses matches identity (definition-of analysis item) name)
                      (failure (str "Rename would conflict with an existing binding: " name)))
                    (when-not (= generation (:generation @state))
                      (throw (errors/JsonRpcContentModified "The workspace changed during rename.")))
                    (workspace-edit
                     state (python/list
                            (for [[uri entries] (group-by first matches)
                                  :let [document (get-in @state [:documents uri])]]
                              (lsp/TextDocumentEdit
                               (lsp/OptionalVersionedTextDocumentIdentifier uri (.-version document))
                               (python/list
                                (map (fn [[_ entry]] (lsp/TextEdit (name-span document entry) name))
                                     entries)))))))))
              (lsp/RenameOptions ** :prepare_provider true))
     (feature lsp/TEXT_DOCUMENT_COMPLETION
              (fn ^:async handler [params]
                (let [{:keys [document analysis offset uri fast?]} (await (completion-query! state params))
                      prefix (completion-prefix document offset)
                      project (or (when fast? (get-in @state [:project-caches (root-for state uri) :project]))
                                  (await (project! state uri)))
                      candidates (await (worker! state
                                                 #(vec (completion-candidates
                                                        (assoc analysis :project project :source (.-source document))
                                                        offset prefix (options-for state uri)))))
                      range (span document (- offset (count prefix)) offset)]
                  (lsp/CompletionList false
                                      (python/list
                                       (concat (map (fn [[label definition]]
                                                      (completion-item label definition range))
                                                    (sort-by first (into {} (reverse candidates))))
                                               (auto-require-items document analysis project prefix range (settings-for state uri))
                                               (when (:snippets? @state) (snippet-items document offset prefix (settings-for state uri))))))))
              (lsp/CompletionOptions ** :trigger_characters #py ["/" "."]))
     (feature lsp/TEXT_DOCUMENT_SIGNATURE_HELP
              (fn ^:async handler [params]
                (let [{:keys [analysis document offset]} (await (query! state params))]
                  (signature-help analysis document offset)))
              (lsp/SignatureHelpOptions ** :trigger_characters #py [" " "("]
                                        :retrigger_characters #py [" "]))
     (feature lsp/TEXT_DOCUMENT_SEMANTIC_TOKENS_FULL
              (fn ^:async handler [params]
                (refresh-settings! state)
                (let [uri (.-uri (.-text_document params))
                      analysis (await (analyzed! state uri))
                      document (get-in @state [:documents uri])
                      data (if (get (settings-for state uri) :semantic-tokens? true)
                             (semantic-data analysis document nil) [])]
                  (token-response! state uri data nil)))
              (lsp/SemanticTokensLegend (python/list token-types) (python/list token-modifiers)))
     (feature lsp/TEXT_DOCUMENT_SEMANTIC_TOKENS_FULL_DELTA
              (fn ^:async handler [params]
                (refresh-settings! state)
                (let [uri (.-uri (.-text_document params))
                      analysis (await (analyzed! state uri))
                      document (get-in @state [:documents uri])
                      data (if (get (settings-for state uri) :semantic-tokens? true)
                             (semantic-data analysis document nil) [])]
                  (token-response! state uri data (.-previous_result_id params)))))
     (feature lsp/TEXT_DOCUMENT_SEMANTIC_TOKENS_RANGE
              (fn ^:async handler [params]
                (refresh-settings! state)
                (let [uri (.-uri (.-text_document params))
                      analysis (await (analyzed! state uri))
                      document (get-in @state [:documents uri])]
                  (lsp/SemanticTokens
                   (python/list (if (get (settings-for state uri) :semantic-tokens? true)
                                  (semantic-data analysis document (.-range params)) []))))))
     (feature lsp/TEXT_DOCUMENT_CODE_ACTION
              (fn ^:async handler [params]
                (refresh-settings! state)
                (let [uri (.-uri (.-text_document params))
                      analysis (await (analyzed! state uri))
                      document (get-in @state [:documents uri])]
                  (python/list (concat
                                (unused-binding-actions state uri document analysis (.-range params) (.-context params))
                                (refactor-actions state uri document analysis (.-range params) (.-context params))))))
              (lsp/CodeActionOptions ** :code_action_kinds #py ["quickfix" "refactor.extract" "refactor.inline" "refactor.rewrite" "source.organizeImports"]))
     (feature lsp/TEXT_DOCUMENT_CODE_LENS
              (fn ^:async handler [params]
                (refresh-settings! state)
                (let [uri (.-uri (.-text_document params))
                      analysis (await (analyzed! state uri))
                      document (get-in @state [:documents uri])]
                  (python/list
                   (for [definition (:var-definitions analysis)]
                     (lsp/CodeLens (span document (:start definition) (:end definition))
                                   ** :data (lisp->py {:uri uri :ns (:ns definition) :name (:name definition)}))))))
              (lsp/CodeLensOptions ** :resolve_provider true))
     (feature lsp/CODE_LENS_RESOLVE
              (fn ^:async handler [lens]
                (let [{:keys [uri ns name]} (py->lisp (.-data lens))
                      references (occurrences (await (all-analyses! state uri)) [:var ns name] false)
                      settings (settings-for state uri)
                      patterns (:test-locations-regex settings ["_test\\.(?:lpy|cljc)$"])
                      tests (when (get-in settings [:code-lens :segregate-test-references] (get settings :lens-segregate-test-references true))
                              (filter (fn [[reference-uri _]]
                                        (and (not= uri reference-uri)
                                             (some #(regex/search % reference-uri) patterns))) references))
                      main (remove (set tests) references)
                      title (str (reference-title main "reference")
                                 (when (seq tests) (str " | " (reference-title tests "test"))))
                      position (.-start (.-range lens))
                      document (get-in @state [:documents uri])
                      offset (.offset_at_position document position)
                      source (subs (.-source document) 0 offset)
                      row (inc (count (filter #{\newline} source)))
                      column (inc (- offset (inc (.rfind source "\n"))))]
                  (lsp/CodeLens (.-range lens)
                                ** :command (lsp/Command title "code-lens-references"
                                                         ** :arguments #py [uri row column])))))
     ((.command ls "code-lens-references")
      (fn ^:async references-command [uri row column]
        (let [analysis (await (analyzed! state uri))
              document (get-in @state [:documents uri])
              position (.position_to_client_units document (lsp/Position (dec row) (dec column)))
              item (occurrence analysis (.offset_at_position document position))]
          (python/list (keep (fn [[_ entry]] (location state entry))
                             (occurrences (await (all-analyses! state uri)) (identity-of item) false))))))
     (feature lsp/TEXT_DOCUMENT_PREPARE_CALL_HIERARCHY
              (fn ^:async handler [params]
                (let [{:keys [analysis item]} (await (query! state params))
                      definition (definition-of analysis item)]
                  (python/list (or (when (seq (:arglists definition))
                                     (when-let [entry (hierarchy-item state definition)] [entry])) [])))))
     (feature lsp/CALL_HIERARCHY_INCOMING_CALLS
              (fn ^:async handler [params]
                (let [item (.-item params) identity (item-identity item)
                      analyses (await (all-analyses! state (.-uri item)))
                      matches (for [[uri analysis] analyses call (:calls analysis)
                                    :when (and (:caller call) (= identity (identity-of (:definition call))))]
                                [uri call])]
                  (python/list
                   (keep (fn [[_ calls]]
                           (let [[uri first-call] (first calls)
                                 document (get-in @state [:documents uri])]
                             (when-let [caller (hierarchy-item state (:caller first-call))]
                               (lsp/CallHierarchyIncomingCall
                                caller (python/list (map (fn [[_ call]]
                                                           (let [head (:name-range call)]
                                                             (span document (:start head) (:end head)))) calls))))))
                         (group-by (fn [[uri call]] [uri (identity-of (:caller call))]) matches))))))
     (feature lsp/CALL_HIERARCHY_OUTGOING_CALLS
              (fn ^:async handler [params]
                (let [item (.-item params) identity (item-identity item)
                      analysis (await (analyzed! state (.-uri item)))
                      document (get-in @state [:documents (.-uri item)])
                      matches (filter #(and (= identity (identity-of (:caller %)))
                                            (identity-of (:definition %))) (:calls analysis))]
                  (python/list
                   (keep (fn [[_ calls]]
                           (when-let [callee (hierarchy-item state (:definition (first calls)))]
                             (lsp/CallHierarchyOutgoingCall
                              callee (python/list (map (fn [call]
                                                         (let [head (:name-range call)]
                                                           (span document (:start head) (:end head)))) calls)))))
                         (group-by #(identity-of (:definition %)) matches))))))
     (feature lsp/TEXT_DOCUMENT_DOCUMENT_SYMBOL
              (fn ^:async handler [params]
                (let [uri (.-uri (.-text_document params))
                      analysis (await (analyzed! state uri))
                      document (get-in @state [:documents uri])]
                  (python/list
                   (for [definition (:var-definitions analysis)]
                     (lsp/DocumentSymbol (:name definition) (definition-kind definition)
                                         (span document (:scope-start definition (:start definition))
                                               (:scope-end definition (:end definition)))
                                         (span document (:start definition) (:end definition))))))))
     (feature lsp/WORKSPACE_SYMBOL
              (fn ^:async handler [params]
                (let [query (.lower (.-query params))]
                  (python/list
                   (for [[_uri analysis] (await (all-analyses! state))
                         definition (:var-definitions analysis)
                         :when (str/includes? (.lower (:name definition)) query)
                         :let [loc (location state definition)]
                         :when loc]
                     (lsp/SymbolInformation loc (:name definition) (definition-kind definition)
                                            ** :container_name (:ns definition)))))))
     (feature lsp/TEXT_DOCUMENT_FORMATTING
              (fn ^:async handler [params]
                (refresh-settings! state)
                (let [uri (.-uri (.-text_document params))
                      document (get-in @state [:documents uri])]
                  (if-not (get (settings-for state uri) :document-formatting? true) #py []
                          (let [source (.-source document)
                                options (await (formatting-options! state uri))
                                formatted (await (worker! state fmt/format-string source options :basilisp))]
                            (when (identical? document (get-in @state [:documents uri]))
                              (if (= source formatted) #py []
                                  #py [(lsp/TextEdit (span document 0 (count source)) formatted)])))))))
     (feature lsp/TEXT_DOCUMENT_RANGE_FORMATTING
              (fn ^:async handler [params]
                (refresh-settings! state)
                (let [uri (.-uri (.-text_document params))
                      document (get-in @state [:documents uri])
                      source (.-source document)]
                  (if-not (get (settings-for state uri) :document-range-formatting? true) #py []
                          (let [start (.offset_at_position document (.-start (.-range params)))
                                end (.offset_at_position document (.-end (.-range params)))
                                forms (syntax/forms (:root (syntax/parse source)))
                                selected (filter #(and (<= (:start %) end) (<= start (:end %))) forms)
                                from (:start (first selected)) to (:end (last selected))]
                            (if-not from #py []
                                    (let [options (await (formatting-options! state uri))
                                          formatted (await (worker! state fmt/format-string (subs source from to) options :basilisp))]
                                      (when (identical? document (get-in @state [:documents uri]))
                                        #py [(lsp/TextEdit (span document from to) formatted)]))))))))
     (python/setattr ls "blt_state" state)
     ls)))

(defn start
  "Serve LSP over stdin/stdout until the client exits."
  ([] (start {}))
  ([options]
   (logging/basicConfig ** :level logging/WARNING)
   (let [ls (create-server options)]
     (try (.start_io ls)
          (finally
            (stop-workers! (.-blt_workers ls))
            (py/stop-cache! (.-blt_python_cache ls)))))
   0))
