(ns basilisp-tools.python
  "Cached Python metadata for analysis and editor queries.

  Local .py/.pyi files are read as ASTs without importing them. Installed
  dependencies can be inspected in an isolated, time-limited subprocess.
  This process boundary contains failures; it is not a security sandbox.
  No analyzed Basilisp forms are evaluated."
  (:require [basilisp.string :as str])
  (:import [importlib.util :as import-util] [json] [pathlib] [subprocess] [sys] [tempfile] [time]
           [basilisp.lang.map :as lmap] [basilisp.lang.vector :as lvec]))

(defn- load-worker []
  ;; Loading the stdlib-only worker directly avoids reinitializing the parent
  ;; package while Basilisp itself is importing this namespace.
  (let [file (.with_name (pathlib/Path
                          (.-__file__ (get sys/modules "basilisp_tools.python"))) "_inspect.py")
        spec (import-util/spec-from-file-location "_blt_metadata_decoder" (str file))
        module (import-util/module-from-spec spec)]
    (.exec_module (.-loader spec) module)
    module))

(def ^:private worker-runtime (load-worker))
(def ^:private decode-object (.metadata_decoder worker-runtime keyword lmap/map lvec/vector))

(defn create-cache
  "Create metadata storage owned by a checker run or language server."
  []
  (atom (with-meta {} {:generation 0 :processes (.InspectionProcesses worker-runtime)})))

(defn comparison-options
  "Attach a fresh comparison memo for one analysis. Do not retain it between analyses."
  [opts]
  (assoc opts ::type-comparisons (atom {})))

(def ^:private cache (create-cache))
(def ^:private cache-limit 256)

(defn clear-cache!
  "Discard metadata after interpreter/dependency changes."
  ([] (clear-cache! cache))
  ([storage]
   (swap! storage (fn [entries]
                    (with-meta {} (update (meta entries) :generation (fnil inc 0)))))))

(defn stop-cache!
  "Stop inspection workers owned by a checker/server and reject new work."
  [storage]
  (.stop (:processes (meta @storage)))
  (clear-cache! storage))

(defn- options [opts]
  {:python-executable (or (:python-executable opts) sys/executable)
   :python-paths (mapv #(str (.resolve (pathlib/Path %))) (:python-paths opts))
   :python-inspection? (get opts :python-inspection? true)
   :python-timeout (get opts :python-timeout 5)})

(defn- local-file [module paths]
  (first
   (for [root paths
         :let [stem (.joinpath (pathlib/Path root) (str/replace module "." "/"))]
         candidate [(.with_suffix stem ".pyi") (.joinpath stem "__init__.pyi")
                    (.with_suffix stem ".py") (.joinpath stem "__init__.py")]
         :when (.is_file candidate)]
     candidate)))

(defn- cache-key [module opts]
  (let [file (local-file module (:python-paths opts))
        fingerprint (when file
                      (let [stat (.stat file)]
                        [(str file) (.-st_mtime_ns stat) (.-st_size stat)]))]
    [module opts fingerprint]))

(defn- unknown [module reason]
  {:status :unknown :name module :reason reason})

(def ^:private transient-reasons
  #{"inspection-timeout" "inspection-failed" "interpreter-unavailable"
    "invalid-inspection-output" "missing-result"})

(defn- inspection-results [output modules reason opts]
  (let [text (if (instance? python/bytes output) (.decode output "utf-8" "replace") (or output ""))
        completed (reduce (fn [results line]
                            (try
                              (into results (lmap/map (json/loads line ** :object_hook decode-object)))
                              (catch python/ValueError _ results)
                              (catch python/TypeError _ results)))
                          {} (str/split-lines text))
        retry-at (+ (time/monotonic) (max 1 (:python-timeout opts)))]
    (into {} (map (fn [module]
                    [module (or (get completed module)
                                (with-meta (unknown module reason) {:retry-at retry-at}))])
                  modules))))

(defn- inspect-batch [modules opts storage]
  (let [temp (tempfile/TemporaryDirectory)
        worker (.with_name (pathlib/Path
                            (.-__file__ (get sys/modules "basilisp_tools.python")))
                           "_inspect.py")]
    (try
      (let [request {:modules modules :paths (:python-paths opts)
                     :enabled (:python-inspection? opts) :stream true :compact "graph"}
            process (.run (:processes (meta @storage))
                          (lisp->py [(:python-executable opts) "-I" (str worker)])
                          ** :input (json/dumps (lisp->py request))
                          :text true :capture_output true :cwd (.-name temp)
                          :timeout (:python-timeout opts))]
        (inspection-results (.-stdout process) modules
                            (if (= 0 (.-returncode process)) "invalid-inspection-output" "inspection-failed") opts))
      (catch subprocess/TimeoutExpired error
        ;; The worker flushes each module, so a slow dependency cannot discard
        ;; useful metadata already produced by the rest of the batch.
        (inspection-results (.-stdout error) modules "inspection-timeout" opts))
      (catch python/OSError _
        (inspection-results nil modules "interpreter-unavailable" opts))
      (catch python/ValueError _
        (inspection-results nil modules "invalid-inspection-output" opts))
      (finally (.cleanup temp)))))

(defn- fresh? [metadata]
  (and metadata
       (or (not (contains? transient-reasons (:reason metadata)))
           (< (time/monotonic) (get (meta metadata) :retry-at 0)))
       (.dependencies_fresh worker-runtime (:dependencies metadata))))

(defn- retain-results [entries additions]
  ;; Keep new results and bound retained entries, including old fingerprints.
  (let [merged (into entries additions)]
    (with-meta
      (if (> (count merged) cache-limit)
        (into {} (concat (take (max 0 (- cache-limit (count additions))) entries)
                         (take-last cache-limit additions)))
        merged)
      (meta entries))))

(defn- store-results! [storage generation additions]
  ;; Clearing a cache also invalidates work that was already in flight.
  (swap! storage (fn [entries]
                   (if (= generation (get (meta entries) :generation 0))
                     (retain-results entries additions)
                     entries))))

(defn- environment-info [opts]
  (let [storage (or (:python-cache opts) cache)
        executable (or (:python-executable opts) sys/executable)
        key [:environment-info executable]
        generation (get (meta @storage) :generation 0)]
    (if (= executable sys/executable)
      {:paths (vec (filter seq (vec sys/path)))
       :version [(.-major sys/version-info) (.-minor sys/version-info)]}
      (or (get @storage key)
          (let [worker (.with_name (pathlib/Path
                                    (.-__file__ (get sys/modules "basilisp_tools.python")))
                                   "_inspect.py")
                result (try
                         (let [process (.run (:processes (meta @storage))
                                             (lisp->py [executable "-I" (str worker)])
                                             ** :input "{\"operation\":\"environment-info\"}"
                                             :text true :capture_output true
                                             :timeout (get opts :python-timeout 5))]
                           (when (= 0 (.-returncode process))
                             (let [info (json/loads (.-stdout process))]
                               {:paths (vec (get info "paths"))
                                :version (vec (get info "version"))})))
                         (catch python/Exception _ nil))]
            (when result (store-results! storage generation [[key result]]))
            result)))))

(defn environment-paths
  "Return the selected interpreter's import roots without importing dependencies."
  ([] (environment-paths {}))
  ([opts] (or (:paths (environment-info opts)) [])))

(defn environment-version
  "Return [major minor] for the selected interpreter, or nil when unavailable.
  Shares the environment-paths query and does not import project dependencies."
  ([] (environment-version {}))
  ([opts] (:version (environment-info opts))))

(defn inspect-modules
  "Inspect modules in one subprocess, returning a string-keyed metadata map.

  Options: :python-executable, :python-paths (static project search roots),
  :python-inspection? (default true), :python-timeout (seconds, default 5),
  :python-cache (create-cache result, otherwise a bounded shared fallback).
  Local and imported source edits invalidate entries; transient failures retry
  after a short cooldown to avoid stalling every file in a workspace."
  ([modules] (inspect-modules modules {}))
  ([modules opts]
   (let [storage (or (:python-cache opts) cache)
         opts (options opts)
         generation (get (meta @storage) :generation 0)
         keyed (mapv #(vector % (cache-key % opts)) (distinct modules))
         missing (filterv #(not (fresh? (get @storage (second %)))) keyed)
         results (when (seq missing) (inspect-batch (mapv first missing) opts storage))
         additions (mapv (fn [[module key]]
                           [key (get results module (unknown module "missing-result"))]) missing)
         combined (into @storage additions)]
     (when (seq additions)
       (store-results! storage generation additions))
     (into {} (map (fn [[module key]] [module (get combined key)]) keyed)))))

(defn inspect-module
  "Inspect one module; use inspect-modules to prefetch a file's imports."
  ([module] (inspect-module module {}))
  ([module opts] (get (inspect-modules [module] opts) module)))

(def ^:private inspected-operators
  #{"__add__" "__radd__" "__sub__" "__rsub__" "__mul__" "__rmul__" "__truediv__" "__rtruediv__"})

(defn resolve-member
  "Return member metadata, nil for a certainly missing member, or :unknown.

  Dynamic modules/classes and unavailable metadata never imply absence."
  [metadata member]
  (or (get (:members metadata) member)
      (when (or (and (.startswith member "_")
                     (not (and (= :class (:kind metadata)) (contains? inspected-operators member))))
                (not= :known (:status metadata))
                (not (:members-complete? metadata)))
        (unknown member "dynamic-or-unavailable"))))

(defn- signature-text [params returns]
  (loop [remaining (seq params) parts [] star? false]
    (if-let [param (first remaining)]
      (let [kind (:kind param)
            variadic? (contains? #{:var-positional :var-keyword} kind)
            parts (if (and (= :keyword-only kind) (not star?)) (conj parts "*") parts)
            part (str (case kind :var-positional "*" :var-keyword "**" "")
                      (:name param)
                      (when (:annotation param) (str ": " (:annotation param)))
                      (when (and (not (:required? param)) (not variadic?)) "=..."))
            parts (conj parts part)
            parts (if (and (= :positional-only kind)
                           (not= :positional-only (:kind (second remaining))))
                    (conj parts "/") parts)]
        (recur (next remaining) parts (or star? variadic? (= :keyword-only kind))))
      (str "(" (str/join ", " parts) ")" (when returns (str " -> " returns))))))

(defn bind-member
  "Remove the receiver from instance signatures, including every overload."
  [metadata]
  (let [metadata (cond-> metadata
                   (:union-members metadata) (update :union-members #(mapv bind-member %)))
        metadata (if (:instance-method? metadata)
                   (let [metadata (assoc metadata :instance-method? false :bound? true)]
                     (if (contains? metadata :parameters)
                       (let [params (vec (rest (:parameters metadata)))]
                         (assoc metadata :parameters params
                                :signature (signature-text params (:return-type metadata))))
                       metadata))
                   metadata)]
    (if (seq (:overloads metadata))
      (let [overloads (mapv bind-member (:overloads metadata))]
        (assoc metadata :overloads overloads
               :signature (str/join "\n" (keep :signature overloads))))
      metadata)))

(defn return-type
  "Return structured inferred type information without evaluating annotations."
  [metadata]
  (when (some? metadata)
    (if (or (:module metadata) (:union metadata) (:typevar metadata)
            (:any? metadata) (:never? metadata) (:ellipsis? metadata)
            (:parameter-list? metadata) (:type-pack? metadata))
      (if (:type-module metadata)
        (return-type (dissoc metadata :typevar))
        (cond-> (select-keys metadata [:module :path :arguments :union :nullable?
                                       :typevar :bound :constraints :default :literal-values
                                       :any? :never? :ellipsis? :parameter-spec? :variadic? :unpack?
                                       :parameter-part :parameter-list? :type-pack? :callable-overloads])
          (and (:parameter-list? metadata) (contains? metadata :parameters)) (assoc :parameters (:parameters metadata))
          (contains? metadata :type-arguments) (assoc :arguments (mapv return-type (:type-arguments metadata)))
          (:type-bound metadata) (assoc :bound (return-type (:type-bound metadata)))
          (:type-constraints metadata) (assoc :constraints (mapv return-type (:type-constraints metadata)))
          (:type-default metadata) (assoc :default (return-type (:type-default metadata)))))
      (let [result (cond-> {}
                     (:type-module metadata) (assoc :module (:type-module metadata) :path (:type-path metadata))
                     (contains? metadata :type-arguments) (assoc :arguments (mapv return-type (:type-arguments metadata)))
                     (seq (:type-union metadata)) (assoc :union (mapv return-type (:type-union metadata)))
                     (:nullable? metadata) (assoc :nullable? true)
                     (contains? metadata :literal-values) (assoc :literal-values (:literal-values metadata))
                     (:type-any? metadata) (assoc :any? true)
                     (:type-never? metadata) (assoc :never? true)
                     (:type-ellipsis? metadata) (assoc :ellipsis? true)
                     (:parameter-spec? metadata) (assoc :parameter-spec? true)
                     (:variadic? metadata) (assoc :variadic? true)
                     (:unpack? metadata) (assoc :unpack? true)
                     (:parameter-part metadata) (assoc :parameter-part (:parameter-part metadata))
                     (:parameter-list? metadata) (assoc :parameter-list? true)
                     (:type-pack? metadata) (assoc :type-pack? true))]
        (when (seq result) result)))))

(defn- type-metadata [type]
  (cond-> {}
    (:module type) (assoc :type-module (:module type) :type-path (:path type))
    (:arguments type) (assoc :type-arguments (mapv type-metadata (:arguments type)))
    (:union type) (assoc :type-union (mapv type-metadata (:union type)))
    (:typevar type) (assoc :typevar (:typevar type))
    (:bound type) (assoc :type-bound (type-metadata (:bound type)))
    (:constraints type) (assoc :type-constraints (mapv type-metadata (:constraints type)))
    (:default type) (assoc :type-default (type-metadata (:default type)))
    (:nullable? type) (assoc :nullable? true)
    (contains? type :literal-values) (assoc :literal-values (:literal-values type))
    (:any? type) (assoc :type-any? true)
    (:never? type) (assoc :type-never? true)
    (:ellipsis? type) (assoc :type-ellipsis? true)
    (:parameter-spec? type) (assoc :parameter-spec? true)
    (:variadic? type) (assoc :variadic? true)
    (:unpack? type) (assoc :unpack? true)
    (:parameter-part type) (assoc :parameter-part (:parameter-part type))
    (:parameter-list? type) (assoc :parameter-list? true)
    (:type-pack? type) (assoc :type-pack? true)
    (:parameters type) (assoc :parameters (:parameters type))
    (:callable-overloads type) (assoc :callable-overloads (:callable-overloads type))))

(def ^:private type-keys
  [:type-module :type-path :type-arguments :type-union :typevar :type-bound
   :type-constraints :type-default :nullable? :literal-values :type-any? :type-never?
   :type-ellipsis? :parameter-spec? :variadic? :unpack? :parameter-part :parameter-list? :type-pack?])

(def ^:private none-type {:module "builtins" :path ["NoneType"]})

(defn union-type
  "Combine known types, retaining nullability. An unknown branch stays unknown."
  [types]
  (when (and (seq types) (every? some? types) (not-any? :any? types))
    (let [flat (mapcat #(or (:union %) [%]) types)
          nullable? (some #(or (:nullable? %) (= none-type (dissoc % :literal-values))) flat)
          values (vec (distinct (remove #(or (= none-type %) (:never? %))
                                        (map #(dissoc % :nullable?) flat))))
          result (case (count values)
                   0 (if nullable? none-type {:never? true})
                   1 (first values)
                   {:union values})]
      (cond-> result (and nullable? (seq values)) (assoc :nullable? true)))))

(defn- variants [type]
  (cond-> (vec (or (:union type) [(dissoc type :nullable?)]))
    (:nullable? type) (conj none-type)))

(defn- every-compatible [values]
  (cond (some false? values) false
        (every? true? values) true
        :else nil))

(defn- any-compatible [values]
  (cond (some true? values) true
        (every? false? values) false
        :else nil))

(declare type-compatible? structural-compatible? callable-metadata callable-compatible?)

(defn widen-literals
  "Widen inferred mutable container element literals without changing declared annotations."
  [type]
  (when type
    (let [result (if (:union type)
                   (union-type (map widen-literals (variants type)))
                   (dissoc type :literal-values))]
      (cond-> result
        (:arguments result) (assoc :arguments (mapv widen-literals (:arguments result)))))))

(def ^:private persistent-collection-bases
  {["basilisp.lang.vector" "PersistentVector"] #{"Iterable" "Sequence" "Collection" "Sized" "Container"}
   ["basilisp.lang.map" "PersistentMap"] #{"Iterable" "Mapping" "Collection" "Sized" "Container"}
   ["basilisp.lang.list" "PersistentList"] #{"Iterable" "Sized"}
   ["basilisp.lang.set" "PersistentSet"] #{"Iterable" "Set" "Collection" "Sized" "Container"}
   ["basilisp.lang.queue" "PersistentQueue"] #{"Iterable" "Sized"}
   ["basilisp.lang.seq" "Cons"] #{"Iterable"}
   ["basilisp.lang.seq" "LazySeq"] #{"Iterable"}
   ["basilisp.lang.seq" "_EmptySequence"] #{"Iterable"}})

(defn- invariant-variants [type]
  (if (seq (:literal-values type))
    ;; Heterogeneous Literal values are stored on their union wrapper. Split
    ;; the values first so Literal[1, "x"] never widens to int | str here.
    (map (fn [value]
           (if (nil? value) none-type
               {:module "builtins" :path [(.-__name__ (python/type value))] :literal-values [value]}))
         (:literal-values type))
    (mapcat (fn [branch]
              (if (or (:union branch) (:nullable? branch) (:literal-values branch))
                (invariant-variants branch) [branch]))
            (variants type))))

(defn- invariant-compatible?
  "Compare invariant arguments by meaning; unresolved nested arguments stay unknown."
  [actual expected]
  (cond
    (= actual expected) true
    (or (nil? actual) (nil? expected) (:any? actual) (:any? expected)
        (:typevar actual) (:typevar expected)) nil
    (or (:union actual) (:nullable? actual) (:union expected) (:nullable? expected)
        (> (count (:literal-values actual)) 1) (> (count (:literal-values expected)) 1))
    (let [actuals (invariant-variants actual) expecteds (invariant-variants expected)
          covered? (fn [sources targets]
                     (every-compatible
                      (map (fn [source]
                             (any-compatible (map (fn [target]
                                                    (let [result (type-compatible? source target)]
                                                      (if (nil? result) (invariant-compatible? source target) result))) targets))) sources)))]
      (every-compatible [(covered? actuals expecteds) (covered? expecteds actuals)]))
    (not= (dissoc actual :arguments :literal-values) (dissoc expected :arguments :literal-values)) false
    (= none-type (dissoc actual :literal-values)) true
    (or (:literal-values actual) (:literal-values expected))
    (and (= (count (:literal-values actual)) (count (:literal-values expected)))
         (every? true? (map #(and (= (python/type %1) (python/type %2)) (= %1 %2))
                            (:literal-values actual) (:literal-values expected))))
    (or (not (contains? actual :arguments)) (not (contains? expected :arguments))) nil
    (not= (count (:arguments actual)) (count (:arguments expected))) false
    :else (every-compatible (map invariant-compatible? (:arguments actual) (:arguments expected)))))

(defn- generic-compatible? [actual expected invariant? compare]
  (cond
    (empty? expected) true
    (or (empty? actual) (not= (count actual) (count expected))) nil
    invariant?
    (every-compatible (map invariant-compatible? actual expected))
    :else (every-compatible (map compare actual expected))))

(defn- collection-arguments [actual expected]
  (let [kind (first (:path actual)) target (first (:path expected))]
    (cond
      (and (= "builtins" (:module actual)) (= "tuple" kind)
           (contains? #{"Iterable" "Sequence" "Collection" "Container"} target))
      [(if (:ellipsis? (last (:arguments actual))) (first (:arguments actual))
           (union-type (:arguments actual)))]
      (and (= "builtins" (:module actual)) (contains? #{"str" "bytes" "range"} kind))
      [{:module "builtins" :path [(if (= "str" kind) "str" "int")]}]
      (contains? #{"Iterable" "Collection" "Container" "Set" "Sequence" "MutableSequence" "MutableSet"} target)
      (when (seq (:arguments actual)) [(first (:arguments actual))])
      :else (:arguments actual))))

(def ^:private builtin-value-types
  #{"bool" "int" "float" "complex" "str" "bytes" "bytearray" "memoryview"
    "list" "dict" "tuple" "set" "frozenset" "range" "NoneType" "object" "type"})

(defn- basic-type-compatible?
  "Conservative assignability: true, false, or nil when static evidence is insufficient."
  [actual expected compare opts]
  (cond
    (or (nil? actual) (nil? expected) (:any? actual) (:any? expected)) nil
    (= actual expected) true
    (:never? actual) true
    (:never? expected) false
    (:typevar expected) (cond
                          (:constraints expected) (any-compatible (map #(compare actual %) (:constraints expected)))
                          (:bound expected) (compare actual (:bound expected))
                          :else nil)
    (:typevar actual) (when (:bound actual) (compare (:bound actual) expected))
    (or (:union actual) (:nullable? actual))
    (every-compatible (map #(compare % expected) (variants actual)))
    (or (:union expected) (:nullable? expected))
    (any-compatible (map #(compare actual %) (variants expected)))
    (:literal-values expected)
    (when (contains? actual :literal-values)
      (every? (fn [value]
                (some #(and (= (python/type value) (python/type %)) (= value %))
                      (:literal-values expected))) (:literal-values actual)))
    (and (= "builtins" (:module expected)) (= ["object"] (:path expected))) true
    (and (= "collections.abc" (:module actual)) (= ["Callable"] (:path actual))
         (= "collections.abc" (:module expected)) (= ["Callable"] (:path expected)))
    (callable-compatible? actual expected opts)
    (or (:parameter-list? actual) (:parameter-list? expected) (:ellipsis? actual) (:ellipsis? expected)) nil
    (and (= (:module actual) (:module expected)) (= (:path actual) (:path expected)))
    (cond
      (and (= "builtins" (:module expected)) (= ["tuple"] (:path expected))
           (contains? actual :arguments) (= 2 (count (:arguments expected)))
           (:ellipsis? (second (:arguments expected)))
           (not-any? #(or (:unpack? %) (:ellipsis? %)) (:arguments actual)))
      (every-compatible (map #(compare % (first (:arguments expected))) (:arguments actual)))
      (and (= "builtins" (:module expected)) (= ["tuple"] (:path expected))
           (contains? actual :arguments) (contains? expected :arguments)
           (not-any? #(or (:unpack? %) (:ellipsis? %)) (concat (:arguments actual) (:arguments expected)))
           (not= (count (:arguments actual)) (count (:arguments expected)))) false
      :else
      (generic-compatible? (:arguments actual) (:arguments expected)
                           (and (= "builtins" (:module expected))
                                (contains? #{"list" "dict" "set"} (first (:path expected)))) compare))
    (get persistent-collection-bases [(:module actual) (first (:path actual))])
    (let [bases (get persistent-collection-bases [(:module actual) (first (:path actual))])]
      (cond
        (= "builtins" (:module expected)) false
        (and (= "collections.abc" (:module expected))
             (contains? #{"Iterable" "Iterator" "Sequence" "MutableSequence" "Mapping" "MutableMapping"
                          "Set" "MutableSet" "Collection" "Sized" "Container"} (first (:path expected))))
        (if (contains? bases (first (:path expected)))
          (generic-compatible? (collection-arguments actual expected) (:arguments expected) false compare)
          false)
        :else nil))
    (and (= "builtins" (:module actual)) (= "builtins" (:module expected)))
    (let [a (first (:path actual)) e (first (:path expected))]
      (cond
        (contains? #{"float" "complex"} e) (contains? (if (= e "float") #{"bool" "int" "float"} #{"bool" "int" "float" "complex"}) a)
        (and (= e "int") (= a "bool")) true
        ;; Other builtin families (notably exceptions) have real subclass
        ;; relationships. Resolve their ancestry before proving a mismatch.
        (and (contains? builtin-value-types a) (contains? builtin-value-types e)) false
        :else nil))
    (and (= "builtins" (:module actual)) (= "collections.abc" (:module expected)))
    (let [a (first (:path actual)) e (first (:path expected))
          known {"Iterable" #{"list" "tuple" "set" "frozenset" "dict" "str" "bytes" "range"}
                 "Sequence" #{"list" "tuple" "str" "bytes" "range"}
                 "Collection" #{"list" "tuple" "set" "frozenset" "dict" "str" "bytes" "range"}
                 "Mapping" #{"dict"} "MutableMapping" #{"dict"}
                 "MutableSequence" #{"list"} "Set" #{"set" "frozenset"} "MutableSet" #{"set"}
                 "Container" #{"list" "tuple" "set" "frozenset" "dict" "str" "bytes" "range"}
                 "Sized" #{"list" "tuple" "set" "frozenset" "dict" "str" "bytes" "range"}}]
      (when-let [accepted (get known e)]
        (if (contains? accepted a)
          (generic-compatible? (collection-arguments actual expected) (:arguments expected)
                               (contains? #{"MutableSequence" "MutableMapping" "MutableSet"} e) compare)
          false)))
    :else nil))

(defn type-compatible?
  "Conservative assignability, optionally resolving class inheritance and protocols."
  ([actual expected] (basic-type-compatible? actual expected type-compatible? {}))
  ([actual expected opts]
   (let [result (basic-type-compatible? actual expected type-compatible? {})]
     (if (some? result)
       result
       (let [comparisons (or (::type-comparisons opts) (atom {}))
             opts (assoc opts ::type-comparisons comparisons)
             ;; Depth is part of the budget: a deep unknown must not hide a
             ;; later, shallower path through the same inheritance diamond.
             key [actual expected (get opts :python-type-depth 0)]
             cached (get @comparisons key ::unseen)]
         (if (= ::unseen cached)
           (do
             (swap! comparisons assoc key ::pending)
             (let [resolved (basic-type-compatible? actual expected
                                                    #(type-compatible? %1 %2 opts) opts)
                   result (if (some? resolved) resolved
                              (structural-compatible? actual expected opts))]
               (swap! comparisons assoc key result)
               result))
           (when (not= ::pending cached) cached)))))))

(declare type-label substitute-metadata substitute-type)

(defn- substitute-arguments [arguments bindings]
  (vec (mapcat (fn [argument]
                 (let [replacement (substitute-type argument bindings)]
                   (if (and (:unpack? argument) (:type-pack? replacement))
                     (:arguments replacement)
                     [replacement]))) arguments)))

(defn- substitute-type [type bindings]
  (cond
    (:typevar type) (or (get bindings (:typevar type)) (:default type) (:bound type) type)
    :else (cond-> type
            (:arguments type) (assoc :arguments (substitute-arguments (:arguments type) bindings))
            (:parameters type) (assoc :parameters (substitute-metadata (:parameters type) bindings))
            (:callable-overloads type) (assoc :callable-overloads (mapv #(substitute-type % bindings) (:callable-overloads type)))
            (:union type) (assoc :union (mapv #(substitute-type % bindings) (:union type))))))

(defn- forwarded-parameters [original substituted bindings]
  (vec (mapcat
        (fn [[before after]]
          (let [captured (get bindings (:typevar before))
                part (:parameter-part before)]
            (if (and part (:parameter-list? captured) (:parameters captured))
              (filter (fn [parameter]
                        (if (= "args" part)
                          (contains? #{:positional-only :positional-or-keyword :var-positional} (:kind parameter))
                          (contains? #{:keyword-only :var-keyword} (:kind parameter))))
                      (:parameters captured))
              [after])))
        (map vector original substituted))))

(defn- substitution-needed? [value bindings memo]
  (when (or (map? value) (vector? value))
    (let [storage (:needed memo) key (python/id value)]
      (if-let [cached (get storage key)]
        (second cached)
        (let [needed (boolean (or (and (map? value)
                                       (contains? bindings (if (:type-self? value) "__Self__" (:typevar value))))
                                  (some #(substitution-needed? % bindings memo)
                                        (if (map? value) (vals value) value))))]
          (.__setitem__ storage key [value needed])
          needed)))))

(defn- substitute-metadata
  ([value bindings] (substitute-metadata value bindings {:values (python/dict) :needed (python/dict)}))
  ([value bindings memo]
   ;; Inspection metadata is a shared graph. Specialize each immutable node once
   ;; instead of expanding repeated generic declarations into a much larger tree.
   (if-not (substitution-needed? value bindings memo)
     value
     (if-let [cached (get (:values memo) (python/id value))]
       (second cached)
       (let [result (cond
                      (map? value)
                      (let [result (into {} (map (fn [[key item]] [key (substitute-metadata item bindings memo)]) value))
                            replacement (get bindings (if (:type-self? value) "__Self__" (:typevar value)))
                            result (if replacement
                                     (merge (apply dissoc result (conj type-keys :type-self?)) (type-metadata replacement))
                                     result)
                            result (cond-> result
                                     (:type-arguments value)
                                     (assoc :type-arguments
                                            (vec (mapcat (fn [[before after]]
                                                           (if (and (:unpack? before) (:type-pack? after))
                                                             (:type-arguments after) [after]))
                                                         (map vector (:type-arguments value) (:type-arguments result)))))
                                     (:parameters value)
                                     (assoc :parameters (forwarded-parameters (:parameters value) (:parameters result) bindings)))
                            inferred (when (or (:annotation value) (:return-type value)) (return-type result))
                            result (cond-> result
                                     (and inferred (:annotation value)) (assoc :annotation (type-label inferred))
                                     (and inferred (:return-type value)) (assoc :return-type (type-label inferred)))]
                        (if (:parameters result)
                          (assoc result :signature (signature-text (:parameters result) (:return-type result)))
                          result))
                      (vector? value) (mapv #(substitute-metadata % bindings memo) value)
                      :else value)]
         (when (or (map? value) (vector? value))
           (.__setitem__ (:values memo) (python/id value) [value result]))
         result)))))

(defn- callable-ref? [type]
  (and (= "collections.abc" (:module type)) (= ["Callable"] (:path type))))

(defn- parameter-list [parameters]
  {:parameter-list? true :parameters (vec parameters)
   :arguments (mapv return-type parameters)})

(declare call-return-type)

(defn callable-type
  "Represent a Python function value with its complete call signature. Classes produce type[T]."
  [metadata]
  (cond
    (= :class (:kind metadata))
    (when-let [type (return-type metadata)]
      {:module "builtins" :path ["type"] :arguments [type]})
    (= :function (:kind metadata))
    (cond-> {:module "collections.abc" :path ["Callable"]
             :arguments [(when (contains? metadata :parameters) (parameter-list (:parameters metadata)))
                         (call-return-type metadata)]}
      (seq (:overloads metadata))
      (assoc :callable-overloads (mapv #(callable-type (assoc % :kind :function)) (:overloads metadata))))
    :else (when (callable-ref? (return-type metadata)) (return-type metadata))))

(defn- fixed-tuple-arguments [arguments]
  ;; A concrete Unpack contributes its elements, not one tuple-valued argument.
  (if-not (some :unpack? arguments)
    arguments
    (vec (mapcat (fn [argument]
                   (if (and (:unpack? argument) (= "builtins" (:module argument))
                            (= ["tuple"] (:path argument)) (contains? argument :arguments)
                            (not-any? :ellipsis? (:arguments argument)))
                     (fixed-tuple-arguments (:arguments argument))
                     [argument])) arguments))))

(defn- homogeneous-unpack? [type]
  (and (:unpack? type) (= "builtins" (:module type)) (= ["tuple"] (:path type))
       (= 2 (count (:arguments type))) (:ellipsis? (second (:arguments type)))))

(defn- positional-pattern [parameters]
  (vec (mapcat (fn [parameter]
                 (let [type (return-type parameter)]
                   (case (:kind parameter)
                     (:positional-only :positional-or-keyword) [type]
                     :var-positional [(if (:unpack? type) type
                                          {:module "builtins" :path ["tuple"] :unpack? true
                                           :arguments [type {:ellipsis? true}]})]
                     []))) parameters)))

(defn- callable-parameters [type]
  (cond
    (:parameter-list? type)
    (if (contains? type :parameters)
      (:parameters type)
      (let [arguments (fixed-tuple-arguments (:arguments type))]
        (cond
          ;; Unresolved packs acquire a call shape only after generic inference.
          (some #(and (:unpack? %) (not (homogeneous-unpack? %))) arguments) nil
          (some :unpack? arguments)
          [(merge {:name "args" :kind :var-positional :required? false}
                  (type-metadata {:module "builtins" :path ["tuple"] :unpack? true :arguments arguments}))]
          :else
          (mapv (fn [index argument]
                  (merge {:name (str "arg" index) :kind :positional-only :required? true}
                         (type-metadata argument)))
                (range (count arguments)) arguments))))
    (and (= "typing" (:module type)) (= ["Concatenate"] (:path type)))
    (when-let [tail (callable-parameters (last (:arguments type)))]
      (into (mapv (fn [index argument]
                    (merge {:name (str "prefix" index) :kind :positional-only :required? true}
                           (type-metadata argument)))
                  (range (dec (count (:arguments type)))) (butlast (:arguments type)))
            tail))
    :else nil))

(defn callable-metadata
  "Recover call metadata from an annotated or inferred Callable value."
  [type]
  (when (callable-ref? type)
    (let [parameters (callable-parameters (first (:arguments type)))
          result (second (:arguments type))]
      (cond-> (merge {:status :known :kind :function :name "<callable>"} (type-metadata result))
        (some? parameters) (assoc :parameters parameters
                                  :signature (signature-text parameters (type-label result)))
        (seq (:callable-overloads type))
        (assoc :overloads (mapv callable-metadata (:callable-overloads type)))))))

(declare infer-arguments)

(defn specialize
  "Substitute a receiver's generic arguments throughout its class/member metadata."
  [metadata receiver]
  (let [parameters (:type-parameters metadata)
        expected (mapv #(cond-> (return-type %) (:variadic? %) (assoc :unpack? true)) parameters)
        bindings (if (contains? receiver :arguments)
                   (infer-arguments {} expected (:arguments receiver)) {})]
    (if (seq bindings) (substitute-metadata metadata (assoc bindings "__Self__" receiver)) metadata)))

(declare inspect-path inspect-member inherited-metadata)

(defn- merge-members [members]
  (when (and (seq members) (every? some? members))
    (let [first-member (first members)
          type (union-type (map return-type members))]
      (merge (apply dissoc first-member type-keys)
             (type-metadata type)
             {:union-members (vec members)}))))

(defn inspect-type
  "Resolve a type, specializing generics and retaining only common union members."
  ([metadata] (inspect-type metadata {}))
  ([metadata opts]
   (when-let [type (return-type metadata)]
     (cond
       (:union type)
       (let [types (keep #(inspect-type % opts) (:union type))]
         (when (= (count types) (count (:union type)))
           (let [names (filter (fn [name] (every? #(contains? (:members %) name) types))
                               (keys (:members (first types))))]
             {:status :known :kind :class :members-complete? false
              :members (into {} (map (fn [name]
                                       [name (merge-members (map #(get (:members %) name) types))]) names))})))
       (:typevar type) (when-let [bound (or (:bound type) (:default type))]
                         (inspect-type bound opts))
       (and (:module type) (seq (:path type)))
       (some-> (inspect-path (:module type) (:path type) (dissoc opts :instance?))
               (inherited-metadata opts)
               (specialize type))))))

(defn- inherited-metadata [metadata opts]
  (if (and (seq (:unresolved-bases metadata)) (< (get opts :python-type-depth 0) 8))
    (let [opts (update opts :python-type-depth (fnil inc 0))
          parents (keep #(inspect-type % opts) (:unresolved-bases metadata))
          inherited (reduce (fn [members parent] (merge members (:members parent))) {} (reverse parents))]
      (assoc metadata :members (merge inherited (:members metadata)) :unresolved-bases []))
    metadata))

(defn inspect-member
  "Resolve a bound member on generic/union receivers without executing a descriptor."
  ([type member] (inspect-member type member {}))
  ([type member opts]
   (if (and (:module type) (not (:union type)) (not (:typevar type)))
     (when-let [owner (some-> (inspect-path (:module type) (:path type) (dissoc opts :instance?))
                              (inherited-metadata opts))]
       (when-let [child (resolve-member owner member)]
         (-> (assoc child :type-parameters (:type-parameters owner) :receiver-type type)
             (specialize type)
             bind-member)))
     (if-let [owner (inspect-type type opts)]
       (some-> (resolve-member owner member) bind-member)
       (unknown member "unknown-receiver-type")))))

(defn- dereference-member [metadata opts]
  (let [depth (get opts :python-resolution-depth 0)]
    (cond
      (> depth 24) (unknown (:name metadata) "cyclic-python-alias")
      (:target-module metadata)
      (inspect-path (:target-module metadata) (:target-path metadata)
                    (assoc opts :python-resolution-depth (inc depth)))
      (and (:target metadata) (not (:members metadata)))
      (inspect-module (:target metadata) opts)
      :else metadata)))

(defn- package-child [metadata member opts]
  ;; Basilisp initialization and earlier imports can load a package child that
  ;; is absent from the isolated worker. Resolve source files without importing.
  (when (and (= :module (:kind metadata)) (seq (:package-paths metadata))
             (not (str/includes? member "."))
             (local-file member (:package-paths metadata)))
    (let [depth (count (str/split (:name metadata) #"\."))
          roots (mapv (fn [path]
                        (str (nth (iterate #(.-parent %) (pathlib/Path path)) depth)))
                      (:package-paths metadata))]
      (inspect-module (str (:name metadata) "." member)
                      (assoc opts :python-paths (into (vec (:python-paths opts)) roots)
                             :python-inspection? false)))))

(defn inspect-path
  "Resolve members and reexports without executing descriptors.

  :instance? binds the final method to an inferred receiver. Annotated property
  results and module-valued members can be traversed lazily."
  ([module path] (inspect-path module path {}))
  ([module path opts]
   (loop [metadata (inspect-module module opts) remaining (seq path)]
     (let [metadata (dereference-member metadata opts)]
       (if-let [part (first remaining)]
         (let [owner (if (and (not (:members metadata)) (return-type metadata))
                       (or (inspect-type metadata opts) metadata) metadata)
               child (when owner
                       (or (get (:members owner) part)
                           (package-child owner part opts)
                           (resolve-member owner part)))
               child (if (contains? #{:variable :property} (:kind metadata))
                       (some-> child bind-member) child)]
           (when child (recur child (next remaining))))
         (if (:instance? opts) (bind-member metadata) metadata))))))

(declare check-call unpacked-call-signature)

(defn- check-single-call
  "Validate positional/keyword binding only when a signature is known.

  Return clj-kondo-shaped :invalid-arity problems. Types are deliberately
  not guessed, and missing runtime signature metadata is not an error."
  [metadata positional-count keyword-names]
  (if (seq (:overloads metadata))
    (let [results (mapv #(check-call % positional-count keyword-names) (:overloads metadata))]
      (cond
        (some #(= [] %) results) []
        (some nil? results) nil
        :else (first results)))
    (when (contains? metadata :parameters)
      (let [params (:parameters metadata)
            positional (filterv #(contains? #{:positional-only :positional-or-keyword}
                                            (:kind %)) params)
            by-name (into {} (map #(vector (:name %) %) params))
            assigned (set (map :name (take positional-count positional)))
            keys (set keyword-names)
            var-positional? (some #(= :var-positional (:kind %)) params)
            var-keyword? (some #(= :var-keyword (:kind %)) params)
            problem (cond
                      (and (not var-positional?) (> positional-count (count positional)))
                      (str "Expected at most " (count positional)
                           " positional arguments, received " positional-count)

                      (not= (count keys) (count keyword-names))
                      "Duplicate Python keyword argument"

                      :else
                      (or
                       (some (fn [key]
                               (let [param (get by-name key)]
                                 (cond
                                   (and param (= :positional-or-keyword (:kind param))
                                        (contains? assigned key))
                                   (str "Multiple values for Python argument '" key "'")

                                   (and (not var-keyword?)
                                        (or (nil? param)
                                            (not (contains? #{:positional-or-keyword :keyword-only}
                                                            (:kind param)))))
                                   (str "Unexpected Python keyword argument '" key "'"))))
                             keyword-names)
                       (some (fn [param]
                               (when (and (:required? param)
                                          (not (and (contains? #{:positional-only :positional-or-keyword} (:kind param))
                                                    (contains? assigned (:name param))))
                                          (not (and (not= :positional-only (:kind param))
                                                    (contains? keys (:name param)))))
                                 (str "Missing required Python argument '" (:name param) "'")))
                             params)))]
        (if problem
          [{:type :invalid-arity :message problem}]
          [])))))

(defn check-call
  "Validate binding for every possible receiver, accepting any matching overload."
  [metadata positional-count keyword-names]
  (if (seq (:union-members metadata))
    (let [results (mapv #(check-call % positional-count keyword-names) (:union-members metadata))]
      (or (first (filter seq results)) (when (every? some? results) [])))
    (let [prepared (unpacked-call-signature metadata (vec (repeat positional-count nil)))]
      (if-let [message (:arity-error prepared)]
        [{:type :invalid-arity :message message}]
        (check-single-call (:signature prepared) positional-count keyword-names)))))

(defn- fixed-signature-compatible? [actual expected opts]
  (let [e (bind-member expected)
        ep (:parameters e)
        positional? #(contains? #{:positional-only :positional-or-keyword} (:kind %))
        epos (filterv positional? ep)
        prepared (unpacked-call-signature (bind-member actual) (mapv return-type epos))
        a (:signature prepared) ap (:parameters a)
        apos (filterv positional? ap)
        ekw (filterv #(= :keyword-only (:kind %)) ep)
        abyname (into {} (map #(vector (:name %) %) ap))
        avar (first (filter #(= :var-positional (:kind %)) ap))
        akw (first (filter #(= :var-keyword (:kind %)) ap))
        minimal (check-call a (count (filter :required? epos)) (map :name (filter :required? ekw)))
        full (check-call a (count epos) (map :name ekw))
        names-ok? (every? (fn [param]
                            (or akw
                                (let [other (get abyname (:name param))]
                                  (contains? #{:positional-or-keyword :keyword-only} (:kind other)))))
                          (filter #(contains? #{:positional-or-keyword :keyword-only} (:kind %)) ep))
        variadic-ok? (every? (fn [param]
                               (case (:kind param) :var-positional (some? avar) :var-keyword (some? akw) true)) ep)
        pairs (concat (map-indexed (fn [index param] [param (or (get apos index) avar)]) epos)
                      (map (fn [param] [param (or (get abyname (:name param)) akw)]) ekw))]
    (when (and ap ep)
      (if (or (:arity-error prepared) (seq minimal) (seq full) (not names-ok?) (not variadic-ok?))
        false
        (every-compatible
         (cons (type-compatible? (return-type a) (return-type e) opts)
               (map (fn [[required accepted]]
                      (type-compatible? (return-type required) (return-type accepted) opts)) pairs)))))))

(defn- positional-shape [signature]
  (when (contains? signature :parameters)
    (let [parameters (:parameters signature)
          fixed (count (filter #(contains? #{:positional-only :positional-or-keyword} (:kind %)) parameters))
          varargs (first (filter #(= :var-positional (:kind %)) parameters))
          type (return-type varargs)
          pattern (when (and (:unpack? type) (= "builtins" (:module type)) (= ["tuple"] (:path type)))
                    (fixed-tuple-arguments (:arguments type)))
          spreads (filter homogeneous-unpack? pattern)]
      (cond
        (nil? varargs) {:minimum fixed :unbounded? false}
        (not (:unpack? type)) {:minimum fixed :unbounded? true}
        (and (= 2 (count pattern)) (:ellipsis? (second pattern))) {:minimum fixed :unbounded? true}
        (and (some? pattern) (<= (count spreads) 1)
             (not-any? #(or (:ellipsis? %) (and (:unpack? %) (not (homogeneous-unpack? %)))) pattern))
        {:minimum (+ fixed (- (count pattern) (count spreads))) :unbounded? (boolean (seq spreads))}
        :else nil))))

(defn- signature-compatible? [actual expected opts]
  (let [e (bind-member expected)
        varargs (first (filter #(= :var-positional (:kind %)) (:parameters e)))]
    (if-not varargs
      (fixed-signature-compatible? actual expected opts)
      (when-let [shape (positional-shape e)]
        (let [a (bind-member actual)
              actual-shape (positional-shape a)
              minimum (:minimum shape)
              counts (if (:unbounded? shape) [minimum (inc minimum)] [minimum])]
          (cond
            (nil? actual-shape) nil
            (and (:unbounded? shape) (not (:unbounded? actual-shape))) false
            :else
            ;; Check both the shortest call and a repeated tail element. Prefix
            ;; and suffix contracts remain fixed; the homogeneous middle repeats.
            (every-compatible
             (map (fn [n]
                    (let [prepared (if (:unpack? (return-type varargs))
                                     (:signature (unpacked-call-signature e (vec (repeat n nil))))
                                     (assoc e :parameters
                                            (vec (mapcat (fn [parameter]
                                                           (if (= :var-positional (:kind parameter))
                                                             (repeat (- n minimum)
                                                                     (assoc parameter :kind :positional-only :required? true))
                                                             [parameter])) (:parameters e)))))]
                      (fixed-signature-compatible? a prepared opts))) counts))))))))

(defn- callable-compatible? [actual expected opts]
  (let [a (callable-metadata actual) e (callable-metadata expected)
        actuals (or (seq (:overloads a)) [a])
        expecteds (or (seq (:overloads e)) [e])]
    (every-compatible
     (map (fn [required]
            (any-compatible (map #(signature-compatible? % required opts) actuals)))
          expecteds))))

(defn- structural-compatible? [actual expected opts]
  (when (and (:module actual) (:module expected)
             (not= [(:module actual) (:path actual)] [(:module expected) (:path expected)])
             (< (get opts :python-type-depth 0) 12))
    (let [opts (update opts :python-type-depth (fnil inc 0))
          ;; Nominal checks need bases and type flags, not a specialization of
          ;; every method on large classes such as numpy.ndarray.
          summary (fn [type]
                    (some-> (inspect-path (:module type) (:path type) opts)
                            (select-keys (into type-keys [:status :kind :bases :type-parameters
                                                          :typed-dict? :typed-dict-fields :protocol? :nominal?]))
                            (specialize type)))
          a (summary actual)
          e (summary expected)
          a-class (when (= :class (:kind a)) (select-keys (return-type a) [:module :path]))
          e-class (when (= :class (:kind e)) (select-keys (return-type e) [:module :path]))]
      (when (and (= :known (:status a)) (= :known (:status e)))
        (cond
          (and (:module a-class) (seq (:path a-class)) (= a-class e-class))
          ;; Reexports name the same class; keep the caller's type arguments.
          (type-compatible? (merge actual a-class) (merge expected e-class))
          (and (= "builtins" (:module actual)) (= ["type"] (:path actual))
               (seq (:arguments actual)))
          ;; A class value is an instance of its metaclass, not necessarily the
          ;; builtin type class. Missing metaclass evidence remains unknown.
          (when-let [metaclass (:metaclass (inspect-type (first (:arguments actual)) opts))]
            (type-compatible? (return-type metaclass) expected opts))
          (:typed-dict? e)
          (when (:typed-dict? a)
            (every-compatible
             (map (fn [[name field]]
                    (if-let [provided (get (:typed-dict-fields a) name)]
                      (if (and (:required? field) (not (:required? provided)))
                        false
                        (type-compatible? (return-type provided) (return-type field) opts))
                      (if (:required? field) false nil)))
                  (:typed-dict-fields e))))
          (:protocol? e)
          (every-compatible
           (map (fn [[name member]]
                  (let [provided (inspect-member actual name opts)]
                    (cond
                      (nil? provided) false
                      (= :unknown (:status provided)) nil
                      (= :function (:kind member)) (signature-compatible? provided member opts)
                      :else (type-compatible? (return-type provided) (return-type member) opts))))
                (remove (fn [[name _]] (contains? #{"__init__" "__new__" "__class_getitem__"} name)) (:members (inspect-type expected opts)))))
          :else
          (let [object-type {:module "builtins" :path ["object"]}
                closed-nominal? (and (:nominal? a) (:nominal? e) a-class e-class
                                     (not= object-type a-class) (vector? (:bases a)))
                results (map (fn [base]
                               (let [type (return-type base)]
                                 ;; object is a complete terminal ancestor, while
                                 ;; an object-typed argument itself stays unknown.
                                 (if (and closed-nominal? (= object-type type))
                                   (= object-type e-class)
                                   (type-compatible? type expected opts)))) (:bases a))]
            (cond
              (some true? results) true
              (and closed-nominal? (every? false? results)) false
              :else nil)))))))

(defn- literal-tree? [value]
  (and (map? value) (or (contains? value :items) (contains? value :entries))))

(declare argument-compatible?)

(defn- literal-compatible? [expected tree opts]
  (let [arguments (:arguments expected)
        tuple? (and (= "builtins" (:module expected)) (= ["tuple"] (:path expected)))
        mapping? (or (and (= "builtins" (:module expected)) (= ["dict"] (:path expected)))
                     (and (= "collections.abc" (:module expected))
                          (contains? #{["Mapping"] ["MutableMapping"]} (:path expected))))
        compare-child (fn [child expected]
                        (argument-compatible? (:type child) expected (when (literal-tree? child) child) opts))]
    (cond
      (and tuple? (contains? expected :arguments))
      (cond
        (some :unpack? arguments) nil
        (and (= 2 (count arguments)) (:ellipsis? (second arguments)))
        (every-compatible (map #(compare-child % (first arguments)) (:items tree)))
        (some :ellipsis? arguments) nil
        (not= (count arguments) (count (:items tree))) false
        :else (every-compatible (map compare-child (:items tree) arguments)))
      (empty? arguments) true
      mapping?
      (when (= 2 (count arguments))
        (every-compatible
         (mapcat (fn [[key value]]
                   [(compare-child key (first arguments)) (compare-child value (second arguments))])
                 (:entries tree))))
      (= 1 (count arguments))
      (every-compatible
       (map #(compare-child % (first arguments))
            (if (contains? tree :entries) (map first (:entries tree)) (:items tree))))
      :else nil)))

(defn- argument-compatible? [actual expected fresh? opts]
  (cond
    (not fresh?) (type-compatible? actual expected opts)
    (or (:union expected) (:nullable? expected))
    (any-compatible (map #(argument-compatible? actual % fresh? opts) (variants expected)))
    (:typevar expected)
    (cond
      (:constraints expected) (any-compatible (map #(argument-compatible? actual % fresh? opts) (:constraints expected)))
      (:bound expected) (argument-compatible? actual (:bound expected) fresh? opts)
      :else (type-compatible? actual expected opts))
    (and (literal-tree? fresh?)
         (true? (type-compatible? (dissoc actual :arguments) (dissoc expected :arguments))))
    ;; Only literal syntax owns its children. References retain ordinary variance.
    (literal-compatible? expected fresh? opts)
    (and (= "builtins" (:module actual) (:module expected))
         (= (:path actual) (:path expected))
         (contains? #{["dict"] ["list"] ["set"]} (:path expected)))
    ;; The outer literal is new, but its children can refer to existing mutable values.
    ;; Contextualize only this container; nested types retain their normal variance.
    (let [actual-args (:arguments actual) expected-args (:arguments expected)]
      (cond
        (empty? expected-args) true
        (or (empty? actual-args) (not= (count actual-args) (count expected-args))) nil
        :else (every-compatible (map #(type-compatible? %1 %2 opts) actual-args expected-args))))
    :else (type-compatible? actual expected opts)))

(defn- argument-pairs [metadata positional-types keyword-types opts]
  (let [params (:parameters metadata)
        positional (filterv #(contains? #{:positional-only :positional-or-keyword} (:kind %)) params)
        varargs (first (filter #(= :var-positional (:kind %)) params))
        kwargs (first (filter #(= :var-keyword (:kind %)) params))
        by-name (into {} (map #(vector (:name %) %) (remove #(= :positional-only (:kind %)) params)))]
    (concat
     (map-indexed (fn [index actual]
                    [(return-type (or (get positional index) varargs)) actual
                     (or (get-in opts [:python-fresh-values :positional index])
                         (contains? (get-in opts [:python-fresh-arguments :positional]) index))]) positional-types)
     (map (fn [[name actual]]
            [(return-type (or (get by-name name) kwargs)) actual
             (or (get-in opts [:python-fresh-values :keywords name])
                 (contains? (get-in opts [:python-fresh-arguments :keywords]) name))]) keyword-types))))

(declare infer-bindings)

(defn- infer-arguments
  ([bindings expected actual] (infer-arguments bindings expected actual false))
  ([bindings expected actual upper?]
   (let [expected (fixed-tuple-arguments expected)
         actual (fixed-tuple-arguments actual)
         packs (vec (keep-indexed #(when (and (:unpack? %2) (:variadic? %2)) %1) expected))]
     (cond
       (or (> (count packs) 1)
           (and (seq packs) (some #(or (and (:unpack? %) (not (homogeneous-unpack? %)))
                                       (:ellipsis? %)) actual))) bindings
       (seq packs)
       (let [pack-index (first packs)
             suffix (- (count expected) pack-index 1)
             end (- (count actual) suffix)]
         (if (< end pack-index)
           bindings
           (let [pack (get expected pack-index)
                 captured (mapv #(if upper? % (dissoc % :literal-values))
                                (subvec (vec actual) pack-index end))
                 previous (get bindings (:typevar pack))
                 inferred (cond
                            (nil? previous) {:type-pack? true :arguments captured}
                            (some homogeneous-unpack? captured) previous
                            (some homogeneous-unpack? (:arguments previous)) {:type-pack? true :arguments captured}
                            (= (count (:arguments previous)) (count captured))
                            {:type-pack? true :arguments (mapv #(union-type [%1 %2]) (:arguments previous) captured)}
                            :else previous)
                 bindings (assoc bindings (:typevar pack) inferred)
                 pairs (concat (map vector (take pack-index expected) (take pack-index actual))
                               (map vector (drop (inc pack-index) expected) (drop end actual)))]
             (reduce (fn [result [e a]] (infer-bindings result e a upper?)) bindings pairs))))
       :else
       (reduce (fn [result [e a]] (infer-bindings result e a upper?)) bindings (map vector expected actual))))))

(defn- narrow-binding [candidate upper-bounds]
  ;; Retain every callback constraint so a later, narrower candidate can resolve
  ;; an earlier unknown intersection without depending on argument order.
  (or (first (filter (fn [candidate]
                       (every? #(true? (type-compatible? candidate %)) upper-bounds))
                     (cons candidate upper-bounds)))
      {:any? true}))

(defn- unresolved-type-variable? [type]
  (or (:typevar type)
      (some unresolved-type-variable? (:arguments type))
      (some unresolved-type-variable? (:union type))
      (some unresolved-type-variable? (:callable-overloads type))))

(defn- infer-bindings
  ([bindings expected actual] (infer-bindings bindings expected actual false))
  ([bindings expected actual upper?]
   (cond
     (or (nil? expected) (nil? actual) (:any? actual) (:parameter-part expected)
         (and (:unpack? expected) (:variadic? expected))) bindings
     ;; A polymorphic callback's variables belong to its own invocation. They
     ;; cannot replace concrete constraints already inferred for this call.
     (and (:typevar expected) (unresolved-type-variable? actual)) bindings
     (and (callable-ref? expected) (callable-ref? actual)
          (= 2 (count (:arguments expected))) (= 2 (count (:arguments actual))))
     (let [[expected-parameters expected-result] (:arguments expected)
           [actual-parameters actual-result] (:arguments actual)]
       (infer-bindings
        (infer-bindings bindings expected-parameters actual-parameters (not upper?))
        expected-result actual-result upper?))
     (and (= "typing" (:module expected)) (= ["Concatenate"] (:path expected))
          (:parameter-list? actual))
     (let [prefix (vec (butlast (:arguments expected)))
           parameters (callable-parameters actual)
           fixed (take (count prefix) parameters)]
       (if (or (nil? parameters) (< (count parameters) (count prefix))
               (some #(not (contains? #{:positional-only :positional-or-keyword} (:kind %))) fixed))
         bindings
         (infer-bindings
          (infer-arguments bindings prefix (mapv return-type fixed) upper?)
          (last (:arguments expected))
          (parameter-list (drop (count prefix) parameters)) upper?)))
     (:typevar expected)
     (let [name (:typevar expected)
           constraint (first (filter #(true? (type-compatible? actual %)) (:constraints expected)))
           upper? (and upper? (not (:parameter-spec? expected)) (not (:variadic? expected))
                       (empty? (:constraints expected)))
           inferred (if upper? actual (or constraint (dissoc actual :literal-values)))
           previous (get bindings name)
           upper-bounds (get-in (meta bindings) [::upper-bounds name])
           upper-bounds (if upper?
                          (vec (distinct (cond-> (conj (vec upper-bounds) inferred)
                                           (:bound expected) (conj (:bound expected)))))
                          upper-bounds)
           inferred (cond
                      (and previous (seq (:constraints expected)) (not= previous inferred)) {:never? true}
                      (and previous (not upper?)) (or (union-type [previous inferred]) previous)
                      :else inferred)
           value (if (seq upper-bounds) (narrow-binding inferred upper-bounds) inferred)
           bindings (if (seq upper-bounds)
                      (with-meta bindings (assoc-in (meta bindings) [::upper-bounds name] upper-bounds))
                      bindings)]
       (assoc bindings name value))
     (:union expected)
     (let [candidate (first (filter #(not (false? (type-compatible? actual %))) (:union expected)))]
       (if candidate (infer-bindings bindings candidate actual upper?) bindings))
     (and (:parameter-list? expected) (:parameter-list? actual) (:parameters actual))
     (infer-arguments bindings (:arguments expected) (positional-pattern (:parameters actual)) upper?)
     (and (seq (:arguments expected)) (contains? actual :arguments)
          (= (boolean (callable-ref? expected)) (boolean (callable-ref? actual))))
     (infer-arguments bindings (:arguments expected) (:arguments actual) upper?)
     :else bindings)))

(defn- unpacked-call-signature
  "Expand a single typed *args pack using supplied positions, without evaluating annotations."
  [signature positional-types]
  (let [parameters (:parameters signature)
        varargs (first (filter #(= :var-positional (:kind %)) parameters))
        annotation (return-type varargs)]
    (if-not (:unpack? annotation)
      {:signature signature :bindings {}}
      (let [pattern (when (:unpack? annotation)
                      (cond
                        (:variadic? annotation) [annotation]
                        (and (= "builtins" (:module annotation)) (= ["tuple"] (:path annotation)))
                        (fixed-tuple-arguments (:arguments annotation))))
            fixed (count (filter #(contains? #{:positional-only :positional-or-keyword} (:kind %)) parameters))
            supplied (vec (drop fixed positional-types))
            packs (filter #(and (:unpack? %) (:variadic? %)) pattern)
            spreads (filter #(or (and (:unpack? %) (:variadic? %)) (homogeneous-unpack? %)) pattern)
            homogeneous? (and (= 2 (count pattern)) (:ellipsis? (second pattern)))
            known? (and (some? pattern) (<= (count spreads) 1)
                        (not-any? #(and (:unpack? %) (not (:variadic? %)) (not (homogeneous-unpack? %))) pattern)
                        (or homogeneous? (not-any? :ellipsis? pattern)))
            minimum (if homogeneous? 0 (- (count pattern) (count spreads)))]
        (cond
          (not known?)
          {:signature (assoc signature :parameters
                             (mapv #(if (= :var-positional (:kind %))
                                      (apply dissoc % type-keys) %) parameters))
           :bindings {}}
          (< (count supplied) minimum)
          {:signature signature :bindings {}
           :arity-error (str "Expected at least " (+ fixed minimum) " positional arguments for unpacked Python parameters, received "
                             (count positional-types))}
          (and (empty? spreads) (not homogeneous?) (> (count supplied) (count pattern)))
          {:signature signature :bindings {}
           :arity-error (str "Expected at most " (+ fixed (count pattern)) " positional arguments for unpacked Python parameters, received "
                             (count positional-types))}
          :else
          (let [bindings (if (seq packs)
                           (select-keys (infer-arguments {} pattern supplied) (map :typevar packs)) {})
                expanded (if homogeneous?
                           (vec (repeat (count supplied) (first pattern)))
                           (vec (mapcat (fn [type]
                                          (cond
                                            (homogeneous-unpack? type)
                                            (repeat (- (count supplied) minimum) (first (:arguments type)))
                                            (and (:unpack? type) (get bindings (:typevar type)))
                                            (:arguments (get bindings (:typevar type)))
                                            :else [type])) pattern)))
                replacements (mapv (fn [index type]
                                     (merge {:name (str "*" (:name varargs) index)
                                             :kind :positional-only :required? true}
                                            (type-metadata type)))
                                   (range (count expanded)) expanded)
                parameters (vec (mapcat #(if (= :var-positional (:kind %)) replacements [%]) parameters))]
            {:signature (assoc signature :parameters parameters
                               :signature (signature-text parameters (:return-type signature)))
             :bindings bindings}))))))

(defn- callable-argument-branches [positional-types keyword-types]
  (reduce
   (fn [calls [kind key type]]
     (when calls
       (let [expanded (for [[positional keyword] calls candidate (:callable-overloads type)]
                        (if (= :positional kind)
                          [(assoc positional key candidate) keyword]
                          [positional (assoc keyword key candidate)]))
             bounded (vec (take 33 expanded))]
         (when (<= (count bounded) 32) bounded))))
   [[(vec positional-types) keyword-types]]
   (concat (keep-indexed #(when (seq (:callable-overloads %2)) [:positional %1 %2]) positional-types)
           (keep (fn [[key type]] (when (seq (:callable-overloads type)) [:keyword key type])) keyword-types))))

(defn- select-call-signatures
  [metadata positional-types keyword-types opts]
  (let [branches (callable-argument-branches positional-types keyword-types)
        signatures (or (seq (:overloads metadata)) [metadata])]
    (if (and branches (> (count branches) 1))
      (vec (mapcat (fn [[positional keyword]]
                     (map #(assoc % :callable-branch? true)
                          (select-call-signatures metadata positional keyword opts))) branches))
      (vec
       (keep (fn [original]
               (let [prepared (unpacked-call-signature original positional-types)
                     signature (:signature prepared)
                     valid? (if (seq (:union-members original))
                              (not (seq (check-call original (count positional-types) (keys keyword-types))))
                              (and (not (:arity-error prepared))
                                   (not (seq (check-single-call signature (count positional-types) (keys keyword-types))))))]
                 (when valid?
                   (let [pairs (vec (argument-pairs signature positional-types keyword-types opts))
                         bindings (reduce (fn [result [expected actual]]
                                            (infer-bindings result expected actual)) (:bindings prepared) pairs)
                         specialized (if (seq bindings) (substitute-metadata signature bindings) signature)
                         unchanged? (identical? specialized signature)
                         specialized-pairs (if unchanged? pairs (argument-pairs specialized positional-types keyword-types opts))
                         comparisons (map (fn [[expected actual fresh?]]
                                            (let [result (argument-compatible? actual expected fresh? opts)
                                                  substituted (substitute-type expected bindings)]
                                              (if (or (false? result) (= expected substituted))
                                                result
                                                (argument-compatible? actual substituted fresh? opts)))) specialized-pairs)]
                     (when-not (or (and (not unchanged?)
                                        (some (fn [[expected actual fresh?]]
                                                (and (not (:parameter-part expected))
                                                     (false? (argument-compatible? actual expected fresh? opts)))) pairs))
                                   (some false? comparisons)
                                   (and (not (identical? original specialized))
                                        (seq (check-call specialized (count positional-types) (keys keyword-types)))))
                       (assoc specialized :type-match? (every-compatible comparisons)))))))
             signatures)))))

(defn- expand-arguments [positional-types keyword-types]
  (reduce
   (fn [calls [kind key type]]
     (when calls
       (let [choices (variants type)
             expanded (for [[positional keyword] calls candidate choices]
                        (if (= :positional kind)
                          [(assoc positional key candidate) keyword]
                          [positional (assoc keyword key candidate)]))
             bounded (vec (take 33 expanded))]
         (when (<= (count bounded) 32) bounded))))
   [[(vec positional-types) keyword-types]]
   (concat (keep-indexed (fn [index type]
                           (when (or (:union type) (:nullable? type)) [:positional index type])) positional-types)
           (keep (fn [[key type]]
                   (when (or (:union type) (:nullable? type)) [:keyword key type])) keyword-types))))

(defn call-signatures
  "Select signatures by argument types, requiring coverage of every union branch.
  Surviving :type-match? is true for proven matches, nil when evidence is incomplete."
  ([metadata positional-types keyword-types] (call-signatures metadata positional-types keyword-types {}))
  ([metadata positional-types keyword-types opts]
   (let [selected (select-call-signatures metadata positional-types keyword-types opts)
         union? #(or (:union %) (:nullable? %))]
     (if (or (some :type-match? selected)
             (not-any? union? (concat positional-types (vals keyword-types))))
       selected
       (if-let [expanded (expand-arguments positional-types keyword-types)]
         (let [branches (mapv (fn [[positional keyword]]
                                (select-call-signatures metadata positional keyword opts)) expanded)]
           (if (every? seq branches) (vec (distinct (mapcat identity branches))) []))
         ;; Exhausting the branch budget is uncertainty, not a type error.
         ;; Keep checking independent arguments and call shape without narrowing a result.
         (mapv #(assoc % :type-match? nil)
               (select-call-signatures metadata
                                       (mapv #(when-not (union? %) %) positional-types)
                                       (into {} (map (fn [[name type]] [name (when-not (union? type) type)]) keyword-types))
                                       opts)))))))

(defn type-label
  "Render inferred Python types for signatures, hovers, and editor hints."
  [type]
  (let [base (cond
               (nil? type) "Any"
               (:any? type) "Any"
               (:never? type) "Never"
               (:typevar type) (:typevar type)
               (:ellipsis? type) "..."
               (:parameter-list? type) (str "[" (str/join ", " (map type-label (:arguments type))) "]")
               (:type-pack? type) (str "*" (str/join ", " (map type-label (:arguments type))))
               (:union type) (str/join " | " (map type-label (:union type)))
               (contains? type :literal-values) (str "Literal[" (str/join ", " (map python/repr (:literal-values type))) "]")
               (:module type) (str (when-not (= "builtins" (:module type)) (str (:module type) "."))
                                   (str/join "." (:path type))
                                   (when (seq (:arguments type))
                                     (str "[" (str/join ", " (map type-label (:arguments type))) "]")))
               :else "Any")]
    (str base (when (:nullable? type) " | None"))))

(defn- call-return-type [metadata]
  (let [type (return-type (if (contains? metadata :constructor-return)
                            (:constructor-return metadata) metadata))]
    (cond
      (:context-manager? metadata)
      {:module "contextlib"
       :path [(if (:async-context-manager? metadata) "AbstractAsyncContextManager" "AbstractContextManager")]
       :arguments [(first (:arguments type))]}
      (and (:async? metadata) (not (:generator? metadata)))
      {:module "collections.abc" :path ["Coroutine"] :arguments [nil nil type]}
      :else type)))

(defn- signature-result [signatures]
  (when (seq signatures)
    (let [definite (first (filter :type-match? signatures))
          results (mapv call-return-type signatures)
          origins (mapv (fn [type]
                          (let [type (or (:bound type) type)]
                            (when (:module type) (select-keys type [:module :path])))) results)]
      (cond
        (and (some :callable-branch? signatures) (every? callable-ref? results))
        (assoc (first results) :callable-overloads (vec (distinct (mapcat #(or (:callable-overloads %) [%]) results))))
        (and (some :callable-branch? signatures) (> (count results) 1)) (union-type results)
        definite (call-return-type definite)
        (apply = results) (first results)
        (and (every? some? origins) (apply = origins))
        (cond-> (first origins) (some :nullable? results) (assoc :nullable? true))
        :else nil))))

;; Integrate into basilisp-tools.python; helpers use the existing canonical refs.
(declare iterated-type element-type call-result)

(defn- builtin-generic [module name arguments]
  (cond-> {:module module :path [name]}
    (seq arguments) (assoc :arguments (vec arguments))))

(defn- builtin-iterator [element]
  (builtin-generic "collections.abc" "Iterator" [element]))

(defn- builtin-tuple [elements]
  {:module "builtins" :path ["tuple"] :arguments (vec elements)})

(defn- builtin-mapping-arguments [source opts]
  (let [module (:module source) name (last (:path source))]
    (cond
      (or (and (= "builtins" module) (= "dict" name))
          (and (= "basilisp.lang.map" module) (= "PersistentMap" name))
          (and (contains? #{"typing" "typing_extensions" "collections.abc"} module)
               (contains? #{"Mapping" "MutableMapping"} name)))
      [(first (:arguments source)) (second (:arguments source))]
      (:union source)
      (let [arguments (map #(builtin-mapping-arguments % opts) (:union source))]
        (when (every? some? arguments)
          [(union-type (map first arguments)) (union-type (map second arguments))]))
      source
      (let [metadata (inspect-type source opts)]
        (when (:typed-dict? metadata)
          [{:module "builtins" :path ["str"]}
           (union-type (map return-type (vals (:typed-dict-fields metadata))))])))))

(defn- builtin-dict-arguments [source opts]
  (or (builtin-mapping-arguments source opts)
      (when source
        (let [pair (iterated-type source opts)
              tuple? (and (= "builtins" (:module pair)) (= ["tuple"] (:path pair)))]
          (cond
            (and tuple? (= 2 (count (:arguments pair))) (not (:ellipsis? (second (:arguments pair)))))
            (:arguments pair)
            (and tuple? (seq (:arguments pair)) (not (:ellipsis? (second (:arguments pair)))))
            nil
            :else (when-let [element (iterated-type pair opts)] [element element]))))))

(defn- builtin-method-result [marker receiver positional keyword opts]
  (when (and receiver (empty? keyword))
    (let [argc (count positional)
          arguments (:arguments receiver)
          key-type (first arguments) value-type (second arguments)]
      (case marker
        "dict.keys" (when (zero? argc) (builtin-generic "collections.abc" "KeysView" [key-type]))
        "dict.values" (when (zero? argc) (builtin-generic "collections.abc" "ValuesView" [value-type]))
        "dict.items" (when (zero? argc) (builtin-generic "collections.abc" "ItemsView" [key-type value-type]))
        "dict.copy" (when (zero? argc) (builtin-generic "builtins" "dict" arguments))
        "dict.get" (when (<= 1 argc 2)
                     (let [key-values (:literal-values (first positional))
                           value (if (= 1 (count key-values))
                                   (or (element-type receiver (first key-values) opts) value-type)
                                   value-type)
                           fallback (if (= argc 2) (second positional)
                                        {:module "builtins" :path ["NoneType"]})]
                       (union-type [value fallback])))
        "list.copy" (when (zero? argc) (builtin-generic "builtins" "list" arguments))
        "set.copy" (when (zero? argc) (builtin-generic "builtins" "set" arguments))
        "frozenset.copy" (when (zero? argc) (builtin-generic "builtins" "frozenset" arguments))
        nil))))

(defn builtin-call-result
  "Infer trusted builtins without invoking source code or user callables.
  :builtin-call is emitted only for verified builtin identity by the worker."
  [metadata positional-types keyword-types opts]
  (let [marker (:builtin-call metadata)
        argc (count positional-types)
        source (first positional-types)
        no-keywords? (empty? keyword-types)
        type (fn [name args] (builtin-generic "builtins" name args))
        element #(iterated-type % opts)
        method? (and marker (str/includes? marker "."))]
    (cond
      (nil? marker) nil
      method?
      (let [receiver (or (:receiver-type metadata) source)
            positional (if (:receiver-type metadata) positional-types (vec (rest positional-types)))]
        (if (:union receiver)
          (union-type (map #(builtin-method-result marker % positional keyword-types opts) (:union receiver)))
          (builtin-method-result marker receiver positional keyword-types opts)))
      (contains? #{"list" "set" "frozenset"} marker)
      (when (and no-keywords? (<= argc 1))
        (type marker (when (= argc 1)
                       [(cond-> (element source) (not= marker "frozenset") widen-literals)])))
      (= "tuple" marker)
      (when (and no-keywords? (<= argc 1))
        (cond
          (zero? argc) (builtin-tuple [])
          (and (= "builtins" (:module source)) (= ["tuple"] (:path source)))
          (select-keys source [:module :path :arguments])
          :else (builtin-tuple [(element source) {:ellipsis? true}])))
      (= "sorted" marker)
      (when (and (= argc 1) (every? #{"key" "reverse"} (keys keyword-types)))
        (type "list" [(widen-literals (element source))]))
      (= "iter" marker)
      (when (and no-keywords? (<= 1 argc 2))
        (builtin-iterator (if (= argc 1) (element source)
                              (when-let [callable (or (callable-metadata source)
                                                      (inspect-member source "__call__" opts))]
                                (call-result callable [] {} opts)))))
      (= "next" marker)
      (when (and no-keywords? (<= 1 argc 2))
        (if (= argc 1) (element source) (union-type [(element source) (second positional-types)])))
      (= "reversed" marker)
      (when (and no-keywords? (= argc 1)) (builtin-iterator (element source)))
      (= "enumerate" marker)
      (when (and (<= argc 2) (every? #{"iterable" "start"} (keys keyword-types))
                 (not (and (pos? argc) (contains? keyword-types "iterable")))
                 (not (and (= argc 2) (contains? keyword-types "start")))
                 (or (pos? argc) (contains? keyword-types "iterable")))
        (builtin-iterator (builtin-tuple [{:module "builtins" :path ["int"]}
                                          (element (if (pos? argc) source (get keyword-types "iterable")))])))
      (= "zip" marker)
      (when (every? #{"strict"} (keys keyword-types))
        (builtin-iterator (if (zero? argc) {:never? true} (builtin-tuple (mapv element positional-types)))))
      (= "range" marker)
      (when (and no-keywords? (<= 1 argc 3)) (type "range" nil))
      (contains? #{"len" "hash" "id" "ord"} marker)
      (when (and no-keywords? (= argc 1)) (type "int" nil))
      (contains? #{"repr" "ascii" "bin" "oct" "hex" "chr"} marker)
      (when (and no-keywords? (= argc 1)) (type "str" nil))
      (contains? #{"any" "all"} marker)
      (when (and no-keywords? (= argc 1)) (type "bool" nil))
      (= "filter" marker)
      (when (and no-keywords? (= argc 2)) (builtin-iterator (element (second positional-types))))
      (= "map" marker)
      (when (and no-keywords? (<= 2 argc))
        (builtin-iterator
         (when-let [callable (or (callable-metadata source) (inspect-member source "__call__" opts))]
           (call-result callable (mapv element (rest positional-types)) {} opts))))
      (= "dict" marker)
      (when (<= argc 1)
        (let [arguments (when (= argc 1) (builtin-dict-arguments source opts))
              keywords? (seq keyword-types)
              keyword-key {:module "builtins" :path ["str"]}
              keyword-value (when keywords? (union-type (vals keyword-types)))
              key-type (cond (and (= argc 1) keywords?) (union-type [(first arguments) keyword-key])
                             (= argc 1) (first arguments)
                             keywords? keyword-key)
              value-type (cond (and (= argc 1) keywords?) (union-type [(second arguments) keyword-value])
                               (= argc 1) (second arguments)
                               keywords? keyword-value)]
          (type "dict" (when (or (pos? argc) keywords?)
                         [(widen-literals key-type) (widen-literals value-type)]))))
      :else nil)))

(defn call-result
  "Infer call results from overloads and TypeVars. Ambiguous unknown calls return nil.
  Optional preselected signatures must describe this exact call; nil selects them here."
  ([metadata positional-types keyword-types] (call-result metadata positional-types keyword-types {}))
  ([metadata positional-types keyword-types opts] (call-result metadata positional-types keyword-types opts nil))
  ([metadata positional-types keyword-types opts preselected]
   (if (seq (:union-members metadata))
     (union-type (map #(call-result % positional-types keyword-types opts) (:union-members metadata)))
     (let [expanded (expand-arguments positional-types keyword-types)]
       (when expanded
         (let [reuse? (and (some? preselected) (= 1 (count expanded))
                           (= [(vec positional-types) keyword-types] (first expanded)))
               results (mapv (fn [[positional keyword]]
                               (when-not (and reuse? (empty? preselected))
                                 (or (when (and (:builtin-call metadata)
                                                (not (seq (check-call metadata (count positional) (keys keyword)))))
                                       (builtin-call-result metadata positional keyword opts))
                                     (signature-result (if reuse? preselected
                                                           (call-signatures metadata positional keyword opts)))))) expanded)]
           (if (= 1 (count results)) (first results) (union-type results))))))))

(defn- literal-index-type [type index]
  ;; Only immutable builtin literals are indexed here; user methods never run.
  (when (and (python/isinstance index python/int) (= 1 (count (:literal-values type))))
    (let [value (first (:literal-values type))]
      (when (and (or (= (python/type value) python/str) (= (python/type value) python/bytes))
                 (<= (- (python/len value)) index) (< index (python/len value)))
        (let [item (python/getattr value "__getitem__")
              result (item index)]
          {:module "builtins" :path [(if (string? result) "str" "int")] :literal-values [result]})))))

(defn element-type
  "Infer an indexed/iterated element, including tuples, TypedDict keys, and unions."
  ([type] (element-type type nil {}))
  ([type index] (element-type type index {}))
  ([type index opts]
   (cond
     (:union type) (union-type (map #(element-type % index opts) (:union type)))
     (get persistent-collection-bases [(:module type) (first (:path type))])
     (if (= "basilisp.lang.map" (:module type)) (second (:arguments type)) (first (:arguments type)))
     (= "builtins" (:module type))
     (case (first (:path type))
       "dict" (second (:arguments type))
       "tuple" (let [args (:arguments type)
                     index (when (python/isinstance index python/int)
                             (if (neg? index) (+ (count args) index) (python/int index)))]
                 (cond
                   (:ellipsis? (second args)) (first args)
                   (and (int? index) (<= 0 index) (< index (count args))) (get args index)
                   :else (union-type args)))
       "str" (or (literal-index-type type index) {:module "builtins" :path ["str"]})
       "bytes" (or (literal-index-type type index) {:module "builtins" :path ["int"]})
       "bytearray" {:module "builtins" :path ["int"]}
       "range" {:module "builtins" :path ["int"]}
       (first (:arguments type)))
     (contains? #{"collections.abc" "typing"} (:module type))
     (if (contains? #{"Mapping" "MutableMapping"} (first (:path type)))
       (second (:arguments type))
       (first (:arguments type)))
     :else
     (let [metadata (inspect-type type opts)]
       (cond
         (:typed-dict? metadata) (if (string? index)
                                   (return-type (get (:typed-dict-fields metadata) index))
                                   (union-type (map return-type (vals (:typed-dict-fields metadata)))))
         (:named-tuple? metadata) (when (python/isinstance index python/int)
                                    (let [parameters (:parameters metadata)
                                          index (if (neg? index) (+ (count parameters) index) (python/int index))]
                                      (return-type (get parameters index))))
         :else (when-let [getitem (get (:members metadata) "__getitem__")]
                 (call-result (bind-member getitem)
                              [(cond
                                 (string? index) {:module "builtins" :path ["str"] :literal-values [index]}
                                 (int? index) {:module "builtins" :path ["int"] :literal-values [index]}
                                 :else nil)] {})))))))

(defn awaited-type
  "Return the result of awaiting Coroutine/Awaitable metadata."
  ([type] (awaited-type type {}))
  ([type opts]
   (cond
     (:union type) (union-type (map #(awaited-type % opts) (:union type)))
     (or (and (contains? #{"collections.abc" "typing" "typing_extensions"} (:module type))
              (contains? #{"Coroutine" "Awaitable"} (last (:path type))))
         (and (contains? #{"asyncio" "asyncio.futures" "asyncio.tasks" "_asyncio"} (:module type))
              (contains? #{"Future" "Task"} (last (:path type)))))
     (last (:arguments type))
     :else (when-let [method (inspect-member type "__await__" opts)]
             (last (:arguments (call-result method [] {})))))))

(defn iterated-type
  "Return an iteration element; mappings iterate over keys."
  ([type] (iterated-type type {}))
  ([type opts]
   (cond
     (:union type) (union-type (map #(iterated-type % opts) (:union type)))
     (get persistent-collection-bases [(:module type) (first (:path type))]) (first (:arguments type))
     (and (= "collections.abc" (:module type)) (= ["ItemsView"] (:path type)))
     {:module "builtins" :path ["tuple"] :arguments (:arguments type)}
     (and (= "builtins" (:module type)) (= ["dict"] (:path type))) (first (:arguments type))
     (and (contains? #{"collections.abc" "typing" "typing_extensions"} (:module type))
          (contains? #{"Mapping" "MutableMapping"} (last (:path type)))) (first (:arguments type))
     (and (contains? #{"collections.abc" "typing" "typing_extensions"} (:module type))
          (contains? #{"Iterator" "Iterable" "Generator" "AsyncIterator" "AsyncIterable" "AsyncGenerator"}
                     (last (:path type)))) (first (:arguments type))
     :else (or (element-type type nil opts)
               (when-let [method (inspect-member type "__iter__" opts)]
                 (first (:arguments (call-result method [] {}))))))))

(defn context-type
  "Return a with/async-with binding type from annotations or safe __enter__ metadata."
  ([type] (context-type type {}))
  ([type opts]
   (cond
     (:union type) (union-type (map #(context-type % opts) (:union type)))
     (and (contains? #{"contextlib" "typing" "typing_extensions"} (:module type))
          (contains? #{"AbstractContextManager" "AbstractAsyncContextManager" "ContextManager" "AsyncContextManager"}
                     (last (:path type)))) (first (:arguments type))
     (:async? opts) (when-let [method (inspect-member type "__aenter__" opts)]
                      (awaited-type (call-result method [] {}) opts))
     :else (or (when-let [method (inspect-member type "__enter__" opts)]
                 (call-result method [] {}))
               (when-let [method (inspect-member type "__aenter__" opts)]
                 (awaited-type (call-result method [] {}) opts))))))
