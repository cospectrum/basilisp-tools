(ns basilisp-tools.lsp-scheduling-test
  (:require [basilisp.test :refer [deftest is]]
            [basilisp-tools.lsp])
  (:import [asyncio] [time] [importlib] [threading] [contextvars] [functools] [pygls.workspace :as workspace]))

(deftest analysis-workers-coalesce-and-survive-cancellation-test
  (let [analyze-var (ns-resolve 'basilisp-tools.lsp 'analyze-document)
        project-var (ns-resolve 'basilisp-tools.lsp 'project!)
        analyzed (deref (ns-resolve 'basilisp-tools.lsp 'analyzed!))
        original-analyze @analyze-var original-project @project-var
        module (importlib/import_module "basilisp_tools.lsp")
        analyze-name (.-__name__ original-analyze) project-name (.-__name__ original-project)
        active (atom 0) peak (atom 0) calls (atom [])
        uri "file:///tmp/coalesced.lpy"
        document #(workspace/TextDocument uri ** :source %)
        state (atom {:documents {uri (document "old")} :generation 0 :options {} :settings {} :roots []})
        fake (fn [document _project _options _settings]
               (swap! active inc)
               (swap! peak max @active)
               (swap! calls conj (.-source document))
               (time/sleep 0.06)
               (swap! active dec)
               {:source (.-source document)})
        project (fn ^:async no-project [_state _uri] {})
        run (fn ^:async exercise []
              (let [first (asyncio/create_task (analyzed state uri))
                    second (asyncio/create_task (analyzed state uri))
                    third (asyncio/create_task (analyzed state uri))]
                (await (asyncio/sleep 0.02))
                (swap! state assoc :generation 1 :documents {uri (document "new")})
                (.cancel first)
                (let [results (await (asyncio/gather second third))]
                  (is (= [{:source "new"} {:source "new"}] (vec results)))
                  (is (= 1 @peak))
                  (is (= ["old" "new"] @calls))
                  (is (= {:source "new"} (await (analyzed state uri))))
                  (is (= 2 (count @calls))))))]
    (try
      (python/setattr module analyze-name fake)
      (python/setattr module project-name project)
      (asyncio/run (run))
      (finally
        (python/setattr module analyze-name original-analyze)
        (python/setattr module project-name original-project)))))

(deftest unchanged-documents-reuse-analysis-until-dependency-api-changes-test
  (let [analyze-var (ns-resolve 'basilisp-tools.lsp 'analyze-document)
        project-var (ns-resolve 'basilisp-tools.lsp 'project!)
        analyzed (deref (ns-resolve 'basilisp-tools.lsp 'analyzed!))
        module (importlib/import_module "basilisp_tools.lsp")
        original-analyze @analyze-var original-project @project-var
        analyze-name (.-__name__ original-analyze) project-name (.-__name__ original-project)
        uri "file:///tmp/consumer.lpy" calls (atom 0)
        definition {:ns "provider" :name "f" :fixed-arities #{1} :scope-end 20}
        declarations (atom {"provider" {"f" definition}})
        state (atom {:documents {uri (workspace/TextDocument uri ** :source "(ns consumer)")}
                     :generation 0 :analysis-epoch 0 :options {} :settings {} :roots []})
        fake (fn [_document _project _options _settings]
               (swap! calls inc)
               {:namespace "consumer" :namespace-usages [{:name "provider"}]
                :var-usages [{:ns "provider" :name "f" :definition definition}] :calls []})
        project (fn ^:async current-declarations [_state _uri] @declarations)
        run (fn ^:async exercise []
              (await (analyzed state uri))
              (is (= 1 @calls))
              (swap! declarations assoc-in ["provider" "f" :scope-end] 50)
              (swap! state update :generation inc)
              (let [result (await (analyzed state uri))]
                (is (= 1 @calls))
                (is (= 50 (get-in result [:var-usages 0 :definition :scope-end]))))
              (swap! declarations assoc "unrelated" {"g" {:ns "unrelated" :name "g"}})
              (swap! state update :generation inc)
              (await (analyzed state uri))
              (is (= 1 @calls))
              (swap! declarations assoc-in ["provider" "f" :fixed-arities] #{2})
              (swap! state update :generation inc)
              (await (analyzed state uri))
              (is (= 2 @calls))
              (swap! state update :analysis-epoch inc)
              (await (analyzed state uri))
              (is (= 3 @calls)))]
    (try
      (python/setattr module analyze-name fake)
      (python/setattr module project-name project)
      (asyncio/run (run))
      (finally
        (python/setattr module analyze-name original-analyze)
        (python/setattr module project-name original-project)))))

(deftest document-diagnostics-do-not-wait-for-project-linters-test
  (let [module (importlib/import_module "basilisp_tools.lsp")
        names ['analyzed! 'workspace-findings! 'publish!]
        originals (mapv #(deref (ns-resolve 'basilisp-tools.lsp %)) names)
        attributes (mapv #(.-__name__ %) originals)
        refresh (deref (ns-resolve 'basilisp-tools.lsp 'refresh!))
        uri "file:///tmp/early.lpy"
        document (workspace/TextDocument uri ** :source "missing" :version 1)
        state (atom {:documents {uri document} :open #{uri} :settings {} :roots []})
        local {:findings [{:type :unresolved-symbol :message "missing"}]}
        published (atom [])
        run (fn ^:async exercise []
              (let [first-published (asyncio/Event) project-ready (asyncio/Event)
                    analyzed (fn ^:async current-analysis [_state _uri] local)
                    findings (fn ^:async slow-project [_state _uri]
                               (await (.wait project-ready))
                               {uri [{:type :clojure-lsp/unused-public-var}]})
                    publish (fn [_ls _state _document analysis]
                              (swap! published conj analysis)
                              (.set first-published))]
                (doseq [[name function] (map vector attributes [analyzed findings publish])]
                  (python/setattr module name function))
                (let [task (asyncio/create_task (refresh nil state uri))]
                  (await (asyncio/wait_for (.wait first-published) 2))
                  (is (= [local] @published))
                  (is (not (.done task)))
                  (.set project-ready)
                  (await task)
                  (is (= 2 (count @published)))
                  (is (= :clojure-lsp/unused-public-var
                         (:type (last (:findings (last @published)))))))
                ;; A newer document snapshot must never receive old project findings.
                (.clear first-published) (.clear project-ready) (reset! published [])
                (let [task (asyncio/create_task (refresh nil state uri))]
                  (await (asyncio/wait_for (.wait first-published) 2))
                  (swap! state assoc-in [:documents uri]
                         (workspace/TextDocument uri ** :source "fixed" :version 2))
                  (.set project-ready)
                  (await task)
                  (is (= [local] @published)))))]
    (try
      (asyncio/run (run))
      (finally
        (doseq [[name original] (map vector attributes originals)]
          (python/setattr module name original))))))

(deftest analysis-worker-bound-includes-cancelled-running-jobs-test
  (let [create (deref (ns-resolve 'basilisp-tools.lsp 'create-workers))
        stop (deref (ns-resolve 'basilisp-tools.lsp 'stop-workers!))
        submit (deref (ns-resolve 'basilisp-tools.lsp 'worker!))
        workers (create) state (atom {:workers workers})
        gate (threading/Event) active (atom 0) peak (atom 0)
        context (contextvars/ContextVar "blt-test-context")
        token (.set context "caller")
        blocked (fn []
                  (swap! active inc) (swap! peak max @active)
                  (try (.wait gate 3) (.get context)
                       (finally (swap! active dec))))
        run (fn ^:async exercise []
              (let [tasks (mapv (fn [_] (asyncio/create_task (submit state blocked))) (range 8))]
                (await (asyncio/sleep 0.05))
                (is (= 4 @active))
                (doseq [task tasks] (.cancel task))
                (let [more (mapv (fn [_] (asyncio/create_task (submit state blocked))) (range 4))]
                  (await (asyncio/sleep 0.05))
                  (is (= 4 @peak))
                  (.set gate)
                  (is (= ["caller" "caller" "caller" "caller"] (vec (await (apply asyncio/gather more)))))
                  (await (apply (functools/partial asyncio/gather ** :return_exceptions true) tasks)))))]
    (try
      (asyncio/run (run))
      (finally
        (.set gate) (stop workers) (.reset context token)
        (doseq [thread (:threads workers)] (.join thread 1))))))

(deftest document-analysis-does-not-wait-for-cache-persistence-test
  (let [module (importlib/import_module "basilisp_tools.lsp")
        names ['analyze-document 'project! 'analysis-cache-write!]
        originals (mapv #(deref (ns-resolve 'basilisp-tools.lsp %)) names)
        attributes (mapv #(.-__name__ %) originals)
        analyzed (deref (ns-resolve 'basilisp-tools.lsp 'analyzed!))
        stop (deref (ns-resolve 'basilisp-tools.lsp 'stop-workers!))
        uri "file:///tmp/deferred.lpy"
        document #(workspace/TextDocument uri ** :source %)
        state (atom {:documents {uri (document "old")} :generation 0 :options {} :settings {} :roots []})
        started (threading/Event) release (threading/Event)
        active (atom 0) peak (atom 0) calls (atom 0) persisted (atom [])
        analyze (fn [document _project options _settings]
                  (let [result {:source (.-source document) :findings []}]
                    (swap! (:deferred-cache-writes options) conj {:file nil :fingerprint "test" :analysis result})
                    result))
        project (fn ^:async no-project [_state _uri] {})
        write (fn [_file _fingerprint analysis current?]
                (swap! calls inc) (swap! active inc) (swap! peak max @active) (.set started)
                (try
                  (.wait release 5)
                  (when (current?) (swap! persisted conj (:source analysis)))
                  (finally (swap! active dec))))
        run (fn ^:async exercise []
              ;; The first result returns even while its writer is held below.
              (is (= "old" (:source (await (asyncio/wait_for (analyzed state uri) 1)))))
              (loop [attempt 0]
                (when (and (not (.is_set started)) (< attempt 100))
                  (await (asyncio/sleep 0.005)) (recur (inc attempt))))
              (is (.is_set started))
              (swap! state assoc :generation 1 :documents {uri (document "superseded")})
              (await (asyncio/wait_for (analyzed state uri) 1))
              (let [queued (get-in @state [:cache-writes uri])]
                (swap! state assoc :generation 2 :documents {uri (document "new")})
                (await (asyncio/wait_for (analyzed state uri) 1))
                (await (asyncio/sleep 0.01))
                (is (.cancelled queued)))
              (is (= 1 @calls))
              (.set release)
              (when-let [pending (get-in @state [:cache-writes uri])]
                (await (asyncio/wait_for pending 2)))
              (is (= 1 @peak))
              (is (= ["new"] @persisted)))]
    (try
      (doseq [[attribute function] (map vector attributes [analyze project write])]
        (python/setattr module attribute function))
      (asyncio/run (run))
      (finally
        (.set release) (stop (:workers @state))
        (doseq [[attribute original] (map vector attributes originals)]
          (python/setattr module attribute original))))))
