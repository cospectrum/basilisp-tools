(ns basilisp-tools.lsp-refactor-safety-test
  (:require [basilisp.test :refer [deftest is]]
            [basilisp.string :as str]
            [basilisp-tools.analyzer :as analyzer]
            [basilisp-tools.lsp :as lsp]
            [basilisp-tools.syntax :as syntax]))

(defn- apply-edits [source edits]
  (reduce (fn [source [start end replacement]]
            (str (subs source 0 start) replacement (subs source end)))
          source (sort-by first > edits)))

(defn- evaluate [source]
  (load-string (str "(ns user) " source)))

(defn- analyze [source]
  (analyzer/analyze source {:filename "/tmp/blt-refactor-safety.lpy"}))

(deftest extraction-without-a-target-declines-safely-test
  (doseq [[source offset] [["" 0]
                           ["   " 1]
                           ["\n\n" 1]
                           ["(inc 5)\n\n" 8]
                           ["(inc 5)\n  ;; retained comment" 9]]
          command ["introduce-let" "extract-function" "extract-to-def"]]
    (is (empty? (lsp/refactor-edits source (analyze source) command offset ["value"]))
        (str command " at " offset " in " (pr-str source)))))

(deftest introduce-let-advances-over-trivia-test
  (doseq [[source offset] [["\n(inc 5)" 0]
                           ["(inc 5)\n  (inc 8)" 9]
                           [";; retained comment\n\n(inc 5)" 0]]]
    (let [result (apply-edits source (lsp/refactor-edits source (analyze source) "introduce-let" offset ["value"]))]
      (is (not= source result))
      (is (= (evaluate source) (evaluate result)))
      (is (= (str/includes? source ";; retained comment") (str/includes? result ";; retained comment"))))))

(defn- refactor-at [source command marker args]
  (apply-edits source (lsp/refactor-edits source (analyze source) command (.find source marker) args)))

(deftest binding-refactors-preserve-evaluation-and-scope-test
  (doseq [[source command marker]
          [["(let [a 1] (inc a))" "move-to-let" "(inc"]
           ["(let [a (inc 1)] a (inc 1))" "move-to-let" "(inc"]
           ["(let [a (inc 1)] a (inc 1))" "move-to-let" "1"]
           ["(let [a 1] (identity (inc a)))" "move-to-let" "(inc"]
           ["(let [a 1] (#(+ % a) 2))" "move-to-let" "%"]
           ["(let [x 1] (when-let [y x] y))" "move-to-let" "y))"]
           ["(let [x 1] (doseq [y [x]] y))" "move-to-let" "y))"]
           ["(let [a 1] a)" "introduce-let" "a)"]
           ["(+ 1 (let [a 1] a) 2)" "expand-let" "(let"]
           ["(let [x 5] (when x (let [y 2] y)))" "expand-let" "(let [y"]
           ["(do [(let [f 1] f)])" "expand-let" "(let"]
           ["(defn safety-something [x] 5) (+ (* 3 3) (let [x 4] (safety-something 1) (* x x)))" "expand-let" "(let"]
           ["(def safety-f (fn [] (let [a 1] a) 2)) (safety-f)" "expand-let" "(let"]]]
    (let [result (refactor-at source command marker ["new-binding"])]
      (is (not= source result) (str command " " source))
      (is (= (evaluate source) (evaluate result)) result))))

(deftest binding-refactors-decline-effects-and-capture-test
  (doseq [[source command marker name]
          [["(let [] (println :first) (println :second))" "move-to-let" "(println :second" "value"]
           ["(let [] (vector (println :first) (println :second)))" "move-to-let" "(println :second" "value"]
           ["(let [a 1] (+ value a))" "move-to-let" "a))" "value"]
           ["(let [value 7] (+ value (let [value 1] value)))" "expand-let" "(let [value 1" "unused"]
           ["(vector (println :first) (let [a (println :second)] a))" "expand-let" "(let" "unused"]
           ["(let [x (let [a 1] a)] x)" "expand-let" "(let [a" "unused"]
           ["'(+ 1 (let [a 1] a))" "expand-let" "(let" "unused"]
           ["(fn [x] {:pre [(let [a 1] (= x a))]} x)" "expand-let" "(let" "unused"]
           ["(fn [x] {:pre [(pos? x)]} x)" "introduce-let" "{:pre" "unused"]
           ["(defn safety-f ([bar] (let [a 1] a 2)))" "expand-let" "(let" "unused"]]]
    (is (= source (refactor-at source command marker [name])) (str command " " source))))

(deftest function-refactors-preserve-captures-and-variadic-arguments-test
  (doseq [[source command marker]
          [["((fn [x] (+ x 1)) 4)" "demote-fn" "(fn"]
           ["((fn [x & xs] [x xs]) 1 2 3)" "demote-fn" "(fn"]
           ["((fn named [x] (+ x 1)) 4)" "demote-fn" "(fn"]
           ["((fn [x] ;; kept\n (+ x 1)) 4)" "demote-fn" "(fn"]
           ["(#(+ %1 %2) 4 5)" "promote-fn" "#("]
           ["(#(do (inc %) (dec %)) 4)" "promote-fn" "#("]
           ["(#(vector %&) 4 5)" "promote-fn" "#("]
           ["((fn [x] (+ x 1)) 4)" "promote-fn" "(fn"]
           ["(let [a 5] ((fn [x] (+ a x)) 4))" "promote-fn" "(fn"]
           ["(let [a 5] ((fn [x & xs] [a x xs]) 1 2 3))" "promote-fn" "(fn"]
           ["(let [a 5] ((fn ([x] (+ a x)) ([x y] (+ a x y))) 4 3))" "promote-fn" "(fn"]]]
    (let [result (refactor-at source command marker ["safety-promoted"])]
      (is (not= source result) (str command " " source))
      (is (= (evaluate source) (evaluate result)) result))))

(deftest function-promotion-preserves-loop-closure-cells-test
  (doseq [source
          ["(mapv (fn [f] (f)) (loop [x 0 fs []] (if (< x 3) (recur (inc x) (conj fs (fn [& _] x))) fs)))"
           "(let [fs (atom [])] (dotimes [x 3] (swap! fs conj (fn ([] x) ([y] (+ x y))))) (mapv (fn [f] (f)) @fs))"]]
    (let [marker (if (str/includes? source "(fn [&") "(fn [&" "(fn ([]")
          result (refactor-at source "promote-fn" marker ["safety-loop-promoted"])]
      (is (= [3 3 3] (evaluate source)))
      (is (= source result)))))

(deftest collection-cycle-repairs-odd-map-without-creating-one-test
  (let [source "{some-fun 1 2}"
        result (refactor-at source "cycle-coll" "{" [])]
    (is (= "[some-fun 1 2]" result))
    (is (empty? (:diagnostics (syntax/parse result)))))
  (is (= "(some-fun 1 2)" (refactor-at "(some-fun 1 2)" "change-coll" "(" ["map"]))))

(defn- inline [source marker]
  (apply-edits source (lsp/refactor-edits source (analyze source)
                                          "inline-function" (.rfind source marker) [])))

(defn- reorder [source]
  (let [uri "file:///tmp/blt-refactor-safety.lpy"
        edits ((deref (ns-resolve 'basilisp-tools.lsp 'parameter-edits))
               {uri source} {uri (analyze source)} uri (inc (.find source "[x y]")) 1)]
    (apply-edits source (get edits uri))))

(deftest inline-preserves-evaluation-and-capture-test
  (doseq [source
          ["(defn safety-f [x y] (+ x y)) (let [x 10] (safety-f 1 x))"
           "(defn safety-f [x y] (+ x y)) (let [+ (fn [& _] :shadow)] (safety-f 1 2))"
           "(def events (atom [])) (defn safety-f [x y] [x y @events]) (safety-f (do (swap! events conj :first) 1) (do (swap! events conj :second) 2))"
           "(defn safety-f [x y] (let [y (+ x y)] [x y])) (safety-f 2 3)"
           "(defn safety-f [x y] ;; retained body comment\n (+ x y)) (safety-f 2 3)"
           "(defn safety-f [x y] #_ignored (+ x y)) (safety-f 2 3)"]]
    (let [result (inline source "(safety-f")]
      (is (not= source result))
      (is (empty? (:diagnostics (syntax/parse result))))
      (is (= (evaluate source) (evaluate result)) result))))

(deftest inline-retains-sensitive-source-test
  (doseq [source
          ["(defn safety-f [x y] (+ x y)) (safety-f 1 ; keep\n 2)"
           "(defn safety-f [x y] (+ x y)) (safety-f 1 #_keep 2)"
           "(defn safety-f [x y] {:pre [(pos? x)]} (+ x y)) (safety-f 1 2)"
           "(defn safety-f [x y] {:post [(pos? %)]} (+ x y)) (safety-f 1 2)"
           "(defn safety-f ([x y] (+ x y)) ([x] x)) (safety-f 1 2)"
           "(defn safety-f [x y] (recur y x)) (safety-f 1 2)"]]
    (is (= source (inline source "(safety-f")))))

(deftest parameter-reordering-preserves-effects-test
  (doseq [source
          ["(defn safety-f [x y] [x y]) (safety-f 1 2)"
           "(def events (atom [])) (defn safety-f [x y] [x y @events]) (safety-f (do (swap! events conj :first) 1) (do (swap! events conj :second) 2))"
           "(defn safety-f [x y] [x y]) [(safety-f 1 2) (safety-f 3 4)]"
           "(defn safety-f [x y] [x y]) (let [blt-callee :old blt-arg0 :a blt-arg1 :b] (safety-f blt-arg0 blt-arg1))"]]
    (let [result (reorder source)]
      (is (not= source result))
      (is (empty? (:diagnostics (syntax/parse result))))
      (is (= (evaluate source) (evaluate result)) result))))

(deftest parameter-reordering-declines-ambiguous-source-test
  (doseq [source
          ["(defn safety-f [x y] [x y]) (safety-f 1 ; keep\n 2)"
           "(defn safety-f [x y] [x y]) (safety-f 1 #_keep 2)"
           "(defn safety-f [x y] [x y]) (map safety-f [1] [2])"
           "(defn safety-f [x y] [x y]) (let [callback safety-f] (callback 1 2))"
           "(defn safety-f [x y] [x y]) (safety-f (safety-f 1 2) 3)"]]
    (is (= source (reorder source)))))

(deftest generated-inline-bindings-do-not-collide-test
  (let [names (map #(str "arg" %) (range 12))
        source (str "(defn safety-f [" (str/join " " names) "] [" (str/join " " names) "]) "
                    "(let [blt-inline1 :occupied] (safety-f " (str/join " " (range 12)) "))")
        result (inline source "(safety-f")]
    (is (not= source result))
    (is (= (vec (range 12)) (evaluate result)))))

(deftest lookup-refactors-preserve-defaults-test
  (doseq [target ["{}" "{:a nil}" "{:a {}}" "{:a {:b nil}}" "{:a {:b 7}}"]
          command ["get-in-less" "get-in-none"]
          default ["" " :fallback"]]
    (let [source (str "(get-in " target " [:a :b]" default ")")
          result (apply-edits source (lsp/refactor-edits source (analyze source) command 0 []))]
      (is (not= source result))
      (is (= (evaluate source) (evaluate result)) result))))

(deftest python-lookup-refactors-preserve-runtime-protocols-test
  (doseq [source ["(get #py {:a 1} :a)"
                  "(get-in #py {:a #py {:b 7}} [:a :b])"
                  "(get-in #py {:a #py {:b nil}} [:a :b] :fallback)"
                  "(get-in #py {:a #py {}} [:a :b] :fallback)"
                  "(:a #py {:a 1})"
                  "(:a #py {:a 1} :fallback)"]
          command ["get-in-more" "get-in-all" "get-in-less" "get-in-none"]]
    (let [result (apply-edits source (lsp/refactor-edits source (analyze source) command 0 []))]
      (is (= (evaluate source) (evaluate result)) (str command " " result)))))
