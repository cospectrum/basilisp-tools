(ns basilisp-tools.config-test
  (:require [basilisp.test :refer [deftest is testing]]
            [basilisp-tools.cli :as cli]
            [basilisp-tools.format :as fmt])
  (:import [io] [os] [pathlib] [tempfile]
           [unittest.mock :as mock]))

(defn- in-project [f]
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))]
    (try (f root) (finally (.cleanup temp)))))

(defn- put! [root name source]
  (let [file (.joinpath root name)]
    (.mkdir (.-parent file) ** :parents true :exist_ok true)
    (.write_text file source ** :encoding "utf-8")
    file))

(defn- project! [root options]
  (put! root "project.clj" (str "(defproject example/tool \"0.1.0\" " options ")")))

(defn- error-message [f]
  (try (f) nil (catch python/Exception e (str e))))

(defn- invoke [cwd args]
  (let [previous (os/getcwd)
        out (io/StringIO) err (io/StringIO)
        patches [(mock/patch "sys.stdout" out) (mock/patch "sys.stderr" err)]]
    (doseq [p patches] (.start p))
    (try
      (os/chdir cwd)
      (let [code (cli/main args)]
        {:code code :out (.getvalue out) :err (.getvalue err)})
      (finally
        (os/chdir previous)
        (doseq [p (reverse patches)] (.stop p))))))

(deftest project-config-is-opt-in-to-edn-test
  (in-project
   (fn [root]
     (let [nested (.joinpath root "src" "nested")]
       (.mkdir nested ** :parents true)
       (put! root ".cljfmt.edn" "{:indentation? true}")
       (doseq [option ["" ":cljfmt nil" ":cljfmt {}"
                       ":cljfmt {:load-config-file? false}"
                       ":cljfmt {:load-config-file? nil}"]]
         (testing option
           (project! root option)
           (let [options (fmt/load-config nested)]
             (is (= (str root) (:project-root options)))
             (is (not (contains? options :indentation?)))
             (is (not (contains? options :load-config-file?))))))
       (testing "Ignored config files need not even be valid"
         (put! root ".cljfmt.edn" "{:broken")
         (project! root ":cljfmt {:indentation? false}")
         (is (false? (:indentation? (fmt/load-config nested)))))
       (testing "Opting in makes errors in the selected EDN visible"
         (project! root ":cljfmt {:load-config-file? true}")
         (is (thrown? python/Exception (fmt/load-config nested))))))))

(deftest project-options-win-with-shallow-merge-test
  (in-project
   (fn [root]
     (put! root ".cljfmt.edn"
           "{:indentation? true :sort-ns-references? true :max-column-alignment-gap 4 :extra-indents {file-only [[:inner 0]]}}")
     (project! root
               ":cljfmt {:load-config-file? true :indentation? false :max-column-alignment-gap nil :extra-indents {project-only [[:block 1]]}}")
     (let [options (fmt/load-config root)]
       (is (false? (:indentation? options)))
       (is (true? (:sort-ns-references? options)))
       (is (contains? options :max-column-alignment-gap))
       (is (nil? (:max-column-alignment-gap options)))
       (is (= {'project-only [[:block 1]]} (:extra-indents options)))
       (is (not (contains? options :load-config-file?))))
     (testing "The Lein flag follows Clojure truthiness"
       (project! root ":cljfmt {:load-config-file? 0}")
       (is (true? (:sort-ns-references? (fmt/load-config root))))))))

(deftest nearest-project-and-file-discovery-test
  (in-project
   (fn [outer]
     (let [root (.joinpath outer "project")
           nested (.joinpath root "work" "nested")]
       (.mkdir nested ** :parents true)
       (project! outer ":cljfmt {:indentation? false}")
       (project! root ":cljfmt {:load-config-file? true}")
       (put! outer ".cljfmt.edn" "{:sort-ns-references? false}")
       (put! root "cljfmt.edn" "{:sort-ns-references? true}")
       (put! nested ".cljfmt.edn" "{:indentation? false}")
       (testing "Lein file discovery starts at the nearest project root"
         (let [options (fmt/load-config nested)]
           (is (= (str root) (:project-root options)))
           (is (true? (:sort-ns-references? options)))
           (is (not (contains? options :indentation?)))))
       (testing "Dot config wins over plain config in the same directory"
         (put! root ".cljfmt.edn" "{:sort-ns-references? false}")
         (is (false? (:sort-ns-references? (fmt/load-config nested)))))))))

(deftest explicit-config-selection-test
  (in-project
   (fn [root]
     (let [edn-file (put! root "chosen.edn" "{:indentation? false}")
           project-file (project! root ":cljfmt {:indentation? true}")]
       (put! root ".cljfmt.edn" "{:indentation? false}")
       (is (true? (:indentation? (fmt/load-config project-file))))
       (is (= {:indentation? false} (fmt/load-config edn-file)))
       (is (= (str root) (:paths-root (meta (fmt/load-config project-file)))))
       (let [file (put! root "paths.edn" "{:paths [\"code\"] :project-root \"display-only\"}")]
         (is (nil? (:paths-root (meta (fmt/load-config file))))))
       (testing "Explicit EDN bypasses project discovery and project parse errors"
         (put! root "project.clj" "(defproject")
         (is (= {:indentation? false} (fmt/load-config edn-file))))))))

(deftest project-path-precedence-test
  (in-project
   (fn [root]
     (doseq [name ["src" "test" "code" "spec" "chosen"]]
       (.mkdir (.joinpath root name)))
     (project! root "")
     (is (= ["src" "test"] (:paths (fmt/load-config root))))
     (project! root ":source-paths [\"code\" \"missing\"] :test-paths [\"spec\"]")
     (is (= ["code" "spec"] (:paths (fmt/load-config root))))
     (put! root ".cljfmt.edn" "{:paths [\"chosen\"]}")
     (project! root ":source-paths [\"code\"] :test-paths [\"spec\"] :cljfmt {:load-config-file? true}")
     (is (= ["code" "spec"] (:paths (fmt/load-config root))))
     (project! root ":source-paths [\"code\"] :test-paths [\"spec\"] :cljfmt {:load-config-file? true :paths [\"chosen\"]}")
     (is (= ["chosen"] (:paths (fmt/load-config root)))))))

(deftest literal-project-config-and-inert-code-test
  (in-project
   (fn [root]
     (let [marker (.joinpath root "must-not-exist")
           project (str "(spit " (pr-str (str marker)) " \"unsafe\")\n"
                        "#_(defproject discarded \"0\" :cljfmt (computed))\n"
                        "(defproject example/tool \"0.1.0\"\n"
                        "  :description ~(str \"computed but unused\")\n"
                        "  #_:cljfmt #_(computed)\n"
                        "  :cljfmt {:extra-indents {example/action [[:inner 0]] #\"^wrap-\" [[:block 1]]}"
                        " :file-pattern #\"\\.lpy$\"})")]
       (put! root "project.clj" project)
       (let [options (fmt/load-config root)]
         (is (= [[:inner 0]] (get (:extra-indents options) 'example/action)))
         (is (= "\\.lpy$" (.-pattern (:file-pattern options))))
         (is (= "(example/action x\n  (body))"
                (fmt/format-string "(example/action x\n(body))" options)))
         (is (= "(wrap-action x\n  (body))"
                (fmt/format-string "(wrap-action x\n(body))" options))))
       (is (not (.exists marker)))))))

(deftest unsupported-project-config-is-explicit-test
  (in-project
   (fn [root]
     (doseq [[config expected] [["(load-settings)" "literal"]
                                ["~(load-settings)" "unsupported"]
                                ["{:extra-indents (make-indents)}" "must be a map"]
                                ["{:extra-indents #unsafe {}}" "unsupported"]]]
       (testing config
         (project! root (str ":cljfmt " config))
         (let [message (error-message #(fmt/load-config root))]
           (is (some? message))
           (is (and message (>= (.find (.lower message) expected) 0)))))))))

(deftest literal-lein-profiles-test
  (in-project
   (fn [root]
     (doseq [path ["src" "test" "generated" "integration"]]
       (.mkdir (.joinpath root path)))
     (project! root ":profiles {:dev {:dependencies ~(load-dependencies)
                                     :cljfmt {:indentation? false}
                                     :source-paths [\"generated\"]
                                     :test-paths [\"integration\"]}}")
     (let [options (fmt/load-config root)]
       (is (false? (:indentation? options)))
       (is (= ["generated" "src" "integration" "test"] (:paths options))))
     (project! root ":source-paths [\"src\"] :test-paths [\"test\"]
                    :cljfmt {:extra-indents {a [[:inner 0]]}}
                    :profiles {:dev {:source-paths [\"generated\"]
                                     :test-paths ^:replace [\"integration\"]
                                     :cljfmt {:extra-indents {b [[:block 1]]}}}}")
     (let [options (fmt/load-config root)]
       (is (= ["generated" "src" "integration"] (:paths options)))
       (is (= {'a [[:inner 0]] 'b [[:block 1]]} (:extra-indents options))))
     (project! root ":cljfmt {:indentation? true}
                    :profiles {:formatting {:cljfmt {:indentation? false}}
                               :default [:formatting]
                               :unused {:cljfmt {:indentation? true}}}")
     (is (false? (:indentation? (fmt/load-config root))))
     (is (true? (:indentation? (fmt/load-config root {:lein-profiles [:unused]}))))
     (put! root "profiles.clj" "{:formatting {:cljfmt {:indentation? true}}}")
     (is (true? (:indentation? (fmt/load-config root))))
     (project! root ":profiles {:default [:a] :a [:b] :b [:a]}")
     (is (thrown? python/Exception (fmt/load-config root))))))

(deftest literal-lein-profile-merge-priority-test
  (in-project
   (fn [root]
     (doseq [[left right expected]
             [["{:extra-indents {a [[:inner 0]]}}"
               "{:extra-indents ^:replace {b [[:block 1]]}}"
               {'b [[:block 1]]}]
              ["{:extra-indents ^:replace {a [[:inner 0]]}}"
               "{:extra-indents {b [[:block 1]]}}"
               {'a [[:inner 0]]}]
              ["{:extra-indents {a [[:inner 0]]}}"
               "{:extra-indents ^:displace {b [[:block 1]]}}"
               {'a [[:inner 0]]}]]]
       (project! root (str ":cljfmt " left " :profiles {:dev {:cljfmt " right "}}"))
       (is (= expected (:extra-indents (fmt/load-config root))))))))

(deftest project-relative-paths-and-cli-overrides-test
  (in-project
   (fn [root]
     (let [nested (.joinpath root "work")
           source "(defn f []\n(answer))\n"
           expected "(defn f []\n  (answer))\n"
           project-source (put! root "code/main.lpy" source)
           local-source (put! root "work/local.lpy" source)]
       (put! root "unselected.lpy" "(")
       (project! root ":source-paths [\"code\"] :test-paths []")
       (let [result (invoke nested ["format" "--quiet"])]
         (is (= 0 (:code result)) (:err result)))
       (is (= expected (.read_text project-source ** :encoding "utf-8")))
       (is (= source (.read_text local-source ** :encoding "utf-8")))
       (let [result (invoke nested ["format" "--quiet" "local.lpy"])]
         (is (= 0 (:code result)) (:err result)))
       (is (= expected (.read_text local-source ** :encoding "utf-8")))))))

(deftest explicit-namespaced-map-config-test
  (in-project
   (fn [root]
     (let [source "{:extra-indents #:example{action [[:inner 0]]}}"
           file (put! root "chosen.edn" source)]
       (project! root (str ":cljfmt " source))
       (doseq [path [file root]]
         (let [options (fmt/load-config path)]
           (is (= {'example/action [[:inner 0]]} (:extra-indents options)))
           (is (= "(example/action x\n  (body))"
                  (fmt/format-string "(example/action x\n(body))" options)))))))))

(deftest clojure-file-discovery-order-test
  (in-project
   (fn [root]
     (let [names [".cljfmt.edn" ".cljfmt.clj" "cljfmt.edn" "cljfmt.clj"]]
       (doseq [[i filename] (map-indexed vector names)]
         (put! root filename (str "{:max-column-alignment-gap " i "}")))
       (doseq [[i filename] (map-indexed vector names)]
         (is (= i (:max-column-alignment-gap
                   (fmt/load-config root {:read-clj-config-files? true}))))
         (.unlink (.joinpath root filename)))))))

(deftest ignored-clojure-config-warns-and-keeps-searching-test
  (in-project
   (fn [root]
     (let [nested (.joinpath root "child")
           stderr (io/StringIO)]
       (put! root ".cljfmt.edn" "{:indentation? false}")
       (put! nested ".cljfmt.clj" "{:indentation? true}")
       (with-open [patch (mock/patch "sys.stderr" stderr)]
         (let [options (fmt/load-config nested)]
           (is (false? (:indentation? options)))))
       (is (= (str "Warning: .clj config file '.cljfmt.clj' detected but "
                   "--read-clj-config-files is not set. Ignoring config file.\n")
              (.getvalue stderr)))
       (put! nested "cljfmt.edn" "{:indentation? false}")
       (with-open [patch (mock/patch "sys.stderr" (io/StringIO))]
         (is (false? (:indentation? (fmt/load-config nested)))))
       (is (true? (:indentation? (fmt/load-config nested {:read-clj-config-files? true}))))))))

(deftest explicit-clojure-config-reader-test
  (in-project
   (fn [root]
     (let [file (put! root "chosen.clj"
                      "^:replace {:extra-indents {^String action [[:inner 0]] #\"^wrap-\" [[:block 1]]}}")
           opts (fmt/load-config file)]
       (is (= [[:inner 0]] (get (:extra-indents opts) 'action)))
       (is (= "(wrap-action x\n  (body))"
              (fmt/format-string "(wrap-action x\n(body))" opts))))
     (let [file (put! root "chosen.clj" "{:alias-map {::local remote} :extra-indents #::{action [[:inner 0]]}}")
           opts (fmt/load-config file)]
       (is (= {:user/local 'remote} (:alias-map opts)))
       (is (= {'user/action [[:inner 0]]} (:extra-indents opts))))
     (doseq [[filename source]
             [["chosen.edn" "{:extra-indents {#\"^wrap-\" [[:block 1]]}}"]
              ["chosen.edn" "{:alias-map {::local remote}}"]
              ["chosen.clj" "{:alias-map {::absent/local remote}}"]
              ["chosen.clj" "{:extra-indents {#re \"^wrap-\" [[:block 1]]}}"]]]
       (is (thrown? python/Exception (fmt/load-config (put! root filename source))))))))

(deftest file-configuration-consumes-one-form-test
  (in-project
   (fn [root]
     (doseq [filename ["chosen.edn" "chosen.clj"]]
       (doseq [source ["nil" "{} {:indentation? false}" "{} (" "{}]" "#_{} {}"]]
         (is (= {} (fmt/load-config (put! root filename source)))))
       (doseq [source ["" "; only a comment" "{:indentation?"]]
         (is (thrown? python/Exception (fmt/load-config (put! root filename source)))))))))

(deftest clojure-reader-evaluation-is-rejected-test
  (in-project
   (fn [root]
     (let [marker (.joinpath root "must-not-exist")
           source (str "#=(spit " (pr-str (str marker)) " \"unsafe\")")]
       (is (thrown? python/Exception (fmt/load-config (put! root "chosen.clj" source))))
       (is (not (.exists marker)))))))

(deftest runtime-format-options-retain-clojure-truthiness-test
  (doseq [key [:ansi? :parallel? :quiet? :verbose? :read-clj-config-files?]]
    (is (true? (get (fmt/resolve-options {key true}) key)))
    (is (false? (get (fmt/resolve-options {key false}) key)))
    (is (nil? (get (fmt/resolve-options {key nil}) key)))
    (is (= 0 (get (fmt/resolve-options {key 0}) key)))
    (is (= "true" (get (fmt/resolve-options {key "true"}) key))))
  (is (= "src" (:project-root (fmt/resolve-options {:project-root "src"}))))
  (is (thrown? python/Exception (fmt/resolve-options {:project-root 4}))))

(deftest external-lein-profile-discovery-test
  (in-project
   (fn [root]
     (let [home (.joinpath root "lein-home")]
       (with-open [patch (.dict mock/patch os/environ #py {"LEIN_HOME" (str home)} ** :clear true)]
         (project! root "")
         (put! home "profiles.clj" "{:user {:cljfmt {:indentation? false}}}")
         (is (false? (:indentation? (fmt/load-config root))))
         (put! home "profiles.d/dev.clj" "{:cljfmt {:indent-line-comments? true}}")
         (is (true? (:indent-line-comments? (fmt/load-config root))))
         (project! root ":profiles {:user {:cljfmt {:indentation? true}}}")
         (is (true? (:indentation? (fmt/load-config root))))
         (put! root "profiles.clj" "{:user {:cljfmt {:indentation? false}}}")
         (is (false? (:indentation? (fmt/load-config root))))
         (put! home "profiles.d/user.clj" "{:cljfmt {:indentation? true}}")
         (is (thrown? python/Exception (fmt/load-config root)))
         (with-open [disabled (.dict mock/patch os/environ #py {"LEIN_NO_USER_PROFILES" ""})]
           (is (false? (:indentation? (fmt/load-config root))))
           (is (nil? (:indent-line-comments? (fmt/load-config root))))))))))

(deftest xdg-lein-profile-discovery-test
  (in-project
   (fn [root]
     (let [home (.joinpath root "home")
           config (.joinpath root "config")]
       (with-open [patch (.dict mock/patch os/environ #py {"XDG_CONFIG_HOME" (str config)}
                                ** :clear true)
                   home-patch (mock/patch "pathlib.Path.home" ** :return_value home)]
         (project! root "")
         (put! config "leiningen/profiles.clj" "{:user {:cljfmt {:indentation? false}}}")
         (is (false? (:indentation? (fmt/load-config root))))
         (put! home ".lein/profiles.clj" "{:user {:cljfmt {:indentation? true}}}")
         (is (true? (:indentation? (fmt/load-config root)))))))))

(deftest composite-lein-profile-metadata-test
  (in-project
   (fn [root]
     (project! root ":cljfmt {:indentation? true}
                    :profiles {:default ^:displace [:one]
                               :one {:cljfmt {:indentation? false}}}")
     (is (true? (:indentation? (fmt/load-config root))))
     (project! root ":profiles {:default ^:displace [:one]
                               :one {:cljfmt {:indentation? false}}}")
     (is (nil? (:indentation? (fmt/load-config root)))))))

(deftest clojure-octal-configuration-data-test
  (in-project
   (fn [root]
     (let [file (put! root "chosen.clj" "{:custom [\\o141 \"\\123\" \"\\\\123\"]}")
           options (fmt/load-config file)]
       (is (= ["a" "S" "\\123"] (:custom options)))))))

(deftest literal-string-escape-configuration-test
  (in-project
   (fn [root]
     (let [file (put! root "strings.edn"
                      "{\"unicode\" \"\\u0041B\" \"emoji\" \"\\uD83D\\uDE00\" \"basilisp\" \"\\a\\v\\U0001f600\"}")
           options (fmt/load-config file)]
       (is (= "AB" (get options "unicode")))
       (is (= "😀" (get options "emoji")))
       (is (= "\a\v😀" (get options "basilisp")))))))

(deftest literal-primitive-configuration-test
  (in-project
   (fn [root]
     (let [file (put! root "primitives.clj"
                      "{:values [0x10 020 2r10 23N 1.5M 2/3 \\formfeed \\backspace :dotted.name Long/1]}")
           options (fmt/load-config file)]
       (is (= [16 16 2 23 1.5M 2/3 "\f" "\b" :dotted.name (symbol "Long/1")]
              (:values options)))))))
