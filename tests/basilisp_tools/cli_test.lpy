(ns basilisp-tools.cli-test
  (:require [basilisp.test :refer [deftest is testing]]
            [basilisp.string :as str]
            [basilisp-tools.cli :as cli])
  (:import [io] [json] [os] [pathlib] [stat] [tempfile]
           [unittest.mock :as mock]))

(defn- run-cli [args input]
  (let [out (io/StringIO) err (io/StringIO)
        patches [(mock/patch "sys.stdin" (io/StringIO input))
                 (mock/patch "sys.stdout" out)
                 (mock/patch "sys.stderr" err)]]
    (doseq [p patches] (.start p))
    (try
      (let [code (cli/main args)]
        {:code code :out (.getvalue out) :err (.getvalue err)})
      (finally (doseq [p (reverse patches)] (.stop p))))))

(deftest stdin-test
  (let [source "(defn f [x]\n(+ x 1))"
        expected "(defn f [x]\n  (+ x 1))"]
    (is (= {:code 0 :out expected :err ""} (run-cli ["format" "-"] source)))
    (is (= 1 (:code (run-cli ["format" "--check" "-"] source))))
    (is (= "" (:out (run-cli ["format" "--check" "-"] source))))
    (is (= 0 (:code (run-cli ["format" "--check" "-"] expected))))
    (let [result (run-cli ["format" "--diff" "-"] source)]
      (is (= 1 (:code result)))
      (is (.startswith (:out result) "--- a/stdin\n+++ b/stdin\n")))
    (let [result (run-cli ["format" "-"] "(broken")]
      (is (= 2 (:code result)))
      (is (= "" (:out result)))
      (is (.startswith (:err result) "blt: <stdin>:1:")))
    (is (= 2 (:code (run-cli ["format" "-" "."] source))))))

(deftest file-workflow-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        file (.joinpath root "sample.lpy")
        config (.joinpath root "config.edn")
        source "(let [x 1]\n(python/print x))\n"
        expected "(let [x 1]\n  (python/print x))\n"
        invoke (fn [flags] (run-cli (concat ["format" "--config" (str config)] flags [(str root)]) ""))]
    (try
      (.write_text config "{}" ** :encoding "utf-8")
      (.write_text file source ** :encoding "utf-8")
      (os/chmod file 0640)
      (.mkdir (.joinpath root ".venv"))
      (.write_text (.joinpath root ".venv" "ignored.lpy") "(invalid" ** :encoding "utf-8")
      (.write_text (.joinpath root "ignored.txt") "(invalid" ** :encoding "utf-8")
      (is (= 1 (:code (invoke ["--check"]))))
      (is (= source (.read_text file ** :encoding "utf-8")))
      (is (= 1 (:code (invoke ["--diff"]))))
      (is (= source (.read_text file ** :encoding "utf-8")))
      (is (= 0 (:code (invoke []))))
      (is (= expected (.read_text file ** :encoding "utf-8")))
      (is (= 0640 (stat/S_IMODE (.-st_mode (.stat file)))))
      (is (= 0 (:code (invoke ["--check"]))))
      (testing "A malformed file prevents writes to the whole selection"
        (.write_text file source ** :encoding "utf-8")
        (.write_text (.joinpath root "broken.lpy") "(" ** :encoding "utf-8")
        (is (= 2 (:code (invoke []))))
        (is (= source (.read_text file ** :encoding "utf-8"))))
      (finally (.cleanup temp)))))

(deftest missing-input-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))]
    (try
      (is (= 2 (:code (run-cli ["format" (str root)] ""))))
      (is (= 2 (:code (run-cli ["format" (str (.joinpath root "missing"))] ""))))
      (is (= 2 (:code (run-cli ["format" "--config" (str (.joinpath root "missing")) "-"] "(x)"))))
      (finally (.cleanup temp)))))

(deftest checker-output-and-status-test
  (let [args ["check" "--repro" "--no-python-inspection" "--format" "json"
              "--filename" "sample.lpy"]
        source "(ns sample)\n(let [unused 1] :ok)\n"
        result (run-cli (conj args "-") source)
        data (json/loads (:out result))]
    (is (= 2 (:code result)))
    (is (= "" (:err result)))
    (is (= 1 (.get (.get data "summary") "warning")))
    (is (= "unused-binding" (.get (first (.get data "findings")) "type")))
    (is (= 0 (:code (run-cli (concat args ["--fail-level" "error" "-"]) source))))
    (is (= 3 (:code (run-cli (conj args "-") "(ns sample)\nmissing"))))
    (is (= 3 (:code (run-cli (conj args "-") "(ns sample)\n("))))
    (is (= 0 (:code (run-cli (conj args "-") "(ns sample)\n(let [value 1] value)"))))
    (testing "Later explicit configs override earlier values"
      (let [result (run-cli (concat args
                                    ["--config" "{:linters {:unused-binding {:level :error}}}"
                                     "--config" "{:linters {:unused-binding {:level :off}}}"
                                     "-"]) source)]
        (is (= 0 (:code result)))
        (is (empty? (.get (json/loads (:out result)) "findings")))))))

(deftest checker-file-is-read-only-test
  (let [temp (tempfile/TemporaryDirectory)
        file (.joinpath (pathlib/Path (.-name temp)) "sample.lpy")
        source "(ns sample)\r\n(let [unused  1] :ok)\r\n"]
    (try
      (.write_bytes file (.encode source "utf-8"))
      (let [result (run-cli ["check" "--repro" "--no-python-inspection"
                             "--format" "edn" (str file)] "")]
        (is (= 2 (:code result)))
        (is (.startswith (:out result) "{"))
        (is (= (.encode source "utf-8") (.read_bytes file))))
      (finally (.cleanup temp)))))

(deftest formatter-command-overrides-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        config (.joinpath root "config.edn")
        source "(let [x 1]\nx)"]
    (try
      (.write_text config "{:indentation? false :normalize-newlines-at-file-end? true}" ** :encoding "utf-8")
      (let [result (run-cli ["format" "--config" (str config) "--indentation"
                             "--no-normalize-newlines-at-file-end" "-"] source)]
        (is (= 0 (:code result)))
        (is (= "(let [x 1]\n  x)" (:out result))))
      (is (= (str source "\n")
             (:out (run-cli ["format" "--config" (str config) "-"] source))))
      (finally (.cleanup temp)))))

(deftest formatter-relative-pattern-and-display-root-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        source-dir (.joinpath root "src")
        config (.joinpath root "config.edn")]
    (try
      (.mkdir source-dir)
      (.write_text config "{}" ** :encoding "utf-8")
      (.write_text (.joinpath source-dir "sample.lpy") "(let [x 1]\nx)" ** :encoding "utf-8")
      (.write_text (.joinpath root "excluded.lpy") "(" ** :encoding "utf-8")
      (let [result (run-cli ["format" "--config" (str config) "--check"
                             "--file-pattern" "^src/.*\\.lpy$" "--project-root" (str root)
                             "--verbose" (str root)] "")]
        (is (= 1 (:code result)))
        (is (.startswith (:err result) "Processing file: src/sample.lpy\n"))
        (is (.endswith (:err result) "Would format src/sample.lpy\n")))
      (finally (.cleanup temp)))))

(deftest formatter-parallel-preserves-batch-validation-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        config (.joinpath root "config.edn")
        first-file (.joinpath root "a.lpy")
        second-file (.joinpath root "b.lpy")
        source "(let [x 1]\nx)"
        args ["format" "--config" (str config) "--no-ansi"]]
    (try
      (.write_text config "{:parallel? true :quiet? true :verbose? true}" ** :encoding "utf-8")
      (.write_text first-file source ** :encoding "utf-8")
      (.write_text second-file "(" ** :encoding "utf-8")
      (is (= 2 (:code (run-cli (conj args (str root)) ""))))
      (is (= source (.read_text first-file ** :encoding "utf-8")))
      (.write_text second-file source ** :encoding "utf-8")
      (let [parallel (run-cli (concat args ["--parallel" "--diff" (str root)]) "")
            sequential (run-cli (concat args ["--no-parallel" "--diff" (str root)]) "")]
        (is (= 1 (:code parallel)))
        (is (= (:out sequential) (:out parallel)))
        (is (= "" (:err parallel))))
      (is (= 0 (:code (run-cli (conj args (str root)) ""))))
      (is (= "(let [x 1]\n  x)" (.read_text first-file ** :encoding "utf-8")))
      (is (= "(let [x 1]\n  x)" (.read_text second-file ** :encoding "utf-8")))
      (finally (.cleanup temp)))))

(deftest kondo-lint-cli-alias-test
  (let [result (run-cli ["check" "--repro" "--no-python-inspection" "--format" "json"
                         "--filename" "sample.lpy" "--lint" "-"] "(ns sample)\nmissing")]
    (is (= 3 (:code result)))
    (is (= "unresolved-symbol" (.get (first (.get (json/loads (:out result)) "findings")) "type")))))

(deftest formatter-clj-discovery-cli-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        original (.cwd pathlib/Path)
        source "(let [x 1]\nx)"]
    (try
      (.write_text (.joinpath root ".cljfmt.clj") "{:indentation? false}" ** :encoding "utf-8")
      (os/chdir root)
      (let [enabled (run-cli ["format" "--read-clj-config-files" "-"] source)
            disabled (run-cli ["format" "--no-read-clj-config-files" "-"] source)]
        (is (= 0 (:code enabled)))
        (is (= source (:out enabled)))
        (is (= 0 (:code disabled)))
        (is (= "(let [x 1]\n  x)" (:out disabled)))
        (is (not= "" (:err disabled))))
      (finally (os/chdir original) (.cleanup temp)))))

(deftest formatter-configured-project-root-only-affects-display-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        original (.cwd pathlib/Path)
        source-dir (.joinpath root "src")
        display-root (.joinpath root "display")
        source "(let [x 1]\nx)"]
    (try
      (.mkdir source-dir)
      (.mkdir display-root)
      (.write_text (.joinpath source-dir "sample.lpy") source ** :encoding "utf-8")
      (.write_text (.joinpath root ".cljfmt.edn")
                   "{:paths [\"src\"] :project-root \"display\"}" ** :encoding "utf-8")
      (os/chdir root)
      (let [result (run-cli ["format" "--check"] "")]
        (is (= 1 (:code result)))
        (is (= "Would format ../src/sample.lpy\n" (:err result))))
      (finally (os/chdir original) (.cleanup temp)))))

(deftest checker-sarif-cli-test
  (let [result (run-cli ["check" "--repro" "--no-python-inspection" "--format" "sarif"
                         "--filename" "example.lpy" "-"] "(ns example)\nmissing")
        data (json/loads (:out result))
        run (first (.get data "runs"))
        finding (first (.get run "results"))]
    (is (= 3 (:code result)))
    (is (= "2.1.0" (.get data "version")))
    (is (= "unresolved-symbol" (.get finding "ruleId")))
    (is (= "error" (.get finding "level")))
    (is (= 2 (.get (.get (.get (first (.get finding "locations")) "physicalLocation") "region") "startLine")))))

(deftest checker-dependencies-cli-test
  (let [result (run-cli ["check" "--repro" "--no-python-inspection" "--format" "json"
                         "--parallel" "--dependencies"
                         "--config" "{:output {:analysis true}}"
                         "--filename" "example.lpy" "-"] "(ns example)\nmissing")]
    (is (= 0 (:code result)))
    (is (= "" (:out result)))
    (is (= "" (:err result)))))

(deftest checker-optional-booleans-test
  (doseq [flags [["--parallel" "true"] ["--parallel" "false"]
                 ["--parallel=true"] ["--parallel=false"] ["--no-parallel"]]]
    (let [result (run-cli (concat ["check" "--repro" "--no-python-inspection" "--cache" "false"
                                   "--format" "json"] flags ["-"]) "(ns boolean-options) missing")]
      (is (= 3 (:code result)))
      (is (= "unresolved-symbol" (.get (first (.get (json/loads (:out result)) "findings")) "type"))))))

(deftest lsp-batch-workflow-test
  (let [temporary (tempfile/TemporaryDirectory)
        root (.resolve (pathlib/Path (.-name temporary)))
        source (.joinpath root "src" "demo")
        first-file (.joinpath source "a.lpy")
        second-file (.joinpath source "b.lpy")
        clean-file (.joinpath source "clean.lpy")
        invoke (fn [args] (run-cli (concat ["lsp"] args ["--project-root" (str root)
                                                         "--no-python-inspection" "--raw"]) ""))
        environment (.dict mock/patch os/environ #py {"HOME" (str root) "XDG_CONFIG_HOME" (str (.joinpath root "config"))})]
    (.start environment)
    (try
      (.mkdir source ** :parents true)
      (.write_text first-file "(ns demo.a)\n(defn work [value]\nvalue)\n(work 1)\n" ** :encoding "utf-8")
      (.write_text second-file "(ns demo.b (:require [demo.a :as a]))\n(a/work 2)\n" ** :encoding "utf-8")
      (.write_text clean-file "(ns demo.clean (:require [demo.a :as unused]))\n" ** :encoding "utf-8")
      (testing "Dry formatting is read-only and file selection is honored"
        (let [original (.read_bytes first-file)
              result (invoke ["format" "--dry" "--filenames" "src/demo/a.lpy"])]
          (is (= 1 (:code result)))
          (is (.startswith (:out result) "--- a/src/demo/a.lpy"))
          (is (= original (.read_bytes first-file))))
        (is (= 0 (:code (invoke ["format" "--filenames" "src/demo/a.lpy"]))))
        (is (str/includes? (.read_text first-file ** :encoding "utf-8") "\n  value)")))
      (testing "Qualified references and rename share the project index"
        (let [result (invoke ["references" "--from" "demo.a/work" "--output" "{:format :json}"])]
          (is (= 0 (:code result)))
          (is (= 3 (count (json/loads (:out result))))))
        (let [original (.read_bytes first-file)
              result (invoke ["rename" "--from" "demo.a/work" "--to" "demo.a/run-work" "--dry"])]
          (is (= 0 (:code result)))
          (is (str/includes? (:out result) "run-work"))
          (is (= original (.read_bytes first-file))))
        (is (= 0 (:code (invoke ["rename" "--from" "demo.a/work" "--to" "demo.a/run-work"]))))
        (is (str/includes? (.read_text first-file ** :encoding "utf-8") "(defn run-work"))
        (is (str/includes? (.read_text second-file ** :encoding "utf-8") "(a/run-work 2)")))
      (testing "Namespace cleanup preserves load-only dependencies"
        (is (= 0 (:code (invoke ["clean-ns" "--namespace" "demo.clean"]))))
        (let [text (.read_text clean-file ** :encoding "utf-8")]
          (is (not (str/includes? text ":as unused")))
          (is (str/includes? text "demo.a"))))
      (testing "Dump exposes selected analysis fields as JSON"
        (let [result (invoke ["dump" "--output" "{:format :json :filter-keys [:analysis :source-paths]}"])
              data (json/loads (:out result))]
          (is (= 0 (:code result)))
          (is (= #{"analysis" "source-paths"} (set (.keys data))))
          (is (= 3 (count (.get (.get data "analysis") "namespace-definitions"))))))
      (testing "Missing symbols return an unsuccessful query"
        (is (= 1 (:code (invoke ["references" "--from" "demo.a/absent"])))))
      (testing "Namespace rename moves the file and updates consumers"
        (let [renamed (.joinpath source "renamed.lpy")
              original (.read_bytes first-file)
              result (invoke ["rename" "--from" "demo.a" "--to" "demo.renamed" "--dry"])]
          (is (= 0 (:code result)))
          (is (str/includes? (:out result) "rename to src/demo/renamed.lpy"))
          (is (= original (.read_bytes first-file)))
          (is (not (.exists renamed)))
          (is (= 0 (:code (invoke ["rename" "--from" "demo.a" "--to" "demo.renamed"]))))
          (is (not (.exists first-file)))
          (is (str/includes? (.read_text renamed ** :encoding "utf-8") "(ns demo.renamed)"))
          (is (str/includes? (.read_text second-file ** :encoding "utf-8") "[demo.renamed :as a]"))))
      (testing "Diagnostics use LSP ranges and an error exit status"
        (.write_text (.joinpath source "bad.lpy") "(ns demo.bad)\nmissing\n" ** :encoding "utf-8")
        (let [result (invoke ["diagnostics" "--namespace" "demo.bad" "--output" "{:format :json}"])
              data (json/loads (:out result))
              findings (first (.values data))]
          (is (= 3 (:code result)))
          (is (= 1 (count findings)))
          (is (= "unresolved-symbol" (.get (first findings) "code")))
          (is (= 1 (.get (.get (.get (first findings) "range") "start") "line")))))
      (finally (.stop environment) (.cleanup temporary)))))

(deftest formatter-lein-profile-cli-test
  (let [temporary (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temporary))
        original (.cwd pathlib/Path)]
    (try
      (.write_text (.joinpath root "project.clj")
                   "(defproject sample \"0\" :cljfmt {:indentation? true} :profiles {:release {:cljfmt {:indentation? false}}})"
                   ** :encoding "utf-8")
      (os/chdir root)
      (let [source "(let [value 1]\nvalue)"
            result (run-cli ["format" "--lein-profile" "release" "-"] source)]
        (is (= 0 (:code result)))
        (is (= source (:out result))))
      (finally (os/chdir original) (.cleanup temporary)))))

(deftest checker-edn-cli-test
  (let [base ["check" "--repro" "--no-python-inspection" "--cache" "false" "--format" "json"]]
    (doseq [args [["--lang" "edn"] ["--filename" "settings.edn"]]]
      (let [result (run-cli (concat base args ["-"]) "{:name unresolved :values (missing 1)}")]
        (is (= 0 (:code result)))
        (is (empty? (.get (json/loads (:out result)) "findings")))))
    (let [result (run-cli (concat base ["--lang" "edn" "-"]) "{:a 1 :a 2}")]
      (is (= 3 (:code result)))
      (is (some #(= "duplicate-map-key" (.get % "type"))
                (.get (json/loads (:out result)) "findings"))))))

(deftest lsp-batch-settings-propagation-test
  (let [temporary (tempfile/TemporaryDirectory)
        root (.resolve (pathlib/Path (.-name temporary)))
        source (.joinpath root "src")
        invoke (fn [args] (run-cli (concat ["lsp"] args ["--project-root" (str root)
                                                         "--no-python-inspection" "--raw"]) ""))
        environment (.dict mock/patch os/environ #py {"HOME" (str root) "XDG_CONFIG_HOME" (str (.joinpath root "config"))})]
    (.start environment)
    (try
      (.mkdir source)
      (.write_text (.joinpath source "helper.lpy") "(ns helper)\n(defn z [] 1)\n(defn a [] 1)\n" ** :encoding "utf-8")
      (.write_text (.joinpath source "sample.lpy")
                   "(ns sample\n  (:require [helper :refer [z a]]))\n(z)\n(a)\n" ** :encoding "utf-8")
      (testing "Cleanup uses the selected layout settings"
        (let [result (invoke ["clean-ns" "--namespace" "sample" "--dry"
                              "--settings" "{:clean {:sort {:refer false}}}"])]
          (is (= 0 (:code result)))
          (is (= "" (:out result)))))
      (testing "Namespace selection takes precedence and exclusion patterns match whole names"
        (let [args ["dump" "--namespace" "sample" "--filenames" "src/helper.lpy"
                    "--ns-exclude-regex" "sam"
                    "--output" "{:format :json :filter-keys [:analysis]}"]
              result (invoke args)
              names (.get (.get (json/loads (:out result)) "analysis") "namespace-definitions")]
          (is (= 0 (:code result)))
          (is (= ["sample"] (mapv #(.get % "name") names))))
        (is (= 2 (:code (invoke ["dump" "--analysis" "{:type :unknown}"])))))
      (testing "Namespace-only analysis omits var details"
        (let [result (invoke ["dump" "--analysis" "{:type :project-namespaces-only}"
                              "--output" "{:format :json :filter-keys [:analysis]}"])
              data (.get (json/loads (:out result)) "analysis")]
          (is (= 0 (:code result)))
          (is (= 2 (count (.get data "namespace-definitions"))))
          (is (empty? (.get data "var-definitions")))
          (is (empty? (.get data "var-usages")))))
      (testing "Formatting uses analyzed macro indentation metadata when requested"
        (let [file (.joinpath source "styled.lpy")]
          (.write_text file "(ns styled)\n(defmacro ^{:style/indent 1} custom [x & body] nil)\n(custom a\nb)\n" ** :encoding "utf-8")
          (is (= 0 (:code (invoke ["format" "--namespace" "styled" "--analysis" "{:type :project-only}"]))))
          (is (str/includes? (.read_text file ** :encoding "utf-8") "(custom a\n  b)"))))
      (testing "Dump reports the checker configuration actually used"
        (let [config (.joinpath root ".lint")]
          (.mkdir config)
          (.write_text (.joinpath config "config.edn") "{:linters {:unresolved-symbol {:level :off}}}" ** :encoding "utf-8"))
        (let [result (invoke ["dump" "--settings" "{:kondo-config-dir \".lint\"}"
                              "--output" "{:format :json :filter-keys [:clj-kondo-settings]}"])
              config (.get (json/loads (:out result)) "clj-kondo-settings")]
          (is (= 0 (:code result)))
          (is (= "off" (.get (.get (.get config "linters") "unresolved-symbol") "level")))))
      (finally (.stop environment) (.cleanup temporary)))))
