(ns basilisp-tools.python-test
  (:require [basilisp.test :refer [deftest is testing]]
            [basilisp-tools.python :as bridge])
  (:import [pathlib] [subprocess] [sys] [tempfile] [types]
           [unittest.mock :as mock]))

(deftest installed-module-test
  (let [modules (bridge/inspect-modules ["builtins" "math" "json" "pathlib" "os.path"])
        math (get modules "math")
        sin (bridge/resolve-member math "sin")
        json (get modules "json")
        loads (bridge/resolve-member json "loads")]
    (is (= :known (:status math)))
    (is (= :function (:kind (bridge/resolve-member (get modules "os.path") "join"))))
    (is (= :runtime (:inspection math)))
    (is (= :positional-only (:kind (first (:parameters sin)))))
    (is (= [] (bridge/check-call sin 1 [])))
    (is (= :invalid-arity (:type (first (bridge/check-call sin 0 [])))))
    (is (= :invalid-arity (:type (first (bridge/check-call sin 2 [])))))
    (is (= :invalid-arity (:type (first (bridge/check-call sin 0 ["x"])))))
    (is (nil? (bridge/resolve-member math "surely_not_a_math_function")))
    (is (= [] (bridge/check-call loads 1 ["object_hook"])))
    (is (= :class (:kind (bridge/resolve-member (get modules "pathlib") "Path"))))
    (is (= :function (:kind (bridge/resolve-member (get modules "builtins") "len"))))
    (is (= [] (bridge/check-call (bridge/inspect-path "pathlib" ["Path" "read_text"]
                                                      {:instance? true}) 0 [])))))

(deftest static-project-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        file (.joinpath root "sample.py")
        sentinel (.joinpath root "executed")
        opts {:python-paths [(str root)]}]
    (try
      (.write_text file
                   (str "from pathlib import Path\n"
                        "Path(" (python/repr (str sentinel)) ").touch()\n"
                        "def convert(value: str, /, count=1, *, strict: bool, **extras) -> int:\n"
                        "    \"\"\"Convert a value.\"\"\"\n"
                        "    return 1\n"
                        "class Widget:\n"
                        "    def __init__(self, name): pass\n"
                        "    def update(self, value, *, flush=False): pass\n"
                        "    @staticmethod\n"
                        "    def fresh(value): pass\n"
                        "    @classmethod\n"
                        "    def make(cls, value): pass\n"
                        "    @property\n"
                        "    def dangerous(self):\n"
                        "        raise RuntimeError('descriptor executed')\n")
                   ** :encoding "utf-8")
      (let [module (bridge/inspect-module "sample" opts)
            convert (bridge/resolve-member module "convert")
            widget (bridge/resolve-member module "Widget")]
        (is (= :static (:inspection module)))
        (is (= (str (.resolve file)) (:filename convert)))
        (is (= 3 (:row convert)))
        (is (= "int" (:return-type convert)))
        (is (= [] (bridge/check-call convert 1 ["strict"])))
        (is (= :invalid-arity (:type (first (bridge/check-call convert 1 [])))))
        (is (= [] (bridge/check-call convert 1 ["strict" "value"])))
        (is (= :invalid-arity (:type (first (bridge/check-call convert 1 ["strict" "count" "count"])))))
        (is (= [] (bridge/check-call widget 1 [])))
        (is (= "sample.Widget" (:return-type widget)))
        (is (= [] (bridge/check-call (bridge/bind-member (bridge/resolve-member widget "update")) 1 [])))
        (is (= [] (bridge/check-call (bridge/resolve-member widget "fresh") 1 [])))
        (is (= [] (bridge/check-call (bridge/resolve-member widget "make") 1 [])))
        (is (= :property (:kind (bridge/resolve-member widget "dangerous"))))
        (is (not (.exists sentinel))))
      (testing "Local static inspection stays available when runtime imports are disabled"
        (is (= :static (:inspection (bridge/inspect-module "sample" (assoc opts :python-inspection? false))))))
      (testing "Source edits invalidate the cached static metadata"
        (.write_text file "def replacement(): pass\n" ** :encoding "utf-8")
        (let [module (bridge/inspect-module "sample" opts)]
          (is (nil? (bridge/resolve-member module "convert")))
          (is (= :function (:kind (bridge/resolve-member module "replacement"))))))
      (finally (.cleanup temp)))))

(deftest stub-and-dynamic-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        opts {:python-paths [(str root)] :python-inspection? false}]
    (try
      (.write_text (.joinpath root "module.py") "raise RuntimeError('never import')\n" ** :encoding "utf-8")
      (.write_text (.joinpath root "module.pyi")
                   "def supported(value: str) -> int: ...\ndef __getattr__(name): ...\n"
                   ** :encoding "utf-8")
      (let [module (bridge/inspect-module "module" opts)]
        (is (= :known (:status module)))
        (is (.endswith (:filename module) ".pyi"))
        (is (= :function (:kind (bridge/resolve-member module "supported"))))
        (is (= :unknown (:status (bridge/resolve-member module "generated_at_runtime")))))
      (finally (.cleanup temp)))))

(deftest inspection-boundary-test
  (is (= :unknown (:status (bridge/inspect-module "math" {:python-inspection? false}))))
  (is (= :missing (:status (bridge/inspect-module "blt_module_that_does_not_exist_92831"))))
  (is (= :unknown (:status (bridge/inspect-module "math" {:python-executable "/does/not/exist"}))))
  (is (nil? (bridge/check-call {:status :unknown} 100 ["anything"])))
  (let [patch (mock/patch "subprocess.Popen"
                          ** :side_effect (subprocess/TimeoutExpired "python" 0.01))]
    (.start patch)
    (try
      (is (= "inspection-timeout"
             (:reason (bridge/inspect-module "timeout_probe" {:python-timeout 0.01}))))
      (finally (.stop patch)))))

(deftest inspection-cache-test
  (bridge/clear-cache!)
  (let [original subprocess/Popen
        patch (mock/patch "subprocess.Popen" ** :wraps original)
        wrapped (.start patch)]
    (try
      (bridge/inspect-modules ["math" "json"])
      (bridge/inspect-module "math")
      (bridge/inspect-module "json")
      (is (= 1 (.-call_count wrapped)))
      (finally (.stop patch)))))

(deftest static-descriptor-inspection-test
  (let [script "import importlib.util, sys\nspec = importlib.util.spec_from_file_location(\"worker\", sys.argv[1])\nworker = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(worker)\ncalls = []\nclass Descriptor:\n    def __get__(self, *args):\n        calls.append(\"descriptor\")\n        raise AssertionError(\"descriptor executed\")\nclass Sample:\n    __signature__ = Descriptor()\n    value = Descriptor()\n    @property\n    def property_value(self):\n        calls.append(\"property\")\n        raise AssertionError(\"property executed\")\nclass Meta(type):\n    @property\n    def __signature__(cls):\n        calls.append(\"metaclass\")\n        raise AssertionError(\"metaclass executed\")\nclass MetaSample(metaclass=Meta):\n    pass\nclass Callable:\n    @property\n    def __signature__(self):\n        calls.append(\"callable\")\n        raise AssertionError(\"callable executed\")\n    def __call__(self):\n        pass\nfor value in [Sample, MetaSample, Callable()]:\n    metadata = worker.runtime_member(\"sample\", value)\n    assert \"parameters\" not in metadata\nassert not calls, calls\nprint(\"safe\")\n"
        worker (.with_name (pathlib/Path (.-__file__ (get sys/modules "basilisp_tools.python")))
                           "_inspect.py")
        result (subprocess/run (lisp->py [sys/executable "-I" "-c" script (str worker)])
                               ** :text true :capture_output true :timeout 5)]
    (is (= 0 (.-returncode result)) (.-stderr result))
    (is (= "safe\n" (.-stdout result)))))

(deftest static-package-and-overloads-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        package (.joinpath root "sample_pkg")
        opts {:python-paths [(str root)] :python-inspection? false
              :python-cache (bridge/create-cache)}]
    (try
      (.mkdir package)
      (.write_text (.joinpath package "__init__.pyi")
                   "from .models import Child as Public, choose, make, Decorated\n"
                   ** :encoding "utf-8")
      (.write_text (.joinpath package "models.py")
                   (str "from typing import overload, Optional, Self\n"
                        "class Base:\n"
                        "    def __init__(self, name: str): pass\n"
                        "    def inherited(self, amount: int) -> str: return ''\n"
                        "    @property\n"
                        "    def label(self) -> str: raise RuntimeError('do not execute')\n"
                        "class Child(Base):\n"
                        "    def again(self) -> Self: return self\n"
                        "@overload\n"
                        "def choose(value: str) -> Child: ...\n"
                        "@overload\n"
                        "def choose(value: str, count: int) -> Child: ...\n"
                        "def choose(*args): raise RuntimeError('do not execute')\n"
                        "def make() -> Optional[Child]: return Child('x')\n"
                        "@unknown_decorator\n"
                        "class Decorated: pass\n")
                   ** :encoding "utf-8")
      (let [public (bridge/inspect-path "sample_pkg" ["Public"] opts)
            choose (bridge/inspect-path "sample_pkg" ["choose"] opts)
            make (bridge/inspect-path "sample_pkg" ["make"] opts)]
        (is (= :class (:kind public)))
        (is (= {:module "sample_pkg.models" :path ["Child"]} (bridge/return-type public)))
        (is (= [] (bridge/check-call public 1 [])))
        (is (seq (bridge/check-call public 0 [])))
        (is (= [] (bridge/check-call
                   (bridge/inspect-path "sample_pkg" ["Public" "inherited"] (assoc opts :instance? true)) 1 [])))
        (is (= {:module "sample_pkg.models" :path ["Child"]}
               (bridge/return-type (bridge/inspect-path "sample_pkg" ["Public" "again"] opts))))
        (is (= :property (:kind (bridge/inspect-path "sample_pkg" ["Public" "label"] opts))))
        (is (= {:module "builtins" :path ["str"]}
               (bridge/return-type (bridge/inspect-path "sample_pkg" ["Public" "label"] opts))))
        (is (= 2 (count (:overloads choose))))
        (is (= [] (bridge/check-call choose 1 [])))
        (is (= [] (bridge/check-call choose 2 [])))
        (is (seq (bridge/check-call choose 3 [])))
        (is (= {:module "sample_pkg.models" :path ["Child"]} (bridge/return-type choose)))
        (is (= {:module "sample_pkg.models" :path ["Child"] :nullable? true} (bridge/return-type make)))
        (is (= :class (:kind (bridge/inspect-type make opts))))
        (is (nil? (bridge/check-call (bridge/inspect-path "sample_pkg" ["Decorated"] opts) 9 []))))
      (testing "Changing an imported file invalidates its public reexports"
        (.write_text (.joinpath package "models.py") "class Child:\n    def replacement(self): pass\n"
                     ** :encoding "utf-8")
        (is (= :function (:kind (bridge/inspect-path "sample_pkg" ["Public" "replacement"] opts)))))
      (finally (.cleanup temp)))))

(deftest dataclass-constructor-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        opts {:python-paths [(str root)] :python-inspection? false}]
    (try
      (.write_text (.joinpath root "records.py")
                   (str "from dataclasses import dataclass, field, KW_ONLY\n"
                        "from typing import ClassVar\n"
                        "@dataclass\n"
                        "class Parent:\n"
                        "    name: str\n"
                        "@dataclass\n"
                        "class Child(Parent):\n"
                        "    count: int = 1\n"
                        "    hidden: int = field(init=False)\n"
                        "    constant: ClassVar[str] = 'hello'\n"
                        "    _: KW_ONLY\n"
                        "    enabled: bool\n"
                        "    values: list[int] = field(default_factory=list)\n"
                        "@dataclass(init=False)\n"
                        "class Inherited(Parent):\n"
                        "    other: str\n")
                   ** :encoding "utf-8")
      (let [child (bridge/inspect-path "records" ["Child"] opts)
            inherited (bridge/inspect-path "records" ["Inherited"] opts)]
        (is (= ["name" "count" "enabled" "values"] (mapv :name (:parameters child))))
        (is (= [] (bridge/check-call child 1 ["enabled"])))
        (is (seq (bridge/check-call child 1 [])))
        (is (seq (bridge/check-call child 3 ["enabled"])))
        (is (= [] (bridge/check-call inherited 1 [])))
        (is (seq (bridge/check-call inherited 0 [])))
        (is (= {:module "builtins" :path ["list"]
                :arguments [{:module "builtins" :path ["int"]}]}
               (bridge/return-type (bridge/resolve-member child "values")))))
      (finally (.cleanup temp)))))

(deftest owned-and-bounded-cache-test
  (let [first-cache (bridge/create-cache)
        second-cache (bridge/create-cache)
        original subprocess/Popen
        patch (mock/patch "subprocess.Popen" ** :wraps original)
        wrapped (.start patch)]
    (try
      (bridge/inspect-module "math" {:python-cache first-cache})
      (bridge/inspect-module "math" {:python-cache first-cache})
      (bridge/inspect-module "math" {:python-cache second-cache})
      (is (= 2 (.-call_count wrapped)))
      (bridge/clear-cache! first-cache)
      (is (empty? @first-cache))
      (is (seq @second-cache))
      (let [modules (mapv #(str "bounded_cache_probe_" %) (range 270))
            result (bridge/inspect-modules modules {:python-cache first-cache :python-inspection? false})]
        (is (= 270 (count result)))
        (is (<= (count @first-cache) 256)))
      (finally (.stop patch)))))

(deftest transient-failure-retry-test
  (let [storage (bridge/create-cache)
        opts {:python-cache storage}
        clock (mock/patch "time.monotonic" ** :return_value 0)
        patch (mock/patch "subprocess.Popen"
                          ** :side_effect (subprocess/TimeoutExpired "python" 0.01))
        wrapped (.start patch)]
    (.start clock)
    (try
      (is (= "inspection-timeout" (:reason (bridge/inspect-module "math" opts))))
      (is (= "inspection-timeout" (:reason (bridge/inspect-module "math" opts))))
      (is (= 1 (.-call_count wrapped)))
      (finally (.stop patch) (.stop clock)))
    (is (= :known (:status (bridge/inspect-module "math" opts))))
    (is (seq (bridge/environment-paths {:python-cache storage :python-inspection? false})))))

(deftest in-flight-cache-clear-test
  (let [script "import importlib, json, threading, types\nfrom unittest.mock import patch\nimport basilisp_tools\nfrom basilisp.lang.keyword import keyword\nfrom basilisp.lang.map import map as persistent_map\nbridge = importlib.import_module(\"basilisp_tools.python\")\ncache = bridge.create_cache()\noptions = persistent_map({keyword(\"python-cache\"): cache})\nentered, release = threading.Event(), threading.Event()\ncalls = []\ndef inspect(*args, **kwargs):\n    first = not calls\n    calls.append(True)\n    if first:\n        entered.set()\n        assert release.wait(5)\n    name = json.loads(kwargs[\"input\"])[\"modules\"][0]\n    data = {name: {\"status\": \"known\", \"name\": name, \"kind\": \"module\", \"doc\": \"old\" if first else \"fresh\"}}\n    return types.SimpleNamespace(returncode=0, stdout=json.dumps(data))\nwith patch.object(bridge.worker_runtime.InspectionProcesses, \"run\", side_effect=inspect):\n    thread = threading.Thread(target=lambda: bridge.inspect_module(\"cache_race\", options))\n    thread.start()\n    assert entered.wait(5)\n    bridge.clear_cache__BANG__(cache)\n    assert bridge.inspect_module(\"cache_race\", options).val_at(keyword(\"doc\")) == \"fresh\"\n    release.set()\n    thread.join(5)\n    assert not thread.is_alive()\n    assert bridge.inspect_module(\"cache_race\", options).val_at(keyword(\"doc\")) == \"fresh\"\nprint(\"safe\")\n"
        result (subprocess/run (lisp->py [sys/executable "-I" "-c" script])
                               ** :text true :capture_output true :timeout 15)]
    (is (= 0 (.-returncode result)) (.-stderr result))
    (is (= "safe\n" (.-stdout result)))))

(deftest annotation-descriptor-safety-test
  (let [script "import importlib.util, sys\nspec = importlib.util.spec_from_file_location(\"worker\", sys.argv[1])\nworker = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(worker)\ncalls = []\nclass Annotation:\n    @property\n    def __class__(self):\n        calls.append(\"class descriptor\")\n        return str\n    def __repr__(self):\n        calls.append(\"repr\")\n        return \"danger\"\nclass Meta(type):\n    @property\n    def __module__(self):\n        calls.append(\"module descriptor\")\n        return \"danger\"\n    @property\n    def __dict__(self):\n        calls.append(\"dict descriptor\")\n        return {}\nclass Sample(metaclass=Meta):\n    @property\n    def value(self) -> str:\n        calls.append(\"property\")\n        return \"\"\nfor value in [Annotation(), list[Annotation()], Sample]:\n    worker.annotation(value)\n    worker.runtime_type(value)\nworker.runtime_member(\"sample\", Sample)\nworker.runtime_member(\"annotation\", Annotation())\nassert not calls, calls\nprint(\"safe\")\n"
        worker (.with_name (pathlib/Path (.-__file__ (get sys/modules "basilisp_tools.python"))) "_inspect.py")
        result (subprocess/run (lisp->py [sys/executable "-I" "-c" script (str worker)])
                               ** :text true :capture_output true :timeout 15)]
    (is (= 0 (.-returncode result)) (.-stderr result))
    (is (= "safe\n" (.-stdout result)))))

(deftest metadata-member-name-collision-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        opts {:python-paths [(str root)] :python-cache (bridge/create-cache)}]
    (try
      (.write_text (.joinpath root "colliding.py")
                   (str "from typing import TypedDict\n"
                        "status = 'ready'\n"
                        "kind = 1\n"
                        "inspection = True\n"
                        "typevar = 'member'\n"
                        "class Response:\n"
                        "    status: str\n"
                        "    def kind(self) -> int: return 1\n"
                        "class Payload(TypedDict):\n"
                        "    status: str\n"
                        "    typevar: int\n")
                   ** :encoding "utf-8")
      (let [module (bridge/inspect-module "colliding" opts)
            response (bridge/resolve-member module "Response")
            payload (bridge/resolve-member module "Payload")]
        (is (= :known (:status module)))
        (doseq [member ["status" "kind" "inspection" "typevar"]]
          (is (= :variable (:kind (bridge/resolve-member module member))) member))
        (is (= ["str"] (:type-path (bridge/resolve-member response "status"))))
        (is (= :function (:kind (bridge/resolve-member response "kind"))))
        (is (= ["str"] (get-in payload [:typed-dict-fields "status" :type-path])))
        (is (= ["int"] (get-in payload [:typed-dict-fields "typevar" :type-path]))))
      (finally (.cleanup temp)))))

(deftest partial-inspection-timeout-test
  (let [opts {:python-cache (bridge/create-cache)}
        output (.encode (str "{\"math\":{\"status\":\"known\",\"name\":\"math\",\"kind\":\"module\",\"members\":{}}}\n"
                             "{\"unfinished") "utf-8")
        patch (mock/patch "subprocess.Popen"
                          ** :side_effect (subprocess/TimeoutExpired "python" 0.01 ** :output output))
        wrapped (.start patch)]
    (try
      (let [modules (bridge/inspect-modules ["math" "slow"] opts)]
        (is (= :known (:status (get modules "math"))))
        (is (= "inspection-timeout" (:reason (get modules "slow")))))
      (is (= :known (:status (bridge/inspect-module "math" opts))))
      (is (= 1 (.-call_count wrapped)))
      (finally (.stop patch)))))

(deftest context-manager-protocol-selection-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        opts {:python-paths [(str root)] :python-cache (bridge/create-cache)}
        type {:module "contexts" :path ["Both"]}]
    (try
      (.write_text (.joinpath root "contexts.py")
                   (str "class Both:\n"
                        "    def __enter__(self) -> str: return ''\n"
                        "    async def __aenter__(self) -> int: return 1\n")
                   ** :encoding "utf-8")
      (is (= ["str"] (:path (bridge/context-type type opts))))
      (is (= ["int"] (:path (bridge/context-type type (assoc opts :async? true)))))
      (finally (.cleanup temp)))))

(deftest independent-import-graph-budget-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        modules (mapv #(str "budget_module_" %) (range 70))
        opts {:python-paths [(str root)] :python-inspection? false
              :python-cache (bridge/create-cache)}]
    (try
      (doseq [module modules]
        (.write_text (.joinpath root (str module ".py")) "value: int = 1\n" ** :encoding "utf-8"))
      (let [results (bridge/inspect-modules modules opts)]
        (is (= 70 (count results)))
        (doseq [module modules]
          (is (= :known (:status (get results module))) module)
          (is (= ["int"] (:type-path (bridge/resolve-member (get results module) "value"))) module)))
      (finally (.cleanup temp)))))

(deftest selected-interpreter-environment-test
  (is (= [(.-major sys/version-info) (.-minor sys/version-info)]
         (bridge/environment-version)))
  (let [opts {:python-executable "/selected/bin/python" :python-cache (bridge/create-cache)}
        result (types/SimpleNamespace ** :returncode 0
                                      :stdout "{\"paths\":[\"/selected/lib\"],\"version\":[3,10]}")
        patch (.object mock/patch (python/type (:processes (meta @(:python-cache opts))))
                       "run" ** :return_value result)
        wrapped (.start patch)]
    (try
      (is (= [3 10] (bridge/environment-version opts)))
      (is (= ["/selected/lib"] (bridge/environment-paths opts)))
      (is (= 1 (.-call_count wrapped)))
      (finally (.stop patch)))))

(deftest sibling-inheritance-substitution-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        opts {:python-paths [(str root)] :python-cache (bridge/create-cache)}]
    (try
      (.write_text (.joinpath root "siblings.py")
                   (str "from typing import Generic, TypeVar, Self, TypedDict\n"
                        "T = TypeVar('T')\n"
                        "class Parent:\n"
                        "    def label(self) -> str: return ''\n"
                        "    def again(self) -> Self: return self\n"
                        "class Left(Parent): pass\n"
                        "class Right(Parent): pass\n"
                        "class Box(Generic[T]):\n"
                        "    def get(self) -> T: ...\n"
                        "class Text(Box[str]): pass\n"
                        "class Number(Box[int]): pass\n"
                        "Payload = TypedDict('Payload', {'$id': str, '$ref': int, '$blt_metadata': str, 'records': int, 'root': str, 'status': str})\n")
                   ** :encoding "utf-8")
      (doseq [name ["Left" "Right" "Parent"]]
        (is (= [name] (:type-path (bridge/inspect-path "siblings" [name "again"] opts))))
        (is (= ["str"] (:type-path (bridge/inspect-path "siblings" [name "label"] opts)))))
      (is (= ["str"] (:type-path (bridge/inspect-path "siblings" ["Text" "get"] opts))))
      (is (= ["int"] (:type-path (bridge/inspect-path "siblings" ["Number" "get"] opts))))
      (is (= "T" (:typevar (bridge/inspect-path "siblings" ["Box" "get"] opts))))
      (let [payload (bridge/inspect-path "siblings" ["Payload"] opts)]
        (is (= #{"$id" "$ref" "$blt_metadata" "records" "root" "status"}
               (set (keys (:typed-dict-fields payload)))))
        (is (= ["int"] (get-in payload [:typed-dict-fields "$ref" :type-path]))))
      (finally (.cleanup temp)))))

(deftest metadata-transport-roundtrip-test
  (let [script "import importlib.util, json, sys\nspec = importlib.util.spec_from_file_location('worker', sys.argv[1])\nworker = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(worker)\nshared = {'status': 'known', 'name': 'status', 'kind': 'variable', 'type-module': 'builtins', 'type-path': ['str']}\nsource = {'sample': {'status': 'known', 'kind': 'module', 'members': {name: shared for name in ['left', 'right', '$id', '$ref', '$blt_metadata', 'records', 'root', 'status']}}}\ndecode = worker.metadata_decoder(lambda name: ':' + name, dict, tuple)\nlegacy = json.loads(json.dumps(source), object_hook=decode)\ngraph = json.loads(json.dumps(worker.encode_graph(source)), object_hook=decode)\nassert legacy == graph\nshared_list = ['status', {'$ref': 9, '$blt_graph': 1}]\nnative = {'left': shared_list, 'right': shared_list}\nrestored = worker.decode_graph(json.loads(json.dumps(worker.encode_graph(native))))\nassert restored == native\nassert restored['left'] is restored['right']\nmembers = graph['sample'][':members']\nassert members['left'] is members['right']\nassert set(members) == set(source['sample']['members'])\ntry:\n    json.loads('{\"$blt_graph\":1,\"records\":[],\"root\":{\"$ref\":0}}', object_hook=decode)\nexcept ValueError:\n    pass\nelse:\n    raise AssertionError('invalid reference accepted')\nprint('safe')\n"
        worker (.with_name (pathlib/Path (.-__file__ (get sys/modules "basilisp_tools.python"))) "_inspect.py")
        result (subprocess/run (lisp->py [sys/executable "-I" "-c" script (str worker)])
                               ** :text true :capture_output true :timeout 15)]
    (is (= 0 (.-returncode result)) (.-stderr result))
    (is (= "safe\n" (.-stdout result)))))

(deftest statically-discovered-package-child-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        package (.joinpath root "lazy_package")
        sentinel (.joinpath root "executed")
        opts {:python-paths [(str root)] :python-cache (bridge/create-cache)}]
    (try
      (.mkdir package)
      (.write_text (.joinpath package "__init__.py") "shadowed = 1\n" ** :encoding "utf-8")
      (.write_text (.joinpath package "child.py")
                   (str "from pathlib import Path\n"
                        "Path(" (python/repr (str sentinel)) ").touch()\n"
                        "def convert(value: str) -> int: return len(value)\n")
                   ** :encoding "utf-8")
      (.write_text (.joinpath package "shadowed.py") "raise AssertionError('not a module attribute')\n"
                   ** :encoding "utf-8")
      (let [function (bridge/inspect-path "lazy_package" ["child" "convert"] opts)]
        (is (= :known (:status function)))
        (is (= ["int"] (:type-path function)))
        (is (= [] (bridge/check-call function 1 []))))
      (is (= :variable (:kind (bridge/inspect-path "lazy_package" ["shadowed"] opts))))
      (is (nil? (bridge/inspect-path "lazy_package" ["not_a_module"] opts)))
      (is (not (.exists sentinel)))
      (is (= :function (:kind (bridge/inspect-path "urllib" ["parse" "quote"]))))
      (is (= :class (:kind (bridge/inspect-path "importlib" ["metadata" "EntryPoint"]))))
      (finally (.cleanup temp)))))

(deftest shared-generic-specialization-test
  ;; Eighteen shared levels represent over 250,000 paths but only 19 nodes.
  ;; This shape occurs in large NumPy signatures and inherited class metadata.
  (let [leaf {:status :known :kind :variable :name "value" :typevar "T"}
        tree (nth (iterate #(hash-map :members {"left" % "right" %}) leaf) 18)
        metadata (assoc tree :type-parameters [{:typevar "T"}])
        specialize (fn [name]
                     (bridge/specialize metadata {:arguments [{:module "builtins" :path [name]}]}))]
    (doseq [name ["str" "int"]]
      (loop [value (specialize name) remaining 18]
        (if (zero? remaining)
          (is (= [name] (:type-path value)))
          (let [left (get-in value [:members "left"])
                right (get-in value [:members "right"])]
            (is (identical? left right))
            (recur left (dec remaining))))))
    (is (= "T" (:typevar leaf)))))

(deftest dynamic-super-receiver-test
  (let [opts {:python-cache (bridge/create-cache)}
        receiver {:module "builtins" :path ["super"]}]
    (is (= :unknown (:status (bridge/inspect-member receiver "write" opts))))
    (is (nil? (bridge/inspect-member {:module "builtins" :path ["str"]} "definitely_missing" opts)))))

(deftest module-instance-paths-bind-methods-once
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        opts {:python-paths [(str root)] :python-inspection? false}]
    (try
      (.write_text (.joinpath root "bound_alias.py")
                   (str "from typing import overload\n"
                        "raise AssertionError('module must not execute')\n"
                        "class Bucket:\n"
                        "    @overload\n"
                        "    def get(self, key: str) -> str: ...\n"
                        "    @overload\n"
                        "    def get(self, key: str, default: str) -> str: ...\n"
                        "    def get(self, key, default=None): pass\n"
                        "    @staticmethod\n"
                        "    def fresh(key: str) -> str: pass\n"
                        "    @classmethod\n"
                        "    def make(cls, key: str) -> str: pass\n"
                        "class State:\n"
                        "    bucket: Bucket\n"
                        "    @property\n"
                        "    def current(self) -> Bucket: raise AssertionError('descriptor must not execute')\n"
                        "bucket = Bucket()\n"
                        "state = State()\n")
                   ** :encoding "utf-8")
      (doseq [path [["bucket"] ["state" "bucket"] ["state" "current"]]]
        (let [method (bridge/inspect-path "bound_alias" (conj path "get") opts)]
          (is (= [1 2] (mapv #(count (:parameters %)) (:overloads method))))
          (is (= [] (bridge/check-call method 1 [])))
          (is (= [] (bridge/check-call method 2 [])))
          (is (seq (bridge/check-call method 0 [])))
          (is (seq (bridge/check-call method 3 [])))
          (is (= method (bridge/bind-member method))))
        (doseq [name ["fresh" "make"]]
          (let [method (bridge/inspect-path "bound_alias" (conj path name) opts)]
            (is (= [] (bridge/check-call method 1 [])))
            (is (seq (bridge/check-call method 0 [])))
            (is (seq (bridge/check-call method 2 []))))))
      (let [method (bridge/inspect-path "bound_alias" ["Bucket" "get"] opts)]
        (is (= [2 3] (mapv #(count (:parameters %)) (:overloads method))))
        (is (seq (bridge/check-call method 1 [])))
        (is (= [] (bridge/check-call method 2 []))))
      (doseq [name ["fresh" "make"]]
        (is (= [] (bridge/check-call (bridge/inspect-path "bound_alias" ["Bucket" name] opts) 1 []))))
      (finally (.cleanup temp)))))
