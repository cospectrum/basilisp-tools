(deftest project-python-paths-and-interpreter-settings-test
  (let [temp (tempfile/TemporaryDirectory) base (pathlib/Path (.-name temp))
        launch-root (.joinpath base "launch") project-root (.joinpath base "project")
        _ (.mkdir launch-root) _ (.mkdir project-root)
        config (.joinpath project-root ".lsp" "config.edn")
        executable (.joinpath project-root "bin" "project-python")
        marker (.joinpath project-root "selected-python")
        _ (.mkdir (.-parent config)) _ (.mkdir (.-parent executable))
        environment (.copy os/environ)
        _ (.__setitem__ environment "PATH" (str (.-parent executable) os/pathsep (.get os/environ "PATH" "")))
        c (client launch-root environment)
        uri (.as_uri (.joinpath project-root "configured.lpy"))]
    (try
      (doseq [[root doc] [[launch-root "Wrong launch directory."] [project-root "Correct project directory."]]]
        (.mkdir (.joinpath root "lib"))
        (.write_text (.joinpath root "lib" "onlylocal.py")
                     (str "def value():\n    \"\"\"" doc "\"\"\"\n    return 1\n") ** :encoding "utf-8"))
      (.write_text executable (str "#!/bin/sh\nprintf selected > '" marker
                                   "'\nexec '" sys/executable "' \"$@\"\n") ** :encoding "utf-8")
      (.chmod executable 0755)
      (.write_text config "{:python {:paths [\"lib\"] :executable \"bin/project-python\"}}"
                   ** :encoding "utf-8")
      (initialize! c project-root)
      (open! c uri "(ns configured (:import [onlylocal]))\n(onlylocal/value)")
      (is (<= 0 (.find (get-in (result! c "textDocument/hover" (at uri 1 5)) [:contents :value])
                       "Correct project directory.")))
      (is (.is_file marker))
      (.unlink marker)
      (.write_text config "{:python {:paths [\"lib\"] :executable \"project-python\"}}"
                   ** :encoding "utf-8")
      (notification! c "workspace/didChangeConfiguration" {:settings {}})
      (is (<= 0 (.find (get-in (result! c "textDocument/hover" (at uri 1 5)) [:contents :value])
                       "Correct project directory.")))
      (is (.is_file marker))
      (finally (stop! c) (.cleanup temp)))))

(defn- transformed [source command offset & args]
  (let [analysis (analyzer/analyze source {:filename "/tmp/blt-refactor-test.lpy"})
        edits (lsp/refactor-edits source analysis command offset args)]
    (reduce (fn [text [start end replacement]] (str (subs text 0 start) replacement (subs text end)))
            source (sort-by first > edits))))

(deftest source-refactor-semantics-test
  (doseq [[source command offset]
          [["(+ (* 2 3) 4)" "thread-first-all" 0]
           ["(+ 4 (* 2 3))" "thread-last-all" 0]
           ["(-> 2 (* 3) (+ 4))" "unwind-all" 0]
           ["(->> 2 (* 3) (+ 4))" "unwind-thread" 0]
           ["(get (get {:a {:b 3}} :a) :b)" "get-in-all" 0]
           ["(get-in {:a {:b 3}} [:a :b])" "get-in-none" 0]
           ["(get-in {:a {:b 3}} [:a :b])" "get-in-less" 0]
           ["(if true 1 2)" "if->cond-refactor" 0]
           ["(cond false 1 :else 2)" "cond->if-refactor" 0]
           ["(let [x 2] (+ x x))" "inline-symbol" 6]
           ["(+ 2 3)" "introduce-let" 3]]]
    (let [result (transformed source command offset)]
      (is (not= source result) (str command " should produce an edit"))
      (is (empty? (:diagnostics (syntax/parse result))))
      (is (= (load-string source) (load-string result)) (str command " must preserve evaluation"))))
  (let [source "(defn calc [x y] (+ x (* y 2)))"
        result (transformed source "extract-function" 21 "double-y")]
    (is (not= source result))
    (is (empty? (:diagnostics (syntax/parse result))))
    (is (empty? (:findings (analyzer/analyze result)))))
  (is (= "(let [x (println 1)] [x x])"
         (transformed "(let [x (println 1)] [x x])" "inline-symbol" 6)))
  (is (= "'(+ 1 2)" (transformed "'(+ 1 2)" "extract-function" 2 "unsafe")))
  (is (= "(let [x 1] x)" (transformed "(let [x 1] x)" "introduce-let" 6 "x")))
  (is (= "(+ ; keep\n 1 2)" (transformed "(+ ; keep\n 1 2)" "thread-first-all" 0))))

(deftest structural-editor-transformations-test
  (doseq [[source command offset expected]
          [["[1 2] 3" "forward-slurp" 1 "[1 2 3]"]
           ["1 [2 3]" "backward-slurp" 3 "[1 2 3]"]
           ["[1 2 3]" "forward-barf" 1 "[1 2] 3"]
           ["[1 2 3]" "backward-barf" 1 "1 [2 3]"]
           ["[1 2 3]" "drag-forward" 1 "[2 1 3]"]
           ["[1 2 3]" "drag-backward" 3 "[2 1 3]"]
           ["{:b 2 :a 1}" "sort-map" 0 "{:a 1 :b 2}"]
           ["[1 2]" "cycle-coll" 0 "#{1 2}"]
           ["(defn x [] 1)" "cycle-privacy" 7 "(defn- x [] 1)"]]]
    (let [result (transformed source command offset)]
      (is (= expected result))
      (is (empty? (:diagnostics (syntax/parse result))))))
  (is (= [3 7] (let [source "#(+ %1 %2)"
                     result (transformed source "promote-fn" 0)]
                 [((load-string source) 1 2) ((load-string result) 3 4)])))
  (is (= "(ns foo) ::key" (transformed "(ns foo) :foo/key" "cycle-keyword-auto-resolve" 10))))

(deftest standard-editor-protocol-features-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        uri (.as_uri (.joinpath root "features.lpy")) c (client root)
        source "(ns features)\n;; https://example.com/help\n(defn add [first second]\n  (+ first second))\n(let [amount 1]\n  (add amount 2))"]
    (try
      (let [initialized (initialize! c root)]
        (doseq [capability [:selectionRangeProvider :foldingRangeProvider :documentHighlightProvider
                            :linkedEditingRangeProvider :inlayHintProvider :typeDefinitionProvider :implementationProvider]]
          (is (get-in initialized [:capabilities capability]))))
      (open! c uri source)
      (let [ranges (result! c "textDocument/selectionRange"
                            {:textDocument {:uri uri} :positions [{:line 5 :character 8} {:line 2 :character 8}]})]
        (is (= 2 (count ranges)))
        (is (= {:line 5 :character 7} (get-in ranges [0 :range :start])))
        (is (:parent (first ranges))))
      (is (= 2 (count (result! c "textDocument/foldingRange" {:textDocument {:uri uri}}))))
      (is (= "https://example.com/help"
             (:target (first (result! c "textDocument/documentLink" {:textDocument {:uri uri}})))))
      (let [highlights (result! c "textDocument/documentHighlight" (at uri 5 8))
            linked (result! c "textDocument/linkedEditingRange" (at uri 5 8))]
        (is (= 2 (count highlights)))
        (is (= #{2 3} (set (map :kind highlights))))
        (is (= 2 (count (:ranges linked)))))
      (let [hints (result! c "textDocument/inlayHint"
                           {:textDocument {:uri uri} :range {:start {:line 0 :character 0}
                                                             :end {:line 5 :character 17}}})]
        (is (some #(= "first:" (:label %)) hints))
        (is (some #(= "second:" (:label %)) hints)))
      (let [actions (result! c "textDocument/codeAction"
                             {:textDocument {:uri uri} :range {:start {:line 5 :character 2} :end {:line 5 :character 16}}
                              :context {:diagnostics [] :only ["refactor"]}})]
        (is (some #(= "Thread first" (:title %)) actions))
        (is (every? :edit actions)))
      (finally (stop! c) (.cleanup temp)))))

(deftest file-rename-updates-namespace-and-consumers-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        provider (.joinpath root "old.lpy") consumer (.joinpath root "consumer.lpy")
        _ (.write_text provider "(ns old) (defn value [] 1)")
        _ (.write_text consumer "(ns consumer (:require [old :as o])) (old/value) (o/value)")
        c (client root)]
    (try
      (initialize! c root)
      (let [edit (result! c "workspace/willRenameFiles"
                          {:files [{:oldUri (.as_uri provider) :newUri (.as_uri (.joinpath root "renamed.lpy"))}]})
            changes (:documentChanges edit)]
        (is (= 2 (count changes)))
        (is (= ["renamed" "renamed" "renamed"]
               (mapv :newText (mapcat :edits changes)))))
      (finally (stop! c) (.cleanup temp)))))

(deftest dependency-exported-lsp-settings-and-custom-linter-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        exported (.joinpath root "deps" "clojure-lsp.exports" "example" "lint")
        project (.joinpath root ".lsp") home (.joinpath root "home")]
    (try
      (.mkdir exported ** :parents true)
      (.mkdir project)
      (.mkdir home)
      (.write_text (.joinpath exported "config.edn")
                   "{:hover {:hide-file-location? true} :classpath-config-paths [\"example/lint\"]}")
      (.write_text (.joinpath project "config.edn")
                   "{:classpath-config-paths [\"example/lint\"] :hover {:arity-on-same-line? true}}")
      (let [settings (lsp/load-settings {:root (str root) :home (str home)
                                         :xdg-config-home (str (.joinpath home "xdg"))
                                         :classpath-paths [(str (.joinpath root "deps"))]})]
        (is (true? (get-in settings [:hover :hide-file-location?])))
        (is (true? (get-in settings [:hover :arity-on-same-line?]))))
      (.write_text (.joinpath project "config.edn")
                   "{:source-paths [\".\"] :linters {:custom {rules/lint {:level :info}}}}")
      (.write_text (.joinpath root "rules.clj")
                   "(ns rules) (defn lint [{:keys [uris reg-diagnostic!]}] (doseq [uri uris] (reg-diagnostic! {:uri uri :range {:row 1 :col 1 :end-row 1 :end-col 2} :message \"Custom rule\"})))")
      (let [c (client root) uri (.as_uri (.joinpath root "app.lpy"))]
        (try
          (initialize! c root)
          (open! c uri "(ns app)")
          (let [diagnostics (:diagnostics (next-diagnostics! c uri
                                                             #(some (fn [finding] (= "Custom rule" (:message finding))) %)))
                custom (first (filter #(= "Custom rule" (:message %)) diagnostics))]
            (is custom)
            (is (= 3 (:severity custom))))
          (finally (stop! c))))
      (finally (.cleanup temp)))))

(defn- apply-wire-edits [source edits]
  (let [lines (.splitlines source ** :keepends true)
        offset (fn [position] (+ (reduce + 0 (map count (take (:line position) lines))) (:character position)))
        edits (map (fn [edit] [(offset (get-in edit [:range :start])) (offset (get-in edit [:range :end])) (:newText edit)]) edits)]
    (reduce (fn [text [start end replacement]] (str (subs text 0 start) replacement (subs text end)))
            source (sort-by first > edits))))

(deftest parameter-movement-preserves-evaluation-order-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp)) c (client root)
        uri (.as_uri (.joinpath root "params.lpy"))
        source "(ns params)\n(defn pair [a b] [a b])\n(def events (atom []))\n(pair (do (swap! events conj :a) 1) (do (swap! events conj :b) 2))\n@events"]
    (try
      (initialize! c root) (open! c uri source)
      (doseq [[command character] [["drag-param-forward" 12] ["drag-param-backward" 14]]]
        (result! c "workspace/executeCommand" {:command command :arguments [uri 1 character]})
        (let [request (last (filter #(= "workspace/applyEdit" (:method %)) @(:notifications c)))
              edits (get-in request [:params :edit :documentChanges 0 :edits])
              result (apply-wire-edits source edits)]
          (is (seq edits))
          (is (>= (.find result "[b a]") 0))
          (is (= (load-string source) (load-string result)))
          (send! c {:id (:id request) :result {:applied true}})))
      (finally (stop! c) (.cleanup temp)))))

(deftest inline-functions-and-binding-context-safety-test
  (let [source "(defn blt-inline-sample [x y] (+ x y)) (let [x 10] (blt-inline-sample 2 x))"
        result (transformed source "inline-function" (.rfind source "(blt-inline-sample"))]
    (is (not= source result))
    (is (= (load-string source) (load-string result))))
  (doseq [source ["(defn f [x] x)" "(fn f [x] x)" "(for [x [1]] x)" "(doseq [x [1]] x)"]
          command ["extract-function" "introduce-let"]]
    (is (= source (transformed source command (.find source "[") "new-name"))))
  (is (= "(fn [x y] (+ x 1))" (transformed "(fn [x y] (+ x 1))" "demote-fn" 0)))
  (is (= "(get-in {:a 1} (list :a))" (transformed "(get-in {:a 1} (list :a))" "get-in-none" 0)))
  (let [source "(fn [x y] (+ x y))" result (transformed source "demote-fn" 0)]
    (is (= 3 ((load-string result) 1 2)))))

(deftest snippets-project-tree-and-test-tree-protocol-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp)) c (client root)
        uri (.as_uri (.joinpath root "features_test.lpy"))
        source "(ns features-test (:require [basilisp.test :refer [deftest testing is]]))\n(deftest example (testing \"group\" (is true)))\ndefn"]
    (try
      (result! c "initialize"
               {:processId nil :rootUri (.as_uri root)
                :initializationOptions {:source-paths ["."]}
                :capabilities {:textDocument {:completion {:completionItem {:snippetSupport true}}}
                               :experimental {:testTree true}}})
      (notification! c "initialized" {})
      (open! c uri source)
      (let [items (:items (result! c "textDocument/completion" (at uri 2 4)))
            snippet (first (filter #(and (= "defn" (:label %)) (= 2 (:insertTextFormat %))) items))]
        (is snippet)
        (is (>= (.find (get-in snippet [:textEdit :newText]) "${1:name}") 0)))
      (let [tree (result! c "clojure/workspace/projectTree/nodes" nil)]
        (is (= 1 (:type tree)))
        (is (= 2 (:type (first (:nodes tree))))))
      (let [tree (result! c "clojure/workspace/projectTree/nodes" {:name "." :type 2 :final false})]
        (is (some #(= "features-test" (:name %)) (:nodes tree))))
      (let [info (result! c "clojure/serverInfo/raw" {})]
        (is (:server-version info)))
      (let [info (result! c "clojure/cursorInfo/raw" (at uri 2 2))]
        (is (:node info)))
      (let [notification (first (filter #(= "clojure/textDocument/testTree" (:method %)) @(:notifications c)))
            tree (get-in notification [:params :tree])]
        (is (= 1 (:kind tree)))
        (is (= "example" (get-in tree [:children 0 :name])))
        (is (= "group" (get-in tree [:children 0 :children 0 :name]))))
      (finally (stop! c) (.cleanup temp)))))

(deftest python-and-keyword-references-across-aliases-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp)) c (client root)
        first-file (.joinpath root "first.lpy") second-file (.joinpath root "second.lpy")
        first-source "(ns first (:import [math :as m])) (m/sin 1) :shared/key"
        _ (.write_text first-file first-source)
        _ (.write_text second-file "(ns second (:import [math])) (math/sin 2) :shared/key")
        uri (.as_uri first-file)]
    (try
      (initialize! c root) (open! c uri first-source)
      (let [refs (result! c "textDocument/references"
                          (assoc (at uri 0 38) :context {:includeDeclaration false}))]
        (is (= 2 (count refs))))
      (let [refs (result! c "textDocument/references"
                          (assoc (at uri 0 47) :context {:includeDeclaration true}))]
        (is (= 2 (count refs))))
      (is (nil? (result! c "textDocument/prepareRename" (at uri 0 38))))
      (finally (stop! c) (.cleanup temp)))))

(deftest batch-analysis-depth-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        entry (str (.joinpath root "entry.lpy")) dep (.joinpath root "dependency.lpy")
        source "(ns entry (:require [dependency :as d])) (d/value)"
        _ (.write_text dep "(ns dependency) (defn value [] 1)")
        documents {entry source} options {:python-paths [(str root)] :python-inspection? false}]
    (try
      (let [shallow (lsp/workspace-analysis documents options)
            namespaces (lsp/workspace-analysis documents (assoc options :analysis :project-namespaces-only))
            full (lsp/workspace-analysis documents (assoc options :analysis :project-and-full-dependencies))]
        (is (= 1 (count shallow)))
        (is (empty? (:var-usages (get namespaces entry))))
        (is (= #{entry (str dep)} (set (keys full)))))
      (finally (.cleanup temp)))))

(deftest binding-and-namespace-refactors-test
  (doseq [[source command needle]
          [["(let [m {:a 1 :b 2}] (+ (:a m) (get m :b)))" "destructure-keys" "m {"]
           ["(let [{:keys [a b]} {:a 1 :b 2}] (+ a b))" "restructure-keys" "{:keys"]
           ["(let [x 1] (let [y 2] (+ x y)))" "expand-let" "let [y"]
           ["(let [x 1] (+ x 2))" "move-to-let" "(+"]
           ["(vec (for [x [1 2]] (+ x 3)))" "move-to-for-let" "(+"]
           ["{:group/a 1 :b 2 :other/c 3}" "cycle-namespaced-map" "{"]
           ["#:group{:a 1 :_/b 2 :other/c 3}" "cycle-namespaced-map" "{"]
           ["(:b (:a {:a {:b 3}}))" "get-in-all" "(:b"]
           ["(get {:a 1} :a 0)" "get-in-none" "(get"]]]
    (let [result (transformed source command (.index source needle))]
      (is (not= source result) (str command " must be offered"))
      (is (empty? (:diagnostics (syntax/parse result))))
      (is (= (load-string source) (load-string result)) (str command " preserves value"))))
  (let [source "(ns x (:require [basilisp.string :as s :refer [join]]))\n(join \", \" [\"a\" \"b\"])"
        result (transformed source "refer-to-as" (.index source ":refer"))]
    (is (str/includes? result "(s/join"))
    (is (not (str/includes? result ":refer")))
    (is (empty? (:findings (analyzer/analyze result)))))
  (let [source "(ns x (:require [basilisp.string :as s]))\n(s/join \", \" [\"a\" \"b\"])"
        result (transformed source "as-to-refer" (.index source ":as"))]
    (is (str/includes? result ":refer [join]"))
    (is (str/includes? result "(join"))
    (is (not (str/includes? result ":as")))
    (is (empty? (:findings (analyzer/analyze result)))))
  (let [source "(ns x (:require [basilisp.string :as s]))\n(let [join identity] (s/join []))"]
    (is (= source (transformed source "as-to-refer" (.index source ":as")))))
  (let [source "(defn f [m] (:a m))"]
    (is (= source (transformed source "destructure-keys" (.index source "m]")))))
  (let [source "(let [m (python/dict)] (:a m))"]
    (is (= source (transformed source "destructure-keys" (.index source "m ")))))
  (is (= "#{1 2 3}" (transformed "#{3 1 2}" "sort-clauses" 0)))
  (let [source "(missing 1 2)" result (transformed source "create-function" 1)]
    (is (str/includes? result "(basilisp.core/defn- missing [arg1 arg2]"))
    (is (empty? (:diagnostics (syntax/parse result))))))

(deftest automatic-require-completion-and-command-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp)) c (client root)
        uri (.as_uri (.joinpath root "consumer.lpy")) source "(ns consumer)\n(val)"]
    (try
      (.write_text (.joinpath root "provider.lpy") "(ns provider) (defn value [] 42)" ** :encoding "utf-8")
      (initialize! c root) (open! c uri source)
      (let [items (:items (result! c "textDocument/completion" (at uri 1 4)))
            item (first (filter #(= "provider/value" (:label %)) items))
            result (apply-wire-edits source (cons (:textEdit item) (:additionalTextEdits item)))]
        (is item)
        (is (seq (:additionalTextEdits item)))
        (is (str/includes? result "(:require [provider])"))
        (is (str/includes? result "(provider/value)")))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 2} :contentChanges [{:text "(ns consumer)\n(value)"}]})
      (diagnostics! c 2)
      (result! c "workspace/executeCommand" {:command "add-missing-libspec" :arguments [uri 1 2]})
      (let [request (last (filter #(= "workspace/applyEdit" (:method %)) @(:notifications c)))
            edits (get-in request [:params :edit :documentChanges 0 :edits])]
        (is (seq edits))
        (is (str/includes? (apply-wire-edits "(ns consumer)\n(value)" edits) "[provider :refer [value]]"))
        (send! c {:id (:id request) :result {:applied true}}))
      (finally (stop! c) (.cleanup temp)))))

(deftest selection-extraction-and-presentation-settings-test
  (let [source "(defn blt-selected [x] (inc x) (+ x 2)) (blt-selected 4)"
        start (.index source "(inc") end (.index source ") (blt")
        analysis (assoc (analyzer/analyze source) :selection-end end
                        :settings {:private-by-default-on-extract? false})
        edits (lsp/refactor-edits source analysis "extract-function" start ["selected-part"])
        result (reduce (fn [text [start end replacement]] (str (subs text 0 start) replacement (subs text end)))
                       source (sort-by first > edits))]
    (is (seq edits))
    (is (str/includes? result "(basilisp.core/defn selected-part [x]"))
    (is (= (load-string source) (load-string result))))
  (let [source "(inc 1)" analysis (assoc (analyzer/analyze source) :settings {:keep-parens-when-threading? true})]
    (is (= "(-> 1\n    (inc))" (nth (first (lsp/refactor-edits source analysis "thread-first" 0 [])) 2))))
  (let [source "(defn allocation [] [1])"]
    (is (= source (transformed source "extract-to-def" (.index source "[1]") "shared")))))

(deftest new-namespace-and-hover-call-settings-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp)) c (client root)
        uri (.as_uri (.joinpath root "blank.lpy"))]
    (try
      (let [init (initialize! c root)]
        (is (get-in init [:capabilities :experimental :testTree]))
        (is (get-in init [:capabilities :experimental :projectTree])))
      (open! c uri "")
      (result! c "workspace/symbol" {:query ""})
      (let [request (first (filter #(= "workspace/applyEdit" (:method %)) @(:notifications c)))]
        (is (= "(ns blank)\n" (get-in request [:params :edit :documentChanges 0 :edits 0 :newText])))
        (send! c {:id (:id request) :result {:applied true}}))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 2} :contentChanges [{:text "(ns blank) (let [x 1] (inc x))"}]})
      (diagnostics! c 2)
      (is (str/includes? (get-in (result! c "textDocument/hover" (at uri 0 27)) [:contents :value]) "calling: inc"))
      (notification! c "workspace/didChangeConfiguration" {:settings {:hover {:hide-signature-call? true}}})
      (is (not (str/includes? (get-in (result! c "textDocument/hover" (at uri 0 27)) [:contents :value]) "calling:")))
      (finally (stop! c) (.cleanup temp)))))

(deftest comment-dependency-placement-test
  (let [source "(ns app)\n(comment (s/join []))" offset (.index source "s/join")]
    (doseq [[mode expected] [[:always "(basilisp.core/require '[basilisp.string :as s])"]
                             [:never "(:require [basilisp.string :as s])"]]]
      (let [analysis (assoc (analyzer/analyze source) :settings {:add-missing {:add-to-rcf mode}})
            edits (lsp/refactor-edits source analysis "add-require-suggestion" offset ["basilisp.string" "s"])
            result (reduce (fn [text [start end replacement]] (str (subs text 0 start) replacement (subs text end)))
                           source (sort-by first > edits))]
        (is (str/includes? result expected))
        (is (empty? (:diagnostics (syntax/parse result))))))))

(deftest workspace-move-form-protocol-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp)) c (client root)
        source-file (.joinpath root "move_source.lpy")
        target-file (.joinpath root "move_target.lpy")
        source "(ns move-source)\n(defn greet [x] (str \"Hi \" x))\n(greet \"Ada\")\n"
        target "(ns move-target)\n"
        uri (.as_uri source-file)]
    (try
      (.write_text source-file source)
      (.write_text target-file target)
      (initialize! c root)
      (open! c uri source)
      (result! c "workspace/executeCommand"
               {:command "move-form" :arguments [uri 1 7 "move_target.lpy"]})
      (let [request (first (filter #(= "workspace/applyEdit" (:method %)) @(:notifications c)))
            changes (get-in request [:params :edit :documentChanges])
            results (into {} (for [change changes
                                   :let [changed-uri (get-in change [:textDocument :uri])
                                         before (if (= uri changed-uri) source target)]]
                               [changed-uri (apply-wire-edits before (:edits change))]))]
        (is (= #{uri (.as_uri target-file)} (set (keys results))))
        (is (str/includes? (get results (.as_uri target-file) "") "defn greet"))
        (is (not (str/includes? (get results uri "") "(defn greet")))
        (is (str/includes? (get results uri "") "move-target/greet"))
        (send! c {:id (:id request) :result {:applied true}}))
      (finally (stop! c) (.cleanup temp)))))

(deftest batch-rename-scope-and-dependency-safety-test
  (let [file "/tmp/rename-scope.lpy"
        source "(ns rename-scope) (defn left [x] x) (defn right [other] other)"
        docs {file source}
        options {:python-inspection? false}
        result (lsp/batch-query docs options "rename"
                                {:filename file :row 1 :col (+ 2 (.index source "[x")) :to "other"})]
    (is (= 2 (:occurrences (:result result)))))
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        entry (str (.joinpath root "entry.lpy")) dep (.joinpath root "dependency.lpy")
        source "(ns entry (:require [dependency :as d])) (d/value)"
        _ (.write_text dep "(ns dependency) (defn value [] 1)")
        documents {entry source}
        options {:python-paths [(str root)] :python-inspection? false
                 :analysis {:type :project-and-full-dependencies}}]
    (try
      (let [refs (lsp/batch-query documents options "references" {:from "dependency/value" :include-declaration? true})]
        (is (= #{entry (str dep)} (set (map :filename (:result refs))))))
      (doseq [from ["dependency/value" "dependency"]]
        (is (thrown? Exception (lsp/batch-query documents options "rename" {:from from :to "renamed"}))))
      (finally (.cleanup temp)))))

(deftest editor-formatting-honors-macro-metadata-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp)) c (client root)
        uri (.as_uri (.joinpath root "format_meta.lpy"))
        source "(ns format-meta)\n(defmacro ^{:style/indent 1} custom [x & body] nil)\n(custom 1\n2\n3)"]
    (try
      (initialize! c root) (open! c uri source)
      (let [edits (result! c "textDocument/formatting"
                           {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}})]
        (is (str/includes? (apply-wire-edits source edits) "(custom 1\n  2\n  3)")))
      (let [edits (result! c "textDocument/rangeFormatting"
                           {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}
                            :range {:start {:line 2 :character 0} :end {:line 4 :character 2}}})]
        (is (str/includes? (apply-wire-edits source edits) "(custom 1\n  2\n  3)")))
      (finally (stop! c) (.cleanup temp)))))

(deftest workspace-logging-lifecycle-protocol-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp)) c (client root)
        first-log (.joinpath root "first.log") second-log (.joinpath root "second.log")
        uri (.as_uri (.joinpath root "logging_example.lpy"))]
    (try
      (result! c "initialize"
               {:processId nil :rootUri (.as_uri root)
                :initializationOptions {:source-paths ["."] :log-path "first.log"}
                :capabilities {}})
      (notification! c "initialized" {})
      (open! c uri "(ns logging-example) (def value 1)")
      (is (.is_file first-log))
      (notification! c "workspace/didChangeConfiguration" {:settings {:log-path "second.log"}})
      (result! c "clojure/serverInfo/raw" {})
      (stop! c)
      (is (.is_file second-log))
      (finally
        (when (nil? (.poll (:process c))) (stop! c))
        (.cleanup temp)))))

(deftest remaining-refactor-command-output-test
  (is (= "1" (transformed "(+ 1 2)" "raise-sexp" 3)))
  (is (= "(+  2)" (transformed "(+ 1 2)" "kill-sexp" 3)))
  (let [source "(ns imports)\n(datetime/date 2020 1 1)"
        result (transformed source "add-missing-import" (.index source "datetime") "datetime")]
    (is (str/includes? result "(:import [datetime])"))
    (is (str/includes? result "(datetime/date 2020 1 1)")))
  (let [source "(ns sample (:require [basilisp.string]))\n(basilisp.string/join \" \" [\"a\" \"b\"])"
        result (transformed source "swap-namespace-with-alias" (.rfind source "basilisp.string") "basilisp.string" "s")]
    (is (str/includes? result "[basilisp.string :as s]"))
    (is (str/includes? result "(s/join")))
  (let [source "(ns sample (:require [basilisp.string :refer :all]))\n(join \" \" [\"a\" \"b\"])"
        offset (.index source ":refer")
        referred (transformed source "replace-refer-all-with-refer" offset)
        aliased (transformed source "replace-refer-all-with-alias" offset)]
    (is (str/includes? referred ":refer [join]") referred)
    (is (str/includes? aliased "[basilisp.string :as string]"))
    (is (str/includes? aliased "(string/join") aliased)))

(deftest cursor-and-macro-configuration-command-protocol-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp)) c (client root)
        uri (.as_uri (.joinpath root "command_demo.lpy"))]
    (try
      (initialize! c root)
      (open! c uri "(ns command-demo)\n(+ 1 2)\n(custom [x 1] x)")
      (doseq [[command character start end]
              [["forward" 0 7 7] ["forward-select" 0 0 7]
               ["backward" 7 0 0] ["backward-select" 7 0 7]]]
        (result! c "workspace/executeCommand" {:command command :arguments [uri 1 character]})
        (let [request (last (filter #(= "window/showDocument" (:method %)) @(:notifications c)))]
          (is (= uri (get-in request [:params :uri])))
          (is (= {:line 1 :character start} (get-in request [:params :selection :start])))
          (is (= {:line 1 :character end} (get-in request [:params :selection :end])))
          (send! c {:id (:id request) :result {:success true}})))
      (result! c "workspace/executeCommand" {:command "resolve-macro-as" :arguments [uri 2 1 "clojure.core/let"]})
      (let [request (last (filter #(= "workspace/applyEdit" (:method %)) @(:notifications c)))
            changes (get-in request [:params :edit :documentChanges])]
        (is (= "create" (:kind (first changes))))
        (is (str/includes? (get-in (second changes) [:edits 0 :newText])
                           "command-demo/custom basilisp.core/let") (pr-str changes))
        (send! c {:id (:id request) :result {:applied true}}))
      (finally (stop! c) (.cleanup temp)))))

(deftest cljc-workspace-discovery-navigation-and-watching-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        provider (.joinpath root "shared.cljc") consumer (.joinpath root "consumer.lpy")
        source "(ns consumer (:require [shared :as s]))\n(s/greet 1)\n"
        provider-source "(ns shared)\n#?(:clj (def ignored 0) :lpy (defn greet [x] x))\n"
        _ (.write_text provider provider-source ** :encoding "utf-8")
        _ (.write_text consumer source ** :encoding "utf-8")
        c (client root) uri (.as_uri consumer)]
    (try
      (initialize! c root)
      (is (empty? (:diagnostics (open! c uri source))))
      (let [definition (result! c "textDocument/definition" (at uri 1 4))]
        (is (= (.as_uri provider) (:uri definition))))
      (is (= ["greet"] (mapv :name (result! c "workspace/symbol" {:query "greet"}))))
      (is (empty? (result! c "workspace/symbol" {:query "ignored"})))
      (let [edit (result! c "workspace/willRenameFiles"
                          {:files [{:oldUri (.as_uri provider)
                                    :newUri (.as_uri (.joinpath root "renamed.cljc"))}]})
            texts (mapcat #(map :newText (:edits %)) (:documentChanges edit))]
        (is (= ["renamed" "renamed"] (vec texts))))
      (.write_text provider "(ns shared)\n(defn greet [x y] (+ x y))\n" ** :encoding "utf-8")
      (notification! c "workspace/didChangeWatchedFiles"
                     {:changes [{:uri (.as_uri provider) :type 2}]})
      (let [diagnostics (:diagnostics (next-diagnostics! c uri
                                                         #(some (fn [finding] (= "invalid-arity" (:code finding))) %)))]
        (is (= 1 (count (filter #(= "invalid-arity" (:code %)) diagnostics)))))
      (finally (stop! c) (.cleanup temp)))))

(deftest keyword-references-preserve-negotiated-unicode-positions-test
  (doseq [encoding ["utf-16" "utf-8"]]
    (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
          c (client root) uri (.as_uri (.joinpath root "keywords.lpy"))
          line "[\"😀\" :demo/value :demo/value]"
          source (str "(ns keywords)\n" line)
          units (fn [offset] (let [prefix (subs line 0 offset)]
                               (if (= encoding "utf-8") (count (.encode prefix "utf-8"))
                                   (quot (count (.encode prefix "utf-16-le")) 2))))
          first-col (units (.find line ":demo/value"))
          second-col (units (.rfind line ":demo/value"))]
      (try
        (result! c "initialize" {:rootUri (.as_uri root)
                                 :initializationOptions {:source-paths ["."]}
                                 :capabilities {:general {:positionEncodings [encoding]}}})
        (notification! c "initialized" {})
        (open! c uri source)
        (let [references (result! c "textDocument/references"
                                  (assoc (at uri 1 (+ first-col 3)) :context {:includeDeclaration true}))]
          (is (= [first-col second-col] (mapv #(get-in % [:range :start :character]) references)))
          (is (= [(+ first-col 11) (+ second-col 11)]
                 (mapv #(get-in % [:range :end :character]) references))))
        (finally (stop! c) (.cleanup temp))))))

(deftest shutdown-exits-while-disposable-project-analysis-is-running-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        bootstrap (.joinpath root "slow_server.py") marker (.joinpath root "analysis-started")
        _ (.write_text bootstrap
                       (str "import sys, time\nfrom pathlib import Path\n"
                            "from basilisp_tools.cli import main\nimport basilisp_tools.lsp as lsp\n"
                            "def slow_worker(jobs):\n"
                            "    future, context, function, arguments = jobs.get()\n"
                            "    future.set_running_or_notify_cancel()\n"
                            "    Path('analysis-started').write_text('running')\n"
                            "    time.sleep(60)\n    return {}\n"
                            "lsp.worker_loop = slow_worker\nsys.argv = ['blt', 'lsp']\nmain()\n"))
        c (client root nil [sys/executable (str bootstrap)])]
    (try
      (initialize! c root)
      (loop [attempt 0]
        (when (and (not (.exists marker)) (< attempt 100))
          (time/sleep 0.02) (recur (inc attempt))))
      (is (.exists marker))
      (let [start (time/monotonic)]
        (stop! c)
        (is (< (- (time/monotonic) start) 5)))
      (finally
        (when (nil? (.poll (:process c))) (.kill (:process c)))
        (.cleanup temp)))))

(deftest shutdown-stops-owned-python-inspection-subprocess-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        bootstrap (.joinpath root "sleeping_inspector.py") marker (.joinpath root "inspection.pid")
        child-code (str "import os,time; from pathlib import Path; Path("
                        (json/dumps (str marker)) ").write_text(str(os.getpid())); time.sleep(60)")
        _ (.write_text bootstrap
                       (str "import sys\nfrom basilisp_tools.cli import main\n"
                            "import basilisp_tools.python as inspection\n"
                            "original = inspection.worker_runtime.InspectionProcesses.run\n"
                            "def sleeping(self, args, **kwargs):\n"
                            "    if str(args[-1]).endswith('_inspect.py'):\n"
                            "        args = [sys.executable, '-c', " (json/dumps child-code) "]\n"
                            "    return original(self, args, **kwargs)\n"
                            "inspection.worker_runtime.InspectionProcesses.run = sleeping\n"
                            "sys.argv = ['blt', 'lsp', '--python-timeout', '60']\nmain()\n"))
        c (client root nil [sys/executable (str bootstrap)]) child (atom nil)]
    (try
      (initialize! c root)
      (notification! c "textDocument/didOpen"
                     {:textDocument {:uri (.as_uri (.joinpath root "waiting.lpy")) :languageId "basilisp" :version 1
                                     :text "(ns waiting (:import [math]))\n(math/sqrt 4)\n"}})
      (loop [attempt 0]
        (when (and (not (.exists marker)) (< attempt 500))
          (time/sleep 0.02) (recur (inc attempt))))
      (is (.exists marker))
      (when (.exists marker) (reset! child (python/int (.read_text marker))))
      (let [start (time/monotonic)]
        (stop! c)
        (is (< (- (time/monotonic) start) 5)))
      (when @child
        (is (try (os/kill @child 0) false (catch python/ProcessLookupError _ true))))
      (finally
        (when (nil? (.poll (:process c))) (.kill (:process c)))
        (when @child (try (os/kill @child 9) (catch python/ProcessLookupError _ nil)))
        (.cleanup temp)))))

(deftest native-reader-formatting-and-navigation-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        c (client root)
        uri (.as_uri (.joinpath root "native_reader.lpy"))
        source "(ns native-reader)\n(defn value\\path [x] (+ x 1))\n(defn run []\n(let [payload {:a\\b 98}]\n(+ (:a\\b payload) (value\\path 1))))\n"
        position (.find (nth (.splitlines source) 4) "value\\path")]
    (try
      (initialize! c root)
      (is (empty? (:diagnostics (open! c uri source))))
      (let [point (at uri 4 position)
            definition (result! c "textDocument/definition" point)
            hover (result! c "textDocument/hover" point)]
        (is (= {:line 1 :character 6} (get-in definition [:range :start])))
        (is (= {:line 1 :character 16} (get-in definition [:range :end])))
        (is (str/includes? (str hover) "value"))
        (is (= 2 (count (result! c "textDocument/references"
                                 (assoc point :context {:includeDeclaration true}))))))

      (let [edits (result! c "textDocument/formatting"
                           {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}})
            formatted (:newText (first edits))]
        (is (= 1 (count edits)))
        (is (str/includes? formatted ":a\\b"))
        (is (str/includes? formatted "value\\path"))
        (is (empty? (:diagnostics (syntax/parse formatted))))
        (is (empty? (:findings (analyzer/analyze formatted)))))

      (let [edits (result! c "textDocument/rangeFormatting"
                           {:textDocument {:uri uri}
                            :range {:start {:line 2 :character 0} :end {:line 4 :character 35}}
                            :options {:tabSize 2 :insertSpaces true}})]
        (is (= 1 (count edits)))
        (is (str/includes? (:newText (first edits)) ":a\\b"))
        (is (empty? (:diagnostics (syntax/parse (:newText (first edits)))))))

      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 2}
                      :contentChanges [{:text (str source "\n:a😀\n")}]})
      (is (seq (:diagnostics (diagnostics! c 2))))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 3}
                      :contentChanges [{:text source}]})
      (is (empty? (:diagnostics (diagnostics! c 3))))
      (finally (stop! c) (.cleanup temp)))))

(deftest references-across-many-unrelated-documents-test
  (let [target "/tmp/blt-many-references/target.lpy"
        documents (assoc (into {} (for [i (range 300)]
                                    [(str "/tmp/blt-many-references/file" i ".lpy")
                                     (str "(ns bulk.n" i ")\n(def value " i ")\n")]))
                         target "(ns bulk.target)\n(def value 1)\n(def other value)\n")
        analyses (lsp/workspace-analysis documents {:python-inspection? false})
        options {:analyses analyses}
        query #(lsp/batch-query documents options "references" %)
        references (:result (query {:from "bulk.target/value" :include-declaration? true}))
        usages (:result (query {:from "bulk.target/value" :include-declaration? false}))
        absent (query {:from "bulk.target/absent" :include-declaration? true})]
    (is (= 301 (count analyses)))
    (is (= 2 (count references)))
    (is (= #{target} (set (map :filename references))))
    (is (= #{2 3} (set (map :row references))))
    (is (= [3] (mapv :row usages)))
    (is (empty? (:result absent)))
    (is (= 1 (:exit-code absent)))
    (let [namespace (query {:from "bulk.target" :include-declaration? true})
          usages (query {:from "bulk.target" :include-declaration? false})
          missing (query {:from "bulk.missing" :include-declaration? true})]
      (is (= [target] (mapv :filename (:result namespace))))
      (is (= [1] (mapv :row (:result namespace))))
      (is (empty? (:result usages)))
      (is (empty? (:result missing)))
      (is (= 1 (:exit-code missing))))
    (is (thrown-with-msg? Exception #"Rename requires a resolved binding"
                          (lsp/batch-query documents options "rename"
                                           {:from "bulk.missing/value" :to "renamed"})))))

(deftest protocol-references-and-rename-across-many-unrelated-documents-test
  (let [temp (tempfile/TemporaryDirectory)
        root (.resolve (pathlib/Path (.-name temp)))
        target (.joinpath root "target.lpy")
        uri (.as_uri target)
        source "(ns target)\n(def value 1)\nvalue\n(defn call-me [] 1)\ncall-me\n(defn swap-me [x y] [x y])\n(swap-me 1 2)\n"
        declaration {:start {:line 1 :character 5} :end {:line 1 :character 10}}
        usage {:start {:line 2 :character 0} :end {:line 2 :character 5}}
        _ (.write_text target source ** :encoding "utf-8")
        _ (doseq [i (range 300)]
            (.write_text (.joinpath root (str "noise" i ".lpy"))
                         (str "(ns noise" i ")\n(def value " i ")\n")
                         ** :encoding "utf-8"))
        c (client root)
        ;; These requests inspect all 301 source files, including on cold CI workers.
        request-long! (fn [method params]
                        (let [id (swap! (:id c) inc)]
                          (send! c {:id id :method method :params params})
                          (response! c id 90)))
        result-long! (fn [method params]
                       (let [response (request-long! method params)]
                         (when-let [error (:error response)]
                           (throw (python/RuntimeError (str error))))
                         (:result response)))
        document-diagnostics!
        (fn [document-uri version]
          (let [match? #(and (= "textDocument/publishDiagnostics" (:method %))
                             (= document-uri (get-in % [:params :uri]))
                             (= version (get-in % [:params :version])))]
            (or (some #(when (match? %) (:params %)) @(:notifications c))
                (loop []
                  (let [message (.get (:messages c) ** :timeout 90)]
                    (when (:reader-error message)
                      (throw (python/RuntimeError (:reader-error message))))
                    (if (match? message) (:params message)
                        (do (swap! (:notifications c) conj message) (recur))))))))]
    (try
      (result-long! "initialize"
                    {:processId nil :rootUri (.as_uri root)
                     :initializationOptions {:source-paths ["."] :cache-path false}
                     :capabilities {:workspace {:workspaceEdit {:documentChanges true}}}})
      (notification! c "initialized" {})
      (notification! c "textDocument/didOpen"
                     {:textDocument {:uri uri :languageId "basilisp" :version 1 :text source}})
      (let [findings (:diagnostics (document-diagnostics! uri 1))]
        (is (empty? findings) (pr-str findings)))
      (testing "Identically named vars in other namespaces are excluded"
        (let [references (result-long! "textDocument/references"
                                       (assoc (at uri 2 2) :context {:includeDeclaration true}))]
          (is (= 2 (count references)))
          (is (= #{{:uri uri :range declaration} {:uri uri :range usage}}
                 (set references))))
        (let [edit (result-long! "textDocument/rename"
                                 (assoc (at uri 2 2) :newName "renamed"))
              documents (:documentChanges edit)
              document (first documents)
              edits (:edits document)]
          (is (= 1 (count documents)))
          (is (= uri (get-in document [:textDocument :uri])))
          (is (= 2 (count edits)))
          (is (= #{{:range declaration :newText "renamed"}
                   {:range usage :newText "renamed"}}
                 (set edits)))))
      (testing "Sparse workspace queries scan unrelated documents without recursion"
        (is (= [] (result-long! "workspace/symbol" {:query "absent-workspace-symbol"})))
        (let [symbols (result-long! "workspace/symbol" {:query "call-me"})]
          (is (= ["call-me"] (mapv :name symbols)))
          (is (= [uri] (mapv #(get-in % [:location :uri]) symbols))))
        (is (= [] (result-long! "textDocument/implementation" (at uri 3 8))))
        (let [items (result-long! "textDocument/prepareCallHierarchy" (at uri 3 8))
              item (first items)]
          (is (= 1 (count items)))
          (is (= "call-me" (:name item)))
          (is (= uri (:uri item)))
          ;; Reading the function value on line five does not call it.
          (is (= [] (result-long! "callHierarchy/incomingCalls" {:item item})))))
      (testing "Parameter movement scans all documents and preserves the call result"
        (result-long! "workspace/executeCommand"
                      {:command "drag-param-forward" :arguments [uri 5 15]})
        (let [request (last (filter #(= "workspace/applyEdit" (:method %)) @(:notifications c)))
              edits (get-in request [:params :edit :documentChanges 0 :edits])
              changed (apply-wire-edits source edits)]
          (is (seq edits))
          (is (str/includes? changed "[y x]"))
          (is (= (load-string source) (load-string changed)))
          (send! c {:id (:id request) :result {:applied false}})))
      (testing "The renamed-refer safety guard still rejects unsafe workspace edits"
        ;; The preceding edit was only returned, so the original target is unchanged.
        (let [alias-uri (.as_uri (.joinpath root "alias_user.lpy"))
              alias-source "(ns alias-user (:require [target :refer [value] :rename {value local-value}]))\nlocal-value\n"]
          (notification! c "textDocument/didOpen"
                         {:textDocument {:uri alias-uri :languageId "basilisp"
                                         :version 2 :text alias-source}})
          (let [findings (:diagnostics (document-diagnostics! alias-uri 2))]
            (is (empty? findings) (pr-str findings)))
          (is (= {:uri uri :range declaration}
                 (result-long! "textDocument/definition" (at alias-uri 1 2))))
          (let [response (request-long! "textDocument/rename"
                                        (assoc (at uri 2 2) :newName "renamed"))]
            (is (= -32602 (get-in response [:error :code])))
            (is (= "Renaming a var used through :rename requires updating its alias declarations manually."
                   (get-in response [:error :message]))))))
      (finally (stop! c) (.cleanup temp)))))
