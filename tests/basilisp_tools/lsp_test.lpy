        (is (every? #(not (some #{"self"} (map :label (:parameters %)))) (:signatures help))))
      (is (some #(= ".upper" (:label %))
                (:items (result! c "textDocument/completion" (at uri 3 5)))))
      (finally (stop! c) (.cleanup temp)))))

