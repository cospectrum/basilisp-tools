        c (client root) uri (.as_uri (.joinpath root "rich.lpy"))
        source "(ns rich (:import [api]))\n(api/select 1 2)\n(let [v (api/Value)] (.method v 1))\n(.upp (.-name (api/Value)))"]
    (try
      (.write_text (.joinpath root "api.pyi")
                   "from typing import overload\n@overload\ndef select(value: int) -> str: ...\n@overload\ndef select(value: int, fallback: str) -> str: ...\nclass Value:\n    @property\n    def name(self) -> str: ...\n    @overload\n    def method(self, value: int) -> str: ...\n    @overload\n    def method(self, value: str, *, upper: bool = ...) -> str: ...\n"
                   ** :encoding "utf-8")
      (initialize! c root)
