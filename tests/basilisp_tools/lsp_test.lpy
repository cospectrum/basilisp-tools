(ns basilisp-tools.lsp-test
  (:require [basilisp.test :refer [deftest is testing]]
            [basilisp.string :as str]
            [basilisp-tools.lsp :as lsp]
            [basilisp-tools.analyzer :as analyzer]
            [basilisp-tools.syntax :as syntax])
  (:import [json] [os] [pathlib] [queue] [subprocess] [sys] [time] [tempfile] [threading]))

(defn- read-messages [process messages]
  (try
    (loop []
      (let [header (.readline (.-stdout process))]
        (when (seq header)
          (let [length (python/int (second (.split (.decode header "ascii") ":")))]
            (loop []
              (when-not (= "\r\n" (.decode (.readline (.-stdout process)) "ascii"))
                (recur)))
            (.put messages (py->lisp (json/loads (.read (.-stdout process) length))))
            (recur)))))
    (catch python/Exception e (.put messages {:reader-error (str e)}))))

(defn- client [root & [environment command]]
  (let [process (subprocess/Popen
                 (or command [(str (.joinpath (.-parent (pathlib/Path sys/executable)) "blt")) "lsp"])
                 ** :stdin subprocess/PIPE :stdout subprocess/PIPE :stderr subprocess/PIPE
                 :cwd (str root) :env environment)
        messages (queue/Queue)
        reader (threading/Thread ** :target #(read-messages process messages) :daemon true)]
    (.start reader)
    {:process process :messages messages :id (atom 0) :notifications (atom [])}))

(defn- send! [client message]
  (let [body (.encode (json/dumps (lisp->py (assoc message :jsonrpc "2.0") :keyword-fn #(subs (str %) 1))
                                  ** :ensure_ascii false) "utf-8")
        stream (.-stdin (:process client))]
    (.write stream (.encode (str "Content-Length: " (count body) "\r\n\r\n") "ascii"))
    (.write stream body)
    (.flush stream)))

(defn- response! [client id timeout]
  (loop []
    (let [message (.get (:messages client) ** :timeout timeout)]
      (when (:reader-error message) (throw (python/RuntimeError (:reader-error message))))
      (if (= id (:id message)) message
          (do (swap! (:notifications client) conj message) (recur))))))

(defn- request! [client method params]
  (let [id (swap! (:id client) inc)]
    (send! client {:id id :method method :params params})
    ;; A fresh installation compiles Basilisp namespaces on its first launch.
    (response! client id (if (= method "initialize") 90 20))))

(defn- result! [client method params]
  (let [response (request! client method params)]
    (when-let [error (:error response)] (throw (python/RuntimeError (str error))))
    (:result response)))

(defn- notification! [client method params]
  (send! client {:method method :params params}))

(defn- diagnostics! [client version]
  (let [match? #(and (= "textDocument/publishDiagnostics" (:method %))
                     (= version (get-in % [:params :version])))]
    (or (some #(when (match? %) (:params %)) @(:notifications client))
        (loop []
          (let [message (.get (:messages client) ** :timeout 20)]
            (if (match? message) (:params message)
                (do (swap! (:notifications client) conj message) (recur))))))))

(defn- initialize! [client root]
  (let [result (result! client "initialize"
                        {:processId nil :rootUri (.as_uri root)
                         :initializationOptions {:source-paths ["."] :text-document-sync-kind "incremental"
                                                 :linters {:clojure-lsp/unused-public-var {:level "off"}}}
                         :capabilities {:general {:positionEncodings ["utf-16"]}
                                        :workspace {:workspaceEdit {:documentChanges true}}}})]
    (notification! client "initialized" {})
    result))

(defn- open! [client uri source]
  (notification! client "textDocument/didOpen"
                 {:textDocument {:uri uri :languageId "basilisp" :version 1 :text source}})
  (diagnostics! client 1))

(defn- at [uri line character]
  {:textDocument {:uri uri} :position {:line line :character character}})

(defn- stop! [client]
  (let [process (:process client)]
    (try
      (result! client "shutdown" nil)
      (notification! client "exit" nil)
      (is (= 0 (.wait process ** :timeout 10)))
      (finally
        (when (nil? (.poll process)) (.kill process))
        (.wait process)
        (.close (.-stdin process))
        (.close (.-stdout process))
        (.close (.-stderr process))))))

(deftest protocol-lifecycle-and-incremental-unicode-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        c (client root) uri (.as_uri (.joinpath root "unicode.lpy"))]
    (try
      (let [initialized (initialize! c root)]
        (is (= "utf-16" (get-in initialized [:capabilities :positionEncoding])))
        (is (= 2 (get-in initialized [:capabilities :textDocumentSync :change])))
        (is (get-in initialized [:capabilities :hoverProvider])))
      (let [source "(ns unicode)\n(def emoji \"😀\")\n(let [x 1] [\"😀\" missing])"
            findings (:diagnostics (open! c uri source))
            unresolved (first (filter #(= "unresolved-symbol" (:code %)) findings))]
        (is (= 17 (get-in unresolved [:range :start :character])))
        (notification! c "textDocument/didChange"
                       {:textDocument {:uri uri :version 2}
                        :contentChanges [{:range {:start {:line 2 :character 17}
                                                  :end {:line 2 :character 24}}
                                          :text "x"}]})
        (let [findings (:diagnostics (diagnostics! c 2))]
          (is (empty? findings) (pr-str findings))))
      (testing "Only the latest document version receives asynchronous diagnostics"
        (notification! c "textDocument/didChange"
                       {:textDocument {:uri uri :version 3} :contentChanges [{:text "("}]})
        (notification! c "textDocument/didChange"
                       {:textDocument {:uri uri :version 4} :contentChanges [{:text "(ns unicode)"}]})
        (is (empty? (:diagnostics (diagnostics! c 4)))))
      (is (= -32601 (get-in (request! c "blt/unknownMethod" {}) [:error :code])))
      (finally (stop! c) (.cleanup temp)))))

(deftest project-navigation-rename-and-formatting-test
  (let [temp (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temp))
        provider (.joinpath root "provider.lpy")
        consumer (.joinpath root "consumer.lpy")
        provider-source "(ns provider)\n(defn greet \"Return its input.\" [name] name)\n"
        consumer-source "(ns consumer (:require [provider :as p]))\n(p/greet \"Alex\")\n"
        _ (.write_text provider provider-source ** :encoding "utf-8")
        _ (.write_text consumer consumer-source ** :encoding "utf-8")
        c (client root) uri (.as_uri consumer)]
    (try
      (initialize! c root)
      (is (empty? (:diagnostics (open! c uri consumer-source))))
      (let [definition (result! c "textDocument/definition" (at uri 1 4))]
        (is (= (.as_uri provider) (:uri definition)))
        (is (= {:line 1 :character 6} (get-in definition [:range :start]))))
      (let [hover (result! c "textDocument/hover" (at uri 1 4))]
        (is (>= (.find (get-in hover [:contents :value]) "Return its input.") 0)))
      (let [refs (result! c "textDocument/references"
                          (assoc (at uri 1 4) :context {:includeDeclaration true}))]
        (is (= 2 (count refs))))
      (let [edit (result! c "textDocument/rename" (assoc (at uri 1 4) :newName "welcome"))
            documents (:documentChanges edit)
            use-edit (first (:edits (first (filter #(= uri (get-in % [:textDocument :uri])) documents))))]
        (is (= 2 (count documents)))
        (is (= 3 (get-in use-edit [:range :start :character])))
        (is (= "welcome" (:newText use-edit))))
      (is (= -32602 (get-in (request! c "textDocument/rename"
                                      (assoc (at uri 1 4) :newName "other/name")) [:error :code])))
      (is (= "greet" (:name (first (result! c "workspace/symbol" {:query "greet"})))))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 2}
                      :contentChanges [{:text "(ns consumer)\n(defn answer [x]\n(+ x 1))\n"}]})
      (diagnostics! c 2)
      (let [edits (result! c "textDocument/formatting"
                           {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}})]
        (is (= "(ns consumer)\n(defn answer [x]\n  (+ x 1))\n" (:newText (first edits)))))
      (let [symbols (result! c "textDocument/documentSymbol" {:textDocument {:uri uri}})]
        (is (= ["answer"] (mapv :name symbols))))
      (finally (stop! c) (.cleanup temp)))))

(deftest python-completion-and-hover-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        uri (.as_uri (.joinpath root "interop.lpy")) c (client root)
        source "(ns interop (:import [math]))\n(math/sin 1)\nmath/si"]
    (try
      (initialize! c root)
      (open! c uri source)
      (let [items (:items (result! c "textDocument/completion" (at uri 2 7)))]
        (is (some #(= "math/sin" (:label %)) items)))
      (let [hover (result! c "textDocument/hover" (at uri 1 5))]
        (is (some? hover))
        (is (.startswith (get-in hover [:contents :value]) "sin\n")))
      (is (nil? (result! c "textDocument/prepareRename" (at uri 1 5))))
      (finally (stop! c) (.cleanup temp)))))

(deftest local-bindings-core-completion-and-rename-safety-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        uri (.as_uri (.joinpath root "local.lpy")) c (client root)
        line "(let [x 1 y 2] (let [x 3] x) x)"
        source (str "(ns local)\n" line "\nmap")]
    (try
      (initialize! c root)
      (open! c uri source)
      (let [edit (result! c "textDocument/rename"
                          (assoc (at uri 1 (.rfind line "x")) :newName "outer"))
            edits (:edits (first (:documentChanges edit)))]
        (is (= 2 (count edits)))
        (is (= #{6 (.rfind line "x")} (set (map #(get-in % [:range :start :character]) edits)))))
      (is (= -32602 (get-in (request! c "textDocument/rename"
                                      (assoc (at uri 1 (.rfind line "x")) :newName "y"))
                            [:error :code])))
      (is (nil? (result! c "textDocument/prepareRename" (at uri 2 1))))
      (is (= -32602 (get-in (request! c "textDocument/rename"
                                      (assoc (at uri 2 1) :newName "newmap")) [:error :code])))
      (let [items (:items (result! c "textDocument/completion" (at uri 2 3)))]
        (is (some #(= "map" (:label %)) items)))
      (doseq [name ["map" "if" ".method"]]
        (is (= -32602 (get-in (request! c "textDocument/rename"
                                        (assoc (at uri 1 (.rfind line "x")) :newName name))
                              [:error :code]))))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 2}
                      :contentChanges [{:text "(ns local)\n(let [{:keys [x]} {:x 1}] x)"}]})
      (diagnostics! c 2)
      (is (nil? (result! c "textDocument/prepareRename" (at uri 1 25))))
      (is (= -32602 (get-in (request! c "textDocument/rename"
                                      (assoc (at uri 1 25) :newName "value")) [:error :code])))
      (finally (stop! c) (.cleanup temp)))))

(deftest python-instance-method-completion-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        uri (.as_uri (.joinpath root "methods.lpy")) c (client root)
        line "(let [p (pathlib/Path \".\")] (.read_ p))"
        source (str "(ns methods (:import [pathlib]))\n" line)]
    (try
      (initialize! c root)
      (open! c uri source)
      (let [items (:items (result! c "textDocument/completion"
                                   (at uri 1 (+ (.find line ".read_") 6))))]
        (is (some #(= ".read_text" (:label %)) items))
        (is (some #(= ".read_bytes" (:label %)) items)))
      (finally (stop! c) (.cleanup temp)))))

(deftest shared-config-and-project-python-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        uri (.as_uri (.joinpath root "configured.lpy")) c (client root)
        config (.joinpath root ".clj-kondo") bin (.joinpath root ".venv" "bin")
        marker (.joinpath root "selected-python")
        executable (.joinpath bin "python")
        source "(ns configured (:import [math]))\n(let [unused 1]\n(math/sin 1))"]
    (try
      (.mkdir config)
      (.write_text (.joinpath config "config.edn")
                   "{:linters {:unused-binding {:level :off}}}" ** :encoding "utf-8")
      (.write_text (.joinpath root ".cljfmt.edn") "{:indentation? false}" ** :encoding "utf-8")
      (.mkdir bin ** :parents true)
      (.write_text executable
                   (str "#!/bin/sh\nprintf selected > '" marker "'\nexec '" sys/executable "' \"$@\"\n")
                   ** :encoding "utf-8")
      (.chmod executable 0755)
      (initialize! c root)
      (is (empty? (:diagnostics (open! c uri source))))
      (is (.is_file marker))
      (is (empty? (result! c "textDocument/formatting"
                           {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}})))
      (finally (stop! c) (.cleanup temp)))))

(deftest close-restores-disk-and-watched-files-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        file (.joinpath root "watched.lpy") uri (.as_uri file) c (client root)
        disk "(ns watched)\n(def disk-value 1)"]
    (try
      (.write_text file disk ** :encoding "utf-8")
      (initialize! c root)
      (open! c uri "(ns watched)\n(def unsaved-value 1)")
      (is (= ["unsaved-value"] (mapv :name (result! c "workspace/symbol" {:query "value"}))))
      (notification! c "textDocument/didClose" {:textDocument {:uri uri}})
      ;; A watched-file notification is an ordered barrier for disk reloading.
      (notification! c "workspace/didChangeWatchedFiles" {:changes [{:uri uri :type 2}]})
      (loop [attempt 0]
        (let [symbols (mapv :name (result! c "workspace/symbol" {:query "value"}))]
          (if (and (< attempt 4) (empty? symbols))
            (recur (inc attempt))
            (is (= ["disk-value"] symbols)))))
      (let [python-file (.joinpath root "other.py")]
        (.write_text python-file "(def leaked-python-symbol 1)" ** :encoding "utf-8")
        (notification! c "workspace/didChangeWatchedFiles"
                       {:changes [{:uri (.as_uri python-file) :type 1}]})
        (is (empty? (result! c "workspace/symbol" {:query "leaked"}))))
      (.unlink file)
      (notification! c "workspace/didChangeWatchedFiles" {:changes [{:uri uri :type 3}]})
      (is (empty? (result! c "workspace/symbol" {:query "value"})))
      (finally (stop! c) (.cleanup temp)))))

(deftest refer-declarations-participate-in-rename-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        provider (.joinpath root "provider.lpy") consumer (.joinpath root "consumer.lpy")
        uri (.as_uri consumer) c (client root)
        source "(ns consumer (:require [provider :refer [greet]]))\n(greet)"]
    (try
      (.write_text provider "(ns provider)\n(defn greet [] 1)" ** :encoding "utf-8")
      (.write_text consumer source ** :encoding "utf-8")
      (initialize! c root)
      (open! c uri source)
      (let [edit (result! c "textDocument/rename" (assoc (at uri 1 3) :newName "welcome"))]
        (is (= 3 (count (mapcat :edits (:documentChanges edit))))))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 2}
                      :contentChanges [{:text "(ns consumer (:require [provider :refer [greet] :rename {greet hello}]))\n(hello)"}]})
      (diagnostics! c 2)
      (is (= -32602 (get-in (request! c "textDocument/rename"
                                      (assoc (at uri 1 3) :newName "welcome")) [:error :code])))
      (finally (stop! c) (.cleanup temp)))))

(deftest generated-constructor-rename-is-rejected-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        uri (.as_uri (.joinpath root "records.lpy")) c (client root)]
    (try
      (initialize! c root)
      (open! c uri "(ns records)\n(defrecord Foo [x])\n(->Foo 1)")
      (doseq [position [(at uri 1 12) (at uri 2 3)]]
        (is (nil? (result! c "textDocument/prepareRename" position)))
        (is (= -32602 (get-in (request! c "textDocument/rename"
                                        (assoc position :newName "Bar")) [:error :code]))))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 2}
                      :contentChanges [{:text "(ns records)\n(defprotocol P (f [this]))\n(deftype T [] P (f [this] 1))\n(f (->T))"}]})
      (diagnostics! c 2)
      (is (nil? (result! c "textDocument/prepareRename" (at uri 3 1))))
      (is (= -32602 (get-in (request! c "textDocument/rename"
                                      (assoc (at uri 3 1) :newName "g")) [:error :code])))
      (finally (stop! c) (.cleanup temp)))))

(deftest completion-respects-namespace-configuration-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        uri (.as_uri (.joinpath root "names.lpy")) c (client root)
        source "(ns names (:refer-clojure :exclude [map] :rename {inc advance}) (:require [basilisp.string :as str :refer [upper-case]]))\nma\nad\nupper\nstr/up"]
    (try
      (initialize! c root)
      (open! c uri source)
      (let [labels (fn [line column]
                     (set (map :label (:items (result! c "textDocument/completion" (at uri line column))))))]
        (is (not (contains? (labels 1 2) "map")))
        (is (contains? (labels 2 2) "advance"))
        (is (contains? (labels 3 5) "upper-case"))
        (is (contains? (labels 4 6) "str/upper-case")))
      (finally (stop! c) (.cleanup temp)))))

(defn- next-diagnostics! [client uri predicate]
  (loop []
    (let [message (.get (:messages client) ** :timeout 20)
          params (:params message)]
      (if (and (= "textDocument/publishDiagnostics" (:method message))
               (= uri (:uri params)) (predicate (:diagnostics params)))
        params
        (recur)))))

(deftest edits-refresh-open-dependent-diagnostics-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        provider (.joinpath root "provider.lpy") consumer (.joinpath root "consumer.lpy")
        provider-uri (.as_uri provider) consumer-uri (.as_uri consumer) c (client root)
        provider-source "(ns provider)\n(defn value [] 1)"
        consumer-source "(ns consumer (:require [provider :as p]))\n(p/value)"]
    (try
      (.write_text provider provider-source ** :encoding "utf-8")
      (.write_text consumer consumer-source ** :encoding "utf-8")
      (initialize! c root)
      (open! c provider-uri provider-source)
      (open! c consumer-uri consumer-source)
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri provider-uri :version 2}
                      :contentChanges [{:text "(ns provider)\n(defn other [] 1)"}]})
      (let [diagnostics (next-diagnostics! c consumer-uri
                                           #(some (fn [d] (= "unresolved-var" (:code d))) %))]
        (is (= 1 (:version diagnostics))))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri provider-uri :version 3}
                      :contentChanges [{:text provider-source}]})
      (is (empty? (:diagnostics (next-diagnostics! c consumer-uri empty?))))
      (finally (stop! c) (.cleanup temp)))))

(deftest workspace-folders-and-watch-registration-test
  (let [temp (tempfile/TemporaryDirectory) base (pathlib/Path (.-name temp))
        root (.joinpath base "first") added (.joinpath base "second")
        _ (.mkdir root) _ (.mkdir added)
        _ (.write_text (.joinpath added "extra.lpy") "(ns extra)\n(def external-value 1)" ** :encoding "utf-8")
        c (client root)]
    (try
      (result! c "initialize"
               {:processId nil :rootUri (.as_uri root)
                :initializationOptions {:source-paths ["."] :text-document-sync-kind "incremental"
                                        :linters {:clojure-lsp/unused-public-var {:level "off"}}}
                :capabilities {:workspace {:didChangeWatchedFiles {:dynamicRegistration true}}}})
      (notification! c "initialized" {})
      (let [registration (.get (:messages c) ** :timeout 20)]
        (is (= "client/registerCapability" (:method registration)))
        (is (= "workspace/didChangeWatchedFiles"
               (get-in registration [:params :registrations 0 :method])))
        (send! c {:id (:id registration) :result nil}))
      (is (empty? (result! c "workspace/symbol" {:query "external"})))
      (notification! c "workspace/didChangeWorkspaceFolders"
                     {:event {:added [{:uri (.as_uri added) :name "second"}] :removed []}})
      (is (= ["external-value"] (mapv :name (result! c "workspace/symbol" {:query "external"}))))
      (notification! c "workspace/didChangeWorkspaceFolders"
                     {:event {:added [] :removed [{:uri (.as_uri added) :name "second"}]}})
      (is (empty? (result! c "workspace/symbol" {:query "external"})))
      (finally (stop! c) (.cleanup temp)))))

(deftest file-settings-control-protocol-and-discovery-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        config (.joinpath root ".lsp" "config.edn")
        _ (.mkdir (.-parent config) ** :parents true)
        _ (.write_text config
                       "{:source-paths [\"src\" \"generated\"] :source-paths-ignore-regex [\"generated\"] :paths-ignore-regex [\".*/skip.lpy\"] :text-document-sync-kind :full :document-formatting? false :document-range-formatting? false :cljfmt {:remove-multiple-non-indenting-spaces? true}}"
                       ** :encoding "utf-8")
        _ (.mkdir (.joinpath root "src"))
        _ (.mkdir (.joinpath root "generated"))
        _ (.write_text (.joinpath root "src" "kept.lpy") "(ns kept) (def kept-value 1)")
        _ (.write_text (.joinpath root "src" "skip.lpy") "(ns skip) (def skipped-value 1)")
        _ (.write_text (.joinpath root "generated" "generated.lpy") "(ns generated) (def generated-value 1)")
        _ (.write_text (.joinpath root "outside.lpy") "(ns outside) (def outside-value 1)")
        c (client root) uri (.as_uri (.joinpath root "src" "kept.lpy"))]
    (try
      (let [init (initialize! c root)]
        (is (= 1 (get-in init [:capabilities :textDocumentSync :change])))
        (is (false? (get-in init [:capabilities :documentFormattingProvider])))
        (is (false? (get-in init [:capabilities :documentRangeFormattingProvider]))))
      (is (= ["kept-value"] (mapv :name (result! c "workspace/symbol" {:query "value"}))))
      (open! c uri "(ns kept)\n(def   kept-value 1)")
      (is (empty? (result! c "textDocument/formatting" {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}})))
      (testing "Project file settings override a dynamic client update"
        (notification! c "workspace/didChangeConfiguration" {:settings {:document-formatting? true}})
        (is (empty? (result! c "textDocument/formatting" {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}}))))
      (testing "Removing a file override exposes the client's current setting"
        (.write_text config "{:source-paths [\"src\"] :paths-ignore-regex [\".*/skip.lpy\"] :cljfmt {:remove-multiple-non-indenting-spaces? true}}" ** :encoding "utf-8")
        (notification! c "workspace/didChangeWatchedFiles"
                       {:changes [{:uri (.as_uri config) :type 2}]})
        (is (= 1 (count (result! c "textDocument/formatting"
                                 {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}})))))
      (testing "Formatting discovers settings changes without watched-file support and reindexes"
        (.write_text config "{:source-paths [\"generated\"]}" ** :encoding "utf-8")
        (result! c "textDocument/formatting" {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}})
        (is (= #{"kept-value" "generated-value"}
               (set (map :name (result! c "workspace/symbol" {:query "value"}))))))
      (finally (stop! c) (.cleanup temp)))))

(deftest lsp-formatter-settings-precedence-and-range-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        config (.joinpath root ".lsp" "config.edn")
        _ (.mkdir (.-parent config) ** :parents true)
        _ (.write_text config
                       "{:cljfmt-config-path \"format.clj\" :cljfmt {:remove-consecutive-blank-lines? false :remove-multiple-non-indenting-spaces? true} :hover {:hide-file-location? true :arity-on-same-line? true}}"
                       ** :encoding "utf-8")
        c (client root) uri (.as_uri (.joinpath root "sample.lpy"))
        source "(ns sample)\n\n\n(defn identity [x] x)\n"]
    (try
      (initialize! c root)
      (open! c uri source)
      (is (empty? (result! c "textDocument/formatting" {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}})))
      (.write_text (.joinpath root "format.clj") "^{:configuration true} {:remove-consecutive-blank-lines? true} :ignored-trailing-form" ** :encoding "utf-8")
      (let [edits (result! c "textDocument/formatting" {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}})]
        (is (= 1 (count edits)))
        (is (< (.find (:newText (first edits)) "\n\n\n") 0)))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 2}
                      :contentChanges [{:text "(ns sample)\n(def   x 1)\n(def   y 2)\n"}]})
      (diagnostics! c 2)
      (let [edits (result! c "textDocument/rangeFormatting"
                           {:textDocument {:uri uri} :range {:start {:line 1 :character 2} :end {:line 1 :character 8}}
                            :options {:tabSize 2 :insertSpaces true}})]
        (is (= 1 (count edits)))
        (is (= "(def x 1)" (:newText (first edits))))
        (is (= {:line 1 :character 0} (get-in (first edits) [:range :start])))
        (is (= {:line 1 :character 11} (get-in (first edits) [:range :end]))))
      (finally (stop! c) (.cleanup temp)))))

(deftest lsp-diagnostic-settings-and-runtime-update-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        config (.joinpath root ".lsp" "config.edn")
        _ (.mkdir (.-parent config) ** :parents true)
        _ (.write_text config "{:linters {:clj-kondo {:ns-exclude-regex \"silent.*\"}}}" ** :encoding "utf-8")
        c (client root) uri (.as_uri (.joinpath root "quiet.lpy"))]
    (try
      (initialize! c root)
      (is (empty? (:diagnostics (open! c uri "(ns silent.example) missing"))))
      (notification! c "textDocument/didChange" {:textDocument {:uri uri :version 2}
                                                 :contentChanges [{:text "(ns quiet) missing"}]})
      (is (= "unresolved-symbol" (:code (first (:diagnostics (diagnostics! c 2))))))
      (notification! c "workspace/didChangeConfiguration" {:settings {:linters {:clj-kondo {:level "off"}}}})
      (next-diagnostics! c uri empty?)
      (notification! c "textDocument/didChange" {:textDocument {:uri uri :version 3}
                                                 :contentChanges [{:text "(ns quiet) still-missing"}]})
      (is (empty? (:diagnostics (diagnostics! c 3))))
      (notification! c "workspace/didChangeConfiguration"
                     {:settings {:linters {:clj-kondo {:level "on" :report-duplicates false}}
                                 :diagnostics {:range-type "simple"}}})
      (notification! c "textDocument/didChange" {:textDocument {:uri uri :version 4}
                                                 :contentChanges [{:text "(ns quiet) (inc 1 2)"}]})
      (let [diagnostic (first (:diagnostics (diagnostics! c 4)))]
        (is (= "invalid-arity" (:code diagnostic)))
        (is (= (get-in diagnostic [:range :start]) (get-in diagnostic [:range :end]))))
      (notification! c "textDocument/didChange" {:textDocument {:uri uri :version 5}
                                                 :contentChanges [{:text "(ns quiet) missing missing"}]})
      (is (= 1 (count (:diagnostics (diagnostics! c 5)))))
      (notification! c "workspace/didChangeConfiguration"
                     {:settings {:linters {:clj-kondo {:report-duplicates true}}}})
      (notification! c "textDocument/didChange" {:textDocument {:uri uri :version 6}
                                                 :contentChanges [{:text "(ns quiet) missing missing"}]})
      (is (= 2 (count (:diagnostics (diagnostics! c 6)))))
      (finally (stop! c) (.cleanup temp)))))

(deftest json-client-indentation-settings-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        c (client root) uri (.as_uri (.joinpath root "sample.lpy"))]
    (try
      (result! c "initialize" {:rootUri (.as_uri root) :capabilities {}
                               :initializationOptions {:cljfmt {:indents {"widget" [["block" 1]]}}}})
      (notification! c "initialized" {})
      (open! c uri "(ns sample)\n(widget x\ny)\n")
      (let [edits (result! c "textDocument/formatting"
                           {:textDocument {:uri uri} :options {:tabSize 2 :insertSpaces true}})]
        (is (= "(ns sample)\n(widget x\n  y)\n" (:newText (first edits)))))
      (finally (stop! c) (.cleanup temp)))))

(defn- absolute-tokens [data]
  (:tokens (reduce (fn [{:keys [line column tokens]} [delta-line delta-column length kind modifiers]]
                     (let [row (+ line delta-line) col (if (zero? delta-line) (+ column delta-column) delta-column)]
                       {:line row :column col :tokens (conj tokens [row col length kind modifiers])}))
                   {:line 0 :column 0 :tokens []} (partition 5 data))))

(deftest signature-help-python-and-basilisp-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        c (client root) uri (.as_uri (.joinpath root "signatures.lpy"))
        source "(ns signatures (:import [json] [pathlib]))\n(defn choose ([x] x) ([x y] y))\n(choose 1 2)\n(json/dumps {} ** :indent 2)\n(let [p (pathlib/Path \".\")] (.read_text p ** :encoding \"utf-8\"))"]
    (try
      (let [init (initialize! c root)]
        (is (get-in init [:capabilities :signatureHelpProvider])))
      (open! c uri source)
      (let [help (result! c "textDocument/signatureHelp" (at uri 2 10))]
        (is (= ["(choose [x])" "(choose [x y])"] (mapv :label (:signatures help))))
        (is (= 1 (:activeSignature help)))
        (is (= 1 (:activeParameter help))))
      (let [help (result! c "textDocument/signatureHelp" (at uri 3 25))
            params (mapv :label (:parameters (first (:signatures help))))]
        (is (= "indent" (nth params (:activeParameter help))))
        (is (.startswith (:label (first (:signatures help))) "dumps(")))
      (let [line (last (.split source "\n"))
            help (result! c "textDocument/signatureHelp" (at uri 4 (+ (.find line ":encoding") 5)))]
        (is (not (some #{"self"} (map :label (:parameters (first (:signatures help)))))))
        (is (= "encoding" (:label (nth (:parameters (first (:signatures help))) (:activeParameter help))))))
      (doseq [key [":sort-keys" ":json/sort-keys" "\"sort_keys\""]]
        (let [line (str "(json/dumps {} ** " key " true)")]
          (notification! c "textDocument/didChange"
                         {:textDocument {:uri uri :version 2}
                          :contentChanges [{:text (str "(ns signatures (:import [json]))\n" line)}]})
          (let [help (result! c "textDocument/signatureHelp" (at uri 1 (- (count line) 2)))
                params (:parameters (first (:signatures help)))]
            (is (= "sort_keys" (:label (nth params (:activeParameter help))))))))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 2}
                      :contentChanges [{:text "(ns signatures)\n(defn choose [x y] y)\n(choose 1 "}]})
      (diagnostics! c 2)
      (let [help (result! c "textDocument/signatureHelp" (at uri 2 10))]
        (is (= "(choose [x y])" (:label (first (:signatures help)))))
        (is (= 1 (:activeParameter help))))
      (finally (stop! c) (.cleanup temp)))))

(deftest semantic-tokens-encoding-delta-range-and-settings-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        c (client root) uri (.as_uri (.joinpath root "tokens.lpy"))
        source "(ns tokens)\n(defn f [x] [\"😀\" x :a/key])\n#_(foo\n #_(bar)\n baz)"]
    (try
      (let [init (initialize! c root)]
        (is (= ["namespace" "type" "function" "macro" "keyword" "class" "variable" "method" "event" "interface" "comment"]
               (get-in init [:capabilities :semanticTokensProvider :legend :tokenTypes])))
        (is (get-in init [:capabilities :semanticTokensProvider :full :delta])))
      (open! c uri source)
      (let [full (result! c "textDocument/semanticTokens/full" {:textDocument {:uri uri}})
            tokens (absolute-tokens (:data full))
            unchanged (result! c "textDocument/semanticTokens/full/delta"
                               {:textDocument {:uri uri} :previousResultId (:resultId full)})
            range (result! c "textDocument/semanticTokens/range"
                           {:textDocument {:uri uri} :range {:start {:line 1 :character 0} :end {:line 2 :character 0}}})]
        (is (some #(= [1 18 1 6 0] %) tokens))
        (is (= [2 3 4] (mapv first (filter #(= 10 (nth % 3)) tokens))))
        (is (every? #(not (neg? %)) (:data full)))
        (is (empty? (:edits unchanged)))
        (is (every? #(= 1 (first %)) (absolute-tokens (:data range))))
        (notification! c "textDocument/didChange" {:textDocument {:uri uri :version 2}
                                                   :contentChanges [{:text (str source "\n(f 1)")}]})
        (diagnostics! c 2)
        (let [delta (result! c "textDocument/semanticTokens/full/delta"
                             {:textDocument {:uri uri} :previousResultId (:resultId unchanged)})
              edit (first (:edits delta))
              rebuilt (vec (concat (take (:start edit) (:data full)) (:data edit)
                                   (drop (+ (:start edit) (:deleteCount edit)) (:data full))))
              updated (result! c "textDocument/semanticTokens/full" {:textDocument {:uri uri}})]
          (is (= rebuilt (:data updated)))
          (is (= (:data updated) (:data (result! c "textDocument/semanticTokens/full/delta"
                                                 {:textDocument {:uri uri} :previousResultId "unknown"}))))))
      (notification! c "workspace/didChangeConfiguration" {:settings {:semantic-tokens? false}})
      (is (empty? (:data (result! c "textDocument/semanticTokens/full" {:textDocument {:uri uri}}))))
      (finally (stop! c) (.cleanup temp)))))

(deftest code-actions-lenses-and-call-hierarchy-test
  (let [temp (tempfile/TemporaryDirectory) root (pathlib/Path (.-name temp))
        c (client root) uri (.as_uri (.joinpath root "calls.lpy"))
        source "(ns calls)\n(defn leaf [x] x)\n(defn parent [x] (leaf x))\n(let [unused (parent 1)] 2)"]
    (try
      (initialize! c root)
      (open! c uri source)
      (let [params {:textDocument {:uri uri}
                    :range {:start {:line 3 :character 6} :end {:line 3 :character 12}}
                    :context {:diagnostics []}}
            actions (result! c "textDocument/codeAction" params)
            edit (first (:edits (first (get-in (first actions) [:edit :documentChanges]))))]
        (is (= "_unused" (:newText edit)))
        (is (empty? (result! c "textDocument/codeAction" (assoc-in params [:context :only] ["source.organizeImports"])))))
      (let [lenses (result! c "textDocument/codeLens" {:textDocument {:uri uri}})
            lens (result! c "codeLens/resolve" (first lenses))]
        (is (= 2 (count lenses)))
        (is (= "1 reference" (get-in lens [:command :title])))
        (is (= "code-lens-references" (get-in lens [:command :command])))
        (is (= 1 (count (result! c "workspace/executeCommand" (:command lens))))))
      (let [leaf (first (result! c "textDocument/prepareCallHierarchy" (at uri 1 7)))
            parent (first (result! c "textDocument/prepareCallHierarchy" (at uri 2 7)))
            incoming (result! c "callHierarchy/incomingCalls" {:item leaf})
            outgoing (result! c "callHierarchy/outgoingCalls" {:item parent})]
        (is (= ["parent"] (mapv #(get-in % [:from :name]) incoming)))
        (is (= ["leaf"] (mapv #(get-in % [:to :name]) outgoing)))
        (is (= {:line 2 :character 18} (get-in (first incoming) [:fromRanges 0 :start]))))
      (notification! c "textDocument/didChange"
                     {:textDocument {:uri uri :version 2}
                      :contentChanges [{:text "(ns calls) (def _x 1) (let [x 2] _x)"}]})
      (diagnostics! c 2)
      (is (empty? (result! c "textDocument/codeAction"
                           {:textDocument {:uri uri}
                            :range {:start {:line 0 :character 26} :end {:line 0 :character 27}}
                            :context {:diagnostics [] :only ["quickfix"]}})))
      (finally (stop! c) (.cleanup temp)))))

(deftest multiworkspace-resolution-python-and-rename-isolation-test
  (let [temp (tempfile/TemporaryDirectory) base (pathlib/Path (.-name temp))
        first-root (.joinpath base "one") second-root (.joinpath base "two")
        _ (.mkdir first-root) _ (.mkdir second-root)
        source "(ns shared (:require [provider :as p]) (:import [api]))\n(defn target [x] x)\n(target 1)\n(api/value)\n(p/target 1)"
        first-uri (.as_uri (.joinpath first-root "shared.lpy"))
        second-uri (.as_uri (.joinpath second-root "shared.lpy"))
        c (client first-root)]
    (try
      (doseq [root [first-root second-root]]
        (.write_text (.joinpath root "shared.lpy") source ** :encoding "utf-8")
        (.write_text (.joinpath root "provider.lpy") "(ns provider) (defn target [x] x)" ** :encoding "utf-8")
        (let [executable (.joinpath root ".venv" "bin" "python")]
          (.mkdir (.-parent executable) ** :parents true)
          (.write_text executable (str "#!/bin/sh\nprintf selected > '" (.joinpath root "selected-python")
                                       "'\nexec '" sys/executable "' \"$@\"\n") ** :encoding "utf-8")
          (.chmod executable 0755)))
      (.write_text (.joinpath first-root "api.py") "def value():\n    \"\"\"First workspace.\"\"\"\n    return 1\n" ** :encoding "utf-8")
      (.write_text (.joinpath second-root "api.py") "def value():\n    \"\"\"Second workspace.\"\"\"\n    return 2\n" ** :encoding "utf-8")
      (result! c "initialize" {:workspaceFolders [{:uri (.as_uri first-root) :name "one"}
                                                  {:uri (.as_uri second-root) :name "two"}]
                               :initializationOptions {:source-paths ["."] :text-document-sync-kind "full"}
                               :capabilities {:workspace {:workspaceEdit {:documentChanges true}}}})
      (notification! c "initialized" {})
      (open! c first-uri source)
      (open! c second-uri source)
      (doseq [[uri doc root] [[first-uri "First workspace." first-root] [second-uri "Second workspace." second-root]]]
        (is (= (.as_uri (.joinpath root "provider.lpy"))
               (:uri (result! c "textDocument/definition" (at uri 4 5)))))
        (is (= 2 (count (:documentChanges (result! c "textDocument/rename"
                                                   (assoc (at uri 4 5) :newName "remote-renamed"))))))
        (is (= uri (:uri (result! c "textDocument/definition" (at uri 2 3)))))
        (is (<= 0 (.find (get-in (result! c "textDocument/hover" (at uri 3 4)) [:contents :value]) doc)))
        (is (.is_file (.joinpath root "selected-python")))
        (is (= 1 (count (:documentChanges (result! c "textDocument/rename"
                                                   (assoc (at uri 2 3) :newName "renamed")))))))
      (finally (stop! c) (.cleanup temp)))))

