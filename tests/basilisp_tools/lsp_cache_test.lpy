(ns basilisp-tools.lsp-cache-test
  (:require [basilisp.test :refer [deftest is]]
            [basilisp-tools.lsp]
            [basilisp-tools.cache :as cache]
            [basilisp-tools.regex :as regex])
  (:import [datetime] [decimal] [fractions] [json] [pathlib] [re] [sys] [tempfile] [uuid]
           [pygls.workspace :as workspace] [unittest.mock :as mock]))

(defn- internal [name] (deref (ns-resolve 'basilisp-tools.lsp name)))

(defn- document [root source]
  (workspace/TextDocument (.as_uri (.joinpath root "sample.lpy")) ** :source source))

(defn- fixture []
  (let [temporary (tempfile/TemporaryDirectory)
        root (.resolve (pathlib/Path (.-name temporary)))]
    {:temporary temporary :root root
     :options {:workspace-root (str root) :python-executable sys/executable
               :python-paths [(str root)] :python-inspection? false}}))

(deftest cache-preserves-analysis-data-types-test
  (let [encode cache/encode decode cache/decode
        instant (.fromisoformat datetime/datetime "2026-08-04T12:34:56.123+02:00")
        id (uuid/UUID "123e4567-e89b-12d3-a456-426614174000")
        amount (decimal/Decimal "12345678901234567890.12345678901234567890")
        value (with-meta {:symbol (with-meta 'app/value {:tag 'int}) :keyword :app/value :vector [1 nil true]
                          :list '(a b) :set #{:one :two} :regex (regex/compile "\\Qfoo.bar\\E")
                          :native-regex (re/compile "abc" re/IGNORECASE) :instant instant :uuid id :amount amount :ratio (fractions/Fraction 1 3)
                          :bytes (.encode "hello" "utf-8") :float 1.25
                          :python-dict #py {"member" #py [1 2]}
                          :tuple (python/tuple [1 2]) :python-set (python/set [1 2])}
                {:source :cached})
        restored (decode (json/loads (json/dumps (encode value))))]
    (is (= (dissoc value :regex :python-dict :tuple :python-set)
           (dissoc restored :regex :python-dict :tuple :python-set)))
    (is (= {:source :cached} (meta restored)))
    (is (= {:tag 'int} (meta (:symbol restored))))
    (is (= "\\Qfoo.bar\\E" (regex/source (:regex restored))))
    (is (re/fullmatch (:native-regex restored) "ABC"))
    (is (= (.-flags (:native-regex value)) (.-flags (:native-regex restored))))
    (is (regex/fullmatch (:regex restored) "foo.bar"))
    (is (python/isinstance (:python-dict restored) python/dict))
    (is (python/isinstance (get (:python-dict restored) "member") python/list))
    (is (python/isinstance (:tuple restored) python/tuple))
    (is (python/isinstance (:python-set restored) python/set))))

(deftest persistent-analysis-cache-hit-and-invalidations-test
  (let [{:keys [temporary root options]} (fixture)
        cached (internal 'cached-analysis) cache-file (internal 'analysis-cache-file)
        calls (atom 0) result {:namespace "sample" :findings [] :locals [{:name "x" :type :int}]}
        compute #(do (swap! calls inc) result)
        doc (document root "(ns sample)")
        invoke #(cached doc %1 %2 %3 %4 compute)]
    (try
      (is (= result (invoke {} options {} {})))
      (is (= result (invoke {} options {} {})))
      (is (= 1 @calls))
      (is (.is_file (cache-file doc options {})))
      (doseq [[project opts settings config]
              [[{"other" {"x" {:name "x"}}} options {} {}]
               [{} options {:hover {:arity-on-same-line? false}} {}]
               [{} options {} {:linters {:unused-binding {:level :off}}}]
               [{} (assoc options :python-inspection? true) {} {}]
               [{} (assoc options :python-executable (str (.joinpath root "missing-python"))) {} {}]]]
        (let [before @calls]
          (invoke project opts settings config)
          (is (= (inc before) @calls))))
      (let [before @calls changed (document root "(ns sample) (def value 1)")]
        (cached changed {} options {} {} compute)
        (is (= (inc before) @calls))
        (cached changed {} options {} {} compute)
        (is (= (inc before) @calls)))
      (finally (.cleanup temporary)))))

(deftest analysis-cache-corruption-and-version-fallback-test
  (let [{:keys [temporary root options]} (fixture)
        cached (internal 'cached-analysis) cache-file (internal 'analysis-cache-file)
        doc (document root "(ns sample)") calls (atom 0)
        compute #(do (swap! calls inc) {:namespace "sample" :findings []})
        run #(cached doc {} options {} {} compute)
        file (cache-file doc options {})]
    (try
      (run)
      (doseq [corrupt ["not json" "{\"schema\":999}" "{\"schema\":1,\"analysis\":[\"evaluate\",\"danger\"]}"]]
        (.write_text file corrupt ** :encoding "utf-8")
        (let [before @calls]
          (run)
          (is (= (inc before) @calls))
          (run)
          (is (= (inc before) @calls))))
      (let [payload (json/loads (.read_text file ** :encoding "utf-8"))
            before @calls]
        (.update payload #py {"analysis" #py ["unknown-tag" "(dangerous code)"]})
        (.write_text file (json/dumps payload) ** :encoding "utf-8")
        (run)
        (is (= (inc before) @calls)))
      (is (= [] (vec (.glob (.-parent file) "*.tmp"))))
      (finally (.cleanup temporary)))))

(deftest python-and-hook-source-changes-invalidate-cache-test
  (let [{:keys [temporary root options]} (fixture)
        cached (internal 'cached-analysis) doc (document root "(ns sample)")
        hook-root (.joinpath root ".clj-kondo") hook (.joinpath hook-root "hooks.lpy")
        module (.joinpath root "native.py") dependency (.joinpath root "external.data")
        calls (atom 0) config {:config-directories [(str hook-root)]}
        compute #(do (swap! calls inc)
                     {:namespace "sample" :findings []
                      :python-modules {"native" {:status :ok :dependencies [((internal 'analysis-cache-stat) dependency)]}}})
        run #(cached doc {} options {} config compute)]
    (try
      (.mkdir hook-root)
      (.write_text hook "(ns hooks)" ** :encoding "utf-8")
      (.write_text module "value = 1" ** :encoding "utf-8")
      (.write_text dependency "version 1" ** :encoding "utf-8")
      (run) (run)
      (is (= 1 @calls))
      (doseq [[file content] [[module "value = 222"] [hook "(ns hooks) (def x 1)"] [dependency "version two"]]]
        (.write_text file content ** :encoding "utf-8")
        (let [before @calls]
          (run)
          (is (= (inc before) @calls))
          (run)
          (is (= (inc before) @calls))))
      (.unlink dependency)
      (let [before @calls] (run) (is (= (inc before) @calls)))
      (finally (.cleanup temporary)))))

(deftest configured-cache-path-and-disabled-cache-test
  (let [{:keys [temporary root options]} (fixture)
        cached (internal 'cached-analysis) cache-file (internal 'analysis-cache-file)
        doc (document root "(ns sample)") calls (atom 0)
        compute #(do (swap! calls inc) {:findings []})
        settings {:cache-path "tool-cache"}]
    (try
      (cached doc {} options settings {} compute)
      (cached doc {} options settings {} compute)
      (is (= 1 @calls))
      (is (.is_relative_to (cache-file doc options settings) (.joinpath root "tool-cache")))
      (is (not (.exists (.joinpath root ".lsp"))))
      (is (nil? (cache-file doc options {:cache-path false})))
      (is (nil? (cache-file doc (assoc options :cache false) {})))
      (is (nil? (cache-file doc (dissoc options :workspace-root) {})))
      (doseq [_ (range 2)] (cached doc {} options {:cache-path false} {} compute))
      (is (= 3 @calls))
      (let [absolute (.joinpath root "absolute-cache")]
        (is (.is_relative_to (cache-file doc options {:cache-path (str absolute)}) absolute)))
      (finally (.cleanup temporary)))))

(deftest uncacheable-values-and-transient-inspection-retry-test
  (let [{:keys [temporary root options]} (fixture)
        cached (internal 'cached-analysis) doc (document root "(ns sample)")
        calls (atom 0) result {:findings [] :python-modules {"missing" {:reason "inspection-timeout"}}}
        compute #(do (swap! calls inc) result)]
    (try
      (is (= result (cached doc {} options {} {} compute)))
      (is (= result (cached doc {} options {} {} compute)))
      (is (= 2 @calls))
      (let [uncacheable {:findings [] :opaque (python/object)}
            compute #(do (swap! calls inc) uncacheable)]
        (is (= uncacheable (cached doc {} options {} {} compute)))
        (is (= uncacheable (cached doc {} options {} {} compute)))
        (is (= 4 @calls)))
      (finally (.cleanup temporary)))))

(deftest analysis-context-memoization-respects-epochs-test
  (let [{:keys [temporary root options]} (fixture)
        key (internal 'analysis-cache-key) storage (atom {})
        options (assoc options :persistent-cache-context storage :analysis-epoch 0)
        project {"sample" {"value" {:name "value"}}} doc (document root "(ns sample)")]
    (try
      (let [fingerprint (key doc project options {} {})]
        (is (= fingerprint (key doc project options {} {})))
        (is (= 1 (count @storage)))
        (is (not= fingerprint (key (document root "(ns changed)") project options {} {})))
        (is (= 1 (count @storage)))
        (is (= fingerprint (key doc project (assoc options :analysis-epoch 1) {} {})))
        (is (= 2 (count @storage)))
        (is (not= fingerprint (key doc project options {:settings-changed true} {}))))
      (finally (.cleanup temporary)))))

(deftest real-python-analysis-reuses-persistent-cache-test
  (let [{:keys [temporary root options]} (fixture)
        analyze (internal 'analyze-document)
        module (.joinpath root "native.py")
        doc (document root "(ns sample (:import [native :as native])) (native/typed 1)")
        settings {:kondo-config-dir ".clj-kondo"}
        original (deref (ns-resolve 'basilisp-tools.analyzer 'analyze))
        patch (mock/patch "basilisp_tools.analyzer.analyze" ** :wraps original)
        spy (.start patch)]
    (try
      (.write_text module "def typed(value: int) -> str:\n    return str(value)\n" ** :encoding "utf-8")
      (let [first-result (analyze doc {} options settings)
            restarted (analyze doc {} (assoc options :persistent-cache-context (atom {})) settings)]
        (is (= first-result restarted))
        (is (= 1 (.-call_count spy)))
        (is (seq (:python-usages restarted)))
        (is (seq (get-in restarted [:python-modules "native" :dependencies]))))
      (.write_text module "def typed(value: str) -> int:\n    return len(value)\n" ** :encoding "utf-8")
      (analyze doc {} options settings)
      (is (= 2 (.-call_count spy)))
      (finally (.stop patch) (.cleanup temporary)))))

(deftest dependency-change-during-analysis-does-not-poison-cache-test
  (let [{:keys [temporary root options]} (fixture)
        cached (internal 'cached-analysis) stamp (internal 'analysis-cache-stat)
        doc (document root "(ns sample)") dependency (.joinpath root "external.data") calls (atom 0)
        compute (fn []
                  (swap! calls inc)
                  (let [read-version (stamp dependency)]
                    (.write_text dependency (str "changed during analysis " @calls) ** :encoding "utf-8")
                    {:findings [] :python-modules {"external" {:dependencies [read-version]}}}))]
    (try
      (.write_text dependency "original" ** :encoding "utf-8")
      (cached doc {} options {} {} compute)
      (cached doc {} options {} {} compute)
      (is (= 2 @calls))
      (finally (.cleanup temporary)))))

(deftest unsaved-editor-snapshots-preserve-the-saved-analysis-cache-test
  (let [{:keys [temporary root options]} (fixture)
        cached (internal 'cached-analysis) file (.joinpath root "sample.lpy")
        uri (.as_uri file) source "(ns sample)" calls (atom 0)
        saved (workspace/TextDocument uri ** :source source :version 1)
        dirty (workspace/TextDocument uri ** :source "(ns sample) missing" :version 2)
        compute #(do (swap! calls inc) {:namespace "sample" :findings []})]
    (try
      (.write_text file source ** :encoding "utf-8")
      (cached saved {} options {} {} compute)
      (is (= 1 @calls))
      (cached dirty {} options {} {} compute)
      (cached dirty {} options {} {} compute)
      (is (= 3 @calls))
      ;; Returning to the on-disk text still hits the cache written before edits.
      (cached saved {} options {} {} compute)
      (is (= 3 @calls))
      (.write_text file (.-source dirty) ** :encoding "utf-8")
      (cached dirty {} options {} {} compute)
      (cached dirty {} options {} {} compute)
      (is (= 4 @calls))
      (finally (.cleanup temporary)))))

(deftest persistent-cache-preserves-shared-metadata-test
  (let [{:keys [temporary root options]} (fixture)
        cached (internal 'cached-analysis) doc (document root "(ns sample)")
        shared {:name "read" :parameters [{:name "source" :type "str"}]
                :literal {"$ref" 9 "$blt_graph" "user-value"}}
        result {:namespace "sample" :findings [] :first shared :second shared}
        calls (atom 0) compute #(do (swap! calls inc) result)]
    (try
      (cached doc {} options {} {} compute)
      (let [restored (cached doc {} options {} {} compute)]
        (is (= result restored))
        (is (= 1 @calls))
        (is (identical? (:first restored) (:second restored))))
      (finally (.cleanup temporary)))))

(deftest stale-persistence-does-not-replace-an-existing-cache-test
  (let [temporary (tempfile/TemporaryDirectory)
        root (pathlib/Path (.-name temporary)) file (.joinpath root "snapshot.json")
        write (internal 'analysis-cache-write!) calls (atom 0)]
    (try
      (write file "old" {:findings [] :source "saved"})
      (let [original (.read_text file)]
        ;; The snapshot becomes stale after encoding but before atomic replace.
        (write file "stale" {:findings [] :source "obsolete"} #(= 1 (swap! calls inc)))
        (is (= 2 @calls))
        (is (= original (.read_text file)))
        (is (empty? (vec (.glob root ".blt-*.tmp")))))
      (finally (.cleanup temporary)))))

(deftest cache-rejects-unsupported-values-and-unknown-tags-test
  (let [encode cache/encode decode cache/decode]
    (is (thrown? python/TypeError (encode (python/object))))
    (is (thrown? python/ValueError (decode #py ["eval" "(print :unexpected)"])))
    (is (thrown? python/ValueError (decode #py ["keyword" "name" "extra"])))
    (is (thrown? python/ValueError (decode #py {"unexpected" "map"})))))

(deftest native-name-parts-survive-cache-roundtrip-test
  (doseq [value [(keyword "" "k") (keyword "/" "k") (keyword nil "/")
                 (symbol "" "k") (symbol "/" "k") (symbol nil "/")
                 (with-meta (symbol "/" "k") {:tag (symbol "" "type")})]
          [encode decode] [[cache/encode cache/decode] [cache/encode-graph cache/decode-graph]]]
    (let [restored (decode (json/loads (json/dumps (encode value))))]
      (is (= (namespace value) (namespace restored)))
      (is (= (name value) (name restored)))
      (is (= (meta value) (meta restored)))))
  (is (= :example/name (cache/decode #py ["keyword" "example/name"])))
  (is (= 'example/name (cache/decode #py ["symbol" "example/name"])))
  (is (thrown? python/ValueError (cache/decode #py ["keyword" #py ["ns" "name" "extra"]]))))
